{- ---------------------------------------------------------------------------
   PFLam.module

   The Plausible Fiction object language, in the syntax frozen by
   docs/mettail/mettail-ddl-and-modules-2026-08-19.md.

   This is the `Theory PFLam()` of `publications/plausible-fiction/
   plausible-fiction.tex` (revision of 2026-08-26), decomposed into the four
   independent extensions the paper's section 4 describes, so that the join
   at the bottom is a real pushout rather than one flat declaration.

   `Core` is the dependent lambda-calculus. `Records`, `Variants` and `Holes`
   each extend it and nothing else. They are joined over the SAME `Core`
   instance, so the result has exactly one `Term` carrier -- the same shape as
   `Rholang(nr, rc)` over `QuoteDropCalc` in Rholang.module. Instantiating
   `Core` three times and joining would claim three unrelated calculi that
   happen to share a spelling, and the elaborator rejects it.

   Three things the withdrawn `language!` block carried are deliberately
   absent, and section 4.3 of the paper says why:

     * `grounded`, `holes` and `plug` were term formers carrying native
       folds. They are host operations over this syntax -- `holes` does not
       even return a `Term` -- and now live at the bridge.
     * The `logic { relation ... }` block. The bidirectional checker is an
       ascent program beside the theory; `Theory` has no relational builder.
     * `![String] as HoleId` and friends. `Types` declares categories; how a
       category is pinned to a host ground type is plan 9.4, still open, so
       `HoleId`, `MetaId`, `Tag` and `Lvl` are declared here as ordinary
       categories with no constructors -- exactly as `Elem` is in
       `EmptySet()`.
--------------------------------------------------------------------------- -}

Module PF {

  -- The dependent core: universes, Pi, lambda, application.
  --
  -- There is no `Var` rule. Variables arise only from binders, and a binder
  -- is the abstraction sort `^x.body:[Term -> Term]` (G4). Under the old
  -- positional grammar a `Var` former was needed to give bound occurrences
  -- something to be; HOAS removes it.
  Theory Core() {
    Types {
      Term;
      Lvl;
    }
    Exports {
      Term;
      Lvl;
    }
    Terms {
      Univ . l:Lvl |- "Type" l : Term;
      Pi   . dom:Term, ^x.cod:[Term -> Term]
           |- "Pi" "(" x ":" dom ")" "." cod : Term;
      Lam  . dom:Term, ^x.body:[Term -> Term]
           |- "lam" "(" x ":" dom ")" "." body : Term;
      App  . fun:Term, arg:Term |- "(" fun " " arg ")" : Term;
    }
    Equations {
      (App (Lam a ^x.b) c) == (subst ^x.b c);

      -- Eta, with its side condition expressible. The withdrawn block could
      -- only write "x not free in f" as a comment.
      if x # f then (Lam a ^x.(App f x)) == f;
    }
    Rewrites {
      RBeta   : (App (Lam a ^x.b) c) ~> (subst ^x.b c);
      RAppFun : if S ~> T then (App S c) ~> (App T c);
      RAppArg : if S ~> T then (App c S) ~> (App c T);
      RLam    : if S ~> T then (Lam a ^x.S) ~> (Lam a ^x.T);
    }
  }

  -- Dependent records. Goods and services are Sigma-bundles: a venue is a
  -- location together with a capacity that depends on it.
  Theory Records(c: Core) {
    c
      Terms {
        Sig  . dom:Term, ^x.cod:[Term -> Term]
             |- "Sig" "(" x ":" dom ")" "." cod : Term;
        Pair . a:Term, b:Term |- "<" a "," b ">" : Term;
        Fst  . p:Term |- "fst" p : Term;
        Snd  . p:Term |- "snd" p : Term;
      }
      Equations {
        (Fst (Pair a b)) == a;
        (Snd (Pair a b)) == b;
      }
      Rewrites {
        RFst    : (Fst (Pair a b)) ~> a;
        RSnd    : (Snd (Pair a b)) ~> b;
        RFstArg : if S ~> T then (Fst S) ~> (Fst T);
        RSndArg : if S ~> T then (Snd S) ~> (Snd T);
      }
  }

  -- Finite dependent variants: the outcomes a plan can branch on.
  --
  -- Two things to note. First, the motive of `Case` is WRITTEN
  -- (`case s return M of { ... }`). G6 requires every argument in the
  -- context to be referenced exactly once in the concrete syntax, and the
  -- old positional form let the motive be passed without being spelled.
  --
  -- Second, variant beta selects the matching arm by a remainder pattern
  -- with a REPEATED label variable `l` -- structurally the same rule as
  -- rho's COMM, which repeats the channel `n`. The pattern is the
  -- selection, so no `selectArm` helper is needed.
  --
  -- `alts` and `brs` are HashBags, which is the closest sort the frozen
  -- surface offers. A bag admits duplicates, so label-uniqueness across
  -- alternatives is NOT enforced structurally here; see plan 9.3.
  Theory Variants(c: Core) {
    c
      Types {
        Tag;
        VariantAlt;
        CaseBranch;
      }
      Exports {
        Tag;
        VariantAlt;
        CaseBranch;
      }
      Terms {
        Variant . alts:HashBag(VariantAlt)
                |- "<" alts.*sep("|") ">" : Term;
        Alt     . lbl:Tag, ty:Term |- lbl ":" ty : VariantAlt;
        Inj     . lbl:Tag, val:Term |- "inj" lbl val : Term;
        Case    . scrut:Term, mot:Term, brs:HashBag(CaseBranch)
                |- "case" scrut "return" mot "of" "{" brs.*sep(";") "}" : Term;
        CaseBr  . lbl:Tag, ^x.body:[Term -> Term]
                |- lbl " " x "=>" body : CaseBranch;
      }
      Equations {
        (Case (Inj l a) mot { (CaseBr l ^x.body), ...rest })
          == (subst ^x.body a);
      }
      Rewrites {
        -- Reduces on a KNOWN injection. On a scrutinee stuck against an
        -- unresolved hole no rule applies, and that stuck term is a branch
        -- point of the demand tree (paper section 4.5). Stuckness is now a
        -- property of the rule set rather than a comment on the rule.
        RCase  : (Case (Inj l a) mot { (CaseBr l ^x.body), ...rest })
                   ~> (subst ^x.body a);
        RScrut : if S ~> T then (Case S mot { ...brs })
                   ~> (Case T mot { ...brs });
        RArm   : if S ~> T then (Case c mot { (CaseBr l ^x.S), ...rest })
                   ~> (Case c mot { (CaseBr l ^x.T), ...rest });
      }
  }

  -- The three distinguishing constructors.
  --
  --   Hole  filler-resolved.   Supplied by another participant's PF. `ty` is
  --                            the Pi-closed interface Pi Gamma_h . T_h.
  --   Obs   outcome-resolved.  Revealed by RUNNING a step (attestation), not
  --                            by a market plug. A legitimate case scrutinee
  --                            and a demand-tree branch point.
  --   Meta  unification-solved. An elaboration metavariable. NEVER
  --                            advertised to the market.
  Theory Holes(c: Core) {
    c
      Types {
        HoleId;
        MetaId;
      }
      Exports {
        HoleId;
        MetaId;
      }
      Terms {
        Hole . h:HoleId, ty:Term |- "?" h ":" ty : Term;
        Obs  . h:HoleId, ty:Term |- "observe" h ":" ty : Term;
        Meta . m:MetaId, ty:Term |- "%" m ":" ty : Term;
      }
  }

  -- The join. `r`, `v` and `h` descend from the same `Core`, so this is a
  -- pushout over it: one `Term`, one `Lvl`, one `App`. The result is the
  -- theory the paper calls PFLam.
  Theory PFLam(r: Records, v: Variants, h: Holes) {
    r \/ v \/ h
  }

  Theory FreePFLam() {
    let c = Core() in (
    let r = Records(c) in (
    let v = Variants(c) in (
    let h = Holes(c) in (
    PFLam(r, v, h)
    ))))
  }

  theory FreePFLam()
}
