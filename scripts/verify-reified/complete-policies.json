{
  "forbidden_non_test": [
    {"pattern": "panic!", "reason": "no panic paths in non-test code"},
    {"pattern": "assert!", "reason": "no assertions in non-test code"},
    {"pattern": "assert_eq!", "reason": "no assertions in non-test code"},
    {"pattern": "assert_ne!", "reason": "no assertions in non-test code"},
    {"pattern": "unreachable!", "reason": "no panic paths in non-test code"},
    {"pattern": "todo!", "reason": "no placeholders"},
    {"pattern": "unimplemented!", "reason": "no placeholders"},
    {"pattern": ".unwrap()", "reason": "prefer typed errors; only lock expects are allowed"},
    {"pattern": "TODO", "reason": "no placeholders"},
    {"pattern": "FIXME", "reason": "no placeholders"},
    {"pattern": "debug_assertions", "reason": "checks run in every build profile (FR-7)"},
    {"pattern": "saturating_", "reason": "checked arithmetic only (FR-6)"},
    {"pattern": "remove_data_at_recorded", "reason": "do-not-use: records a logical produce instead of the real source"},
    {"pattern": "remove_all_continuations", "reason": "do-not-use: leaves join entries behind"}
  ],
  "forbidden_anywhere": [
    {"pattern": "datum_index_key", "reason": "consensus checklist: no arity index"},
    {"pattern": "search_data_candidates", "reason": "consensus checklist: no backtracking search"},
    {"pattern": "event_coverage", "reason": "consensus checklist: no production EventCoverage"},
    {"pattern": "write_exclusive", "reason": "M-1 replaced write_exclusive"},
    {"pattern": "writeExclusive", "reason": "M-1 replaced write_exclusive"},
    {"pattern": "suffix_key", "reason": "I-1 dropped suffix_key"},
    {"pattern": "0xF3", "reason": "decision 7: the Reified namespace tag is 0xE0"},
    {"pattern": "0xf3", "reason": "decision 7: the Reified namespace tag is 0xE0"}
  ],
  "allowed_expect": "\\.expect\\(\"[^\"]* lock\"\\)",
  "test_region_start": "^#\\[cfg\\(test\\)\\]\\s*$",
  "production_scan": {
    "description": "Plan grep gate: no production source holds a consensus token.",
    "roots": ["casper/src", "comm/src", "models/build.rs", "models/src", "node/src", "rho-pure-eval/src", "rholang/src", "rspace++/src"],
    "suffixes": [".rs", ".proto"],
    "patterns": [
      {"pattern": "datum_index_key", "reason": "item 3: no arity index"},
      {"pattern": "pattern_index_prefix", "reason": "item 3: no arity index"},
      {"pattern": "select_indexed_candidates", "reason": "item 3: no indexed candidate selection"},
      {"pattern": "search_data_candidates", "reason": "item 3: no backtracking search"},
      {"pattern": "changed_history_keys", "reason": "item 4: no production trie diff for event coverage"},
      {"pattern": "changed_leaf_keys", "reason": "item 4: no production trie diff for event coverage"},
      {"pattern": "checkpoint_unpublished", "reason": "item 13: checkpoint publication is unchanged"},
      {"pattern": "decode_checked", "reason": "items 5 and 13: history trie decoding is unchanged"},
      {"pattern": "UnsupportedPriorityMetadata", "reason": "item 8 and I-5: no event message gets a priority field"},
      {"pattern": "write_exclusive", "reason": "item 8 and M-1"},
      {"pattern": "writeExclusive", "reason": "item 8 and M-1"},
      {"pattern": "query_specs", "reason": "item 5 and M-2: host structs get no query field"},
      {"pattern": "querySpecs", "reason": "item 8 and I-5: no event message gets a query field"},
      {"pattern": "TypedQuerySpec", "reason": "item 17 and I-1: the host gets no typed query"},
      {"pattern": "consume_with_query_specs", "reason": "item 17 and I-1: ISpace gets no query consume"},
      {"pattern": "suffix_key", "reason": "item 17 and I-1"},
      {"pattern": "SpacePathKey", "reason": "decision 7: Reified channels use the 0xE0 namespace tag, not a path key"},
      {"pattern": "space_channel_codec", "reason": "decision 7: no path-key channel codec"},
      {"pattern": "par_wire_", "reason": "decision 1: stack-safe Par codecs belong to the Bag campaign"},
      {"pattern": "ParBag", "reason": "decision 1: ParBag belongs to the Bag campaign"},
      {"pattern": "BagReservation", "reason": "decision 1: Bag work belongs to the Bag campaign"},
      {"pattern": "use_blocks", "reason": "item 16 and decision 18: no K15 protobuf field"},
      {"pattern": "e_free_body", "reason": "item 16 and decision 18: no K15 protobuf field"},
      {"pattern": "event_coverage", "reason": "item 4: no production EventCoverage"}
    ]
  },
  "phases": {
    "p1": {
      "description": "P1 storage substrate (decision 19 and the fix rules FR-1 to FR-10).",
      "sources": [
        "rspace++/src/rspace/space_store_handle.rs",
        "rspace++/src/rspace/rspace/space_play.rs",
        "rspace++/src/rspace/replay_rspace/space_replay.rs"
      ],
      "entry_points": [
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "pub trait SpaceTxnHost<"},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "pub trait SpaceTxn<"},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "pub struct SpaceStoreHandle<"},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "pub fn sub_order("},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "pub fn begin_evaluation_scope("},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "fn sweep_volatile("},
        {"file": "rspace++/src/rspace/space_store_handle.rs", "pattern": "fn root_leaf_record_count("},
        {"file": "rspace++/src/rspace/rspace/space_play.rs", "pattern": "SpaceTxnHost<C, P, A, K> for RSpace<C, P, A, K>"},
        {"file": "rspace++/src/rspace/replay_rspace/space_replay.rs", "pattern": "SpaceTxnHost<C, P, A, K> for ReplayRSpace<C, P, A, K>"},
        {"file": "rspace++/src/rspace/replay_rspace/space_replay.rs", "pattern": "SpaceTxnHost<C, P, A, K> for ReportingRspace<C, P, A, K>"}
      ],
      "tests": [
        "rspace++/tests/reified_space_store_handle.rs",
        "rspace++/tests/reified_space_store_handle_props.rs",
        "rspace++/tests/reified_space_store_handle/support.rs",
        "rholang/tests/reified_space_store_handle_par.rs",
        "rholang/tests/reified_space_txn_host_bounds.rs"
      ],
      "property_files": [
        "rspace++/tests/reified_space_store_handle_props.rs",
        "rholang/tests/reified_space_store_handle_par.rs"
      ]
    }
  }
}
