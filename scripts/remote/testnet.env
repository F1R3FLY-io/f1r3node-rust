# CBC Casper test net, shard 1 (docs/plans/test-net.md section 3).
# Load with TESTBED_PROFILE=testnet; oci-common.sh sources this file before
# its defaults, so an explicit environment value still wins.
#
# Two linux/amd64 VMs: the 60h stability soak tests the amd64 digest, so
# the test net runs that same digest. Sizing starts from the soak RSS
# envelope and is re-measured by TASK-014-2.

: "${TESTBED_NAME:=f1r3node-rust-testnet-cbc-casper-1}"
: "${VPS1_NAME:=${TESTBED_NAME}-vm-a}"
: "${VPS2_NAME:=${TESTBED_NAME}-vm-b}"
: "${VCN_CIDR:=10.2.0.0/16}"
: "${SUBNET_CIDR:=10.2.1.0/24}"
: "${SHAPE:=VM.Standard.E5.Flex}"
: "${VPS1_OCPUS:=4}"
: "${VPS1_MEMORY_GB:=24}"
: "${VPS2_OCPUS:=4}"
: "${VPS2_MEMORY_GB:=24}"
: "${STATE_FILE:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/testnet-state.json}"
: "${KEY_FILE:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/testnet.pem}"
