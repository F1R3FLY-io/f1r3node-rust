' Sequence Diagram 02 — Estimator::tips deterministic fork-choice pipeline.
'
' The tips() call chain in casper/src/rust/estimator.rs, in order:
'   consume the certified eligible-message projection
'   → calculate_lca over every eligible message
'   → build_scores_map (parallel per-validator ancestry; ordered reduction)
'   → greedy_ghost_head (per-level score/hash argmax)
'   → terminal_frontier (all asynchronous branch expansions; deduplicated)
'   → rank_forkchoices (greedy head ++ sorted remaining terminals)
'   → filter_deep_parents (max_parent_depth)
'   → take(max_number_of_parents)
'
' Every step is a PURE function of (DAG, latest_messages), so all honest nodes
' compute a node-identical ForkChoice (Rocq fork_choice_determinism_correct).
'
' Render:
'   plantuml -tsvg docs/casper/theory/fork-choice/diagrams/02-seq-tips-pipeline.puml

@startuml 02-seq-tips-pipeline
!theme plain

skinparam sequence {
  ArrowColor            #444444
  LifeLineBorderColor   #666666
  LifeLineBackgroundColor #F5F5F5
  ParticipantBorderColor #333333
  ParticipantFontName   "monospace"
  ParticipantFontSize   10
  NoteBackgroundColor   #FFF7E0
  NoteBorderColor       #E65100
}
skinparam defaultFontName "monospace"
skinparam defaultFontSize 10

title Estimator::tips pipeline (deterministic fork-choice)

' Participant color legend:
'   Estimator      = gold      (#FFE082)  the pure fork-choice driver
'   DAG            = sky blue  (#BBDEFB)  block metadata + children reads
'   Certified ctx  = lavender  (#D1C4E9)  frozen round authority and votes
'
' Arrow color legend:
'   blue   (#1565C0) = read query to the DAG
'   green  (#2E7D32) = bonded-weight lookup
'   gray   (#546E7A) = self-step (pure transform)
'   orange (#E65100) = final result

participant "Estimator" as EST #FFE082
participant "DAG" as DAG #BBDEFB
participant "Certified context" as CTX #D1C4E9

activate EST

EST -[#1565C0]> CTX : eligible_latest_messages()
note over EST
  exact complete slots; sender, generation,
  objective evidence, and floor ancestry bound
end note

EST -[#1565C0]> DAG : calculate_lca(..)
activate DAG
note over DAG
  lowest_universal_common_ancestor_many
  over every certified eligible message
end note
DAG --[#1565C0]> EST : LCA hash
deactivate DAG

EST -[#546E7A]> EST : build_scores_map — BFS to LCA
activate EST #C8E6C9
loop parallel per eligible validator, down every parent path
  EST -[#2E7D32]> CTX : frozen_authority[validator]
  CTX --[#2E7D32]> EST : positive i64 stake
  EST -[#546E7A]> EST : emit per-validator contribution map
end
EST -[#546E7A]> EST : deterministic checked ordered reduction
deactivate EST

EST -[#546E7A]> EST : greedy_ghost_head(lca)
activate EST #FFE0B2
loop until no scored child
  EST -[#1565C0]> DAG : children(block)
  activate DAG
  DAG --[#1565C0]> EST : scored children
  deactivate DAG
  EST -[#546E7A]> EST : require child height advances;\nselect score DESC, hash ASC head
end
deactivate EST

EST -[#546E7A]> EST : terminal_frontier({lca})
loop asynchronous expansion order
  EST -[#1565C0]> DAG : all scored children(block)
  DAG --[#1565C0]> EST : height-advancing children
  EST -[#546E7A]> EST : set replacement + deduplication
end
EST -[#546E7A]> EST : require ghost in frontier;\nranked = ghost ++ sorted(frontier - ghost)

EST -[#1565C0]> DAG : filter_deep_parents(ranked)
activate DAG
DAG --[#1565C0]> EST : block_number(main) − p ≤ max_parent_depth
deactivate DAG

EST -[#546E7A]> EST : take(max_number_of_parents)\n(B2 cast-safe: < 0 or i32::MAX ⟹ all)

EST -[#E65100]>o EST : ForkChoice { tips, lca }
deactivate EST

note over EST, CTX
  Every step is a PURE function of (DAG, certified context)
  ⟹ node-identical result on every honest node.
  Rocq fork_choice_determinism_correct (axiom-free).
end note

@enduml
