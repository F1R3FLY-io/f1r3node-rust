' Component Diagram 01 — Finalized-floor: spec <-> Rocq <-> TLA+ <-> Z3/Sage <-> Rust.
'
' Each box is a finalized-floor-merge component, annotated with:
'   - the spec concern it addresses,
'   - the Rocq module(s) + key lemmas that mechanize it,
'   - the TLA+ module(s) that model-check it,
'   - the Z3 / Sage witness (where one exists),
'   - the Rust file that implements it.
'
' Source of truth for the traceability table in
' docs/casper/theory/finalized-floor/finalized-floor-verification.md (section 4),
' mirroring the slashing verification doc's Figure 11.1 component-correspondence style.
'
' Render:
'   plantuml -tsvg docs/casper/theory/finalized-floor/diagrams/01-component-correspondence.puml

@startuml 01-component-correspondence
!theme plain

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor     #333333
}
skinparam package {
  BackgroundColor<<Derivation>> #E3F2FD
  BackgroundColor<<Oracle>>     #FFF7EE
  BackgroundColor<<Algebra>>    #EEFAF1
  BackgroundColor<<Driver>>     #FFF3E0
  BackgroundColor<<Recovery>>   #F3E5F5
  BackgroundColor<<Storage>>    #EFEBE9
  BackgroundColor<<Theorem>>    #E8F5E9
  BorderColor #444444
}
skinparam defaultFontName "monospace"
skinparam defaultFontSize 10

title Finalized-floor: spec ─ Rocq ─ TLA⁺ ─ Z3/Sage ─ Rust correspondence

' Layer color legend (fill per concept):
'   derivation / frontier walk = sky blue   (#BBDEFB)
'   clique oracle              = warm amber  (#FFECB3)
'   merge write-algebra        = mint green  (#C8E6C9)
'   merge driver / Δ-backstop  = orange      (#FFE0B2)
'   recovery                   = lavender    (#D1C4E9)
'   floor / frontier cache     = tan/storage (#D7CCC8)
'   capstone theorem           = strong green(#A5D6A7)
'
' Edge color legend:
'   blue   (#1565C0) = read query
'   orange (#E65100) = write / persist
'   teal   (#00838F) = drives (orchestration)
'   gray   (#546E7A) = uses / delegates
'   (hidden edges anchor the capstone on top)

package "Capstone" <<Theorem>> {
  component "Capstone theorem ── axiom-free\n──────────────────────────────────────\nRocq  MainTheorem.v\n  ▶ finalized_floor_merge_correct\n  ▶ finalized_floor_selection_correct\n  ▶ finalized_floor_arithmetic_correct\n  ▶ finalized_floor_phase7_correct\nPrint Assumptions ⟹ Closed under the\n  global context (no Axiom / Admitted)" as CAP #A5D6A7
}

package "Derivation layer" <<Derivation>> {
  component "Floor derivation / frontier walk\n──────────────────────────────────────\nspec  floor(B) over frozen just(B);\n      incremental up-walk from pivot F(X)\nRocq  Floor.v (frontier_cache_transparent)\n      Selection.v (select_sound,\n        case_a_common_ancestor,\n        case_b_compatible,\n        select_highest_sound,\n        scope_covers_band)\n      GuardBridge.v (chain_adj_AdjDC,\n        guard_constant_committee_transparent,\n        upgo_finalized)\nTLA⁺  FinalizedFloor.tla,\n      FinalizedFloorScan.tla\nRust  casper/src/rust/finality/floor.rs" as D #BBDEFB
}

package "Oracle layer" <<Oracle>> {
  component "Clique oracle  ft_witnessed > θ\n──────────────────────────────────────\nspec  quorum-finalization decision\nRocq  CliqueOracle.v (L_ANC, L_SNAP)\nZ3    ft_algebra_crosswitness.py\nSage  ft_algebra.sage\nRust  casper/src/rust/safety/clique_oracle.rs" as OR #FFECB3
}

package "Algebra layer" <<Algebra>> {
  component "Merge write-algebra\n──────────────────────────────────────\nspec  per-channel fold (keep-all / add)\nRocq  Merge.v  BitmaskOr semilattice\n        (merge_or_perm,\n         merge_or_no_lost_bit)\n      IntegerAdd.v  wrapping group +\n        checked apply\n        (wadd_assoc,\n         checked_apply_rejects_overflow,\n         checked_apply_rejects_negative,\n         checked_combine_sound,\n         supply_cap_no_launder)\nZ3    integeradd_launder_bitvec.py\nRust  rspace++/…/merging_logic.rs\n        (combine, checked_add)\n      casper/…/conflict_set_merger.rs\n        (cal_merged_result ── REJECT decision)\n      rholang/…/rholang_merging_logic.rs\n        (calculate_number_channel_merge ──\n           terminal APPLY, checked_add + ≥0;\n         calculate_num_channel_diff ──\n           wrapping-group inverse)" as MA #C8E6C9
}

package "Driver layer" <<Driver>> {
  component "Merge driver / scope / Δ-backstop\n──────────────────────────────────────\nspec  derive floor ▶ Δ-guard ▶ scan ▶ fold\nRocq  Selection.scope_covers_band\nTLA⁺  FinalizedFloor.tla\n        (Inv_NoLostParentWrite,\n         Inv_DeltaWithinCap)\nRust  casper/…/interpreter_util.rs\n        (compute_parents_post_state)" as DR #FFE0B2
}

package "Recovery layer" <<Recovery>> {
  component "Recovery\n──────────────────────────────────────\nspec  one-shot re-proposal; additive\n      channel not double-counted\nRocq  Recovery.v (apply_idem,\n        no_double_apply)\nRust  recovery path (canonical_won_sigs)" as RC #D1C4E9
}

package "Storage layer" <<Storage>> {
  database "Floor / frontier cache (LMDB)\n──────────────────────────────────────\nspec  persist pivot F(X) and floor(X)\nRust  block-storage/…/\n        block_dag_key_value_storage.rs\n        (floor_index, frontier_index)" as CA #D7CCC8
}

' === Explicit (visible) edges ===
D  -[#1565C0]-> OR : reads ft_witnessed > θ\nover just(B)
D  -[#1565C0]-> CA : read pivot F(parent)\n(warm hit)
D  -[#E65100]-> CA : persist F(B), floor(B)\n(pure fn of B)
DR -[#00838F]-> D  : drives floor(B) derivation\n(before the scan)
DR -[#00838F]-> MA : drives band-write\nmerge fold
DR -[#546E7A]-> RC : re-propose rejected\nco-parent writes

' === Hidden edges: anchor the capstone on top, connected to all ===
CAP -[hidden]-> D
CAP -[hidden]-> OR
CAP -[hidden]-> MA
CAP -[hidden]-> DR
CAP -[hidden]-> RC
CAP -[hidden]-> CA

@enduml
