' Component Diagram 06 — Event-log split soundness (P2): a union monoid.
'
' DeployChainIndex::new (deploy_chain_index.rs:70-88) partitions each block's
' deploys into a user bucket and a system bucket (by is_system_deploy_id), folds
' each bucket into a user_event_log_index / system_event_log_index, then takes
' EventLogIndex::combine(user, system) (event_log_index.rs:343) — field-wise SET
' UNION on the conflict-relevant produce/consume sets. Set union is a commutative,
' associative, IDEMPOTENT monoid (a join-semilattice) with the empty index as
' identity, so:
'
'     combine(fold user, fold system)  =  fold(all deploys)
'
' and therefore any conflict detector (a pure function of the combined index)
' returns the SAME verdict on the split-recombined index and the monolithic index
' — the split can hide NO user↔system conflict.
'
' Witnesses: Rocq EventLogSplit.combine_split_eq / conflicts_split_complete /
'            event_log_split_sound, Rust event_log_index.rs test
'            split_then_recombine_equals_monolithic_for_conflicts.
'
' Render:
'   plantuml -tsvg docs/casper/theory/merge-algebra/diagrams/06-eventlog-split-monoid.puml

@startuml 06-eventlog-split-monoid
!theme plain

skinparam componentStyle rectangle
skinparam rectangle {
  FontName "monospace"
  FontSize 10
}
skinparam package {
  BackgroundColor<<Split>> #EEFAF1
  BackgroundColor<<Mono>>  #E3F2FD
  BorderColor #444444
}
skinparam legendFontName "monospace"
skinparam legendFontSize 10
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #666666
skinparam defaultFontName "monospace"
skinparam defaultFontSize 10

title Event-log split soundness (P2): combine(fold user, fold system) = fold all

' Node color legend:
'   white  (#FFFFFF) = all deploys (the shared input)
'   gold   (#FFE082) = user bucket + its folded index
'   sky    (#BBDEFB) = system bucket + its folded index
'   mint   (#C8E6C9) = the split-recombined index
'   blue   (#90CAF9) = the monolithic index (fold all directly)
'   green  (#A5D6A7) = the equality verdict (split hides no conflict)
' Edge color legend:
'   blue   (#1565C0) = partition by is_system_deploy_id
'   orange (#E65100) = fold a bucket via EventLogIndex::combine (∪)
'   green  (#2E7D32) = the proven equality

rectangle "all deploys  [d₁ … dₙ]\n(one block's body.deploys)" as ALL #FFFFFF

package "SPLIT path — DeployChainIndex::new" <<Split>> {
  rectangle "user bucket\n{ dᵢ : ¬ is_system_deploy_id(dᵢ) }" as UB #FFE082
  rectangle "system bucket\n{ dᵢ : is_system_deploy_id(dᵢ) }" as SB #BBDEFB
  rectangle "user_event_log_index\n= foldᵢ (∪) user bucket" as UI #FFE082
  rectangle "system_event_log_index\n= foldᵢ (∪) system bucket" as SI #BBDEFB
  rectangle "split index\n= combine(user_idx, system_idx)\n  (field-wise set union ∪)" as SPLITIDX #C8E6C9
  UB -[#E65100,bold]-> UI
  SB -[#E65100,bold]-> SI
  UI -[#1565C0]-> SPLITIDX
  SI -[#1565C0]-> SPLITIDX
}

package "MONOLITHIC path" <<Mono>> {
  rectangle "monolithic index\n= foldᵢ (∪) ALL deploys" as MONOIDX #90CAF9
}

rectangle "combine_split p l  =  foldi l\n──────────────────────────────────────\n∀ conflicts, p, l, other:\n conflicts(split) = conflicts(monolithic)\n⟹ the split hides NO user↔system conflict\n(event_log_split_sound)" as EQ #A5D6A7

ALL -[#1565C0,bold]-> UB : partition
ALL -[#1565C0,bold]-> SB : partition
ALL -[#E65100,bold]-> MONOIDX : fold all
SPLITIDX -[#2E7D32,bold]-> EQ : =
MONOIDX  -[#2E7D32,bold]-> EQ : =

legend bottom
  EventLogIndex::combine is field-wise SET UNION (.union()) on the conflict-relevant
  produce/consume sets — a commutative, associative, IDEMPOTENT monoid (join-
  semilattice) with the empty index as identity. A partition into (filter p) ++
  (filter ¬p) is a permutation of the whole list, and foldi is permutation-invariant
  (foldi_perm), so combine(fold user, fold system) = fold all (combine_split_eq).
  Conflict detection reads only the combined index, so its verdict is identical on
  both paths (conflicts_split_complete). Splitting the log by user/system is a
  book-keeping convenience, never a soundness gap.
endlegend

@enduml
