  "findings": [
    {
      "id": "C1",
      "finding": "The observer accepts only the configured peer process. A direct client gets an empty hello. Every capture goes through casper-authority-process.",
      "consequence": "The supervisor must own the node process. No side channel exists for a probe."
    },
    {
      "id": "C2",
      "finding": "The configuration digest is computable before launch from the 7 public fields. The computed value equals the hello identity in all 10 captures.",
      "consequence": "A manifest can pin configuration_sha256 without a prior capture."
    },
    {
      "id": "C3",
      "finding": "A target node that holds the validator key produces heartbeat blocks and does not adopt the delivered history (5 held, target absent).",
      "consequence": "History delivery requires a non-validator target node."
    },
    {
      "id": "C4",
      "finding": "The p2p driver returns at transport acknowledgment. The capture after load_fixture saw 3 of 6 blocks. The next step saw 6.",
      "consequence": "The step capture is not synchronized with block processing. Live qualification needs a settle condition."
    },
    {
      "id": "C5",
      "finding": "casper-authority-live ends with status incomplete and exit 1 when the driver reports status unknown. Zero errors, 4 receipts, 8 captures.",
      "consequence": "The p2p driver cannot give an applied step. It exports no observed inputs for dag, electorate, or justification. The applied path needs a driver with input exports."
    },
    {
      "id": "C6",
      "finding": "Bounded and reference heads agree in all 10 captures. After delivery the bounded score_count is 2 and the reference score_count is 1.",
      "consequence": "Batch D finding 1 (main parent credit at the ancestor height) reproduces on a live chain."
    },
    {
      "id": "C7",
      "finding": "The display projection of the target is 1065353216 after delivery, the f32 bit pattern of 1.0 for a single validator. Before delivery the target is not held.",
      "consequence": "The Batch E display path works end to end through the owner."
    },
    {
      "id": "C8",
      "finding": "The owner request uses an integer deadline_monotonic_ns. The p2p step request uses a decimal string.",
      "consequence": "Two encodings of one field. Note for the adapter."
    },
    {
      "id": "C9",
      "finding": "A stale observer.sock from a previous node blocks the restarted node's observer. The owner reports connection refused on the capture.",
      "consequence": "The supervisor must clear the observer directory before each node launch."
    },
    {
      "id": "C10",
      "finding": "node keygen fails without a terminal (os error 6). The deploy command requires a non-empty PRIVATE_KEY_PATH positional even with PRIVATE_KEY.",
      "consequence": "Controlled scripts use OpenSSL for the key and /dev/null for the path."
    }
  ],
