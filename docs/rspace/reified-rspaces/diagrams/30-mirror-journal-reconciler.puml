' ============================================================================
' 30 The ChromaDB mirror: capture, publication at each commit, and the writer.
'
' Source of Figure N16.2 in ../design.md (section N16). The figure restates
' MirrorCapture::writes and MirrorBatch::from of
' rholang/src/rust/interpreter/spaces/mirror.rs, run_op of
' rholang/src/rust/interpreter/reified/runtime.rs, and MirrorWriter and apply
' of rholang/src/rust/interpreter/reified/vectordb_services.rs (design v3
' section 4.9, decisions 58, 98 and 114). It adds no new fact.
'
' Changed by decisions 98 and 114: a play publishes the net writes of each
' commit at the commit, and nothing repairs the mirror. Before, the journal
' of an evaluation waited for its final result (M1), and a reconciler
' repaired the mirror to the finalized state. The file name stays, so the
' links to the figure stay valid.
'
' Reading order:
'   1. After each commit of a VectorDB transaction, the capture computes the
'      net writes of the transaction.
'   2. In play, run_op hands the batch of the writes to the bounded queue
'      before the hold of the commit drops, whatever the final result of
'      the deploy. Replay, reporting and native replay publish nothing.
'   3. One writer task applies the batches in order. A batch that the queue
'      refuses, or that fails after its attempts, is dropped.
'   4. Nothing repairs the mirror. Consensus never reads the mirror.
'
' Colors come from concept-colors.iuml (aliases of the shared palette).
' Render: ./render.sh 30-mirror-journal-reconciler.puml   Check: ./render.sh --check

@startuml 30-mirror-journal-reconciler
!include ../../../casper/theory/diagrams/palette.iuml
!include concept-colors.iuml
$ca_base_skin()
skinparam ArrowColor $rrs_relation
skinparam ActivityBorderColor $rrs_relation
skinparam ActivityDiamondBorderColor $rrs_relation
skinparam ActivityDiamondBackgroundColor $ca_note_amber
skinparam PartitionBorderColor $rrs_relation
skinparam NoteBorderColor $rrs_relation
skinparam LegendBorderColor $rrs_relation
skinparam LegendBackgroundColor $ca_note_grey
title The ChromaDB mirror of a VectorDB space (decisions 58, 98 and 114)

start
partition "CAPTURE: after each commit of a VectorDB transaction" {
  :the receipt of the committed transaction
  (only for a space with mirror="chroma"); <<$rrs_substrate>>
  :NET WRITES: the first and the last event of each record id
  stored and stays: an upsert, when the record has an embedding
  removed, not persistent: a delete
  stored and removed, or removed and stored again (Rule E): nothing
  no meter, no error path, no await; <<$rrs_agent>>
}
partition "PUBLISH (decision 98): run_op, before the hold of the commit drops" {
  if (the store mode is Play?) then (yes)
    :one batch of the writes of the commit
    whatever the final result of the deploy; <<$rrs_agent>>
    if (the bounded queue takes the batch?\n(try_send, 1,024 batches)) then (yes)
      :the commit goes on at once; <<$rrs_effect>>
    else (no)
      :drop the batch
      the commit never waits; <<$rrs_reject>>
    endif
  else (no)
    :publish nothing
    (Replay, Reporting or NativeReplay); <<$rrs_reject>>
  endif
  note right
    A failed deploy, a dry run and the play
    of a block that consensus does not keep
    leave their writes in the mirror. Nothing
    external is undone (DR-114).
  end note
}
partition "WRITER TASK: one batch at a time, in publication order" {
  :APPLY: make the collection (its distance follows the metric)
  then upsert, then delete; <<$rrs_service>>
  if (an attempt of three succeeds?\n(pauses of 100 ms, then 200 ms)) then (yes)
    :the mirror holds the writes; <<$rrs_effect>>
  else (no)
    :drop the batch
    a part of the batch can stay applied; <<$rrs_reject>>
  endif
  note right
    Decision 114: nothing repairs the mirror.
    The records of other proposers never
    arrive, so the mirror of a node holds the
    writes of the deploys that the node plays.
  end note
}
stop

legend bottom
**Concept colors**
|<$rrs_substrate>  | the committed transaction (consensus state) |
|<$rrs_agent>      | the capture and the batch of a commit |
|<$rrs_service>    | the node service outside consensus: the writer |
|<$rrs_reject>     | a dropped batch, or no publication |
|<$rrs_effect>     | a completed step |
endlegend
@enduml
