' ============================================================================
' 50 An eval call of rho:lang:vector (TL-1).
'
' Source of Figure TL16 in ../tensor-logic/integration.md (section 3). The
' figure restates the method eval of tensor-logic/gslt.md section 9 and the
' example of tensor-logic/syntax.md section 4.16. It adds no new fact.
'
' Reading order:
'   1. The deploy sends the method name, a tl:Program term, the map of
'      tensors and the options to the capability.
'   2. The TL engine decodes, normalizes, checks and evaluates. Decision 89
'      removed the reservation before each phase.
'   3. A failure at any phase gives the reply [false, code, detail]. A
'      success gives [true, outputs].
'
' Colors come from concept-colors.iuml (aliases of the shared palette).
' Render: ./render.sh 50-tl-vector-eval.puml   Check: ./render.sh --check

@startuml 50-tl-vector-eval
!include ../../../casper/theory/diagrams/palette.iuml
!include concept-colors.iuml
$ca_base_skin()
skinparam sequence {
  ArrowColor $rrs_relation
  LifeLineBorderColor $rrs_relation
  ParticipantBorderColor $rrs_relation
  ActorBorderColor $rrs_relation
  GroupBorderColor $rrs_relation
  DividerBorderColor $rrs_relation
  DividerBackgroundColor $ca_note_grey
}
skinparam NoteBorderColor $rrs_relation
skinparam LegendBorderColor $rrs_relation
skinparam LegendBackgroundColor $ca_note_grey
title An eval call of rho:lang:vector (integration 3)
autonumber

participant "Deploy" as DEPLOY $rrs_host
participant "rho:lang:vector\n[0xE0, 0x23]" as VEC $rrs_system
participant "TL engine" as ENGINE $rrs_tl_engine
' Changed by decision 89: the node has no host-work budget, so the engine has no meter. The text before:
' participant "Host-work meter\nof the deploy" as METER $rrs_meter

DEPLOY -> VEC : vec!?("eval", tl:Program{ Y[i] = relu(W[i, j] X[j]) | Y? },\n  {"W": [[1, -1], [2, 0]], "X": [3, 4]}, {"precision": 64})
VEC -> VEC : unpack [ret, ["eval", program, tensors, options]]
VEC -> ENGINE : the reflected program and the tensors
' Changed by decision 89: no phase reserves, because the node has no host-work budget. The text before:
' group each phase reserves before it runs
group the phases of the engine
  ' ENGINE -> METER : reserve
  ENGINE -> ENGINE : DECODE: the tags and the allowed fingerprint
  ' ENGINE -> METER : reserve
  ENGINE -> ENGINE : NORMALIZE: RESOLVE, INLINE, ELABORATE, SCOPE, CANON
  ' ENGINE -> METER : reserve
  ENGINE -> ENGINE : CHECK: shapes, safety, recursion, the demand bound B
  ' ENGINE -> METER : reserve each step
  ENGINE -> ENGINE : EVALUATE the query slice: Y = [relu(3 - 4), relu(6)]
end
alt every phase succeeds
  ENGINE --> VEC : the values of the queries
  VEC -> VEC : encode each value in the value ABI ("as": "auto")
  VEC --> DEPLOY : [true, {"Y": [0, 6]}] on the return channel
else a phase fails
  ENGINE --> VEC : a typed code and a detail
  VEC --> DEPLOY : [false, code, detail]
end
note over VEC, ENGINE
  The call is deterministic and is not recorded:
  native replay computes the same reply.
end note

legend bottom
**Concept colors**
|<$rrs_host>      | the deploy |
|<$rrs_system>    | the capability |
|<$rrs_tl_engine> | the TL engine |
endlegend
@enduml
