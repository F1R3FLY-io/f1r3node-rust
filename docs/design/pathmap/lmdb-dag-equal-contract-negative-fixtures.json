  "harness_pin_probes": [
    {
      "name": "a harness pin that did not touch the harness is stale",
      "inputs": {
        "pin": "5d19c439215ff26bd28c42beac418da56a6b8dd6",
        "pin_is_ancestor_of_head": true,
        "last_touch_as_of_pin": "0c1d01cebcab832b1ba01191e27f00aa7f268f48"
      },
      "expected_code": "historical_harness_stale"
    },
    {
      "name": "a harness pin that is not an ancestor of HEAD is rejected (synthetic commit)",
      "inputs": {
        "pin": "1111111111111111111111111111111111111111",
        "pin_is_ancestor_of_head": false,
        "last_touch_as_of_pin": "1111111111111111111111111111111111111111"
      },
      "expected_code": "historical_harness_not_ancestor"
    }
  ],
  "staleness_probes": [
    {
      "name": "run instance revision must equal checkout HEAD",
      "inputs": {
        "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "changed_control": [],
        "dirty_paths": []
      },
      "expected_code": "revision_mismatch"
    },
    {
      "name": "changed control source invalidates run instance",
      "inputs": {
        "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "changed_control": ["rspace++/libs/rspace_rhotypes/src/lib.rs"],
        "dirty_paths": []
      },
      "expected_code": "control_source_stale"
    },
    {
      "name": "dirty source tree invalidates run instance",
      "inputs": {
        "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "changed_control": [],
        "dirty_paths": [" M rspace++/libs/rspace_rhotypes/src/lib.rs"]
      },
      "expected_code": "dirty_source_tree"
    }
  ]
