@startuml
skinparam backgroundColor #FAFCFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #38536B
skinparam activity {
  BackgroundColor #E9F2FA
  BorderColor #38536B
  FontColor #172A3A
  DiamondBackgroundColor #FFF1C7
  DiamondBorderColor #9C6A00
}

title RSpace structural-key cost attribution

start
:Authoritative ParBag endpoint\ncanonical Expr protobuf body;
if (control or treatment?) then (control)
  :Decode Expr and recursively rebuild\nsuffix ParBags; <<#FADBD8>>
  note right
    MEASURED: quadratic in unary-list depth
    despite a 225 to 226 byte RMP result
  end note
else (treatment)
  :Verify RPB3 provenance and\nvalidate the canonical shell;
  if (admission valid?) then (yes)
    :Generated protobuf-region cursor\nretains nested Par byte regions; <<#D5F5E3>>
    note right
      Target: one bounded shell decode,
      direct nested-Par token emission
    end note
  else (no)
    :Refuse before emitting RMP bytes\nor mutating the Bag; <<#FADBD8>>
    stop
  endif
endif
:Emit versioned RMP structural bytes;
:Frame RhoPathV1 key and append\ncanonical bincode identity;
:Insert one prepared byte path into\nthe PathMap<Multiplicity> Bag;
note right
  MEASURED: final insertion did not explain
  the multi-second control slope
end note
stop

legend bottom
  |<#FADBD8>| measured control cost or refusal |
  |<#D5F5E3>| provisional cursor treatment |
  |<#E9F2FA>| unchanged pipeline stage |
endlegend
@enduml
