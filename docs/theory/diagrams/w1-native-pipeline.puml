' W1 native cost-accounting pipeline — the three surface forms are RECOGNIZED
' (the recognizer resolves + validates the signature to a native accounting::Sig,
' applying the lollipop / uniform-sign / strip_signed_binds AST rewrites), then
' the inner P is lowered through the ORDINARY normalizer, emitting NO fuel-gate
' node; metering happens per-COMM at the reducer. The transpiler's Part-B gate
' translation is DROPPED — it would double-meter relative to the normative Rule 1.
'
' (Converted from the former Mermaid source to PlantUML; PlantUML is preferred
'  over Mermaid wherever their capabilities overlap.)
'
' Source of truth for Figure D in
' cost-accounting-impl/w1-surface-syntax-native-integration.md.
' Render:  plantuml -tsvg docs/theory/diagrams/w1-native-pipeline.puml
'          (or: ./render.sh w1-native-pipeline.puml)

@startuml w1-native-pipeline
!include palette.iuml
skinparam defaultFontName "sans-serif"
skinparam shadowing false
skinparam rectangle {
  BorderColor #333333
}
title W1 native pipeline — recognize (don't lower-to-gate), meter per-COMM

rectangle "{% P %}[s]\n— signed term" as A1 $ca_surface
rectangle "s :: S\n— token stack" as A2 $ca_surface
rectangle "for(... {% y <- x %}[s] ...)\n— signed join" as A3 $ca_surface

rectangle "Recognizer\nrecognize_signed_term / _token_stack / _signed_join" as REC $ca_process
rectangle "Resolve + validate signature\nsignature_to_native_sig ⇒ accounting::Sig\n(lollipop / uniform-sign / strip_signed_binds rewrites)" as SIG $ca_gate
rectangle "ORDINARY lowering\nnormalize_ann_proc(P) — emits NO fuel-gate node" as NORM $ca_control
rectangle "Normalized Par\n≡ byte-identical to unsigned P ✓" as PAR $ca_supply
rectangle "Reducer — per-COMM metering\none token per send / receive,\nattributed to s's lane (s₀ collapse: one envelope lane)" as METER $ca_pool

rectangle "✗ Part-B gate   for(t <- Σ⟦s⟧){ *t ∣ P }\nDROPPED — would double-meter vs Rule 1 (§838)" as DROP $ca_rejectfill

A1 --> REC
A2 --> REC
A3 --> REC
REC --> SIG
SIG --> NORM
NORM --> PAR
PAR --> METER
SIG -[$ca_debit,dashed]-> DROP : recognition decorates;\nemits NO gate

@enduml
