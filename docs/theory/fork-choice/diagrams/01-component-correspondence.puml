' Component Diagram 01 — Fork-choice: spec <-> Rocq <-> TLA+ <-> Z3/Sage <-> Rust.
'
' Each box is a fork-choice ("ghosting") component, annotated with:
'   - the spec concern it addresses,
'   - the Rocq module(s) + key lemmas that mechanize it,
'   - the TLA+ module(s) that model-check it,
'   - the Z3 / Sage / Wolfram witness (where one exists),
'   - the Rust file that implements it.
'
' The concurrent campaign found a real head-selection defect: globally sorting
' terminal leaves is not greedy LMD-GHOST. The repaired estimator computes the
' greedy head and exact concurrent terminal frontier separately, then composes
' them. Validators bound-check declared parents; they do not rerun fork choice.
'
' Source of truth for the traceability table in
' docs/theory/fork-choice/fork-choice-verification.md (section 4).
'
' Render:
'   plantuml -tsvg docs/theory/fork-choice/diagrams/01-component-correspondence.puml

@startuml 01-component-correspondence
!theme plain

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor     #333333
}
skinparam package {
  BackgroundColor<<TieBreak>> #FFF7E0
  BackgroundColor<<Scoring>>  #EEFAF1
  BackgroundColor<<Filter>>   #F3E5F5
  BackgroundColor<<Lca>>      #E3F2FD
  BackgroundColor<<Rank>>     #FFF3E0
  BackgroundColor<<Bound>>    #EFEBE9
  BackgroundColor<<Bridge>>   #FCE4EC
  BackgroundColor<<Theorem>>  #E8F5E9
  BorderColor #444444
}
skinparam defaultFontName "monospace"
skinparam defaultFontSize 10

title Fork-choice: spec ─ Rocq ─ TLA⁺ ─ Z3/Sage ─ Rust correspondence

' Layer color legend (fill per concept):
'   ranking / tie-break (S1 core) = gold        (#FFE082)
'   scoring                       = mint green   (#C8E6C9)
'   slashing filter (T-10 reuse)  = lavender     (#D1C4E9)
'   certified-message LCA         = sky blue     (#BBDEFB)
'   greedy head + exact frontier  = orange       (#FFE0B2)
'   bounds / truncation           = tan/storage  (#D7CCC8)
'   main-parent + validate bridge = pink         (#F8BBD0)
'   capstone theorem              = strong green (#A5D6A7)
'
' Edge color legend:
'   blue   (#1565C0) = feeds / read query (pipeline data flow)
'   orange (#E65100) = produces / selects final ForkChoice
'   gray   (#546E7A) = delegates / uses (tie-break sort)
'   (hidden edges anchor the capstone on top)

package "Capstone" <<Theorem>> {
  component "Six capstones ── axiom-free\n──────────────────────────────────────\nRocq  MainTheorem.v\n  ▶ determinism + certified context\n  ▶ greedy GHOST + terminal frontier\n  ▶ parent bounds + Rust bridge\nPrint Assumptions ⟹ Closed under the\n  global context (no Axiom / Admitted)" as CAP #A5D6A7
}

package "Certified-context projection" <<Filter>> {
  component "One eligible slot per floor validator\n──────────────────────────────────────\nspec  sender + generation + floor ancestry;\n      objective exclusions only\nRocq  CertifiedContext.v\nTLA⁺  ForkChoiceScan.tla\nRust  causal_equivocation.rs" as FIL #D1C4E9
}

package "LCA layer" <<Lca>> {
  component "LCA over every eligible message\n──────────────────────────────────────\nspec  no receiver-local height projection\nRocq  Lca.v (lca_is_common_ancestor,\n        reduce_converges, lca_is_lowest)\nTLA⁺  ForkChoiceScan.tla\nRust  estimator.rs (calculate_lca)\n      dag_operations.rs (LCUA many)" as LCA #BBDEFB
}

package "Scoring layer" <<Scoring>> {
  component "Cumulative validator-weight score\n──────────────────────────────────────\nspec  Σ bonded weight over each tip's\n      supporting chain down to the LCA\nRocq  Score.v (score_perm_invariant,\n        score_eq_support_sum,\n        weight_is_pure)\nZ3    score_supply_cap_bitvec.py\nRust  estimator.rs (build_scores_map)\n      proto_util.rs\n        (weight_from_validator_by_dag ── B1)" as SCO #C8E6C9
}

package "Greedy head + concurrent frontier" <<Rank>> {
  component "Two-lane LMD-GHOST ranking\n──────────────────────────────────────\nspec  greedy child descent chooses head;\n      async expansion retains all terminals\nRocq  Rank.v + TerminalFrontier.v\nTLA⁺  GhostTerminalFrontier.tla\nWolfram ghost_heaviest_subtree.wl\nRust  estimator.rs\n      (greedy_ghost_head, terminal_frontier,\n       rank_forkchoices)" as RNK #FFE0B2
}

package "Ranking / tie-break  (S1 core)" <<TieBreak>> {
  component "TOTAL tie-break  score DESC, hash ASC\n──────────────────────────────────────\nspec  the unique argmax ⟹ NO FORK\nRocq  TieBreak.v (sort_total_order,\n        output_indep_of_input_perm)\nTLA⁺  ForkChoice.tla (Inv_Deterministic)\nZ3    tiebreak_total_order.py\nSage  forkchoice_algebra.sage\nRust  list_ops.rs\n        (sort_by_with_decreasing_order)\n      estimator.rs (rank_forkchoices)" as TIE #FFE082
}

package "Bounds / truncation layer" <<Bound>> {
  component "Depth expiry + frontier capacity\n──────────────────────────────────────\nspec  keep GHOST head; expire deep causal\n      tips deterministically; never silently\n      truncate the live antichain\nRocq  Bound.v + ParentAntichain.v\nTLA⁺  StatePreservingForkChoice.tla\nRust  estimator.rs (depth)\n      snapshot.rs (antichain + coverage)\n      casper_conf.rs (active + floor cap)" as BND #D7CCC8
}

package "Main-parent + validation bridge" <<Bridge>> {
  component "GHOST main + causal-parent bridge\n──────────────────────────────────────\nspec  C supplies state dependencies;\n      V ⊆ C supplies votes; GHOST stays first;\n      floor is a replay/evidence backstop;\n      validators bound-check declared parents\nRocq  GuardBridge.v + ParentAntichain.v\n        (pipeline determinism, GHOST-head\n         preservation, antichain coverage)\nTLA⁺  StatePreservingForkChoice.tla\nRust  causal_equivocation.rs\n      snapshot.rs (GHOST-first, antichain,\n        floor backstop, recovery coverage)\n      validate.rs (no fork-choice recompute)" as BRG #F8BBD0
}

' === Explicit (visible) pipeline edges (Estimator::tips order) ===
FIL -[#1565C0]-> LCA : surviving\nlatest messages
LCA -[#1565C0]-> SCO : LCA + scored band
SCO -[#1565C0]-> RNK : scores map
RNK -[#546E7A]-> TIE : sort siblings + tail\n(score desc, hash asc)
RNK -[#1565C0]-> BND : ranked tips
BND -[#E65100]-> BRG : capped tips ⟹\nForkChoice { tips, lca }

' === Hidden edges: anchor the capstone on top, connected to all ===
CAP -[hidden]-> FIL
CAP -[hidden]-> LCA
CAP -[hidden]-> SCO
CAP -[hidden]-> RNK
CAP -[hidden]-> TIE
CAP -[hidden]-> BND
CAP -[hidden]-> BRG

@enduml
