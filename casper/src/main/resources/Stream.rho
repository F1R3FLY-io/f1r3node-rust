// Stream.rho — File I/O FIP §Streams library (MVP slice).
//
// A `Stream` agent produces a sequence of values incrementally, on
// demand.  Streams are never constructed directly by user code —
// producer-side agents (File.chars(), Dir.entries(), etc.) mint them.
// This library provides the base agent; producer agents in later
// phases (Phase 5+) supply the producer contract at construction.
//
// ## Delivered methods
//
//   - `next()` — return next value or [false, "EOS", msg]
//   - `chunk(n)` — return up to `n` values in a specialization-typed
//     container; specialization is parameterized via `chunkBuilder`
//     supplied at construction
//   - `close()` — release the source; idempotent
//   - `fold(init, combine)` — sequential fold; auto-close on exit;
//     catches EOS internally
//   - `forEach(handler)` — side-effect fold; auto-close on exit
//   - `foldChunks(init, chunkSize, combineChunk)` — sequential chunk-
//     oriented fold; amortizes per-value COMM cost
//   - `foldConcurrent(init, combine, workers)` — N-worker parallel
//     fold with commutative-associative combine; refuses on LineStream
//   - `mapReduce(mapFn, reduceFn, init, workers)` — two-phase parallel
//     map+reduce with commutative-associative reduce; refuses on LineStream
//   - `default(...@args)` — FSERR_UNSUPPORTED for unknown methods
//
// ## Deferred to follow-up commits
//
//   - LineStream single-active-inner rule
//   - Materialization helpers `toString(cap)` / `toByteArray(cap)` /
//     `toList(cap)`
//
// ## Constructor signature
//
//   Stream!?(*producer, *chunkBuilder)
//
// where:
//
//   `producer(returnCh)` — a contract-shaped channel.  When invoked,
//     it responds on `returnCh` with either:
//        [true, value]        — next value in the sequence
//        [false, "EOS", msg]  — end-of-stream (normal termination)
//        [false, code, msg]   — real error
//     Producers are stateful (they hold their own cursor); the Stream
//     agent invokes them serially, never concurrently.  NB: the
//     serial-invocation guarantee is PER-STREAM-CAP, not per-
//     producer-function — if two Stream caps share a producer (e.g.,
//     via a shared source cap like a `File` returned from an Fs cache
//     under the shared-Fs MVP, see File.rho §Shared-Fs caveat), the
//     underlying producer receives interleaved invocations from both
//     streams.  Each stream's invocations remain serial, but the
//     shared producer's cursor advances across both.
//
//   `chunkBuilder(values, returnCh)` — a contract that packs a List
//     of individual values into the specialization's chunk container
//     and replies on `returnCh` with:
//        [true, container]                    — the packed container
//        [false, "FSERR_UNSUPPORTED", msg]    — for LineStream
//     Per-specialization implementations live outside this file:
//        CharStream:  concat over String values (via ++ or interpolate)
//        ByteStream:  concatBytes on the list (Phase 2 primitive)
//        EntryStream: identity — values IS a List already
//        LineStream:  always returns FSERR_UNSUPPORTED (chunk unsupported)
//
// ## State layout
//
// Two cells for a clean mutex/immutable separation:
//
//   @[*private, *paramsP]  — set at ctor to (producer, builder);
//                             consumed at close.  Immutable while open.
//   @[*private, *stateP]   — a transition tag:
//                              "open"
//                              ("eos", msg)
//                              ("error", code, msg)
//                              "closed"
//
// Splitting params from state means chunk() can peek at the builder
// after gatherN has transitioned state to EOS — the builder is still
// available.
//
// ## Concurrency
//
// Same discipline as Buffer.rho: every named method acquires the
// state token via linear-receive, matches "closed" first, does its
// work, re-parks on every exit path.  Third-arm _ catch-all keeps
// the mutex robust against a hypothetical fourth payload shape.

new Stream, paramsP, stateP, gatherN, foldLoop, forEachLoop, foldChunksLoop in {
new foldConcurrentDispatch, foldConcurrentWorker, mapReduceDispatch, mapReduceWorker, collectDone, collectPartials, foldPartials in {

  agent Stream {
    constructor(@producer, @chunkBuilder) {
      @[*private, *paramsP]!((producer, chunkBuilder)) |
      @[*private, *stateP]!("open")
    } |

    // -- next() -----------------------------------------------------
    method next() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stream is closed"])
          }
          ("eos", msg) => {
            @[*private, *stateP]!(state) |
            return!([false, "EOS", msg])
          }
          ("error", code, msg) => {
            @[*private, *stateP]!(state) |
            return!([false, code, msg])
          }
          "open" => {
            // Peek at producer without consuming paramsP (params are
            // immutable while open).
            for (@params <<- @[*private, *paramsP]) {
              match params {
                (producer, _builder) => {
                  new retCh in {
                    @producer!(*retCh) |
                    for (@reply <- retCh) {
                      match reply {
                        [true, val] => {
                          @[*private, *stateP]!("open") |
                          return!([true, val])
                        }
                        [false, "EOS", msg] => {
                          @[*private, *stateP]!(("eos", msg)) |
                          return!([false, "EOS", msg])
                        }
                        [false, code, msg] => {
                          @[*private, *stateP]!(("error", code, msg)) |
                          return!([false, code, msg])
                        }
                        _ => {
                          @[*private, *stateP]!(("error", "FSERR_IO", "producer malformed reply")) |
                          return!([false, "FSERR_IO", "producer malformed reply"])
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!(("error", "FSERR_IO", "params malformed")) |
                  return!([false, "FSERR_IO", "params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stream state unrecognized"])
          }
        }
      }
    } |

    // -- chunk(n) ---------------------------------------------------
    //
    // Type-guarded on n before touching state, matching the Buffer.rho
    // pattern for uncatchable-arithmetic safety.  Gathers up to n
    // values via internal next() dispatches, then packs the collected
    // list via the chunk-builder.  Peek at builder via <<- (peek)
    // reads paramsP without consuming — safe because params are
    // immutable while the stream is not closed.
    //
    // Phase 9 slice 9c-i: reply-payload cap.  `n` is capped at 65536
    // (matches `MAX_ENTRIES` in fileio's Rust `handlers.rs`).  Above
    // the cap the method returns `FSERR_QUOTA_EXCEEDED` before any
    // gathering starts.  Defense-in-depth against a caller requesting
    // a billion-item chunk that would allocate an unbounded reply
    // list AND against the per-item runtime cost cascading through
    // `gatherN` past the caller's intended budget.  LineStream chunk
    // returns `FSERR_UNSUPPORTED` earlier via the chunk-builder
    // dispatch, so this cap only bites `EntryStream.chunk(n)` and
    // `ByteStream.chunk(n)` — matching the plan doc §Phase 9 line
    // 1225 slice 9c deliverable.  The cap number 65536 is embedded
    // as an integer literal (Rholang has no shared-constant
    // mechanism cross-file); the golden-hash pin in
    // `compose_fs_genesis_source_golden_hex` catches any accidental
    // drift.
    method chunk(@n) {
      match n {
        i /\ Int => {
          match i <= 0 {
            true => return!([false, "FSERR_BAD_ARG", "n must be positive"])
            false => match i > 65536 {
              true => return!(
                [false, "FSERR_QUOTA_EXCEEDED",
                 "chunk n exceeds MAX_CHUNK_ITEMS=65536"])
              false => {
              // Early exit if already terminal.
              for (@state <<- @[*private, *stateP]) {
                match state {
                  "closed" => return!([false, "FSERR_CLOSED", "stream is closed"])
                  ("eos", msg) => return!([false, "EOS", msg])
                  ("error", code, msg) => return!([false, code, msg])
                  "open" => {
                    // Gather up to i values.
                    new gCh in {
                      gatherN!(*this, i, [], *gCh) |
                      for (@[values, terminal] <- gCh) {
                        match values {
                          [] => {
                            // Nothing gathered — terminal is EOS or error.
                            return!(terminal)
                          }
                          _ => {
                            // Peek builder from paramsP.
                            for (@params <<- @[*private, *paramsP]) {
                              match params {
                                (_p, cb) => {
                                  new packCh in {
                                    @cb!(values, *packCh) |
                                    for (@packed <- packCh) {
                                      // Shape-validate the builder's reply
                                      // per Mi-1: even a trusted (mint-
                                      // supplied) builder can have a bug
                                      // and return malformed data.
                                      // Accept [true, container] or
                                      // [false, code, msg]; any other
                                      // shape is a builder bug rather
                                      // than a stream error, but we
                                      // surface it as FSERR_IO so the
                                      // caller sees a defined error
                                      // rather than a shape-mismatched
                                      // reply that breaks their own
                                      // pattern match.
                                      match packed {
                                        [true, _]      => return!(packed)
                                        [false, _, _]  => return!(packed)
                                        _              => {
                                          return!([false, "FSERR_IO",
                                            "chunk-builder returned malformed reply"])
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => return!([false, "FSERR_IO", "params malformed"])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!([false, "FSERR_CLOSED", "stream state unrecognized"])
                }
              }
            }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "n must be an integer"])
      }
    } |

    // -- close() ----------------------------------------------------
    method close() {
      for (@_state <- @[*private, *stateP]) {
        @[*private, *stateP]!("closed") |
        return!([true])
      }
    } |

    // -- fold(init, combine) ----------------------------------------
    method fold(@init, @combine) {
      new loopCh in {
        foldLoop!(*this, combine, init, *loopCh) |
        for (@result <- loopCh) {
          // Auto-close on exit (success, EOS, or error).
          for (@_ <- @(*this)!?("close")) {
            return!(result)
          }
        }
      }
    } |

    // -- forEach(handler) -------------------------------------------
    method forEach(@handler) {
      new loopCh in {
        forEachLoop!(*this, handler, *loopCh) |
        for (@result <- loopCh) {
          for (@_ <- @(*this)!?("close")) {
            return!(result)
          }
        }
      }
    } |

    // -- foldChunks(init, chunkSize, combineChunk) -----------------
    //
    // Sequential chunk-oriented fold (spec §184, §204).  Calls
    // `chunk(chunkSize)` in a loop; each container (never empty per
    // §chunk method) is passed to `combineChunk(retCh, acc, container)`
    // which sends the next accumulator back on `retCh`.  On EOS from
    // chunk, returns `[true, finalAccumulator]` without invoking
    // `combineChunk` again.
    //
    // Type-guarded on chunkSize before touching state (Mi-3 pattern).
    // Same close-on-exit and error-propagation semantics as fold.
    //
    // Not supported on LineStream: chunk itself returns
    // FSERR_UNSUPPORTED there, so foldChunks surfaces that same
    // error unchanged.
    method foldChunks(@init, @chunkSize, @combineChunk) {
      match chunkSize {
        i /\ Int => {
          match i <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "chunkSize must be positive"])
            false => {
              new loopCh in {
                foldChunksLoop!(*this, chunkSize, combineChunk,
                  init, *loopCh) |
                for (@result <- loopCh) {
                  for (@_ <- @(*this)!?("close")) {
                    return!(result)
                  }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "chunkSize must be an integer"])
      }
    } |

    // -- foldConcurrent(init, combine, workers) --------------------
    //
    // Parallel variant of `fold` (spec §228).  Spawns `workers`
    // concurrent worker loops sharing a single mutex-protected
    // accumulator cell.  Each worker pulls a value from the source
    // via `next()` (source-side lock serializes pulls) and then
    // enters the accumulator critical section:
    //
    //   for (@acc <- accP) { combine(acc, val) → newAcc; accP!(newAcc) }
    //
    // Combines therefore run one at a time — but next() pulls and
    // any pre-combine work by other workers overlap freely, and the
    // update sequence sees the current acc on every step so no lost-
    // update race can occur.  This makes `combine` work with the
    // asymmetric `(acc, val) → acc` signature the sequential `fold`
    // accepts (init is the initial acc; val is the stream's value
    // type; combine's output is acc-typed).  For symmetric monoid
    // combines with expensive per-value work, prefer `mapReduce`
    // (whose parallel workers run mapFn concurrently by design).
    //
    // Combines are strictly sequential under the accP mutex, so
    // associativity holds vacuously.  Commutativity IS still required:
    // workers race for the accP mutex after successful pulls, so a
    // lead can combine `(init⊕v2)⊕v1` when values arrived v1 before
    // v2.  Under replay the lead's scheduling is captured and replayed
    // to followers, so consensus is deterministic even if the callback
    // isn't strictly commutative — but local dev runs may vary if the
    // user's combine isn't commutative.
    //
    // Not supported on `LineStream` (would require multiple
    // concurrently-active inner streams sharing the source cursor,
    // violating the single-active-inner rule at §Concurrency).
    // Detected via a chunk-builder probe with an empty list: the
    // LineStream chunk-builder unconditionally replies
    // `[false, "FSERR_UNSUPPORTED", ...]`; every other specialization
    // returns `[true, <empty container>]`.  The probe does NOT touch
    // the source producer (chunk-builder is called directly, bypassing
    // gatherN), so it is non-destructive.
    //
    // Argument validation: `workers` must be a positive integer, at
    // most 256 (the impl's chosen quota per spec §253 — bounds spawn
    // cost).  Zero or negative returns `FSERR_BAD_ARG`; non-Int
    // returns `FSERR_BAD_ARG`; > 256 returns `FSERR_QUOTA_EXCEEDED`.
    method foldConcurrent(@init, @combine, @workers) {
      match workers {
        w /\ Int => {
          match w <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "workers must be positive"])
            false => {
              match w > 256 {
                true => return!(
                  [false, "FSERR_QUOTA_EXCEEDED",
                   "workers exceeds cap (256)"])
                false => {
              // LineStream detection: probe chunk-builder with [].
              // Peek at paramsP (params are immutable while open).
              for (@params <<- @[*private, *paramsP]) {
                match params {
                  (_p, cb) => {
                    new probeCh in {
                      @cb!([], *probeCh) |
                      for (@probeReply <- probeCh) {
                        match probeReply {
                          [false, "FSERR_UNSUPPORTED", _] => {
                            return!([false, "FSERR_UNSUPPORTED",
                              "foldConcurrent not supported for this specialization"])
                          }
                          _ => {
                            new loopCh in {
                              foldConcurrentDispatch!(
                                *this, combine, init, w, *loopCh) |
                              for (@result <- loopCh) {
                                // Auto-close on exit.
                                for (@_ <- @(*this)!?("close")) {
                                  return!(result)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!(
                    [false, "FSERR_IO", "params malformed"])
                }
              }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "workers must be an integer"])
      }
    } |

    // -- mapReduce(mapFn, reduceFn, init, workers) -----------------
    //
    // Two-phase parallel combinator (spec §257).  Each element is
    // transformed by `mapFn`, and mapped results are combined by
    // `reduceFn`.  Both phases may run up to `workers` invocations
    // concurrently; the runtime allocates the budget dynamically by
    // interleaving mapFn+reduceFn within each worker.
    //
    // `mapFn` shape:    `(returnCh, @value) => returnCh!(mappedValue)`
    // `reduceFn` shape: `(returnCh, @acc, @mapped) => returnCh!(newAcc)`
    //
    // Requires `reduceFn` to be commutative AND associative (same
    // replay-determinism vs. dev-run-variability caveat as
    // `foldConcurrent`).  Not supported on `LineStream` — same
    // chunk-builder probe as `foldConcurrent`.
    //
    // If either `mapFn` or `reduceFn` errors (replies `[false, ...]`),
    // the error propagates; the worker publishes ("err", code, msg)
    // to the collector and other workers drain toward EOS or their
    // own errors.  Auto-close on exit.
    //
    // Argument validation: `workers` must be a positive integer, at
    // most 256 (same cap as `foldConcurrent`, per spec §288 +
    // implementation-chosen quota).  Zero or negative returns
    // `FSERR_BAD_ARG`; non-Int returns `FSERR_BAD_ARG`; > 256 returns
    // `FSERR_QUOTA_EXCEEDED`.
    method mapReduce(@mapFn, @reduceFn, @init, @workers) {
      match workers {
        w /\ Int => {
          match w <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "workers must be positive"])
            false => {
              match w > 256 {
                true => return!(
                  [false, "FSERR_QUOTA_EXCEEDED",
                   "workers exceeds cap (256)"])
                false => {
              for (@params <<- @[*private, *paramsP]) {
                match params {
                  (_p, cb) => {
                    new probeCh in {
                      @cb!([], *probeCh) |
                      for (@probeReply <- probeCh) {
                        match probeReply {
                          [false, "FSERR_UNSUPPORTED", _] => {
                            return!([false, "FSERR_UNSUPPORTED",
                              "mapReduce not supported for this specialization"])
                          }
                          _ => {
                            new loopCh in {
                              mapReduceDispatch!(
                                *this, mapFn, reduceFn, init, w, *loopCh) |
                              for (@result <- loopCh) {
                                for (@_ <- @(*this)!?("close")) {
                                  return!(result)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!(
                    [false, "FSERR_IO", "params malformed"])
                }
              }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "workers must be an integer"])
      }
    } |

    // -- Default arm -----------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helpers.
  // ==================================================================

  // gatherN(stream, n, acc, ret) — pull up to n values from `stream`
  // via successive `next()` calls, accumulating in `acc`.  Returns
  // ret!([values, terminalReply]) where terminalReply is the last
  // reply from next() — either the last [true, val] appended, or the
  // EOS / error that stopped the gather.  If the FIRST call returns
  // a terminal reply, `values` is [] and the caller propagates the
  // terminal directly.
  contract gatherN(@stream, @n, @acc, ret) = {
    match n <= 0 {
      // M-P5-7 hardening: the n <= 0 case is a defensive fallback
      // (chunk() shape-validates n > 0 up front, so this arm never
      // fires in practice).  If it EVER did, return an unambiguously
      // terminal reply — [true, Nil] could be confused with a real
      // producer value; [false, "EOS", ...] cannot.
      true => ret!([acc, [false, "EOS", "gather limit reached"]])
      false => {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => gatherN!(stream, n - 1, acc ++ [val], *ret)
            _           => ret!([acc, reply])
          }
        }
      }
    }
  } |

  // foldLoop(stream, combine, acc, ret) — sequentially fetch values
  // and pass each to `combine`, chaining the accumulator.  Reply
  // [true, acc] on EOS; [false, code, msg] on any other error or on
  // a combine error.
  contract foldLoop(@stream, @combine, @acc, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, val] => {
          new combCh in {
            @combine!(*combCh, acc, val) |
            for (@combResult <- combCh) {
              match combResult {
                [false, code, msg] => ret!([false, code, msg])
                newAcc             => foldLoop!(stream, combine, newAcc, *ret)
              }
            }
          }
        }
        [false, "EOS", _]  => ret!([true, acc])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!([false, "FSERR_IO", "unexpected reply shape"])
      }
    }
  } |

  // forEachLoop(stream, handler, ret) — no accumulator; handler is
  // (returnCh, @value) => (side effect); returnCh!().
  contract forEachLoop(@stream, @handler, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, val] => {
          new doneCh in {
            @handler!(*doneCh, val) |
            for (@_ <- doneCh) {
              forEachLoop!(stream, handler, *ret)
            }
          }
        }
        [false, "EOS", _]  => ret!([true])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!([false, "FSERR_IO", "unexpected reply shape"])
      }
    }
  } |

  // foldChunksLoop(stream, chunkSize, combineChunk, acc, ret) —
  // per iteration: call chunk(chunkSize), then hand the container
  // to combineChunk(retCh, acc, container).  Same acc-shape convention
  // as fold: combineChunk returns the new accumulator as a bare Par
  // (or [false, code, msg] to abort).  Terminals:
  //   [false, "EOS", _]  → [true, acc]
  //   [false, code, msg] → [false, code, msg] (forwarded)
  //   malformed          → [false, "FSERR_IO", ...]
  contract foldChunksLoop(@stream, @chunkSize, @combineChunk,
                          @acc, ret) = {
    for (@reply <- @stream!?("chunk", chunkSize)) {
      match reply {
        [true, container] => {
          new combCh in {
            @combineChunk!(*combCh, acc, container) |
            for (@combResult <- combCh) {
              match combResult {
                [false, code, msg] => ret!([false, code, msg])
                newAcc             => foldChunksLoop!(
                  stream, chunkSize, combineChunk, newAcc, *ret)
              }
            }
          }
        }
        [false, "EOS", _]  => ret!([true, acc])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!(
          [false, "FSERR_IO", "chunk returned malformed reply"])
      }
    }
  } |

  // ==================================================================
  // foldConcurrent / mapReduce helpers.
  // ==================================================================
  //
  // Design: private-per-worker partial pattern.  Each worker holds a
  // local partial encoded as either `[]` (no values seen yet) or
  // `[v]` (current partial value).  Worker's next-loop combines
  // sequentially into its own partial; on source EOS it publishes
  // ("ok", partial) to doneCh; on any error publishes ("err", code, msg)
  // and exits.  A collector receives exactly N messages from doneCh
  // (one per worker) and then a foldPartials pass folds the non-empty
  // partials into `init` via `combine` (or reduceFn for mapReduce).
  //
  // This gives the spec's promised "up to `workers` combine invocations
  // concurrent": at any moment, up to N workers are each running
  // their own combine (on their private partial), plus a small final
  // sequential fold over N partials.  Commutative+associative combine
  // makes the interleave irrelevant; non-commutative combine yields
  // the lead's scheduling, which replay captures for follower
  // determinism.

  // foldConcurrentDispatch(stream, combine, init, n, ret) — spawn
  // n workers sharing a single accP cell (protected by linear-
  // receive as a mutex).  When all N workers signal done, peek accP
  // for the final acc and reply [true, acc].  On any worker error,
  // record the first error and continue draining N signals (so no
  // worker is stranded), then reply [false, code, msg].
  contract foldConcurrentDispatch(@stream, @combine, @init, @n, ret) = {
    new accP, doneCh, spawner in {
      accP!(init) |
      contract spawner(@k) = {
        match k <= 0 {
          true  => Nil
          false => {
            foldConcurrentWorker!(stream, combine, *accP, *doneCh) |
            spawner!(k - 1)
          }
        }
      } |
      spawner!(n) |
      collectDone!(n, Nil, Nil, *doneCh, *accP, *ret)
    }
  } |

  // foldConcurrentWorker(stream, combine, accP, doneCh) — pull
  // next() in a tail-recursive loop; for each value, enter the
  // accP critical section, invoke combine, write the new acc back.
  // On source EOS publish ("ok", Nil) to doneCh and exit.  On any
  // error publish ("err", code, msg) and exit — the current acc is
  // preserved on the cell so it can be observed by the collector's
  // recovery arm (though the caller sees a failure response).
  contract foldConcurrentWorker(@stream, @combine, accP, doneCh) = {
    new loop in {
      contract loop() = {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => {
              for (@acc <- accP) {
                new combCh in {
                  @combine!(*combCh, acc, val) |
                  for (@combResult <- combCh) {
                    match combResult {
                      [false, code, msg] => {
                        // Restore acc so subsequent workers can
                        // continue draining toward EOS without
                        // deadlocking on accP.
                        accP!(acc) |
                        doneCh!(("err", code, msg))
                      }
                      newAcc => {
                        accP!(newAcc) |
                        loop!()
                      }
                    }
                  }
                }
              }
            }
            [false, "EOS", _]  => doneCh!(("ok", Nil))
            [false, code, msg] => doneCh!(("err", code, msg))
            _                  => doneCh!(
              ("err", "FSERR_IO", "worker unexpected reply"))
          }
        }
      } |
      loop!()
    }
  } |

  // mapReduceDispatch(stream, mapFn, reduceFn, init, n, ret) —
  // symmetric to foldConcurrentDispatch but spawns mapReduceWorkers
  // and uses reduceFn as the final combine.
  contract mapReduceDispatch(@stream, @mapFn, @reduceFn, @init, @n, ret) = {
    new doneCh, spawner in {
      contract spawner(@k) = {
        match k <= 0 {
          true  => Nil
          false => {
            mapReduceWorker!(stream, mapFn, reduceFn, *doneCh) |
            spawner!(k - 1)
          }
        }
      } |
      spawner!(n) |
      collectPartials!(n, [], Nil, Nil, *doneCh, reduceFn, init, *ret)
    }
  } |

  // mapReduceWorker(stream, mapFn, reduceFn, doneCh) — variant of
  // foldConcurrentWorker that runs mapFn(val) → mapped, then
  // reduceFn(partial, mapped) → newPartial.  Both mapFn and reduceFn
  // errors propagate to doneCh as ("err", code, msg).
  contract mapReduceWorker(@stream, @mapFn, @reduceFn, doneCh) = {
    new loop in {
      contract loop(@partial) = {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => {
              new mapCh in {
                @mapFn!(*mapCh, val) |
                for (@mapReply <- mapCh) {
                  match mapReply {
                    [false, code, msg] => doneCh!(("err", code, msg))
                    mapped => {
                      match partial {
                        []      => loop!([mapped])
                        [curr] => {
                          new redCh in {
                            @reduceFn!(*redCh, curr, mapped) |
                            for (@redReply <- redCh) {
                              match redReply {
                                [false, code, msg] => doneCh!(("err", code, msg))
                                newVal             => loop!([newVal])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            [false, "EOS", _]  => doneCh!(("ok", partial))
            [false, code, msg] => doneCh!(("err", code, msg))
            _                  => doneCh!(
              ("err", "FSERR_IO", "worker unexpected reply"))
          }
        }
      } |
      loop!([])
    }
  } |

  // collectDone(remaining, errCode, errMsg, doneCh, accP, ret) —
  // drain `remaining` ("ok" or "err") messages from doneCh; on
  // completion, peek the shared accP for the final acc and reply
  // [true, acc] if no error was seen, else [false, code, msg]
  // (first-error-wins).  Draining all N signals is required so no
  // worker is stranded blocked on doneCh.
  contract collectDone(@remaining, @errCode, @errMsg,
                       doneCh, accP, ret) = {
    match remaining <= 0 {
      true => {
        match errCode {
          Nil => {
            for (@acc <<- accP) {
              ret!([true, acc])
            }
          }
          _ => ret!([false, errCode, errMsg])
        }
      }
      false => {
        for (@msg <- doneCh) {
          match msg {
            ("ok", _) => {
              collectDone!(
                remaining - 1, errCode, errMsg,
                *doneCh, *accP, *ret)
            }
            ("err", code, m) => {
              match errCode {
                Nil => collectDone!(
                  remaining - 1, code, m,
                  *doneCh, *accP, *ret)
                _ => collectDone!(
                  remaining - 1, errCode, errMsg,
                  *doneCh, *accP, *ret)
              }
            }
          }
        }
      }
    }
  } |

  // collectPartials(remaining, partials, errCode, errMsg, doneCh,
  //                 combineFn, init, ret) — drain `remaining` messages
  // from doneCh accumulating either partials or the first error seen.
  // When drained: if no error, foldPartials into init; else return
  // the first error as [false, code, msg].  Draining all N is
  // required so no worker is stranded blocked on doneCh.
  contract collectPartials(
      @remaining, @partials, @errCode, @errMsg,
      doneCh, @combineFn, @init, ret) = {
    match remaining <= 0 {
      true => {
        match errCode {
          Nil => foldPartials!(partials, combineFn, init, *ret)
          _   => ret!([false, errCode, errMsg])
        }
      }
      false => {
        for (@msg <- doneCh) {
          match msg {
            ("ok", partial) => {
              collectPartials!(
                remaining - 1, partials ++ [partial],
                errCode, errMsg,
                *doneCh, combineFn, init, *ret)
            }
            ("err", code, m) => {
              // First error wins; subsequent errors are dropped so
              // the caller sees the first-observed failure.
              match errCode {
                Nil => collectPartials!(
                  remaining - 1, partials, code, m,
                  *doneCh, combineFn, init, *ret)
                _ => collectPartials!(
                  remaining - 1, partials, errCode, errMsg,
                  *doneCh, combineFn, init, *ret)
              }
            }
          }
        }
      }
    }
  } |

  // foldPartials(partials, combineFn, acc, ret) — sequential fold of
  // a list of `[]`-or-`[v]` partials into `acc` via `combineFn`.
  // Empty partials (workers that saw no values) are skipped.  Any
  // combineFn error aborts and returns [false, code, msg].
  contract foldPartials(@partials, @combineFn, @acc, ret) = {
    match partials {
      [] => ret!([true, acc])
      [head ...tail] => {
        match head {
          []      => foldPartials!(tail, combineFn, acc, *ret)
          [v]    => {
            new combCh in {
              @combineFn!(*combCh, acc, v) |
              for (@r <- combCh) {
                match r {
                  [false, code, msg] => ret!([false, code, msg])
                  newAcc             => foldPartials!(
                    tail, combineFn, newAcc, *ret)
                }
              }
            }
          }
          _ => ret!(
            [false, "FSERR_IO", "worker partial had unexpected shape"])
        }
      }
    }
  }
}
}
