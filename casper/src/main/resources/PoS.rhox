// Rholang macro parameters:
// minimumBond - the minimum bond allowed by the PoS
// maximumBond - the maximum bond allowed by PoS
// initialBonds - the initial bonds map
// epochLength - the length of the validation epoch in blocks
// quarantineLength - the length of the quarantine time in blocks
// numberOfActiveValidators - max number of active validator in a shard
// faultToleranceThresholdPpm - protocol fault-tolerance threshold in parts-per-million
// maxParentDepth - the parent-spread validity bound (citability horizon), in blocks
// deployLifespan - the deploy validity window, in blocks
// minPhloPrice - the minimum accepted deploy phlo price
// posMultiSigPublicKeys - public keys
// posMultiSigQuorum - how many confirmations are necessary to use multi-sig vault
/*

Life cycle in POS

POS internal state:
"allBonds"        : Map[Validator, bonds],
"activeValidators": Set[Validator],
"withdrawers"     : Map[Validator, (bonds, quantinue)],
"committedRewards" : Map[Validator, rewards],
"pendingWithdrawers": Map[Validator, quantinue]

**There are two vaults `posVault` and `coopMultiSigVault` while pos contract have no controll on `coopMultiSigVault` but `posVault`**

Several crucial calculate points:

## UserDeploy

* precharge -> user transfer the precharge funding to posVault
* refund -> posVault transfer the refund amount back to userVault

## Bonding

User transfer the bonding amount directly to posVault. `allBonds` would update with {Validator: bondAmount}.

## Withdraw(Unbond)

`pendingWithdrawers` would update with {Validator: quantinue}


## EpochChange(CloseBlock)

1. Calculate all the validator current epoch rewards based on active validator bonding proportion
2. Accumulate `committedRewards` with the result of step 1
3. Update `withdrawers` according to `allBonds` and `pendingWithdrawers` when pendingWithdrawers is not empty, remove the validator in `allBonds`
4. When the block number reaches the quantinue of `withdrawers` , transfer the corresponding bonds+ rewards to the corresponding validator from posVault.
5. update `pendingWithdrawers` to empty Map {}.
6. Pick new `activeValidators`


## Slashing
1. Transfer the bonding amount of the slashed validator based on `allBonds` from posVault to coopMultiSigVault.
2. Set the bonding amount in `allBonds` of the slashed validator to 0
3. remove the slashed validator in `activeValidators`

*/

/*
 The table below describes the required computations and their dependencies

 No. | Dependency | Computation method | Result
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 1.  |            | given              | sk = a9585a0687761139ab3587a4938fb5ab9fcba675c79fefba889859674046d4a5
 2.  |            | given              | timestamp = 1559156420651
 3.  |            | lastNonce          | nonce = 9223372036854775807
 4.  | 1,         | secp256k1          | pk = 047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f
 5.  | 2, 4, 3,   | registry           | value = (1559156420651, 047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f, 9223372036854775807)
 6.  | 5,         | protobuf           | toSign = 2a65aa01620a092a0710d6c0b7cfe05a0a462a44ca0141047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f0a0d2a0b10feffffffffffffffff01
 7.  | 6, 1,      | secp256k1          | sig = 3045022100cd1a32e04e21deb1bb3cd108cb0a3ab1357495f6ad99dfeb08eb17eaa082d388022015a9c5f9cd3b489a1fe3e359dbfe791ddd7d66e8a9a1dfb4978c980128c53f69
 8.  | 4,         | registry           | uri = rho:id:m3xk7h8r54dtqtwsrnxqzhe81baswey66nzw6m533nyd45ptyoybqr
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
*/

new PoS,
    registryLookup(`rho:registry:lookup`),
    vaultAddressOps(`rho:vault:address`),
    systemVaultCh, listOpsCh,
    getUser,
    pickActiveValidators,
    runMVar,
    fst,
    deposit, distributeRewards,
    perActiveValidatorPosVaultsCh,
    rs(`rho:registry:insertSigned:secp256k1`),
    posId(`rho:system:deployerId`),
    PendingRewards, MergeIntMaps, treeHashMapCh,
    sysAuthTokenOps(`sys:authToken:ops`),
    multiSigSystemVaultCh, coopVaultCh,
    uriOut, sumFromPair
in {
  // Simultaneously retrieves SystemVault, ListOps, TreeHashMap, and MultiSigSystemVault contracts from the registry.
  registryLookup!(`rho:vault:system`, *systemVaultCh) |
  registryLookup!(`rho:lang:listOps`, *listOpsCh) |
  registryLookup!(`rho:lang:treeHashMap`, *treeHashMapCh) |
  registryLookup!(`rho:vault:multiSig`, *multiSigSystemVaultCh) |
  for (@(_, SystemVault)         <- systemVaultCh &
       @(_, ListOps)          <- listOpsCh &
       TreeHashMap            <- treeHashMapCh &
       @(_, MultiSigSystemVault) <- multiSigSystemVaultCh) {
    new posDeployerVaultAddressCh, posDeployerAuthKeyCh, posDeployerVaultCh, posVaultCh,
        initialActiveCh, pendingRewardsMapCh, createUnfVault, moveInitialBondCh, posAuthKeyCh
    in {

      // Creates the auth key and System vault associated with the PoS contract.
      new posPkCh in {
        @SystemVault!("deployerAuthKey", *posId, *posDeployerAuthKeyCh) |
        getUser!(*posId, *posPkCh) |
        for (@posPk <- posPkCh) {
          vaultAddressOps!("fromPublicKey", posPk, *posDeployerVaultAddressCh) |
          // Creates Coop multisig vault for slashed funds.
          // Either (false, errorMsg) or (true, (multiSigVault, vaultAddress, systemVault)) are returned on coopVaultCh.
          @MultiSigSystemVault!(
            "create",
            $$posMultiSigPublicKeys$$,
            [],
            $$posMultiSigQuorum$$,
            *coopVaultCh
          )
        }
      } |
      // ret: the return channel of the create
      // pubKey: the pubkey which control the unforgeable name
      contract createUnfVault(ret, @pubkey) = {
        new unf, unfAddrRet, createRetCh, pubKeyChainUnfVault, unfVaultHandle, stdout(`rho:io:stdout`) in {
          vaultAddressOps!("fromUnforgeable", *unf, *unfAddrRet) |
          for (@unfAddr <- unfAddrRet){
            @SystemVault!("findOrCreate", unfAddr, *createRetCh) |
            for (@(true, vault) <- createRetCh){
              contract unfVaultHandle(@"transfer", @targetAddress, @amount, deployerID, transferRet) = {
                new deployerPubKeyBytesCh, DeployerIdOps(`rho:system:deployerId:ops`) in {
                  DeployerIdOps!("pubKeyBytes", *deployerID, *deployerPubKeyBytesCh) |
                  for (@deployerPubKeyBytes <- deployerPubKeyBytesCh) {
                    if (deployerPubKeyBytes ==  pubkey.hexToBytes()){
                      new unfAuthKeyCh in {
                        @SystemVault!("unforgeableAuthKey", *unf, *unfAuthKeyCh) |
                        for (@unfAuthKey <- unfAuthKeyCh){
                          @vault!("transfer", targetAddress, amount, unfAuthKey, *transferRet)
                        }
                      }
                    } else {
                      transferRet!((false, "You have not permission to transfer."))
                    }
                  }
                }
              } |
              ret!((*unf, unfAddr, vault ,*unfVaultHandle))
            }
          }
        }
      }|
      createUnfVault!(*posVaultCh, "$$posPubKey$$") |
      for (@(posVaultUnf, posVaultAddr, posVault, humanControlHandle) <- posVaultCh){
      @SystemVault!("unforgeableAuthKey", posVaultUnf, *posAuthKeyCh) |
      for (@posDeployerVaultAddress <- posDeployerVaultAddressCh;
           @posDeployerAuthKey    <- posDeployerAuthKeyCh;
           @posAuthKey <- posAuthKeyCh)  {
        for (@(true, (coopMultiVault, coopMultiVaultAddr, coopVaultHd)) <<- coopVaultCh) {
          // Creates PoS System vault with sum of initial bonds.
          new bondSumCh in {
            @ListOps!("fold", $$initialBonds$$.toList(), 0n, *sumFromPair, *bondSumCh) |
            for (@bondSum <- bondSumCh) {
              @SystemVault!("createWithBalance", posDeployerVaultAddress, bondSum, *posDeployerVaultCh)|
              for (@(true, posDeployerVault)  <- posDeployerVaultCh) {
                // move all the fund from deployer addr to POS unforgeable vault
                @posDeployerVault!("transfer", posVaultAddr, bondSum, posDeployerAuthKey, *moveInitialBondCh)
              }
            }
          } |
          // Selects the initial active validators.
          pickActiveValidators!($$initialBonds$$.toList(), *initialActiveCh) |
          for (@initialActive     <- initialActiveCh;
               @(true, _) <- moveInitialBondCh) {
            new stateCh, pendingRewardsInitializedCh, rewardsInfo, calTotalActiveBonds, calTotalBonds,
                accumulateSndNum, accumulateFstOfSndArg, accumulateItemInState, forfeitStake in {
              // Initializes PoS state structure.
              stateCh!({
                // Map[PublicKey, Int] - each validator stake
                "allBonds"        : $$initialBonds$$,
                // Set[PublicKey]     - the active validators
                "activeValidators": initialActive,
                // Map[PublicKey, (Int, Int)] - The validators who issued a withdraw request , finished validating jobs and not active.
                //                              When the validator reachs the quantinue length, it would be removed in the map and
                //                              pos would transfer back all the original bond and rewards back to validator vault.
                //                              Value(Int, Int) represents (original bond + reward, quantinue length)
                "withdrawers"     : {},
                // Map[PublicKey, BigInt]
                "committedRewards" : {},
                // Map[PublicKey, Int] - the validators wishing to withdraw and the block number when their quarantine ends
                "pendingWithdrawers": {},
                "randomImages"    : {},
                "randomNumbers"   : {},
                // Map[PublicKey, Map] - open ejection proceedings, keyed by target so at
                //                       most one can be open against a validator at a time.
                //                       Each record carries the proposer that opened it, the
                //                       block it was opened at, and the electorate frozen at
                //                       that block.
                "ejectionEvidence": {},
                // Map[PublicKey, Map] - validators ejected by a passed claim: the
                //                       end of their grace, the floor the claim
                //                       passed at, and the claim's electorate.
                "ejectedValidators": {},
                // Map[PublicKey, Map] - open rejoin requests, keyed by the ejected
                //                       validator making them: the block each was
                //                       opened at and the topup it pays on success.
                "pendingRejoins": {},
                // Map[PublicKey, Map[Int, Map]] - each validator's ejections,
                //                       keyed by the floor the ejection passed
                //                       at: the block that paid its rejoin and
                //                       the topup, both Nil while still ejected.
                //                       Closed ones leave once the retention
                //                       window passes them.
                "freezeHistory": {},
                // BigInt - the paid rejoin topups the PoS vault holds. They back
                //          the overflow the rejoiners are credited, so no epoch
                //          distributes them.
                "heldTopups": 0n,
                // Map[PublicKey, Map] - open overflow claims, keyed by the
                //                       claimant: the block each was opened at,
                //                       the amount, and the electorate frozen at
                //                       that block.
                "overflowClaims": {},
                // Map[PublicKey, Map] - each validator's paid overflow claims:
                //                       the running total, and each payment's
                //                       amount by the block that paid it.
                //                       Payments leave once the retention
                //                       window passes them; the total stays.
                "claimedOverflow": {},
              }) |
              contract rewardsInfo(retCh) = {
                new posBalanceCh, totalActiveBondCh, totalBondCh, totalWithdrawCh, committedRewardsCh in {
                  @posVault!("balance", *posBalanceCh) |
                  accumulateItemInState!(*totalBondCh, "allBonds", *accumulateSndNum) |
                  calTotalActiveBonds!(*totalActiveBondCh) |
                  accumulateItemInState!(*totalWithdrawCh, "withdrawers", *accumulateFstOfSndArg) |
                  accumulateItemInState!(*committedRewardsCh, "committedRewards", *accumulateSndNum) |
                  for (@posBalance <- posBalanceCh; @totalBond <- totalBondCh; @activeBonds <- totalActiveBondCh;
                       @totalWithdraw <- totalWithdrawCh; @totalCommittedRewards <- committedRewardsCh){
                    for (@state <<- stateCh) {
                      retCh!((posBalance - state.get("heldTopups"), totalBond , activeBonds, totalWithdraw, totalCommittedRewards, state.get("allBonds"), state.get("activeValidators"), state.get("ejectedValidators")))
                    }
                  }
                }
              } |
              // Stake eligible for rewards: active and not ejected.
              contract calTotalActiveBonds(returnCh) = {
                new computeSum in {
                  for (@state <<- stateCh){
                    @ListOps!("fold", state.get("allBonds").toList(), 0n, *computeSum, *returnCh) |
                    contract computeSum(@(pk, bondAmount), @acc, resultCh) = {
                      if (state.get("activeValidators").contains(pk) and
                          not state.get("ejectedValidators").contains(pk)){
                        resultCh!(acc + bondAmount)
                      } else {
                        resultCh!(acc)
                      }
                    }
                  }
                }
              } |
              contract accumulateSndNum(@(_, amount), @acc, resultCh) = {
                resultCh!(acc + amount.toBigInt())
              } |
              contract accumulateFstOfSndArg(@(_, (amount, _)), @acc, resultCh) = {
                resultCh!(acc + amount.toBigInt())
              } |
              contract accumulateItemInState(returnCh, @stateKey, accumulateAlgo) = {
                for (@state <<- stateCh){
                  @ListOps!("fold", state.get(stateKey).toList(), 0n, *accumulateAlgo, *returnCh)
                }
              }|
              contract PoS(@"getCurrentEpochRewards", returnCh) = {
                new rewardCh, computeReward in {
                  rewardsInfo!(*rewardCh)|
                  for (@(posBalance, totalBond, activeBonds, totalWithdraw, totalCommittedRewards, bondsMap, activeValidatorsSet, ejectedValidators) <- rewardCh){
                    @ListOps!("fold", bondsMap.toList(), {}, *computeReward, *returnCh) |
                    contract computeReward(@(pk, bonds), @acc,  outCh) = {
                      // Rewards are BigInt, so this product cannot overflow. Each bond is divided by minimumBond first, which truncates the validator's share.
                      // An ejected validator's share goes to the rest; with no
                      // eligible stake left, nothing is distributed this epoch.
                      if (activeValidatorsSet.contains(pk) and
                          not ejectedValidators.contains(pk) and
                          activeBonds / $$minimumBond$$n > 0n){
                        outCh!(acc.set(pk, (posBalance - totalBond - totalWithdraw - totalCommittedRewards) * (bonds / $$minimumBond$$n).toBigInt() / (activeBonds / $$minimumBond$$n).toBigInt()))
                      } else {
                        outCh!(acc.set(pk, 0n))
                      }
                    }
                  }
                }
              } |
              contract PoS(@"getRewards", returnCh) = {
                new currentEpochRewardCh, accumulateReward in {
                  for (@state <<- stateCh) {
                    PoS!("getCurrentEpochRewards", *currentEpochRewardCh)|
                    for (@currentEpochReward <- currentEpochRewardCh) {
                      @ListOps!("fold", currentEpochReward.toList(), state.get("committedRewards"), *accumulateReward, *returnCh) |
                      contract accumulateReward(@(pk, reward), @acc, outCh) = {
                        outCh!(acc.set(pk, acc.getOrElse(pk, 0n) + reward))
                      }
                    }
                  }
                }
              } |
              // Peeks at bonds map.
              contract PoS(@"getBonds", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("allBonds"))
                }
              } |
              // Peeks at active validator list.
              contract PoS(@"getActiveValidators", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("activeValidators"))
                }
              } |
              // Peeks at active validator list.
              contract PoS(@"getWithdrawers", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("withdrawers"))
                }
              } |
              contract PoS(@"getPendingWithdrawer", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("pendingWithdrawers"))
                }
              } |
              // Exposes Coop multisig vault on returnCh.
              contract PoS(@"getCoopVault", returnCh) = {
                for (@(_, coopVault) <<- coopVaultCh) {
                  returnCh!((coopMultiVault, coopMultiVaultAddr, coopVaultHd))
                }
              } |
              // Exposes initial PoS vault on returnCh.
              contract PoS(@"getInitialPosVault", returnCh) = {
                returnCh!((posVaultAddr, posVault))
              } |
              // Exposes epochLength parameter to PoSTest.
              contract PoS(@"getEpochLength", returnCh) = {
                returnCh!($$epochLength$$)
              } |
              // Exposes quarantineLength parameter to PoSTest.
              contract PoS(@"getQuarantineLength", returnCh) = {
                returnCh!($$quarantineLength$$)
              } |
              // Exposes the parameters the node's consensus rules read, fixed at
              // genesis. Every node reads them back and runs them regardless of
              // local configuration, since validity forks on any divergence.
              contract PoS(@"getChainParameters", returnCh) = {
                returnCh!({
                  "faultToleranceThresholdPpm": $$faultToleranceThresholdPpm$$,
                  "maxParentDepth"            : $$maxParentDepth$$,
                  "deployLifespan"            : $$deployLifespan$$,
                  "minPhloPrice"              : $$minPhloPrice$$n,
                  "epochLength"               : $$epochLength$$,
                  "quarantineLength"          : $$quarantineLength$$,
                  "lambdaBasePpm"             : $$lambdaBasePpm$$,
                  "thetaEjectPpm"             : $$thetaEjectPpm$$,
                  "ejectObservationBlocks"    : $$ejectObservationBlocks$$,
                  "breadthExponent"           : $$breadthExponent$$,
                  "recencyReferencePpm"       : $$recencyReferencePpm$$,
                  "voteListBound"             : $$voteListBound$$,
                  "rewardRatePpm"             : $$rewardRatePpm$$
                })
              } |
              contract PoS(@"posVaultTransfer", @targetAddress, @amount, @deployerID, @transferRet) = {
                // human transfer would just use this method
                @humanControlHandle!("transfer", targetAddress, amount, deployerID, transferRet)
              } |
              // Public method allowing users to bond and become validators.
              contract PoS(@"bond", @deployerId, @amount, returnCh) = {
                new userCh, depositCh,
                    processCh
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh <- processCh &
                       @userPk          <- userCh) {
                    if (state.get("allBonds").contains(userPk)) {
                      resultCh!(state, (false, "Public key is already bonded."))
                    } else if (not (amount matches BigInt)) {
                      resultCh!(state, (false, "Bond amount must be a BigInt."))
                    } else if (amount <= 0n) {
                      // Bug #5 fix: explicit positive-stake assertion. The
                      // Rocq invariant `active_implies_bonded` (T-9.5,
                      // BugFixStakeZero.v:36) requires every active
                      // validator to have a strictly positive bond. The
                      // earlier `amount < minimumBond` check covers this
                      // when minimumBond ≥ 1, but a defensive zero-stake
                      // gate makes the invariant explicit and independent
                      // of genesis configuration. See
                      // design/09-bug-fixes-and-rationale.md §9.6 (option a).
                      resultCh!(state, (false, "Bond amount must be positive."))
                    } else if (amount < $$minimumBond$$n) {
                      resultCh!(state, (false, "Bond is less than minimum!"))
                    } else if (amount > $$maximumBond$$n) {
                      resultCh!(state, (false, "Bond is greater than maximum!"))
                    } else {
                      // Transfers user's bond amount to the PoS vault.
                      deposit!(deployerId, amount, posVaultAddr, *depositCh) |
                      for (@depositResult <- depositCh) {
                        match depositResult {
                          // If deposit is successful, the user becomes a bonded validator.
                          (true, _) => {
                            resultCh!(state.set("allBonds", state.get("allBonds").set(userPk, amount)), depositResult)
                          }
                          // If deposit is unsuccessful, the user is not bonded.
                          (false, errorMsg) => {
                            resultCh!(state, (false, "Bond deposit failed: " ++ errorMsg))
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing validators to withdraw their bonded and accumulated funds.
              contract PoS(@"withdraw", @deployerId, returnCh) = {
                new userCh, processCh, blockDataCh,
                    getBlockData(`rho:block:data`)
                in {
                  // Consumes state and updates withdrawers map.
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getBlockData!(*blockDataCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh   <- processCh &
                       @userPk            <- userCh &
                       @blockNumber, _, _ <- blockDataCh) {
                    if (state.get("allBonds").contains(userPk)) {
                      // The withdrawal goes into effect at the start of the next epoch.
                      resultCh!(
                        state.set("pendingWithdrawers",
                                  state.get("pendingWithdrawers")
                                       .set(userPk,
                                         $$quarantineLength$$ + $$epochLength$$ * (1 + blockNumber / $$epochLength$$))),
                        (true, Nil))
                    } else {
                      resultCh!(state, (false, "User is not bonded"))
                    }
                  }
                }
              } |
              // Private method which charges a deployer for a deploy.
              // Deployer's funds are deposited into the block sender's vault.
              // Return expects (Boolean, Either[Nil, String])
              new currentDeployerData in {
                contract PoS(@"chargeDeploy", @deployerId, @amount, @sysAuthToken, return) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new depositCh in {
                          deposit!(deployerId, amount, posVaultAddr, *depositCh) |
                          for (@depositResult <- depositCh){
                            match depositResult {
                              (true, _) => {
                                currentDeployerData!((deployerId, amount)) |
                                return!(depositResult)
                              }
                              (_, errorMessage) => {
                                return!((false, "Deploy payment failed: " ++ errorMessage))
                              }
                            }
                          }
                        }
                      } else {
                        return!((false, "Invalid system auth token"))
                      }
                    }
                  }
                } |
                // Private method which refunds a deployer if too much was charged in chargeDeploy.
                // Funds are transferred from the block sender's vault to the deployer.
                // Return expects (Boolean, Either[Nil, String])
                contract PoS(@"refundDeploy", @refundAmount, @sysAuthToken, return) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        for (@(deployerId, initialPaymentAmount) <- currentDeployerData){
                          if (refundAmount > 0n) {
                            new vaultAddressCh, transferCh in {
                              vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
                              for (@deployerVaultAddress <- vaultAddressCh) {
                                // Transfer (from sender to deployer) called in refundDeploy.
                                @posVault!("transfer", deployerVaultAddress, refundAmount, posAuthKey, *transferCh) |
                                for (@transferResult <- transferCh) {
                                  match transferResult {
                                    (true, _) => {
                                      return!((true, Nil))
                                    }
                                    (_, errorMessage) => {
                                      return!((false, "(Bug found) Deploy refund failed: " ++ errorMessage))
                                    }
                                  }
                                }
                              }
                            }
                          } else {
                            return!((true, Nil))
                          }
                        }
                      } else {
                        return!((false, "Invalid system auth token"))
                      }
                    }
                  }
                }
              } |
              // Ejection proceedings keyed by target, each until a block
              // resolves or expires it.
              contract PoS(@"getEjectionEvidence", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("ejectionEvidence"))
                }
              } |
              contract PoS(@"getEjectedValidators", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("ejectedValidators"))
                }
              } |
              contract PoS(@"getPendingRejoins", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("pendingRejoins"))
                }
              } |
              contract PoS(@"getFreezeHistory", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("freezeHistory"))
                }
              } |
              contract PoS(@"getOverflowClaims", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("overflowClaims"))
                }
              } |
              contract PoS(@"getClaimedOverflow", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("claimedOverflow"))
                }
              } |
              // A validator claims overflow it has earned. The electorate is
              // the committee of the block the claim runs in, less the
              // validators it holds ejected. An ejected validator may claim,
              // to fund its topup, and so may one in the unbonding quarantine.
              // A claim past its deadline still holds the slot until the block
              // that charges its fee removes it.
              contract PoS(@"claimOverflow", @deployerId, @amount, returnCh) = {
                new userCh, processCh, quarantinedCh, blockDataCh, committeeCh,
                    electorateCh, keepVoter,
                    getBlockData(`rho:block:data`), getCommittee(`rho:block:committee`)
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  getBlockData!(*blockDataCh) |
                  getCommittee!(*committeeCh) |
                  for (@state, resultCh   <- processCh &
                       @userPk            <- userCh &
                       @blockNumber, _, _ <- blockDataCh &
                       @committee         <- committeeCh) {
                    match state.get("withdrawers").get(userPk) {
                      Nil => quarantinedCh!(0n)
                      (quarantined, _) => quarantinedCh!(quarantined)
                    } |
                    @ListOps!("fold", committee.toList(), {}, *keepVoter, *electorateCh) |
                    contract keepVoter(@(pk, stake), @acc, ret) = {
                      if (state.get("ejectedValidators").contains(pk)) {
                        ret!(acc)
                      } else {
                        ret!(acc.set(pk, stake))
                      }
                    } |
                    for (@quarantined <- quarantinedCh & @electorate <- electorateCh) {
                      if (not (amount matches BigInt)) {
                        resultCh!(state, (false, "Claim amount must be a BigInt."))
                      } else if (amount <= 0n) {
                        resultCh!(state, (false, "Claim amount must be positive."))
                      } else if (amount > $$maxOverflowPerClaim$$n) {
                        resultCh!(state, (false, "Claim amount exceeds the bound on one claim."))
                      } else if (state.get("allBonds").getOrElse(userPk, 0n) <= 0n and quarantined <= 0n) {
                        resultCh!(state, (false, "Only a validator holding stake may claim overflow."))
                      } else if (state.get("overflowClaims").contains(userPk)) {
                        resultCh!(state, (false, "An overflow claim is already open for this validator."))
                      } else {
                        resultCh!(
                          state.set("overflowClaims",
                            state.get("overflowClaims").set(userPk, {
                              "proposer"  : userPk,
                              "openedAt"  : blockNumber,
                              "amount"    : amount,
                              "electorate": electorate
                            })),
                          (true, Nil))
                      }
                    }
                  }
                }
              } |
              // An ejected validator asks to return within its grace, offering a
              // topup paid only if the rejoin passes. The electorate is
              // the one that ejected it, kept in its ejection record.
              contract PoS(@"rejoinFromEjection", @deployerId, @topup, returnCh) = {
                new userCh, processCh, blockDataCh,
                    getBlockData(`rho:block:data`)
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getBlockData!(*blockDataCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh   <- processCh &
                       @userPk            <- userCh &
                       @blockNumber, _, _ <- blockDataCh) {
                    match state.get("ejectedValidators").get(userPk) {
                      Nil => resultCh!(state, (false, "Only an ejected validator may rejoin."))
                      ejection => {
                        if (not (topup matches BigInt)) {
                          resultCh!(state, (false, "Topup must be a BigInt."))
                        } else if (topup <= 0n) {
                          resultCh!(state, (false, "Topup must be positive."))
                        } else if (blockNumber > ejection.get("graceEnd")) {
                          resultCh!(state, (false, "The grace of this ejection has ended."))
                        } else if (state.get("pendingRejoins").contains(userPk)) {
                          resultCh!(state, (false, "A rejoin is already open for this validator."))
                        } else {
                          resultCh!(
                            state.set("pendingRejoins",
                              state.get("pendingRejoins").set(userPk, {
                                "proposer": userPk,
                                "openedAt": blockNumber,
                                "topup"   : topup
                              })),
                            (true, Nil))
                        }
                      }
                    }
                  }
                }
              } |
              // A validator accuses another of having stopped earning. The
              // accuser's view of the target is NOT checked here and cannot be:
              // it is node-local, two honest nodes are expected to disagree,
              // and a rule reading it would split consensus. The threshold
              // vote settles the claim's merit.
              //
              // The committee is that of the block the deploy runs in, which
              // block validation checks against the block's finalized floor. It
              // decides who is seated and is frozen as the electorate.
              contract PoS(@"ejectValidator", @deployerId, @target, returnCh) = {
                new userCh, processCh, blockDataCh, committeeCh,
                    getBlockData(`rho:block:data`), getCommittee(`rho:block:committee`)
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getBlockData!(*blockDataCh) |
                  getCommittee!(*committeeCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh   <- processCh &
                       @userPk            <- userCh &
                       @blockNumber, _, _ <- blockDataCh &
                       @committee         <- committeeCh) {
                    new electorateCh, notEjected in {
                      // An ejected validator stays bonded and seated
                      // through its grace but votes on no new claim.
                      @ListOps!("fold", committee.toList(), {}, *notEjected, *electorateCh) |
                      contract notEjected(@(pk, stake), @acc, retCh) = {
                        if (state.get("ejectedValidators").contains(pk)) {
                          retCh!(acc)
                        } else {
                          retCh!(acc.set(pk, stake))
                        }
                      } |
                      // A claim holds its slot until a block resolves or
                      // expires it, since its votes count until a floor
                      // reaches its deadline.
                      for (@electorate <- electorateCh) {
                        // Who, then whom, then whether proceedings are
                        // already under way.
                        if (not committee.contains(userPk)) {
                          resultCh!(state, (false, "Only a seated validator may open ejection proceedings."))
                        } else if (not committee.contains(target)) {
                          resultCh!(state, (false, "Ejection target is not a seated validator."))
                        } else if (state.get("ejectedValidators").contains(target)) {
                          resultCh!(state, (false, "Ejection target is already ejected."))
                        } else if (state.get("ejectionEvidence").contains(target)) {
                          resultCh!(state, (false, "Ejection proceedings are already open against this validator."))
                        } else {
                          resultCh!(
                            state.set("ejectionEvidence",
                              state.get("ejectionEvidence").set(target, {
                                "proposer"  : userPk,
                                "openedAt"  : blockNumber,
                                "electorate": electorate
                              })),
                            (true, Nil))
                        }
                      }
                    }
                  }
                }
              } |
              // Moves every bond the validator holds, including one already in
              // quarantine, to the coop vault, takes it out of the active set,
              // closes every ejection proceeding against it and drops its
              // freezes, which no bucket is kept for any more. A failed
              // transfer leaves the validator as it was; one already at nothing
              // is left at nothing.
              contract forfeitStake(@target, @current, retCh) = {
                new stakeCh, transferredCh, bondsCh, withdrawersCh in {
                  match current.get("withdrawers").get(target) {
                    Nil => stakeCh!(current.get("allBonds").getOrElse(target, 0n))
                    (quarantined, _) => stakeCh!(current.get("allBonds").getOrElse(target, 0n) + quarantined)
                  } |
                  for (@stake <- stakeCh) {
                    if (stake > 0n) {
                      @posVault!("transfer", coopMultiVaultAddr, stake, posAuthKey, *transferredCh)
                    } else {
                      transferredCh!((true, Nil))
                    } |
                    for (@transferred <- transferredCh) {
                      match transferred {
                        (true, _) => {
                          if (current.get("allBonds").contains(target)) {
                            bondsCh!(current.get("allBonds").set(target, 0n))
                          } else {
                            bondsCh!(current.get("allBonds"))
                          } |
                          match current.get("withdrawers").get(target) {
                            Nil => withdrawersCh!(current.get("withdrawers"))
                            (_, quarantine) => withdrawersCh!(current.get("withdrawers").set(target, (0n, quarantine)))
                          } |
                          for (@bonds <- bondsCh & @withdrawers <- withdrawersCh) {
                            retCh!(current
                              .set("allBonds", bonds)
                              .set("withdrawers", withdrawers)
                              .set("activeValidators", current.get("activeValidators").delete(target))
                              .set("committedRewards", current.get("committedRewards").delete(target))
                              .set("ejectionEvidence", current.get("ejectionEvidence").delete(target))
                              .set("ejectedValidators", current.get("ejectedValidators").delete(target))
                              .set("pendingRejoins", current.get("pendingRejoins").delete(target))
                              .set("freezeHistory", current.get("freezeHistory").delete(target)))
                          }
                        }
                        _ => retCh!(current)
                      }
                    }
                  }
                }
              } |

              // Slashes a validator whose nay on an overflow claim its own
              // signed ancestry proved it owed. Validation checks the
              // evidence; the contract only needs the system's authority.
              contract PoS(@"slashDishonestVoter", @accused, @sysAuthToken, returnCh) = {
                new isValidTokenCh, processCh, forfeitedCh in {
                  sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                  for (@isValid <- isValidTokenCh) {
                    if (isValid) {
                      runMVar!(*stateCh, *processCh, *returnCh) |
                      for (@state, resultCh <- processCh) {
                        forfeitStake!(accused, state, *forfeitedCh) |
                        for (@forfeited <- forfeitedCh) {
                          resultCh!(forfeited, (true, Nil))
                        }
                      }
                    } else {
                      returnCh!((false, "Invalid AuthToken"))
                    }
                  }
                }
              } |

              // Applies the outcomes block validation found at the block's
              // floor, then the grace expiries the floor has reached, then the
              // claims whose deadline the floor has reached undecided. A passed
              // ejection ejects its target and a failed one clears the slot. A
              // passed rejoin debits its topup from the rejoining validator
              // through the deployer identity the resolution carries for it,
              // and reinstates it if paid; unpaid, or failed, it clears the
              // slot. A passed overflow claim is paid from what the PoS vault
              // holds undistributed, and fails if that cannot cover it; an
              // overflow claim refused or expired costs its claimant the
              // failed-claim fee. Votes count once a floor shows them, so a
              // claim is decided whenever its floor's tally crosses and expires
              // only once its floor reaches the deadline undecided. The tally
              // is not visible here, so every resolution is trusted as to its
              // outcome and checked only to name a recorded claim, a rejoin
              // within its grace; every grace expiry to name a grace that has
              // ended; and every claim expiry a claim whose deadline its floor
              // has reached.
              contract PoS(@"resolveClaims", @resolutions, @graceExpiries,
                           @claimExpiries, @floorHash, @floorNumber,
                           @sysAuthToken, returnCh) = {
                new isValidTokenCh in {
                  sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                  for (@isValid <- isValidTokenCh) {
                    if (isValid) {
                      new processCh, blockDataCh, namesOpenClaim, namesEndedGrace,
                          namesLapsedClaim, recordOf,
                          applyResolution, expireClaim,
                          payOverflow, chargeFailedClaim,
                          checkedCh, endedCh, lapsedCh,
                          resolvedCh, expiredCh, lapsedOutCh,
                          getBlockData(`rho:block:data`)
                      in {
                        runMVar!(*stateCh, *processCh, *returnCh) |
                        getBlockData!(*blockDataCh) |
                        for (@state, resultCh   <- processCh &
                             @blockNumber, _, _ <- blockDataCh) {
                          @ListOps!("fold", resolutions, true, *namesOpenClaim, *checkedCh) |
                          @ListOps!("fold", graceExpiries, true, *namesEndedGrace, *endedCh) |
                          @ListOps!("fold", claimExpiries, true, *namesLapsedClaim, *lapsedCh) |
                          contract recordOf(@claim, retCh) = {
                            match claim.get("family") {
                              "eject"    => retCh!(state.get("ejectionEvidence").get(claim.get("target")))
                              "rejoin"   => retCh!(state.get("pendingRejoins").get(claim.get("target")))
                              "overflow" => retCh!(state.get("overflowClaims").get(claim.get("target")))
                              _          => retCh!(Nil)
                            }
                          } |
                          contract namesLapsedClaim(@claim, @acc, retCh) = {
                            new recordCh in {
                              recordOf!(claim, *recordCh) |
                              for (@record <- recordCh) {
                                match record {
                                  Nil => retCh!(false)
                                  _ => retCh!(
                                    acc and
                                    record.get("proposer") == claim.get("proposer") and
                                    record.get("openedAt") == claim.get("openedAt") and
                                    record.get("openedAt") + $$claimDeadlineBlocks$$ <= floorNumber
                                  )
                                }
                              }
                            }
                          } |
                          contract namesOpenClaim(@resolution, @acc, retCh) = {
                            match (resolution.get("family"),
                                   state.get("ejectionEvidence").get(resolution.get("target")),
                                   state.get("pendingRejoins").get(resolution.get("target")),
                                   state.get("ejectedValidators").get(resolution.get("target"))) {
                              ("eject", Nil, _, _) => retCh!(false)
                              ("eject", record, _, _) => retCh!(
                                acc and
                                record.get("proposer") == resolution.get("proposer") and
                                record.get("openedAt") == resolution.get("openedAt")
                              )
                              ("rejoin", _, Nil, _) => retCh!(false)
                              ("rejoin", _, _, Nil) => retCh!(false)
                              ("rejoin", _, record, ejection) => retCh!(
                                acc and
                                record.get("proposer") == resolution.get("proposer") and
                                record.get("openedAt") == resolution.get("openedAt") and
                                floorNumber <= ejection.get("graceEnd")
                              )
                              ("overflow", _, _, _) => {
                                match state.get("overflowClaims").get(resolution.get("target")) {
                                  Nil => retCh!(false)
                                  record => retCh!(
                                    acc and
                                    record.get("proposer") == resolution.get("proposer") and
                                    record.get("openedAt") == resolution.get("openedAt")
                                  )
                                }
                              }
                              _ => retCh!(false)
                            }
                          } |
                          contract namesEndedGrace(@target, @acc, retCh) = {
                            match state.get("ejectedValidators").get(target) {
                              Nil => retCh!(false)
                              ejection => retCh!(acc and ejection.get("graceEnd") < floorNumber)
                            }
                          } |
                          contract applyResolution(@resolution, @current, retCh) = {
                            match (resolution.get("family"), resolution.get("target"), resolution.get("passed")) {
                              ("eject", target, true) => {
                                retCh!(current
                                  .set("ejectedValidators", current.get("ejectedValidators").set(target, {
                                    "graceEnd"        : floorNumber + $$ejectionGraceBlocks$$,
                                    "ejectFloor"      : floorNumber,
                                    "ejectFloorHash"  : floorHash,
                                    "ejectionSnapshot": current.get("ejectionEvidence").get(target).get("electorate")
                                  }))
                                  .set("freezeHistory", current.get("freezeHistory").set(target,
                                    current.get("freezeHistory").getOrElse(target, {})
                                      .set(floorNumber, {
                                        "to"          : Nil,
                                        "topup"       : Nil,
                                        "fromSequence": resolution.get("fromSequence")
                                      })))
                                  .set("ejectionEvidence", current.get("ejectionEvidence").delete(target)))
                              }
                              ("eject", target, false) => {
                                retCh!(current
                                  .set("ejectionEvidence", current.get("ejectionEvidence").delete(target)))
                              }
                              ("rejoin", target, true) => {
                                new payerPkCh, paidCh in {
                                  getUser!(resolution.get("payer"), *payerPkCh) |
                                  for (@payerPk <- payerPkCh) {
                                    if (payerPk == target) {
                                      deposit!(resolution.get("payer"),
                                               current.get("pendingRejoins").get(target).get("topup"),
                                               posVaultAddr, *paidCh)
                                    } else {
                                      paidCh!((false, "The payer is not the rejoining validator."))
                                    } |
                                    for (@paid <- paidCh) {
                                      match paid {
                                        (true, _) => {
                                          retCh!(current
                                            .set("freezeHistory", current.get("freezeHistory").set(target,
                                              current.get("freezeHistory").get(target).set(
                                                current.get("ejectedValidators").get(target).get("ejectFloor"),
                                                current.get("freezeHistory").get(target)
                                                  .get(current.get("ejectedValidators").get(target).get("ejectFloor"))
                                                  .set("to", blockNumber)
                                                  .set("topup", current.get("pendingRejoins").get(target).get("topup")))))
                                            .set("heldTopups", current.get("heldTopups") +
                                              current.get("pendingRejoins").get(target).get("topup"))
                                            .set("ejectedValidators", current.get("ejectedValidators").delete(target))
                                            .set("pendingRejoins", current.get("pendingRejoins").delete(target)))
                                        }
                                        _ => {
                                          retCh!(current
                                            .set("pendingRejoins", current.get("pendingRejoins").delete(target)))
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              ("rejoin", target, false) => {
                                retCh!(current
                                  .set("pendingRejoins", current.get("pendingRejoins").delete(target)))
                              }
                              ("overflow", target, true) => {
                                payOverflow!(target, current, *retCh)
                              }
                              ("overflow", target, false) => {
                                chargeFailedClaim!(target,
                                  current.set("overflowClaims", current.get("overflowClaims").delete(target)),
                                  *retCh)
                              }
                            }
                          } |
                          // Pays the claim from the PoS vault. What the vault
                          // holds beyond bonds, withdrawals and committed rewards
                          // is the held topups and the epoch's surplus, and a
                          // claim drawing on anything more would be paid out of
                          // stake. The topups are drawn on first. A slashed
                          // claimant forfeits its overflow.
                          contract payOverflow(@target, @current, retCh) = {
                            new balanceCh, bondsCh, withdrawnCh, committedCh, holdsCh,
                                addressCh, createdCh, paidCh, heldCh in {
                              @posVault!("balance", *balanceCh) |
                              @ListOps!("fold", current.get("allBonds").toList(), 0n, *accumulateSndNum, *bondsCh) |
                              @ListOps!("fold", current.get("withdrawers").toList(), 0n, *accumulateFstOfSndArg, *withdrawnCh) |
                              @ListOps!("fold", current.get("committedRewards").toList(), 0n, *accumulateSndNum, *committedCh) |
                              match current.get("withdrawers").get(target) {
                                Nil => holdsCh!(current.get("allBonds").getOrElse(target, 0n) > 0n)
                                (quarantined, _) => holdsCh!(current.get("allBonds").getOrElse(target, 0n) > 0n or quarantined > 0n)
                              } |
                              for (@balance <- balanceCh & @bonds <- bondsCh & @withdrawn <- withdrawnCh &
                                   @committed <- committedCh & @holds <- holdsCh) {
                                match current.get("overflowClaims").get(target).get("amount") {
                                  amount => {
                                    if (holds and amount <= balance - bonds - withdrawn - committed) {
                                      vaultAddressOps!("fromPublicKey", target, *addressCh) |
                                      for (@address <- addressCh) {
                                        @SystemVault!("findOrCreate", address, *createdCh) |
                                        for (_ <- createdCh) {
                                          @posVault!("transfer", address, amount, posAuthKey, *paidCh)
                                        }
                                      } |
                                      for (@paid <- paidCh) {
                                        match paid {
                                          (true, _) => {
                                            if (current.get("heldTopups") > amount) {
                                              heldCh!(current.get("heldTopups") - amount)
                                            } else {
                                              heldCh!(0n)
                                            } |
                                            for (@held <- heldCh) {
                                              retCh!(current
                                                .set("claimedOverflow", current.get("claimedOverflow").set(target, {
                                                  "total"   : current.get("claimedOverflow").getOrElse(target, {"total": 0n}).get("total") + amount,
                                                  "payments": current.get("claimedOverflow").getOrElse(target, {"payments": {}}).get("payments").set(blockNumber, amount)
                                                }))
                                                .set("heldTopups", held)
                                                .set("overflowClaims", current.get("overflowClaims").delete(target)))
                                            }
                                          }
                                          _ => {
                                            retCh!(current
                                              .set("overflowClaims", current.get("overflowClaims").delete(target)))
                                          }
                                        }
                                      }
                                    } else {
                                      retCh!(current
                                        .set("overflowClaims", current.get("overflowClaims").delete(target)))
                                    }
                                  }
                                }
                              }
                            }
                          } |
                          // A claim that ends below 2/3, refused or undecided,
                          // burns a bond-scaled fee into
                          // the coop vault, taken from the bond, or from the
                          // quarantine for a claimant that has unbonded. The
                          // fee rounds up, so a small bond still pays one.
                          contract chargeFailedClaim(@target, @current, retCh) = {
                            new sourceCh, transferredCh in {
                              if (current.get("allBonds").getOrElse(target, 0n) > 0n) {
                                sourceCh!(("allBonds", current.get("allBonds").get(target)))
                              } else {
                                match current.get("withdrawers").get(target) {
                                  Nil => sourceCh!(("none", 0n))
                                  (quarantined, _) => sourceCh!(("withdrawers", quarantined))
                                }
                              } |
                              for (@(source, stake) <- sourceCh) {
                                match (stake * $$failedClaimFeePpm$$n + 999999n) / 1000000n {
                                  fee => {
                                    if (fee <= 0n) {
                                      retCh!(current)
                                    } else {
                                      @posVault!("transfer", coopMultiVaultAddr, fee, posAuthKey, *transferredCh) |
                                      for (@transferred <- transferredCh) {
                                        match (transferred, source, current.get("withdrawers").get(target)) {
                                          ((true, _), "allBonds", _) => {
                                            if (stake - fee > 0n) {
                                              retCh!(current.set("allBonds", current.get("allBonds").set(target, stake - fee)))
                                            } else {
                                              retCh!(current
                                                .set("allBonds", current.get("allBonds").set(target, 0n))
                                                .set("activeValidators", current.get("activeValidators").delete(target)))
                                            }
                                          }
                                          ((true, _), "withdrawers", (_, quarantine)) => {
                                            retCh!(current.set("withdrawers", current.get("withdrawers").set(target, (stake - fee, quarantine))))
                                          }
                                          _ => retCh!(current)
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          } |
                          contract expireClaim(@claim, @current, retCh) = {
                            match (claim.get("family"), claim.get("target")) {
                              ("overflow", target) => {
                                chargeFailedClaim!(target,
                                  current.set("overflowClaims", current.get("overflowClaims").delete(target)),
                                  *retCh)
                              }
                              ("eject", target) => {
                                retCh!(current.set("ejectionEvidence", current.get("ejectionEvidence").delete(target)))
                              }
                              ("rejoin", target) => {
                                retCh!(current.set("pendingRejoins", current.get("pendingRejoins").delete(target)))
                              }
                            }
                          } |
                          for (@allOpen <- checkedCh & @allEnded <- endedCh & @allLapsed <- lapsedCh) {
                            if (not allOpen) {
                              resultCh!(state, (false, "A resolution names no claim open at this block."))
                            } else if (not allEnded) {
                              resultCh!(state, (false, "A grace expiry names no ejection whose grace has ended."))
                            } else if (not allLapsed) {
                              resultCh!(state, (false, "A claim expiry names no claim whose deadline its floor has reached."))
                            } else {
                              @ListOps!("fold", resolutions, state, *applyResolution, *resolvedCh) |
                              for (@resolved <- resolvedCh) {
                                @ListOps!("fold", graceExpiries, resolved, *forfeitStake, *expiredCh) |
                                for (@expired <- expiredCh) {
                                  @ListOps!("fold", claimExpiries, expired, *expireClaim, *lapsedOutCh) |
                                  for (@lapsedOut <- lapsedOutCh) {
                                    resultCh!(lapsedOut, (true, Nil))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    } else {
                      returnCh!((false, "Invalid AuthToken"))
                    }
                  }
                }
              } |
              new commitRewards in {
                // Private method which transfers all of a validator's rewards + bond to the Coop vault.
                // Slash expects (Boolean, Either[Nil, String]) on returnCh.
                contract PoS(@"slash", @deployerId, @blockHash, @sysAuthToken, returnCh) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new invalidBlocksCh, stateProcessCh, userCh,
                            getInvalidBlocks(`rho:casper:invalidBlocks`)
                        in {
                          getInvalidBlocks!(*invalidBlocksCh) |
                          getUser!(deployerId, *userCh) |
                          runMVar!(*stateCh, *stateProcessCh, *returnCh) |
                          for (@invalidBlocks        <- invalidBlocksCh &
                               @userPk               <- userCh &
                               @state, stateUpdateCh <- stateProcessCh) {
                                new toBeSlashed, stakeCh, forfeitedCh in {
                                  if (invalidBlocks.contains(blockHash)) {
                                    toBeSlashed!(invalidBlocks.get(blockHash)) |
                                    for (@validator <- toBeSlashed) {
                                      match state.get("withdrawers").get(validator) {
                                        Nil => stakeCh!(state.get("allBonds").getOrElse(validator, 0n))
                                        (quarantined, _) => stakeCh!(state.get("allBonds").getOrElse(validator, 0n) + quarantined)
                                      } |
                                      forfeitStake!(validator, state, *forfeitedCh) |
                                      for (@stake <- stakeCh & @forfeited <- forfeitedCh) {
                                        // A validator already at nothing was
                                        // slashed before, and slashing it
                                        // again succeeds, since a block may
                                        // re-issue a slash for the same
                                        // offender. With stake left, an
                                        // unchanged state means the transfer
                                        // failed.
                                        if (stake > 0n and forfeited == state) {
                                          stateUpdateCh!(state, (false, "transfer failed"))
                                        } else {
                                          stateUpdateCh!(forfeited, (true, Nil))
                                        }
                                      }
                                    }
                                  } else {
                                    stateUpdateCh!(state, (false, "invalid slash evidence"))
                                  }
                                }
                          }
                        }
                      } else {
                        returnCh!((false, "Invalid system auth token"))
                      }
                    }
                  }
                } |
                // Private method which signals the end of block processing.
                contract PoS(@"closeBlock", @sysAuthToken, ackCh) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new blockDataCh, getBlockData(`rho:block:data`) in {
                          getBlockData!(*blockDataCh) |
                          for (@blockNumber, _, _ <- blockDataCh) {
                            if (blockNumber % $$epochLength$$ != 0) {
                              // Epoch change does not occur.
                              ackCh!((true, Nil))
                            } else {
                              // Epoch change occurs.
                              new payWithdrawer, removeQuarantinedWithdrawers,
                                  stateProcessCh, paymentDoneCh,
                                  accDepositsDoneCh, commitRewardsCh,
                                  newValidatorsCh, removeQuarantinedCh, currentEpochRewardCh,
                                  commitCurrentEpochRewards, updatedRewardsCh, movePendingWithdrawCh, movePendingWithdrawer,
                                  sweepRetention, sweptRetentionCh
                              in {
                                PoS!("getCurrentEpochRewards", * currentEpochRewardCh) |
                                for (@currentRewards <- currentEpochRewardCh) {
                                  runMVar!(*stateCh, *stateProcessCh, *ackCh) |
                                  for (@state, stateUpdateCh <- stateProcessCh) {
                                    // 1. Calculate all the validator current epoch rewards based on active validator bonding proportion
                                    // 2. Accumulate `committedRewards` with the result of step 1
                                    commitCurrentEpochRewards!(state, currentRewards, *updatedRewardsCh) |
                                    for (@newCommittedState <- updatedRewardsCh) {
                                      // 3. Update `withdrawers` according to `allBonds` and `pendingWithdrawers`
                                      // when pendingWithdrawers is not empty, remove the validator in `allBonds`
                                      movePendingWithdrawer!(newCommittedState, *movePendingWithdrawCh) |
                                      for (@newMovedPendingState <- movePendingWithdrawCh){
                                        // 4. When the block number reaches the quantinue of `withdrawers` ,
                                        //  transfer the corresponding bonds+ rewards to the corresponding validator from posVault.
                                        // 5. update `pendingWithdrawers` to empty Map {}.
                                        removeQuarantinedWithdrawers!(blockNumber, newMovedPendingState, *removeQuarantinedCh) |
                                        for (@newRemovedQuantinueState <- removeQuarantinedCh) {
                                          // 6. Pick new `activeValidators`
                                          pickActiveValidators!(newMovedPendingState.get("allBonds").toList(), *newValidatorsCh) |
                                          for (@newValidators <- newValidatorsCh) {
                                            // 7. Drop the closed freezes and overflow payments
                                            // the retention window has passed. No evidence
                                            // reaches them, so this only bounds the maps.
                                            sweepRetention!(blockNumber, newRemovedQuantinueState.set("activeValidators", newValidators), *sweptRetentionCh) |
                                            for (@sweptState <- sweptRetentionCh) {
                                              stateUpdateCh!(sweptState, (true, Nil))
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                } |
                                // Transfers withdrawing validator's bond + accumulated rewards from PoS vault to their vault.
                                contract payWithdrawer(@(pk, amount), returnCh) = {
                                  new vaultCh, vaultAddressCh, createCh in {
                                    vaultAddressOps!("fromPublicKey", pk, *vaultAddressCh) |
                                    for (@toVaultAddress <- vaultAddressCh) {
                                      @SystemVault!("findOrCreate", toVaultAddress, *createCh) |
                                      for (@_ <- createCh){
                                        @posVault!("transfer", toVaultAddress, amount, posAuthKey, *returnCh)
                                      }
                                    }
                                  }
                                } |
                                contract commitCurrentEpochRewards(@state, @currentRewards, returnCh) = {
                                  new accumulate in {
                                    @ListOps!("fold", currentRewards.toList(), state, *accumulate, *returnCh) |
                                    contract accumulate(@(pk, reward), @updatedState, resultCh) = {
                                      resultCh!(updatedState.set("committedRewards",
                                                                  updatedState.get("committedRewards").set(pk, updatedState.get("committedRewards").getOrElse(pk, 0n) + reward)))
                                    }
                                  }
                                } |
                                contract sweepRetention(@currentBlockNumber, @state, returnCh) = {
                                  new keepRecent, keepFreeze, keepPayments, keepPayment,
                                      sweptFreezesCh, sweptClaimedCh in {
                                    @ListOps!("fold", state.get("freezeHistory").toList(), {}, *keepRecent, *sweptFreezesCh) |
                                    @ListOps!("fold", state.get("claimedOverflow").toList(), {}, *keepPayments, *sweptClaimedCh) |
                                    contract keepPayments(@(target, claimed), @acc, resultCh) = {
                                      new keptCh in {
                                        @ListOps!("fold", claimed.get("payments").toList(), {}, *keepPayment, *keptCh) |
                                        for (@kept <- keptCh) {
                                          resultCh!(acc.set(target, claimed.set("payments", kept)))
                                        }
                                      }
                                    } |
                                    contract keepPayment(@(at, amount), @acc, resultCh) = {
                                      if (at + $$retentionWindowBlocks$$ >= currentBlockNumber) {
                                        resultCh!(acc.set(at, amount))
                                      } else {
                                        resultCh!(acc)
                                      }
                                    } |
                                    contract keepRecent(@(target, byFloor), @acc, resultCh) = {
                                      new keptCh in {
                                        @ListOps!("fold", byFloor.toList(), {}, *keepFreeze, *keptCh) |
                                        for (@kept <- keptCh) {
                                          if (kept.size() == 0) {
                                            resultCh!(acc)
                                          } else {
                                            resultCh!(acc.set(target, kept))
                                          }
                                        }
                                      }
                                    } |
                                    contract keepFreeze(@(from, record), @acc, resultCh) = {
                                      match record.get("to") {
                                        Nil => resultCh!(acc.set(from, record))
                                        to => {
                                          if (to + $$retentionWindowBlocks$$ >= currentBlockNumber) {
                                            resultCh!(acc.set(from, record))
                                          } else {
                                            resultCh!(acc)
                                          }
                                        }
                                      }
                                    } |
                                    for (@sweptFreezes <- sweptFreezesCh & @sweptClaimed <- sweptClaimedCh) {
                                      returnCh!(state
                                        .set("freezeHistory", sweptFreezes)
                                        .set("claimedOverflow", sweptClaimed))
                                    }
                                  }
                                } |
                                contract movePendingWithdrawer(@state, returnCh) = {
                                  new movePending in {
                                    @ListOps!("fold", state.get("pendingWithdrawers").toList(), state, *movePending, *returnCh) |
                                    // A validator that bonded again beside its
                                    // quarantine joins the new bond to it, held
                                    // until the later of the two ends.
                                    contract movePending(@(pk, quantine), @updatedState, resultCh) = {
                                      new entryCh in {
                                        match updatedState.get("withdrawers").get(pk) {
                                          Nil => entryCh!((updatedState.get("allBonds").get(pk), quantine))
                                          (held, heldUntil) => {
                                            if (heldUntil > quantine) {
                                              entryCh!((held + updatedState.get("allBonds").getOrElse(pk, 0n), heldUntil))
                                            } else {
                                              entryCh!((held + updatedState.get("allBonds").getOrElse(pk, 0n), quantine))
                                            }
                                          }
                                        } |
                                        for (@entry <- entryCh) {
                                          resultCh!(updatedState
                                                    .set("withdrawers", updatedState.get("withdrawers").set(pk, entry))
                                                    .set("allBonds", updatedState.get("allBonds").delete(pk))
                                                    .set("pendingWithdrawers", updatedState.get("pendingWithdrawers").delete(pk))
                                                    )
                                        }
                                      }
                                    }
                                  }
                                } |
                                // Checks withdrawer's quarantine period against current block number,
                                // then computes their payment, removes them from the bonds and withdrawers maps, and
                                // updates the committed rewards map.
                                contract removeQuarantinedWithdrawers(@currentBlockNumber, @state, returnCh) = {
                                  new quarantinedValidatorsCh, validatorsToWithdrawListCh,
                                      isQuarantineFinished, notWithdrawn, payWithdraw,
                                      newBondsListCh, newWithdrawersListCh,
                                      computeRemove, payRet
                                  in {
                                    // Calculate rewards by taking PoS balance on PoS vault and subtract all active stake + newly bonded
                                    @ListOps!("filter", state.get("withdrawers").toList(), *isQuarantineFinished, *quarantinedValidatorsCh) |
                                    for (@quarantinedValidators <- quarantinedValidatorsCh) {
                                      @ListOps!("unorderedParMap", quarantinedValidators, *payWithdraw, *payRet) |
                                      // Bug #10 fix: pattern-match on the transfer outcome and emit
                                      // (pk, success_bool) on resultCh. The downstream `computeRemove`
                                      // fold then removes ONLY successful withdrawers from the maps;
                                      // failed transfers leave the per-validator state intact for
                                      // retry on a later block. Pre-fix the resultCh just forwarded
                                      // posVault.transfer's (true, _) | (false, errMsg) pair, and the
                                      // surrounding `for (@_ <- payRet)` accepted any value, so a
                                      // failed transfer would still drop the validator from
                                      // `withdrawers` and `committedRewards` — losing funds. See
                                      // design/09-bug-fixes-and-rationale.md §9.13
                                      // (theorem t_9_10_withdraw_transfer_failure_safety,
                                      // formal/rocq/slashing/theories/BugFixWithdrawTransferFailure.v).
                                      // A slashed bond leaves nothing to pay, and the vault
                                      // refuses a transfer of nothing.
                                      contract payWithdraw(@(pk, (bonds, quantine)), resultCh) = {
                                        new transferResultCh in {
                                          match bonds.toBigInt() + state.get("committedRewards").getOrElse(pk, 0n) {
                                            payment => {
                                              if (payment == 0n) {
                                                resultCh!((pk, true))
                                              } else {
                                                payWithdrawer!((pk, payment), *transferResultCh) |
                                                for (@transferResult <- transferResultCh) {
                                                  match transferResult {
                                                    (true, _) => { resultCh!((pk, true)) }
                                                    (_, _)    => { resultCh!((pk, false)) }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |
                                      for (@payResults <- payRet) {
                                        @ListOps!("fold", payResults, state, *computeRemove, *returnCh) |
                                        contract computeRemove(@(pk, success), @updatedState, resultCh) = {
                                          if (success) {
                                            resultCh!(updatedState
                                                      .set("committedRewards", updatedState.get("committedRewards").delete(pk))
                                                      .set("withdrawers", updatedState.get("withdrawers").delete(pk))
                                                      )
                                          } else {
                                            // Failure path: leave per-validator state intact so the
                                            // outer scheduler retries on a later block. The validator
                                            // remains in `withdrawers` with their original (bond,
                                            // quarantine) entry and unchanged `committedRewards`.
                                            resultCh!(updatedState)
                                          }
                                        }
                                      }
                                    } |
                                    // Check whether quarantine period is finished.
                                    contract isQuarantineFinished(@(pk, (bonds, blockNumber)), resultCh) = {
                                      resultCh!(currentBlockNumber >= blockNumber)
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      } else {
                        ackCh!((false, "Invalid system auth token"))
                      }
                    }
                  }
                }
              } |
              //
              contract PoS(@"commitRandomImage", @deployerId, @hash, ackCh) = {
                new userCh, mvarCh in {
                  getUser!(deployerId, *userCh) |
                  runMVar!(*stateCh, *mvarCh, *ackCh) |
                  for (@validator       <- userCh &
                       @state, resultCh <- mvarCh) {
                    if (state.get("randomImages").contains(validator)) {
                      resultCh!(state, (false, "Image already committed"))
                    } else {
                      resultCh!(
                        state.set("randomImages", state.get("randomImages").set(validator, hash)), true)
                    }
                  }
                }
              } |
              //
              contract PoS(@"revealRandom", @deployerId, @random, ackCh) = {
                new userCh, mvarCh, computeHash(`rho:crypto:keccak256Hash`), hashCh in {
                  getUser!(deployerId, *userCh) |
                  runMVar!(*stateCh, *mvarCh, *ackCh) |
                  computeHash!(random, *hashCh) |
                  for (@validator       <- userCh &
                       @state, resultCh <- mvarCh &
                       @hash            <- hashCh) {
                    if (state.get("randomImages").contains(validator)) {
                      if (hash == state.get("randomImages").get(validator)) {
                        resultCh!(
                          state.set("randomNumbers",state.get("randomNumbers").set(validator, random)), true)
                      } else {
                        resultCh!(state, (false, "Previously committed image doesn't match the random number"))
                      }
                    } else {
                      resultCh!(state, (false, "Previously committed random image not found"))
                    }
                  }
                }
              }
            }
          }
        } |
        // Transfers funds from deployer to block sender.
        contract deposit(@deployerId, @amount, @toTargetAddress, returnCh) = {
          new vaultCh, vaultAddressCh,
              indexSender, authKeyCh
          in {
            @SystemVault!("deployerAuthKey", deployerId, *authKeyCh) |
            vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
            for (@authKey        <- authKeyCh &
                 @fromVaultAddress <- vaultAddressCh) {
              @SystemVault!("findOrCreate", fromVaultAddress, *vaultCh) |
              for (@(true, fromVault) <- vaultCh) {
                // Transfers from deployer to PoS vault
                @fromVault!("transfer", toTargetAddress, amount, authKey, *returnCh)
              }
            }
          }
        }
      } |
      // Updates value stored on varCh and sends (Bool) acknowledgement on returnCh.
      contract runMVar(varCh, processCh, returnCh) = {
        new resultCh in {
          for (@v <- varCh) {
            processCh!(v, *resultCh) |
            for (@newV, @result <- resultCh) {
              varCh!(newV) |
              returnCh!(result)
            }
          }
        }
      } |
      // Discards second element of a pair.
      contract fst(@(first, _), resultCh) = {
        resultCh!(first)
      } |
      // For computing some of initial validator bonds.
      contract sumFromPair(@(_, a), @b, resultCh) = {
        resultCh!(a + b)
      } |
      // Retrieves deployer's public key.
      contract getUser(@deployerId, returnCh) = {
        new deployerIdOps(`rho:system:deployerId:ops`) in {
          deployerIdOps!("pubKeyBytes", deployerId, *returnCh)
        }
      } |
      // Selects set of active validators from the set of available validators.
      // A key with no stake, such as a slashed validator's, holds no seat.
      contract pickActiveValidators(@allBonds, returnCh) = {
        new staked, stakedCh, pksCh in {
          contract staked(@(_, stake), retCh) = { retCh!(stake > 0n) } |
          @ListOps!("filter", allBonds, *staked, *stakedCh) |
          for (@stakedBonds <- stakedCh) {
            @ListOps!("map", stakedBonds, *fst, *pksCh) |
            for (@pks <- pksCh) {
              // TODO: Randomly select 100 active validators once we have on-chain randomness
              returnCh!(pks.take($$numberOfActiveValidators$$).toSet())
            }
          }
        }
      }
    }
    }|
    // Registers signed write-only PoS contract bundle.
    rs!(
      "047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f".hexToBytes(),
      (9223372036854775807, bundle+{*PoS}),
      "3045022100cd1a32e04e21deb1bb3cd108cb0a3ab1357495f6ad99dfeb08eb17eaa082d388022015a9c5f9cd3b489a1fe3e359dbfe791ddd7d66e8a9a1dfb4978c980128c53f69".hexToBytes(),
      *uriOut)
  }
}
