// Rholang macro parameters:
// minimumBond - the minimum bond allowed by the PoS
// maximumBond - the maximum bond allowed by PoS
// initialBonds - the initial bonds map
// epochLength - the length of the validation epoch in blocks
// quarantineLength - the length of the quarantine time in blocks
// numberOfActiveValidators - max number of active validator in a shard
// faultToleranceThresholdPpm - protocol fault-tolerance threshold in parts-per-million
// maxParentDepth - the parent-spread validity bound (citability horizon), in blocks
// deployLifespan - the deploy validity window, in blocks
// minPhloPrice - the minimum accepted deploy phlo price
// posMultiSigPublicKeys - public keys
// posMultiSigQuorum - how many confirmations are necessary to use multi-sig vault
/*

Life cycle in POS

POS internal state:
"allBonds"        : Map[Validator, bonds],
"activeValidators": Set[Validator],
"withdrawers"     : Map[Validator, (bonds, quantinue)],
"committedRewards" : Map[Validator, rewards],
"pendingWithdrawers": Map[Validator, quantinue]

**There are two vaults `posVault` and `coopMultiSigVault` while pos contract have no controll on `coopMultiSigVault` but `posVault`**

Several crucial calculate points:

## UserDeploy

* precharge -> user transfer the precharge funding to posVault
* refund -> posVault transfer the refund amount back to userVault

## Bonding

User transfer the bonding amount directly to posVault. `allBonds` would update with {Validator: bondAmount}.

## Withdraw(Unbond)

`pendingWithdrawers` would update with {Validator: quantinue}


## EpochChange(CloseBlock)

1. Calculate all the validator current epoch rewards based on active validator bonding proportion
2. Accumulate `committedRewards` with the result of step 1
3. Update `withdrawers` according to `allBonds` and `pendingWithdrawers` when pendingWithdrawers is not empty, remove the validator in `allBonds`
4. When the block number reaches the quantinue of `withdrawers` , transfer the corresponding bonds+ rewards to the corresponding validator from posVault.
5. update `pendingWithdrawers` to empty Map {}.
6. Pick new `activeValidators`


## Slashing
1. Transfer the bonding amount of the slashed validator based on `allBonds` from posVault to coopMultiSigVault.
2. Remove the slashed validator from `allBonds`
3. remove the slashed validator in `activeValidators`

*/

/*
 The table below describes the required computations and their dependencies

 No. | Dependency | Computation method | Result
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 1.  |            | given              | sk = a9585a0687761139ab3587a4938fb5ab9fcba675c79fefba889859674046d4a5
 2.  |            | given              | timestamp = 1559156420651
 3.  |            | lastNonce          | nonce = 9223372036854775807
 4.  | 1,         | secp256k1          | pk = 047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f
 5.  | 2, 4, 3,   | registry           | value = (1559156420651, 047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f, 9223372036854775807)
 6.  | 5,         | protobuf           | toSign = 2a65aa01620a092a0710d6c0b7cfe05a0a462a44ca0141047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f0a0d2a0b10feffffffffffffffff01
 7.  | 6, 1,      | secp256k1          | sig = 3045022100cd1a32e04e21deb1bb3cd108cb0a3ab1357495f6ad99dfeb08eb17eaa082d388022015a9c5f9cd3b489a1fe3e359dbfe791ddd7d66e8a9a1dfb4978c980128c53f69
 8.  | 4,         | registry           | uri = rho:id:m3xk7h8r54dtqtwsrnxqzhe81baswey66nzw6m533nyd45ptyoybqr
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
*/

new PoS,
    registryLookup(`rho:registry:lookup`),
    vaultAddressOps(`rho:vault:address`),
    systemVaultCh, listOpsCh,
    getUser,
    pickActiveValidators,
    runMVar,
    fst,
    deposit, distributeRewards,
    perActiveValidatorPosVaultsCh,
    rs(`rho:registry:insertSigned:secp256k1`),
    posId(`rho:system:deployerId`),
    PendingRewards, MergeIntMaps, treeHashMapCh,
    sysAuthTokenOps(`sys:authToken:ops`),
    multiSigSystemVaultCh, coopVaultCh,
    uriOut, sumFromPair
in {
  // Simultaneously retrieves SystemVault, ListOps, TreeHashMap, and MultiSigSystemVault contracts from the registry.
  registryLookup!(`rho:vault:system`, *systemVaultCh) |
  registryLookup!(`rho:lang:listOps`, *listOpsCh) |
  registryLookup!(`rho:lang:treeHashMap`, *treeHashMapCh) |
  registryLookup!(`rho:vault:multiSig`, *multiSigSystemVaultCh) |
  for (@(_, SystemVault)         <- systemVaultCh &
       @(_, ListOps)          <- listOpsCh &
       TreeHashMap            <- treeHashMapCh &
       @(_, MultiSigSystemVault) <- multiSigSystemVaultCh) {
    new posDeployerVaultAddressCh, posDeployerAuthKeyCh, posDeployerVaultCh, posVaultCh,
        initialActiveCh, pendingRewardsMapCh, createUnfVault, moveInitialBondCh, posAuthKeyCh
    in {

      // Creates the auth key and System vault associated with the PoS contract.
      new posPkCh in {
        @SystemVault!("deployerAuthKey", *posId, *posDeployerAuthKeyCh) |
        getUser!(*posId, *posPkCh) |
        for (@posPk <- posPkCh) {
          vaultAddressOps!("fromPublicKey", posPk, *posDeployerVaultAddressCh) |
          // Creates Coop multisig vault for slashed funds.
          // Either (false, errorMsg) or (true, (multiSigVault, vaultAddress, systemVault)) are returned on coopVaultCh.
          @MultiSigSystemVault!(
            "create",
            $$posMultiSigPublicKeys$$,
            [],
            $$posMultiSigQuorum$$,
            *coopVaultCh
          )
        }
      } |
      // ret: the return channel of the create
      // pubKey: the pubkey which control the unforgeable name
      contract createUnfVault(ret, @pubkey) = {
        new unf, unfAddrRet, createRetCh, pubKeyChainUnfVault, unfVaultHandle, stdout(`rho:io:stdout`) in {
          vaultAddressOps!("fromUnforgeable", *unf, *unfAddrRet) |
          for (@unfAddr <- unfAddrRet){
            @SystemVault!("findOrCreate", unfAddr, *createRetCh) |
            for (@(true, vault) <- createRetCh){
              contract unfVaultHandle(@"transfer", @targetAddress, @amount, deployerID, transferRet) = {
                new deployerPubKeyBytesCh, DeployerIdOps(`rho:system:deployerId:ops`) in {
                  DeployerIdOps!("pubKeyBytes", *deployerID, *deployerPubKeyBytesCh) |
                  for (@deployerPubKeyBytes <- deployerPubKeyBytesCh) {
                    if (deployerPubKeyBytes ==  pubkey.hexToBytes()){
                      new unfAuthKeyCh in {
                        @SystemVault!("unforgeableAuthKey", *unf, *unfAuthKeyCh) |
                        for (@unfAuthKey <- unfAuthKeyCh){
                          @vault!("transfer", targetAddress, amount, unfAuthKey, *transferRet)
                        }
                      }
                    } else {
                      transferRet!((false, "You have not permission to transfer."))
                    }
                  }
                }
              } |
              ret!((*unf, unfAddr, vault ,*unfVaultHandle))
            }
          }
        }
      }|
      createUnfVault!(*posVaultCh, "$$posPubKey$$") |
      for (@(posVaultUnf, posVaultAddr, posVault, humanControlHandle) <- posVaultCh){
      @SystemVault!("unforgeableAuthKey", posVaultUnf, *posAuthKeyCh) |
      for (@posDeployerVaultAddress <- posDeployerVaultAddressCh;
           @posDeployerAuthKey    <- posDeployerAuthKeyCh;
           @posAuthKey <- posAuthKeyCh)  {
        for (@(true, (coopMultiVault, coopMultiVaultAddr, coopVaultHd)) <<- coopVaultCh) {
          // Creates PoS System vault with sum of initial bonds.
          new bondSumCh in {
            @ListOps!("fold", $$initialBonds$$.toList(), 0n, *sumFromPair, *bondSumCh) |
            for (@bondSum <- bondSumCh) {
              @SystemVault!("createWithBalance", posDeployerVaultAddress, bondSum, *posDeployerVaultCh)|
              for (@(true, posDeployerVault)  <- posDeployerVaultCh) {
                // move all the fund from deployer addr to POS unforgeable vault
                @posDeployerVault!("transfer", posVaultAddr, bondSum, posDeployerAuthKey, *moveInitialBondCh)
              }
            }
          } |
          // Selects the initial active validators.
          pickActiveValidators!($$initialBonds$$.toList(), *initialActiveCh) |
          for (@initialActive     <- initialActiveCh;
               @(true, _) <- moveInitialBondCh) {
            new stateCh, pendingRewardsInitializedCh, rewardsInfo, rewardsInfoForState,
                computeCurrentEpochRewards, calTotalActiveBonds, calTotalBonds,
                accumulateSndNum, accumulateFstOfSndArg, computeEffectiveBonds,
                removeDelegationsForValidator, updateDelegationEntry, updateDelegatedTotalEntry,
                sumPendingUndelegations, stripPendingUndelegationsForValidator,
                moveDelegationsToPendingUndelegations, settleDelegatorReward,
                updateValidatorDelegatorEntry, maxDelegatorsPerValidator,
                settleDelegatorRewards in {
              // Initializes PoS state structure.
              stateCh!({
                // Map[PublicKey, Int] - each validator stake
                "allBonds"        : $$initialBonds$$,
                "slashedValidators": Set(),
                // Map[DelegatorPublicKey, Map[ValidatorPublicKey, Int]] - delegated stake ownership
                "delegations"     : {},
                "validatorDelegators" : {},
                // Map[ValidatorPublicKey, Int] - aggregated delegated stake per validator
                "delegatedTotals" : {},
                // Set[PublicKey]     - the active validators
                "activeValidators": initialActive,
                // Map[PublicKey, (Int, Int)] - The validators who issued a withdraw request , finished validating jobs and not active.
                //                              When the validator reachs the quantinue length, it would be removed in the map and
                //                              pos would transfer back all the original bond and rewards back to validator vault.
                //                              Value(Int, Int) represents (original bond + reward, quantinue length)
                "withdrawers"     : {},
                // Map[PublicKey, BigInt]
                "committedRewards" : {},
                // Map[DelegatorPublicKey, Map[ValidatorPublicKey, Int]] - rewards accumulated for delegators
                "delegatorRewards" : {},
                "rewardIndexes": {},
                "rewardCheckpoints": {},
                "validatorRewardLiabilities": {},
                "delegatorRewardLiability": 0n,
                "pendingUndelegationTotal": 0n,
                // Map[PublicKey, Int] - the validators wishing to withdraw and the block number when their quarantine ends
                "pendingWithdrawers": {},
                // Map[DelegatorPublicKey, Map[ValidatorPublicKey, (Int, Int)]] -
                // pending undelegation requests by delegator and validator, storing (amount, unlockBlock)
                "pendingUndelegations": {},
                "randomImages"    : {},
                "randomNumbers"   : {},
              }) |
              contract maxDelegatorsPerValidator(returnCh) = {
                returnCh!(1600)
              } |
              contract rewardsInfo(retCh) = {
                for (@state <<- stateCh) {
                  rewardsInfoForState!(state, *retCh)
                }
              } |
              contract rewardsInfoForState(@state, retCh) = {
                new posBalanceCh, totalActiveBondCh, totalBondCh, totalWithdrawCh, committedRewardsCh,
                    effectiveBondsCh, delegatorRewardsCh, pendingUndelegationsCh in {
                  @posVault!("balance", *posBalanceCh) |
                  computeEffectiveBonds!(state, *effectiveBondsCh) |
                  delegatorRewardsCh!(state.get("delegatorRewardLiability")) |
                  for (@effectiveBonds <- effectiveBondsCh) {
                    @ListOps!("fold", effectiveBonds.toList(), 0n, *accumulateSndNum, *totalBondCh) |
                    calTotalActiveBonds!(state, effectiveBonds, *totalActiveBondCh) |
                    @ListOps!("fold", state.get("withdrawers").toList(), 0n, *accumulateFstOfSndArg, *totalWithdrawCh) |
                    @ListOps!("fold", state.get("committedRewards").toList(), 0n, *accumulateSndNum, *committedRewardsCh) |
                    sumPendingUndelegations!(state, *pendingUndelegationsCh) |
                    for (@posBalance <- posBalanceCh; @totalBond <- totalBondCh; @activeBonds <- totalActiveBondCh;
                         @totalWithdraw <- totalWithdrawCh; @totalCommittedRewards <- committedRewardsCh;
                         @totalDelegatorRewards <- delegatorRewardsCh; @totalPendingUndelegations <- pendingUndelegationsCh){
                      retCh!((
                        posBalance,
                        totalBond,
                        activeBonds,
                        totalWithdraw,
                        totalCommittedRewards,
                        totalDelegatorRewards,
                        totalPendingUndelegations,
                        effectiveBonds,
                        state.get("activeValidators")
                      ))
                    }
                  }
                }
              } |
              contract calTotalActiveBonds(@state, @effectiveBonds, returnCh) = {
                new computeSum in {
                  @ListOps!("fold", effectiveBonds.toList(), 0n, *computeSum, *returnCh) |
                  contract computeSum(@(pk, bondAmount), @acc, resultCh) = {
                    if (state.get("activeValidators").contains(pk)){
                      resultCh!(acc + bondAmount.toBigInt())
                    } else {
                      resultCh!(acc)
                    }
                  }
                }
              } |
              contract accumulateSndNum(@(_, amount), @acc, resultCh) = {
                resultCh!(acc + amount.toBigInt())
              } |
              contract accumulateFstOfSndArg(@(_, (amount, _)), @acc, resultCh) = {
                resultCh!(acc + amount.toBigInt())
              } |
              contract computeEffectiveBonds(@state, returnCh) = {
                new includePositiveBond, mergeDelegatedTotals, positiveBondsCh in {
                  @ListOps!("fold", state.get("allBonds").toList(), {}, *includePositiveBond, *positiveBondsCh) |
                  contract includePositiveBond(@(validatorPk, selfBond), @acc, resultCh) = {
                    if (selfBond > 0n) {
                      resultCh!(acc.set(validatorPk, selfBond))
                    } else {
                      resultCh!(acc)
                    }
                  } |
                  for (@positiveBonds <- positiveBondsCh) {
                    @ListOps!("fold", state.get("delegatedTotals").toList(), positiveBonds, *mergeDelegatedTotals, *returnCh)
                  } |
                  contract mergeDelegatedTotals(@(validatorPk, delegatedAmount), @acc, resultCh) = {
                    if (acc.contains(validatorPk)) {
                      if (delegatedAmount > 0n) {
                        resultCh!(acc.set(validatorPk, acc.getOrElse(validatorPk, 0n) + delegatedAmount))
                      } else {
                        resultCh!(acc)
                      }
                    } else {
                      resultCh!(acc)
                    }
                  }
                }
              } |
              contract removeDelegationsForValidator(@state, @validatorPk, returnCh) = {
                new removeOne in {
                  @ListOps!("fold", state.get("validatorDelegators").getOrElse(validatorPk, {}).toList(), state.get("delegations"), *removeOne, *returnCh) |
                  contract removeOne(@(delegatorPk, _), @acc, resultCh) = {
                    match acc.getOrElse(delegatorPk, {}).delete(validatorPk) {
                      updatedValidatorMap => {
                        if (updatedValidatorMap.size() == 0) {
                          resultCh!(acc.delete(delegatorPk))
                        } else {
                          resultCh!(acc.set(delegatorPk, updatedValidatorMap))
                        }
                      }
                    }
                  }
                }
              }|
              // Updates one delegator->validator entry and removes empty keys.
              contract updateDelegationEntry(@delegations, @delegatorPk, @validatorPk, @newAmount, returnCh) = {
                if (newAmount == 0n) {
                  match delegations.getOrElse(delegatorPk, {}).delete(validatorPk) {
                    updatedValidatorMap => {
                      if (updatedValidatorMap.size() == 0) {
                        returnCh!(delegations.delete(delegatorPk))
                      } else {
                        returnCh!(delegations.set(delegatorPk, updatedValidatorMap))
                      }
                    }
                  }
                } else {
                  returnCh!(delegations.set(
                    delegatorPk,
                    delegations.getOrElse(delegatorPk, {}).set(validatorPk, newAmount)
                  ))
                }
              }|
              // Updates one validator delegated-total entry and removes zero totals.
              contract updateDelegatedTotalEntry(@delegatedTotals, @validatorPk, @newAmount, returnCh) = {
                if (newAmount == 0n) {
                  returnCh!(delegatedTotals.delete(validatorPk))
                } else {
                  returnCh!(delegatedTotals.set(validatorPk, newAmount))
                }
              }|
              contract updateValidatorDelegatorEntry(@validatorDelegators, @validatorPk, @delegatorPk, @hasDelegation, returnCh) = {
                if (hasDelegation) {
                  returnCh!(validatorDelegators.set(
                    validatorPk,
                    validatorDelegators.getOrElse(validatorPk, {}).set(delegatorPk, Nil)
                  ))
                } else {
                  match validatorDelegators.getOrElse(validatorPk, {}).delete(delegatorPk) {
                    updatedDelegatorMap => {
                      if (updatedDelegatorMap.size() == 0) {
                        returnCh!(validatorDelegators.delete(validatorPk))
                      } else {
                        returnCh!(validatorDelegators.set(validatorPk, updatedDelegatorMap))
                      }
                    }
                  }
                }
              }|
              contract sumPendingUndelegations(@state, returnCh) = {
                returnCh!(state.get("pendingUndelegationTotal"))
              } |
              // Removes pending undelegations tied to a validator and returns
              // (updatedPendingUndelegations, totalRemovedAmount).
              contract stripPendingUndelegationsForValidator(@pendingUndelegations, @validatorPk, returnCh) = {
                new stripOne in {
                  @ListOps!("fold", pendingUndelegations.toList(), ({}, 0n), *stripOne, *returnCh) |
                  contract stripOne(@(delegatorPk, validatorMap), @(accPending, accAmount), resultCh) = {
                    if (validatorMap.contains(validatorPk)) {
                      match validatorMap.get(validatorPk) {
                        (pendingAmount, _) => {
                          match validatorMap.delete(validatorPk) {
                            updatedValidatorMap => {
                              if (updatedValidatorMap.size() == 0) {
                                resultCh!((accPending.delete(delegatorPk), accAmount + pendingAmount.toBigInt()))
                              } else {
                                resultCh!((accPending.set(delegatorPk, updatedValidatorMap), accAmount + pendingAmount.toBigInt()))
                              }
                            }
                          }
                        }
                      }
                    } else {
                      resultCh!((accPending.set(delegatorPk, validatorMap), accAmount))
                    }
                  }
                }
              }|
              contract moveDelegationsToPendingUndelegations(@state, @validatorPk, @unlockBlock, returnCh) = {
                new moveOne in {
                  @ListOps!("fold", state.get("validatorDelegators").getOrElse(validatorPk, {}).toList(), (state, 0n), *moveOne, *returnCh) |
                  contract moveOne(@(delegatorPk, _), @(accState, accAmount), resultCh) = {
                    new settledCh in {
                      settleDelegatorReward!(accState, delegatorPk, validatorPk, *settledCh) |
                      for (@settledState <- settledCh) {
                        match settledState.get("delegations").getOrElse(delegatorPk, {}).getOrElse(validatorPk, 0n) {
                          activeAmount => {
                            new updatedDelegationsCh, deadlineCh in {
                              updateDelegationEntry!(settledState.get("delegations"), delegatorPk, validatorPk, 0n, *updatedDelegationsCh) |
                              match settledState.get("pendingUndelegations").getOrElse(delegatorPk, {}).getOrElse(validatorPk, (0n, 0)) {
                                (pendingAmount, pendingUnlockBlock) => {
                                  if (pendingUnlockBlock > unlockBlock) {
                                    deadlineCh!(pendingUnlockBlock)
                                  } else { deadlineCh!(unlockBlock) } |
                                  for (@updatedDelegations <- updatedDelegationsCh & @deadline <- deadlineCh) {
                                    resultCh!((settledState
                                      .set("delegations", updatedDelegations)
                                      .set("pendingUndelegations", settledState.get("pendingUndelegations").set(delegatorPk,
                                        settledState.get("pendingUndelegations").getOrElse(delegatorPk, {}).set(validatorPk, (pendingAmount + activeAmount, deadline))))
                                      .set("pendingUndelegationTotal", settledState.get("pendingUndelegationTotal") + activeAmount), accAmount + activeAmount))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              contract settleDelegatorReward(@state, @delegatorPk, @validatorPk, returnCh) = {
                if (state.get("slashedValidators").contains(validatorPk)) {
                  returnCh!(state
                    .set("delegatorRewards", state.get("delegatorRewards").set(delegatorPk, state.get("delegatorRewards").getOrElse(delegatorPk, {}).delete(validatorPk)))
                    .set("rewardCheckpoints", state.get("rewardCheckpoints").set(delegatorPk, state.get("rewardCheckpoints").getOrElse(delegatorPk, {}).delete(validatorPk))))
                } else {
                  match state.get("rewardIndexes").getOrElse(validatorPk, 0n) {
                    currentIndex => {
                      match state.get("rewardCheckpoints").getOrElse(delegatorPk, {}).getOrElse(validatorPk, (currentIndex, 0n)) {
                        (lastIndex, remainder) => {
                          match state.get("delegations").getOrElse(delegatorPk, {}).getOrElse(validatorPk, 0n) * (currentIndex - lastIndex) + remainder {
                            scaledReward => {
                              match $$maximumBond$$n * 1000000000000000000n {
                                scale => {
                                  returnCh!(state
                                    .set("delegatorRewards", state.get("delegatorRewards").set(delegatorPk,
                                      state.get("delegatorRewards").getOrElse(delegatorPk, {}).set(validatorPk,
                                        state.get("delegatorRewards").getOrElse(delegatorPk, {}).getOrElse(validatorPk, 0n) + scaledReward / scale)))
                                    .set("rewardCheckpoints", state.get("rewardCheckpoints").set(delegatorPk,
                                      state.get("rewardCheckpoints").getOrElse(delegatorPk, {}).set(validatorPk, (currentIndex, scaledReward % scale)))))
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              contract settleDelegatorRewards(@state, @delegatorPk, returnCh) = {
                new settleOne in {
                  @ListOps!("fold", state.get("rewardCheckpoints").getOrElse(delegatorPk, {}).toList(), state, *settleOne, *returnCh) |
                  contract settleOne(@(validatorPk, _), @updatedState, resultCh) = {
                    settleDelegatorReward!(updatedState, delegatorPk, validatorPk, *resultCh)
                  }
                }
              } |
              contract computeCurrentEpochRewards(@state, returnCh) = {
                new rewardCh, computeReward in {
                  rewardsInfoForState!(state, *rewardCh)|
                  for (@(posBalance, totalBond, activeBonds, totalWithdraw, totalCommittedRewards, totalDelegatorRewards, totalPendingUndelegations, bondsMap, activeValidatorsSet) <- rewardCh){
                    @ListOps!("fold", bondsMap.toList(), {}, *computeReward, *returnCh) |
                    contract computeReward(@(pk, bonds), @acc,  outCh) = {
                      // Rewards are BigInt, so this product cannot overflow. Each bond is divided by minimumBond first, which truncates the validator's share.
                      if (activeValidatorsSet.contains(pk)){
                        match activeBonds / $$minimumBond$$n.toBigInt() {
                          activeBondUnits => {
                            if (activeBondUnits > 0n) {
                              outCh!(acc.set(pk, (posBalance - totalBond - totalWithdraw - totalCommittedRewards - totalDelegatorRewards - totalPendingUndelegations) * (bonds / $$minimumBond$$n).toBigInt() / activeBondUnits))
                            } else {
                              outCh!(acc.set(pk, 0n))
                            }
                          }
                        }
                      } else {
                        outCh!(acc.set(pk, 0n))
                      }
                    }
                  }
                }
              } |
              contract PoS(@"getCurrentEpochRewards", returnCh) = {
                for (@state <<- stateCh) {
                  computeCurrentEpochRewards!(state, *returnCh)
                }
              } |
              contract PoS(@"getRewards", returnCh) = {
                new currentEpochRewardCh, accumulateReward in {
                  for (@state <<- stateCh) {
                    computeCurrentEpochRewards!(state, *currentEpochRewardCh)|
                    for (@currentEpochReward <- currentEpochRewardCh) {
                      @ListOps!("fold", currentEpochReward.toList(), state.get("committedRewards"), *accumulateReward, *returnCh) |
                      contract accumulateReward(@(pk, reward), @acc, outCh) = {
                        match state.get("allBonds").getOrElse(pk, 0n) {
                          selfBond => {
                            match selfBond + state.get("delegatedTotals").getOrElse(pk, 0n) {
                              effectiveBond => {
                                if (effectiveBond > 0n) {
                                  outCh!(acc.set(pk, acc.getOrElse(pk, 0n) + reward * selfBond.toBigInt() / effectiveBond.toBigInt()))
                                } else {
                                  outCh!(acc)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Peeks at raw validator self-bonds map.
              contract PoS(@"getBonds", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("allBonds"))
                }
              } |
              // Peeks at effective bonds map (self-bond + delegated totals).
              contract PoS(@"getEffectiveBonds", returnCh) = {
                for (@state <<- stateCh) {
                  computeEffectiveBonds!(state, *returnCh)
                }
              } |
              // Peeks at delegator->validator mappings.
              contract PoS(@"getDelegations", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("delegations"))
                }
              } |
              contract PoS(@"getValidatorDelegators", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("validatorDelegators"))
                }
              } |
              // Peeks at delegated stake totals grouped by validator.
              contract PoS(@"getDelegatedTotals", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("delegatedTotals"))
                }
              } |
              // Peeks at accumulated delegator rewards.
              contract PoS(@"getDelegatorRewards", returnCh) = {
                for (@state <<- stateCh) {
                  new readDelegator in {
                    @ListOps!("fold", state.get("rewardCheckpoints").toList(), {}, *readDelegator, *returnCh) |
                    contract readDelegator(@(delegatorPk, _), @acc, resultCh) = {
                      new settledCh, totalCh, sumReward in {
                        settleDelegatorRewards!(state, delegatorPk, *settledCh) |
                        for (@settled <- settledCh) {
                          @ListOps!("fold", settled.get("delegatorRewards").getOrElse(delegatorPk, {}).toList(), 0n, *sumReward, *totalCh) |
                          contract sumReward(@(_, amount), @total, reply) = { reply!(total + amount) } |
                          for (@total <- totalCh) {
                            if (total > 0n) {
                              resultCh!(acc.set(delegatorPk, total))
                            } else {
                              resultCh!(acc)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Peeks at pending undelegation map.
              contract PoS(@"getPendingUndelegations", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("pendingUndelegations"))
                }
              } |
              // Peeks at active validator list.
              contract PoS(@"getActiveValidators", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("activeValidators"))
                }
              } |
              // Peeks at active validator list.
              contract PoS(@"getWithdrawers", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("withdrawers"))
                }
              } |
              contract PoS(@"getPendingWithdrawer", returnCh) = {
                for (@state <<- stateCh) {
                  returnCh!(state.get("pendingWithdrawers"))
                }
              } |
              // Exposes Coop multisig vault on returnCh.
              contract PoS(@"getCoopVault", returnCh) = {
                for (@(_, coopVault) <<- coopVaultCh) {
                  returnCh!((coopMultiVault, coopMultiVaultAddr, coopVaultHd))
                }
              } |
              // Exposes initial PoS vault on returnCh.
              contract PoS(@"getInitialPosVault", returnCh) = {
                returnCh!((posVaultAddr, posVault))
              } |
              // Exposes epochLength parameter to PoSTest.
              contract PoS(@"getEpochLength", returnCh) = {
                returnCh!($$epochLength$$)
              } |
              // Exposes quarantineLength parameter to PoSTest.
              contract PoS(@"getQuarantineLength", returnCh) = {
                returnCh!($$quarantineLength$$)
              } |
              // Exposes the protocol fault-tolerance threshold (parts-per-million).
              // This is a CONSENSUS-level value: every node reads it back at startup
              // and uses it for the finalized-floor / finality oracle, so the merge
              // base is node-identical regardless of local configuration.
              contract PoS(@"getFaultToleranceThresholdPpm", returnCh) = {
                returnCh!($$faultToleranceThresholdPpm$$)
              } |
              // Exposes the consensus-critical shard parameters as one tuple:
              // (maxParentDepth, deployLifespan, minPhloPrice). Validity rules
              // fork on divergence, so every node reads these back at startup
              // and runs them regardless of local configuration. Immutable
              // until an on-chain parameter-upgrade mechanism exists.
              contract PoS(@"getConsensusParameters", returnCh) = {
                returnCh!(($$maxParentDepth$$, $$deployLifespan$$, $$minPhloPrice$$))
              } |
              contract PoS(@"getMinimumBond", returnCh) = {
                returnCh!($$minimumBond$$n)
              } |
              // Exposes maximumBond parameter to PoSTest.
              contract PoS(@"getMaximumBond", returnCh) = {
                returnCh!($$maximumBond$$n)
              } |
              // Exposes numberOfActiveValidators parameter to PoSTest.
              contract PoS(@"getNumberOfActiveValidators", returnCh) = {
                returnCh!($$numberOfActiveValidators$$)
              } |
              contract PoS(@"getMaximumDelegatorsPerValidator", returnCh) = {
                maxDelegatorsPerValidator!(*returnCh)
              } |
              contract PoS(@"posVaultTransfer", @targetAddress, @amount, @deployerID, @transferRet) = {
                // human transfer would just use this method
                @humanControlHandle!("transfer", targetAddress, amount, deployerID, transferRet)
              } |
              // Public method allowing users to bond and become validators.
              contract PoS(@"bond", @deployerId, @amount, returnCh) = {
                new userCh, depositCh,
                    processCh
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh <- processCh &
                       @userPk          <- userCh) {
                    if (state.get("slashedValidators").contains(userPk)) {
                      resultCh!(state, (false, "Public key has been slashed."))
                    } else if (state.get("allBonds").contains(userPk)) {
                      resultCh!(state, (false, "Public key is already bonded."))
                    } else if (state.get("withdrawers").contains(userPk) or state.get("pendingWithdrawers").contains(userPk)) {
                      resultCh!(state, (false, "Public key is withdrawing."))
                    } else if (not amount.isBigInt()) {
                      resultCh!(state, (false, "Bond amount must be a BigInt."))
                    } else if (amount <= 0n) {
                      // Bug #5 fix: explicit positive-stake assertion. The
                      // Rocq invariant `active_implies_bonded` (T-9.5,
                      // BugFixStakeZero.v:36) requires every active
                      // validator to have a strictly positive bond. The
                      // earlier `amount < minimumBond` check covers this
                      // when minimumBond ≥ 1, but a defensive zero-stake
                      // gate makes the invariant explicit and independent
                      // of genesis configuration. See
                      // design/09-bug-fixes-and-rationale.md §9.6 (option a).
                      resultCh!(state, (false, "Bond amount must be positive."))
                    } else if (amount < $$minimumBond$$n) {
                      resultCh!(state, (false, "Bond is less than minimum!"))
                    } else if (amount > $$maximumBond$$n) {
                      resultCh!(state, (false, "Bond is greater than maximum!"))
                    } else {
                      // Transfers user's bond amount to the PoS vault.
                      deposit!(deployerId, amount, posVaultAddr, *depositCh) |
                      for (@depositResult <- depositCh) {
                        match depositResult {
                          // If deposit is successful, the user becomes a bonded validator.
                          (true, _) => {
                            resultCh!(state.set("allBonds", state.get("allBonds").set(userPk, amount)), depositResult)
                          }
                          // If deposit is unsuccessful, the user is not bonded.
                          (false, errorMsg) => {
                            resultCh!(state, (false, "Bond deposit failed: " ++ errorMsg))
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing users to delegate stake to an already bonded validator.
              contract PoS(@"delegate", @deployerId, @validatorPk, @amount, returnCh) = {
                new userCh, depositCh, processCh, settledCh in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh <- processCh &
                       @delegatorPk      <- userCh) {
                    if (not amount.isBigInt()) {
                      resultCh!(state, (false, "Delegation amount must be a BigInt."))
                    } else if (amount <= 0n) {
                      resultCh!(state, (false, "Delegation amount must be positive."))
                    } else if (amount < $$minimumBond$$n) {
                      resultCh!(state, (false, "Delegation is less than minimum."))
                    } else if (state.get("allBonds").contains(validatorPk) == false) {
                      resultCh!(state, (false, "Validator is not bonded."))
                    } else if (state.get("allBonds").getOrElse(validatorPk, 0n) <= 0n) {
                      resultCh!(state, (false, "Validator has no active bond."))
                    } else if (state.get("pendingWithdrawers").contains(validatorPk)) {
                      resultCh!(state, (false, "Validator is pending withdrawal."))
                    } else {
                      match state.get("allBonds").getOrElse(validatorPk, 0n) {
                        selfBond => {
                          match state.get("delegatedTotals").getOrElse(validatorPk, 0n) {
                            delegatedTotal => {
                              if (selfBond > $$maximumBond$$n) {
                                resultCh!(state, (false, "Delegation would exceed validator maximum effective bond."))
                              } else if (delegatedTotal > $$maximumBond$$n - selfBond) {
                                resultCh!(state, (false, "Delegation would exceed validator maximum effective bond."))
                              } else if (amount > $$maximumBond$$n - selfBond - delegatedTotal) {
                                resultCh!(state, (false, "Delegation would exceed validator maximum effective bond."))
                              } else {
                                new maxDelegatorsCh in {
                                  maxDelegatorsPerValidator!(*maxDelegatorsCh) |
                                  for (@maxDelegators <- maxDelegatorsCh) {
                                    match state.get("delegations").getOrElse(delegatorPk, {}).getOrElse(validatorPk, 0n) {
                                      previousDelegation => {
                                        match state.get("validatorDelegators").getOrElse(validatorPk, {}) {
                                          validatorDelegatorMap => {
                                            if (previousDelegation == 0n and validatorDelegatorMap.contains(delegatorPk) == false and validatorDelegatorMap.size() >= maxDelegators) {
                                              resultCh!(state, (false, "Validator delegator limit reached."))
                                            } else {
                                              deposit!(deployerId, amount, posVaultAddr, *depositCh) |
                                              for (@depositResult <- depositCh) {
                                                match depositResult {
                                                  (true, _) => {
                                                    settleDelegatorReward!(state, delegatorPk, validatorPk, *settledCh) |
                                                    for (@settledState <- settledCh) {
                                                      resultCh!(
                                                        settledState
                                                          .set("delegations",
                                                            settledState
                                                              .get("delegations")
                                                              .set(
                                                                delegatorPk,
                                                                settledState
                                                                  .get("delegations")
                                                                  .getOrElse(delegatorPk, {})
                                                                  .set(validatorPk, previousDelegation + amount)
                                                              )
                                                          )
                                                          .set(
                                                            "validatorDelegators",
                                                            settledState
                                                              .get("validatorDelegators")
                                                              .set(validatorPk, validatorDelegatorMap.set(delegatorPk, Nil))
                                                          )
                                                          .set(
                                                            "delegatedTotals",
                                                            settledState
                                                              .get("delegatedTotals")
                                                              .set(
                                                                validatorPk,
                                                                settledState.get("delegatedTotals").getOrElse(validatorPk, 0n) + amount
                                                              )
                                                          ),
                                                        (true, Nil)
                                                      )
                                                    }
                                                  }
                                                  (false, errorMsg) => {
                                                    resultCh!(state, (false, "Delegation deposit failed: " ++ errorMsg))
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing delegators to request stake undelegation.
              // Stake is removed from effective bonds immediately and becomes claimable after cooldown.
              contract PoS(@"undelegate", @deployerId, @validatorPk, @amount, returnCh) = {
                new userCh, processCh, blockDataCh,
                    getBlockData(`rho:block:data`)
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  getBlockData!(*blockDataCh) |
                  for (@state, resultCh <- processCh &
                       @delegatorPk      <- userCh &
                       @blockNumber, _, _ <- blockDataCh) {
                    if (not amount.isBigInt()) {
                      resultCh!(state, (false, "Undelegation amount must be a BigInt."))
                    } else if (amount <= 0n) {
                      resultCh!(state, (false, "Undelegation amount must be positive."))
                    } else if (state.get("pendingWithdrawers").contains(validatorPk)) {
                      resultCh!(state, (false, "Validator is pending withdrawal."))
                    } else if (state.get("pendingUndelegations").getOrElse(delegatorPk, {}).contains(validatorPk)) {
                      resultCh!(state, (false, "Pending undelegation already exists for validator."))
                    } else {
                      match state
                            .get("delegations")
                            .getOrElse(delegatorPk, {})
                            .getOrElse(validatorPk, 0n) {
                        delegatedAmount => {
                          if (delegatedAmount < amount) {
                            resultCh!(state, (false, "Undelegation amount exceeds delegated stake."))
                          } else {
                            new updatedDelegationsCh, updatedTotalsCh, updatedValidatorDelegatorsCh, settledCh in {
                              settleDelegatorReward!(state, delegatorPk, validatorPk, *settledCh) |
                              updateDelegationEntry!(
                                state.get("delegations"),
                                delegatorPk,
                                validatorPk,
                                delegatedAmount - amount,
                                *updatedDelegationsCh
                              ) |
                              updateDelegatedTotalEntry!(
                                state.get("delegatedTotals"),
                                validatorPk,
                                state.get("delegatedTotals").getOrElse(validatorPk, 0n) - amount,
                                *updatedTotalsCh
                              ) |
                              updateValidatorDelegatorEntry!(
                                state.get("validatorDelegators"),
                                validatorPk,
                                delegatorPk,
                                delegatedAmount - amount > 0n,
                                *updatedValidatorDelegatorsCh
                              ) |
                              for (@updatedDelegations <- updatedDelegationsCh &
                                   @updatedTotals      <- updatedTotalsCh &
                                   @updatedValidatorDelegators <- updatedValidatorDelegatorsCh &
                                   @settledState <- settledCh) {
                                resultCh!(
                                  settledState
                                    .set("pendingUndelegationTotal", state.get("pendingUndelegationTotal") + amount)
                                    .set("delegations", updatedDelegations)
                                    .set("validatorDelegators", updatedValidatorDelegators)
                                    .set("delegatedTotals", updatedTotals)
                                    .set(
                                      "pendingUndelegations",
                                      state
                                        .get("pendingUndelegations")
                                        .set(
                                          delegatorPk,
                                          state
                                            .get("pendingUndelegations")
                                            .getOrElse(delegatorPk, {})
                                            .set(validatorPk, (amount, $$quarantineLength$$ + $$epochLength$$ * (1 + blockNumber / $$epochLength$$)))
                                        )
                                    ),
                                  (true, Nil)
                                )
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing delegators to complete undelegation and transfer cooled principal back.
              contract PoS(@"completeUndelegate", @deployerId, @validatorPk, returnCh) = {
                new userCh, processCh, blockDataCh, vaultAddressCh, transferCh, invalidBlocksCh,
                    getBlockData(`rho:block:data`), getInvalidBlocks(`rho:casper:invalidBlocks`)
                in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  getBlockData!(*blockDataCh) |
                  getInvalidBlocks!(*invalidBlocksCh) |
                  for (@state, resultCh <- processCh &
                       @delegatorPk      <- userCh &
                       @blockNumber, _, _ <- blockDataCh &
                       @invalidBlocks     <- invalidBlocksCh) {
                    match state.get("pendingUndelegations").getOrElse(delegatorPk, {}).getOrElse(validatorPk, Nil) {
                      Nil => {
                        resultCh!(state, (false, "No pending undelegation for validator."))
                      }
                      (pendingAmount, unlockBlock) => {
                        if (blockNumber < unlockBlock) {
                          resultCh!(state, (false, "Undelegation cooldown not finished."))
                        } else {
                          new hasSlashEvidenceCh, containsSlashEvidence in {
                            contract containsSlashEvidence(@(_, offenderPk), @found, resultCh) = {
                              if (found) {
                                resultCh!(true)
                              } else {
                                resultCh!(offenderPk == validatorPk)
                              }
                            } |
                            match invalidBlocks {
                              Nil => {
                                hasSlashEvidenceCh!(false)
                              }
                              _ => {
                                @ListOps!("fold", invalidBlocks.toList(), false, *containsSlashEvidence, *hasSlashEvidenceCh)
                              }
                            } |
                            for (@hasSlashEvidence <- hasSlashEvidenceCh) {
                              if (hasSlashEvidence) {
                                resultCh!(state, (false, "Validator has pending slash evidence."))
                              } else {
                                vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
                                for (@toVaultAddress <- vaultAddressCh) {
                                  @posVault!("transfer", toVaultAddress, pendingAmount, posAuthKey, *transferCh) |
                                  for (@transferResult <- transferCh) {
                                    match transferResult {
                                      (true, _) => {
                                        match state.get("pendingUndelegations").getOrElse(delegatorPk, {}).delete(validatorPk) {
                                          updatedDelegatorPending => {
                                            if (updatedDelegatorPending.size() == 0) {
                                              resultCh!(state.set("pendingUndelegationTotal", state.get("pendingUndelegationTotal") - pendingAmount).set("pendingUndelegations", state.get("pendingUndelegations").delete(delegatorPk)), (true, Nil))
                                            } else {
                                              resultCh!(state.set("pendingUndelegationTotal", state.get("pendingUndelegationTotal") - pendingAmount).set("pendingUndelegations", state.get("pendingUndelegations").set(delegatorPk, updatedDelegatorPending)), (true, Nil))
                                            }
                                          }
                                        }
                                      }
                                      (false, errorMsg) => {
                                        resultCh!(state, (false, "Undelegation transfer failed: " ++ errorMsg))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing delegators to claim accumulated rewards.
              contract PoS(@"claimDelegatorRewards", @deployerId, returnCh) = {
                new userCh, processCh, vaultAddressCh, transferCh, settledCh in {
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getUser!(deployerId, *userCh) |
                  for (@originalState, resultCh <- processCh & @delegatorPk <- userCh) {
                    settleDelegatorRewards!(originalState, delegatorPk, *settledCh) |
                    for (@state <- settledCh) {
                      new rewardAmountCh, sumValidatorReward in {
                        @ListOps!("fold", state.get("delegatorRewards").getOrElse(delegatorPk, {}).toList(), 0n, *sumValidatorReward, *rewardAmountCh) |
                        contract sumValidatorReward(@(_, amount), @total, reply) = { reply!(total + amount) } |
                        for (@rewardAmount <- rewardAmountCh) {
                          if (rewardAmount <= 0n) {
                            resultCh!(state, (false, "No delegator rewards available."))
                          } else {
                            vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
                            for (@toVaultAddress <- vaultAddressCh) {
                              @posVault!("transfer", toVaultAddress, rewardAmount, posAuthKey, *transferCh) |
                              for (@transferResult <- transferCh) {
                                match transferResult {
                                  (true, _) => {
                                    new liabilitiesCh, debitValidator in {
                                      @ListOps!("fold", state.get("delegatorRewards").getOrElse(delegatorPk, {}).toList(), state.get("validatorRewardLiabilities"), *debitValidator, *liabilitiesCh) |
                                      contract debitValidator(@(validatorPk, amount), @liabilities, reply) = {
                                        reply!(liabilities.set(validatorPk, liabilities.getOrElse(validatorPk, 0n) - amount))
                                      } |
                                      for (@liabilities <- liabilitiesCh) {
                                        resultCh!(state
                                          .set("delegatorRewards", state.get("delegatorRewards").delete(delegatorPk))
                                          .set("validatorRewardLiabilities", liabilities)
                                          .set("delegatorRewardLiability", state.get("delegatorRewardLiability") - rewardAmount), (true, Nil))
                                      }
                                    }
                                  }
                                  (false, errorMsg) => {
                                    resultCh!(originalState, (false, "Delegator reward transfer failed: " ++ errorMsg))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } |
              // Public method allowing validators to withdraw their bonded and accumulated funds.
              contract PoS(@"withdraw", @deployerId, returnCh) = {
                new userCh, processCh, blockDataCh,
                    getBlockData(`rho:block:data`)
                in {
                  // Consumes state and updates withdrawers map.
                  runMVar!(*stateCh, *processCh, *returnCh) |
                  getBlockData!(*blockDataCh) |
                  getUser!(deployerId, *userCh) |
                  for (@state, resultCh   <- processCh &
                       @userPk            <- userCh &
                       @blockNumber, _, _ <- blockDataCh) {
                    if (state.get("allBonds").contains(userPk)) {
                      new movedDelegationsCh in {
                        moveDelegationsToPendingUndelegations!(state, userPk, $$quarantineLength$$ + $$epochLength$$ * (1 + blockNumber / $$epochLength$$), *movedDelegationsCh) |
                        for (@(updatedState, movedAmount) <- movedDelegationsCh) {
                          if (movedAmount != state.get("delegatedTotals").getOrElse(userPk, 0n)) {
                            resultCh!(state, (false, "Delegated total mismatch."))
                          } else {
                            // The withdrawal goes into effect at the start of the next epoch.
                            resultCh!(
                              updatedState
                                .set("validatorDelegators", state.get("validatorDelegators").delete(userPk))
                                .set("delegatedTotals", state.get("delegatedTotals").delete(userPk))
                                .set("pendingWithdrawers",
                                      state.get("pendingWithdrawers")
                                           .set(userPk,
                                             $$quarantineLength$$ + $$epochLength$$ * (1 + blockNumber / $$epochLength$$))),
                              (true, Nil))
                          }
                        }
                      }
                    } else {
                      resultCh!(state, (false, "User is not bonded"))
                    }
                  }
                }
              } |
              // Private method which charges a deployer for a deploy.
              // Deployer's funds are deposited into the block sender's vault.
              // Return expects (Boolean, Either[Nil, String])
              new currentDeployerData in {
                contract PoS(@"chargeDeploy", @deployerId, @amount, @sysAuthToken, return) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new depositCh in {
                          deposit!(deployerId, amount, posVaultAddr, *depositCh) |
                          for (@depositResult <- depositCh){
                            match depositResult {
                              (true, _) => {
                                currentDeployerData!((deployerId, amount)) |
                                return!(depositResult)
                              }
                              (_, errorMessage) => {
                                return!((false, "Deploy payment failed: " ++ errorMessage))
                              }
                            }
                          }
                        }
                      } else {
                        return!((false, "Invalid system auth token"))
                      }
                    }
                  }
                } |
                // Private method which refunds a deployer if too much was charged in chargeDeploy.
                // Funds are transferred from the block sender's vault to the deployer.
                // Return expects (Boolean, Either[Nil, String])
                contract PoS(@"refundDeploy", @refundAmount, @sysAuthToken, return) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        for (@(deployerId, initialPaymentAmount) <- currentDeployerData){
                          if (refundAmount > 0) {
                            new vaultAddressCh, transferCh in {
                              vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
                              for (@deployerVaultAddress <- vaultAddressCh) {
                                // Transfer (from sender to deployer) called in refundDeploy.
                                @posVault!("transfer", deployerVaultAddress, refundAmount, posAuthKey, *transferCh) |
                                for (@transferResult <- transferCh) {
                                  match transferResult {
                                    (true, _) => {
                                      return!((true, Nil))
                                    }
                                    (_, errorMessage) => {
                                      return!((false, "(Bug found) Deploy refund failed: " ++ errorMessage))
                                    }
                                  }
                                }
                              }
                            }
                          } else {
                            return!((true, Nil))
                          }
                        }
                      } else {
                        return!((false, "Invalid system auth token"))
                      }
                    }
                  }
                }
              } |
              new commitRewards in {
                // Private method which transfers all of a validator's rewards + bond to the Coop vault.
                // Slash expects (Boolean, Either[Nil, String]) on returnCh.
                contract PoS(@"slash", @deployerId, @blockHash, @sysAuthToken, returnCh) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new invalidBlocksCh, stateProcessCh, userCh, getInvalidBlocks(`rho:casper:invalidBlocks`) in {
                          getInvalidBlocks!(*invalidBlocksCh) |
                          getUser!(deployerId, *userCh) |
                          runMVar!(*stateCh, *stateProcessCh, *returnCh) |
                          for (@invalidBlocks <- invalidBlocksCh & @userPk <- userCh & @state, stateUpdateCh <- stateProcessCh) {
                            if (invalidBlocks.contains(blockHash)) {
                              match invalidBlocks.get(blockHash) {
                                validator => {
                                  new cleanedDelegationsCh, strippedPendingCh in {
                                    removeDelegationsForValidator!(state, validator, *cleanedDelegationsCh) |
                                    stripPendingUndelegationsForValidator!(state.get("pendingUndelegations"), validator, *strippedPendingCh) |
                                    for (@cleanedDelegations <- cleanedDelegationsCh & @(updatedPendingUndelegations, slashedPending) <- strippedPendingCh) {
                                      match (state.get("withdrawers").getOrElse(validator, (0n, 0)), state.get("validatorRewardLiabilities").getOrElse(validator, 0n)) {
                                        ((withdrawingBond, _), slashedRewards) => {
                                          match state.get("allBonds").getOrElse(validator, 0n) + withdrawingBond + state.get("delegatedTotals").getOrElse(validator, 0n) + slashedPending + state.get("committedRewards").getOrElse(validator, 0n) + slashedRewards {
                                            slashAmount => {
                                              new transferDoneCh in {
                                                if (slashAmount > 0n) {
                                                  @posVault!("transfer", coopMultiVaultAddr, slashAmount, posAuthKey, *transferDoneCh)
                                                } else { transferDoneCh!((true, Nil)) } |
                                                for (@transferResult <- transferDoneCh) {
                                                  match transferResult {
                                                    (true, _) => {
                                                      stateUpdateCh!(state
                                                        .set("allBonds", state.get("allBonds").delete(validator))
                                                        .set("slashedValidators", state.get("slashedValidators").add(validator))
                                                        .set("delegations", cleanedDelegations)
                                                        .set("validatorDelegators", state.get("validatorDelegators").delete(validator))
                                                        .set("delegatedTotals", state.get("delegatedTotals").delete(validator))
                                                        .set("activeValidators", state.get("activeValidators").delete(validator))
                                                        .set("committedRewards", state.get("committedRewards").delete(validator))
                                                        .set("rewardIndexes", state.get("rewardIndexes").delete(validator))
                                                        .set("validatorRewardLiabilities", state.get("validatorRewardLiabilities").delete(validator))
                                                        .set("delegatorRewardLiability", state.get("delegatorRewardLiability") - slashedRewards)
                                                        .set("withdrawers", state.get("withdrawers").delete(validator))
                                                        .set("pendingWithdrawers", state.get("pendingWithdrawers").delete(validator))
                                                        .set("pendingUndelegations", updatedPendingUndelegations)
                                                        .set("pendingUndelegationTotal", state.get("pendingUndelegationTotal") - slashedPending), (true, Nil))
                                                    }
                                                    (_, errorMessage) => {
                                                      stateUpdateCh!(state, (false, "Slash transfer failed: " ++ errorMessage))
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            } else { stateUpdateCh!(state, (false, "invalid slash evidence")) }
                          }
                        }
                      } else { returnCh!((false, "Invalid system auth token")) }
                    }
                  }
                } |
                // Private method which signals the end of block processing.
                contract PoS(@"closeBlock", @sysAuthToken, ackCh) = {
                  new isValidTokenCh in {
                    sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
                    for (@isValid <- isValidTokenCh) {
                      if (isValid) {
                        new blockDataCh, getBlockData(`rho:block:data`) in {
                          getBlockData!(*blockDataCh) |
                          for (@blockNumber, _, _ <- blockDataCh) {
                            if (blockNumber % $$epochLength$$ != 0) {
                              // Epoch change does not occur.
                              ackCh!((true, Nil))
                            } else {
                              // Epoch change occurs.
                              new payWithdrawer, removeQuarantinedWithdrawers,
                                  stateProcessCh, paymentDoneCh,
                                  accDepositsDoneCh, commitRewardsCh,
                                  newValidatorsCh, removeQuarantinedCh, currentEpochRewardCh, effectiveBondsCh,
                                  commitCurrentEpochRewards, updatedRewardsCh, movePendingWithdrawCh, movePendingWithdrawer
                              in {
                                runMVar!(*stateCh, *stateProcessCh, *ackCh) |
                                for (@state, stateUpdateCh <- stateProcessCh) {
                                  computeCurrentEpochRewards!(state, *currentEpochRewardCh) |
                                  for (@currentRewards <- currentEpochRewardCh) {
                                    // 1. Calculate all the validator current epoch rewards based on active validator bonding proportion
                                    // 2. Accumulate `committedRewards` with the result of step 1
                                    commitCurrentEpochRewards!(state, currentRewards, *updatedRewardsCh) |
                                    for (@newCommittedState <- updatedRewardsCh) {
                                      // 3. Update `withdrawers` according to `allBonds` and `pendingWithdrawers`
                                      // when pendingWithdrawers is not empty, remove the validator in `allBonds`
                                      movePendingWithdrawer!(newCommittedState, *movePendingWithdrawCh) |
                                      for (@newMovedPendingState <- movePendingWithdrawCh){
                                        // 4. When the block number reaches the quantinue of `withdrawers` ,
                                        //  transfer the corresponding bonds+ rewards to the corresponding validator from posVault.
                                        // 5. update `pendingWithdrawers` to empty Map {}.
                                        removeQuarantinedWithdrawers!(blockNumber, newMovedPendingState, *removeQuarantinedCh) |
                                        for (@newRemovedQuantinueState <- removeQuarantinedCh) {
                                          // 6. Pick new `activeValidators`
                                          // Uses effective bonds (self + active delegated stake). Pending undelegations
                                          // are excluded because they are no longer in delegatedTotals.
                                          computeEffectiveBonds!(newRemovedQuantinueState, *effectiveBondsCh) |
                                          for (@effectiveBonds <- effectiveBondsCh) {
                                            pickActiveValidators!(effectiveBonds.toList(), *newValidatorsCh) |
                                            for (@newValidators <- newValidatorsCh) {
                                              stateUpdateCh!(newRemovedQuantinueState.set("activeValidators", newValidators), (true, Nil))
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                } |
                                // Transfers withdrawing validator's bond + accumulated rewards from PoS vault to their vault.
                                contract payWithdrawer(@(pk, amount), returnCh) = {
                                  new vaultCh, vaultAddressCh, createCh in {
                                    vaultAddressOps!("fromPublicKey", pk, *vaultAddressCh) |
                                    for (@toVaultAddress <- vaultAddressCh) {
                                      @SystemVault!("findOrCreate", toVaultAddress, *createCh) |
                                      for (@_ <- createCh){
                                        @posVault!("transfer", toVaultAddress, amount, posAuthKey, *returnCh)
                                      }
                                    }
                                  }
                                } |
                                contract commitCurrentEpochRewards(@state, @currentRewards, returnCh) = {
                                  new accumulateValidator in {
                                    @ListOps!("fold", currentRewards.toList(), state, *accumulateValidator, *returnCh) |
                                    contract accumulateValidator(@(validatorPk, validatorReward), @updatedState, resultCh) = {
                                      match (updatedState.get("allBonds").getOrElse(validatorPk, 0n), updatedState.get("delegatedTotals").getOrElse(validatorPk, 0n)) {
                                        (selfBond, delegatedBond) => {
                                          match selfBond + delegatedBond {
                                            effectiveBond => {
                                              if (effectiveBond > 0n) {
                                                match (validatorReward * selfBond / effectiveBond, validatorReward * delegatedBond / effectiveBond) {
                                                  (validatorShare, delegatorShare) => {
                                                    new indexCh in {
                                                      if (delegatedBond > 0n) {
                                                        indexCh!(updatedState.get("rewardIndexes").getOrElse(validatorPk, 0n) + delegatorShare * ($$maximumBond$$n * 1000000000000000000n) / delegatedBond)
                                                      } else {
                                                        indexCh!(updatedState.get("rewardIndexes").getOrElse(validatorPk, 0n))
                                                      } |
                                                      for (@nextIndex <- indexCh) {
                                                        resultCh!(updatedState
                                                          .set("committedRewards", updatedState.get("committedRewards").set(validatorPk,
                                                            updatedState.get("committedRewards").getOrElse(validatorPk, 0n) + validatorShare))
                                                          .set("rewardIndexes", updatedState.get("rewardIndexes").set(validatorPk, nextIndex))
                                                          .set("validatorRewardLiabilities", updatedState.get("validatorRewardLiabilities").set(validatorPk,
                                                            updatedState.get("validatorRewardLiabilities").getOrElse(validatorPk, 0n) + delegatorShare))
                                                          .set("delegatorRewardLiability", updatedState.get("delegatorRewardLiability") + delegatorShare))
                                                      }
                                                    }
                                                  }
                                                }
                                              } else {
                                                resultCh!(updatedState)
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                } |
                                contract movePendingWithdrawer(@state, returnCh) = {
                                  new movePending in {
                                    @ListOps!("fold", state.get("pendingWithdrawers").toList(), state, *movePending, *returnCh) |
                                    contract movePending(@(pk, quantine), @updatedState, resultCh) = {
                                      resultCh!(updatedState
                                                .set("withdrawers", updatedState.get("withdrawers").set(pk, (updatedState.get("allBonds").get(pk), quantine)))
                                                .set("allBonds", updatedState.get("allBonds").delete(pk))
                                                .set("pendingWithdrawers", updatedState.get("pendingWithdrawers").delete(pk))
                                                )
                                    }
                                  }
                                } |
                                // Checks withdrawer's quarantine period against current block number,
                                // then computes their payment, removes them from the bonds and withdrawers maps, and
                                // updates the committed rewards map.
                                contract removeQuarantinedWithdrawers(@currentBlockNumber, @state, returnCh) = {
                                  new quarantinedValidatorsCh, validatorsToWithdrawListCh,
                                      isQuarantineFinished, notWithdrawn, payWithdraw,
                                      newBondsListCh, newWithdrawersListCh,
                                      computeRemove, payRet
                                  in {
                                    // Calculate rewards by taking PoS balance on PoS vault and subtract all active stake + newly bonded
                                    @ListOps!("filter", state.get("withdrawers").toList(), *isQuarantineFinished, *quarantinedValidatorsCh) |
                                    for (@quarantinedValidators <- quarantinedValidatorsCh) {
                                      @ListOps!("unorderedParMap", quarantinedValidators, *payWithdraw, *payRet) |
                                      // Bug #10 fix: pattern-match on the transfer outcome and emit
                                      // (pk, success_bool) on resultCh. The downstream `computeRemove`
                                      // fold then removes ONLY successful withdrawers from the maps;
                                      // failed transfers leave the per-validator state intact for
                                      // retry on a later block. Pre-fix the resultCh just forwarded
                                      // posVault.transfer's (true, _) | (false, errMsg) pair, and the
                                      // surrounding `for (@_ <- payRet)` accepted any value, so a
                                      // failed transfer would still drop the validator from
                                      // `withdrawers` and `committedRewards` — losing funds. See
                                      // design/09-bug-fixes-and-rationale.md §9.13
                                      // (theorem t_9_10_withdraw_transfer_failure_safety,
                                      // formal/rocq/slashing/theories/BugFixWithdrawTransferFailure.v).
                                      contract payWithdraw(@(pk, (bonds, quantine)), resultCh) = {
                                        new transferResultCh in {
                                          payWithdrawer!((pk, bonds.toBigInt() + state.get("committedRewards").getOrElse(pk, 0n)), *transferResultCh) |
                                          for (@transferResult <- transferResultCh) {
                                            match transferResult {
                                              (true, _) => { resultCh!((pk, true)) }
                                              (_, _)    => { resultCh!((pk, false)) }
                                            }
                                          }
                                        }
                                      } |
                                      for (@payResults <- payRet) {
                                        @ListOps!("fold", payResults, state, *computeRemove, *returnCh) |
                                        contract computeRemove(@(pk, success), @updatedState, resultCh) = {
                                          if (success) {
                                            resultCh!(updatedState
                                                      .set("committedRewards", updatedState.get("committedRewards").delete(pk))
                                                      .set("withdrawers", updatedState.get("withdrawers").delete(pk))
                                                      )
                                          } else {
                                            // Failure path: leave per-validator state intact so the
                                            // outer scheduler retries on a later block. The validator
                                            // remains in `withdrawers` with their original (bond,
                                            // quarantine) entry and unchanged `committedRewards`.
                                            resultCh!(updatedState)
                                          }
                                        }
                                      }
                                    } |
                                    // Check whether quarantine period is finished.
                                    contract isQuarantineFinished(@(pk, (bonds, blockNumber)), resultCh) = {
                                      resultCh!(currentBlockNumber >= blockNumber)
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      } else {
                        ackCh!((false, "Invalid system auth token"))
                      }
                    }
                  }
                }
              } |
              //
              contract PoS(@"commitRandomImage", @deployerId, @hash, ackCh) = {
                new userCh, mvarCh in {
                  getUser!(deployerId, *userCh) |
                  runMVar!(*stateCh, *mvarCh, *ackCh) |
                  for (@validator       <- userCh &
                       @state, resultCh <- mvarCh) {
                    if (state.get("randomImages").contains(validator)) {
                      resultCh!(state, (false, "Image already committed"))
                    } else {
                      resultCh!(
                        state.set("randomImages", state.get("randomImages").set(validator, hash)), true)
                    }
                  }
                }
              } |
              //
              contract PoS(@"revealRandom", @deployerId, @random, ackCh) = {
                new userCh, mvarCh, computeHash(`rho:crypto:keccak256Hash`), hashCh in {
                  getUser!(deployerId, *userCh) |
                  runMVar!(*stateCh, *mvarCh, *ackCh) |
                  computeHash!(random, *hashCh) |
                  for (@validator       <- userCh &
                       @state, resultCh <- mvarCh &
                       @hash            <- hashCh) {
                    if (state.get("randomImages").contains(validator)) {
                      if (hash == state.get("randomImages").get(validator)) {
                        resultCh!(
                          state.set("randomNumbers",state.get("randomNumbers").set(validator, random)), true)
                      } else {
                        resultCh!(state, (false, "Previously committed image doesn't match the random number"))
                      }
                    } else {
                      resultCh!(state, (false, "Previously committed random image not found"))
                    }
                  }
                }
              }
            }
          }
        } |
        // Transfers funds from deployer to block sender.
        contract deposit(@deployerId, @amount, @toTargetAddress, returnCh) = {
          new vaultCh, vaultAddressCh,
              indexSender, authKeyCh
          in {
            @SystemVault!("deployerAuthKey", deployerId, *authKeyCh) |
            vaultAddressOps!("fromDeployerId", deployerId, *vaultAddressCh) |
            for (@authKey        <- authKeyCh &
                 @fromVaultAddress <- vaultAddressCh) {
              @SystemVault!("findOrCreate", fromVaultAddress, *vaultCh) |
              for (@(true, fromVault) <- vaultCh) {
                // Transfers from deployer to PoS vault
                @fromVault!("transfer", toTargetAddress, amount, authKey, *returnCh)
              }
            }
          }
        }
      } |
      // Updates value stored on varCh and sends (Bool) acknowledgement on returnCh.
      contract runMVar(varCh, processCh, returnCh) = {
        new resultCh in {
          for (@v <- varCh) {
            processCh!(v, *resultCh) |
            for (@newV, @result <- resultCh) {
              varCh!(newV) |
              returnCh!(result)
            }
          }
        }
      } |
      // Discards second element of a pair.
      contract fst(@(first, _), resultCh) = {
        resultCh!(first)
      } |
      // For computing some of initial validator bonds.
      contract sumFromPair(@(_, a), @b, resultCh) = {
        resultCh!(a + b)
      } |
      // Retrieves deployer's public key.
      contract getUser(@deployerId, returnCh) = {
        new deployerIdOps(`rho:system:deployerId:ops`) in {
          deployerIdOps!("pubKeyBytes", deployerId, *returnCh)
        }
      } |
      // Selects set of active validators from the set of available validators.
      contract pickActiveValidators(@allBonds, returnCh) = {
        new availableValidatorsCh,
            isAvailable, pksCh
        in {
          @ListOps!("map", allBonds, *fst, *pksCh) |
          for (@pks <- pksCh) {
            // TODO: Randomly select 100 active validators once we have on-chain randomness
            returnCh!(pks.take($$numberOfActiveValidators$$).toSet())
          }
        }
      }
    }
    }|
    // Registers signed write-only PoS contract bundle.
    rs!(
      "047b43d6548b72813b89ac1b9f9ca67624a8b372feedd71d4e2da036384a3e1236812227e524e6f237cde5f80dbb921cac12e6500791e9a9ed1254a745a816fe1f".hexToBytes(),
      (9223372036854775807, bundle+{*PoS}),
      "3045022100cd1a32e04e21deb1bb3cd108cb0a3ab1357495f6ad99dfeb08eb17eaa082d388022015a9c5f9cd3b489a1fe3e359dbfe791ddd7d66e8a9a1dfb4978c980128c53f69".hexToBytes(),
      *uriOut)
  }
}
