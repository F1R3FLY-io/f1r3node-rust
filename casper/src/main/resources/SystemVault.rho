/*
 The table below describes the required computations and their dependencies

 No. | Dependency | Computation method | Result
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 1.  |            | given              | sk = 27e5718bf55dd673cc09f13c2bcf12ed7949b178aef5dcb6cd492ad422d05e9d
 2.  |            | given              | timestamp = 1559156183943
 3.  |            | lastNonce          | nonce = 9223372036854775807
 4.  | 1,         | secp256k1          | pk = 040f035630a5d2199184890b4b6b83440c842da0b6becca539f788f7b35d6e873561f673cd6ebe2e32236398a86f29dad992e8fba32534734300fcc5104bcfea0e
 5.  | 2, 4, 3,   | registry           | value = (1559156183943, 040f035630a5d2199184890b4b6b83440c842da0b6becca539f788f7b35d6e873561f673cd6ebe2e32236398a86f29dad992e8fba32534734300fcc5104bcfea0e, 9223372036854775807)
 6.  | 5,         | protobuf           | toSign = 2a65aa01620a092a07108ece9acfe05a0a462a44ca0141040f035630a5d2199184890b4b6b83440c842da0b6becca539f788f7b35d6e873561f673cd6ebe2e32236398a86f29dad992e8fba32534734300fcc5104bcfea0e0a0d2a0b10feffffffffffffffff01
 7.  | 6, 1,      | secp256k1          | sig = 3045022100c58cd73cd1a5c153d4edb3fc6e48aa2344c549a9225bde3def9b98c35e44399902205c3b615a1f19b8b2de23aecfea24dea30ae96eecd5f8bda1c125f47cb92a08d2
 8.  | 4,         | registry           | uri = rho:id:6zcfqnwnaqcwpeyuysx1rm48ndr6sgsbbgjuwf45i5nor3io7dr76j
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 */
new
  SystemVault, rs(`rho:registry:insertSigned:secp256k1`), uriOut,
  rl(`rho:registry:lookup`), VaultAddress(`rho:vault:address`),
  MakeMintCh, AuthKeyCh, EitherCh, TreeHashMapCh,
  _makeVault,
  _newVault,
  _create,
  _systemVault,
  _transferTemplate,
  _depositTemplate,
  reserveAll,
  refundReserved,
  failReservation,
  validateSettlement,
  settleReserved,
  splitAndDeposit,
  prepareTransferBatch,
  depositTransferBatch,
  protocolStakeDispositionStore
in {
  rl!(`rho:system:makeMint`, *MakeMintCh) |
  rl!(`rho:system:authKey`, *AuthKeyCh) |
  rl!(`rho:lang:either`, *EitherCh) |
  rl!(`rho:lang:treeHashMap`, *TreeHashMapCh) |
  for (@(_, MakeMint) <- MakeMintCh &
       @(_, AuthKey)  <- AuthKeyCh &
       @(_, Either)   <- EitherCh &
       TreeHashMap    <- TreeHashMapCh) {
    // Each invocation of the SystemVault contract uses a different mint.
    new mintCh, vaultMapStore, initVault in {
      // Initializes the vaultMapStore.
      TreeHashMap!("init", 2, *vaultMapStore) |
      protocolStakeDispositionStore!({}) |
      for (@vaultMap <- vaultMapStore) {
        // Called from VaultsGenerator:
        //   SystemVault!("init", *ret)
        new initContinue in {
          // System vault initialization in genesis is done in batches.
          // In the last batch `initContinue` channel will not receive
          // anything so further access to `SystemVault(@"init", _)` is impossible.
          initContinue!() |
          contract SystemVault(@"init", ret) = {
            for (<- initContinue) {
              ret!(*TreeHashMap, vaultMap, *initVault, *initContinue)
            }
          }
        } |
        @MakeMint!(*mintCh) |
        for (mint <- mintCh) {
          // Initializes a vault with given name, address, and purse containing the amount.
          contract initVault(name, @address, @initialGeneralAmount, @initialValidatorFuelAmount) = {
            new generalPurseCh, validatorFuelPurseCh in {
              mint!("makePurse", initialGeneralAmount, *generalPurseCh) |
              mint!("makePurse", initialValidatorFuelAmount, *validatorFuelPurseCh) |
              for (generalPurse <- generalPurseCh & validatorFuelPurse <- validatorFuelPurseCh) {
                _newVault!(*name, address, *generalPurse, *validatorFuelPurse)
              }
            }
          } |

          contract SystemVault(@"deployerAuthKey", deployerId, ret) = {
            new VaultAddress(`rho:vault:address`), DeployerIdOps(`rho:system:deployerId:ops`),
                vaultAddrCh, deployerPubKeyBytesCh
            in {
              DeployerIdOps!("pubKeyBytes", *deployerId, *deployerPubKeyBytesCh) |
              for (@deployerPubKeyBytes <- deployerPubKeyBytesCh) {
                VaultAddress!("fromPublicKey", deployerPubKeyBytes, *vaultAddrCh) |
                for (@deployerVaultAddress <- vaultAddrCh) {
                  @AuthKey!("make", (*_systemVault, deployerVaultAddress), *ret)
                }
              }
            }
          } |
          // Creates authKey from System vault name.
          contract SystemVault(@"unforgeableAuthKey", unf, ret) = {
            new VaultAddress(`rho:vault:address`), vaultAddrCh in {
              VaultAddress!("fromUnforgeable", *unf, *vaultAddrCh) |
              for (@unfVaultAddress <- vaultAddrCh) {
                @AuthKey!("make", (*_systemVault, unfVaultAddress), *ret)
              }
            }
          } |
          contract SystemVault(@"find", @vaultAddress, retCh) = {
            new vaultAddressValidCh, vaultAddressValidEitherCh in {
              VaultAddress!("validate", vaultAddress, *vaultAddressValidCh) |
              @Either!("fromNillableError <-", *vaultAddressValidCh, *vaultAddressValidEitherCh) |
              for (@vaultAddressEither <- vaultAddressValidEitherCh) {
                match vaultAddressEither {
                  (false, _) => {
                    retCh!(vaultAddressEither)
                  }
                  _ => {
                    new getVaultCh in {
                      TreeHashMap!("get", vaultMap, vaultAddress, *getVaultCh) |
                      for (@vault <- getVaultCh) {
                        if (vault == Nil) {
                          retCh!((false, "Vault not found"))
                        } else {
                          retCh!((true, vault))
                        }
                      }
                    }
                  }
                }
              }
            }
          } |
          contract SystemVault(@"applyCost", @reservationId, @allocations, @charges, @feeAddress, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid) {
                  new reserveCh in {
                    reserveAll!(allocations, [], *reserveCh) |
                    for (@reserveResult <- reserveCh) {
                      match reserveResult {
                        (true, reserved) => {
                          new validationCh in {
                            validateSettlement!(reserved, charges, *validationCh) |
                            for (@validationResult <- validationCh) {
                              match validationResult {
                                (false, error) => {
                                  failReservation!(reserved, error, *retCh)
                                }
                                _ => {
                                  new feeVaultCh in {
                                    SystemVault!("findOrCreate", feeAddress, *feeVaultCh) |
                                    for (@feeVaultResult <- feeVaultCh) {
                                      match feeVaultResult {
                                        (false, error) => {
                                          failReservation!(reserved, error, *retCh)
                                        }
                                        _ => {
                                          settleReserved!(reserved, charges, feeAddress, *retCh)
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                        (false, error) => {
                          retCh!((false, error))
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized cost application"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolMint", @targetAddress, @amount, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid and amount > 0) {
                  new targetVaultCh in {
                    SystemVault!("findOrCreate", targetAddress, *targetVaultCh) |
                    for (@targetResult <- targetVaultCh) {
                      match targetResult {
                        (true, _) => {
                          new mintedPurseCh, depositCh in {
                            mint!("makePurse", amount, *mintedPurseCh) |
                            for (@mintedPurse <- mintedPurseCh) {
                              @{targetAddress | bundle0{*_systemVault}}!("_costDeposit", "General", mintedPurse, *depositCh) |
                              for (@depositResult <- depositCh) {
                                retCh!(depositResult)
                              }
                            }
                          }
                        }
                        (false, error) => {
                          retCh!((false, error))
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized or invalid protocol mint"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolMintValidatorFuel", @validatorPk, @amount, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid and amount > 0) {
                  new targetAddressCh in {
                    VaultAddress!("fromPublicKey", validatorPk, *targetAddressCh) |
                    for (@targetAddress <- targetAddressCh) {
                      new targetVaultCh in {
                        SystemVault!("findOrCreate", targetAddress, *targetVaultCh) |
                        for (@targetResult <- targetVaultCh) {
                          match targetResult {
                            (true, _) => {
                              new mintedPurseCh, depositCh in {
                                mint!("makePurse", amount, *mintedPurseCh) |
                                for (@mintedPurse <- mintedPurseCh) {
                                  @{targetAddress | bundle0{*_systemVault}}!("_costDeposit", "ValidatorFuel", mintedPurse, *depositCh) |
                                  for (@depositResult <- depositCh) {
                                    retCh!(depositResult)
                                  }
                                }
                              }
                            }
                            (false, error) => {
                              retCh!((false, error))
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized or invalid validator fuel mint"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolBurn", @targetAddress, @amount, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid and amount >= 0) {
                  if (amount == 0) {
                    retCh!((true, Nil))
                  } else {
                    new targetVaultCh in {
                      SystemVault!("find", targetAddress, *targetVaultCh) |
                      for (@targetResult <- targetVaultCh) {
                        match targetResult {
                          (true, _) => {
                            new splitCh in {
                              @{targetAddress | bundle0{*_systemVault}}!("_costSplit", "General", amount, *splitCh) |
                              for (@splitResult <- splitCh) {
                                match splitResult {
                                  [_] => { retCh!((true, Nil)) }
                                  _ => { retCh!((false, "Protocol burn failed")) }
                                }
                              }
                            }
                          }
                          (false, error) => { retCh!((false, error)) }
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized or invalid protocol burn"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolQuarantineValidatorFuel", @validatorPk, @generation, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid) {
                  new targetAddressCh in {
                    VaultAddress!("fromPublicKey", validatorPk, *targetAddressCh) |
                    for (@targetAddress <- targetAddressCh) {
                      new vaultCh in {
                        SystemVault!("find", targetAddress, *vaultCh) |
                        for (@vaultResult <- vaultCh) {
                          match vaultResult {
                            (true, _) => {
                              new quarantineCh in {
                                @{targetAddress | bundle0{*_systemVault}}!("_quarantineValidatorFuel", generation, *quarantineCh) |
                                for (@quarantineResult <- quarantineCh) {
                                  retCh!(quarantineResult)
                                }
                              }
                            }
                            (false, error) => {
                              retCh!((false, error))
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized validator fuel quarantine"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolApplyStakeDisposition", @validatorPk, @generation, @sourceAddress, @outcome, @penaltyAddress, @amount, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid) {
                  for (@dispositions <- protocolStakeDispositionStore) {
                    new applyCh in {
                      match dispositions.get(validatorPk) {
                        Nil => { applyCh!(Nil) }
                        (storedGeneration, storedSource, storedOutcome, storedPenaltyAddress, storedAmount) => {
                          if (
                            storedGeneration == generation and
                            storedSource == sourceAddress and
                            storedOutcome == outcome and
                            storedPenaltyAddress == penaltyAddress and
                            storedAmount == amount
                          ) {
                            protocolStakeDispositionStore!(dispositions) |
                            retCh!((true, Nil))
                          } else if (generation > storedGeneration) {
                            applyCh!(Nil)
                          } else {
                            protocolStakeDispositionStore!(dispositions) |
                            retCh!((false, "Conflicting protocol stake disposition"))
                          }
                        }
                        _ => {
                          protocolStakeDispositionStore!(dispositions) |
                          retCh!((false, "Malformed protocol stake disposition"))
                        }
                      } |
                      for (_ <- applyCh) {
                        match outcome {
                          "Vindicated" => {
                            if (amount == 0) {
                              protocolStakeDispositionStore!(dispositions.set(
                                validatorPk,
                                (generation, sourceAddress, outcome, penaltyAddress, amount)
                              )) |
                              retCh!((true, Nil))
                            } else {
                              protocolStakeDispositionStore!(dispositions) |
                              retCh!((false, "Vindication cannot move stake"))
                            }
                          }
                          "Guilty" => {
                            if (amount < 0) {
                              protocolStakeDispositionStore!(dispositions) |
                              retCh!((false, "Invalid guilty stake disposition"))
                            } else if (amount == 0) {
                              protocolStakeDispositionStore!(dispositions.set(
                                validatorPk,
                                (generation, sourceAddress, outcome, penaltyAddress, amount)
                              )) |
                              retCh!((true, Nil))
                            } else {
                              new sourceVaultCh, penaltyVaultCh in {
                                SystemVault!("find", sourceAddress, *sourceVaultCh) |
                                SystemVault!("find", penaltyAddress, *penaltyVaultCh) |
                                for (@sourceVaultResult <- sourceVaultCh & @penaltyVaultResult <- penaltyVaultCh) {
                                  match (sourceVaultResult, penaltyVaultResult) {
                                    ((true, _), (true, _)) => {
                                      new splitCh in {
                                        @{sourceAddress | bundle0{*_systemVault}}!("_costSplit", "General", amount, *splitCh) |
                                        for (@splitResult <- splitCh) {
                                          match splitResult {
                                            [penaltyPurse] => {
                                              new depositCh in {
                                                @{penaltyAddress | bundle0{*_systemVault}}!("_costDeposit", "General", penaltyPurse, *depositCh) |
                                                for (@depositResult <- depositCh) {
                                                  match depositResult {
                                                    (true, _) => {
                                                      protocolStakeDispositionStore!(dispositions.set(
                                                        validatorPk,
                                                        (generation, sourceAddress, outcome, penaltyAddress, amount)
                                                      )) |
                                                      retCh!((true, Nil))
                                                    }
                                                    (false, error) => {
                                                      protocolStakeDispositionStore!(dispositions) |
                                                      retCh!((false, error))
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            _ => {
                                              protocolStakeDispositionStore!(dispositions) |
                                              retCh!((false, "Stake penalty split failed"))
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {
                                      protocolStakeDispositionStore!(dispositions) |
                                      retCh!((false, "Stake disposition vault not found"))
                                    }
                                  }
                                }
                              }
                            }
                          }
                          "Burned" => {
                            if (amount < 0) {
                              protocolStakeDispositionStore!(dispositions) |
                              retCh!((false, "Invalid burned stake disposition"))
                            } else if (amount == 0) {
                              protocolStakeDispositionStore!(dispositions.set(
                                validatorPk,
                                (generation, sourceAddress, outcome, penaltyAddress, amount)
                              )) |
                              retCh!((true, Nil))
                            } else {
                              new sourceVaultCh in {
                                SystemVault!("find", sourceAddress, *sourceVaultCh) |
                                for (@sourceVaultResult <- sourceVaultCh) {
                                  match sourceVaultResult {
                                    (true, _) => {
                                      new splitCh in {
                                        @{sourceAddress | bundle0{*_systemVault}}!("_costSplit", "General", amount, *splitCh) |
                                        for (@splitResult <- splitCh) {
                                          match splitResult {
                                            [_] => {
                                              protocolStakeDispositionStore!(dispositions.set(
                                                validatorPk,
                                                (generation, sourceAddress, outcome, penaltyAddress, amount)
                                              )) |
                                              retCh!((true, Nil))
                                            }
                                            _ => {
                                              protocolStakeDispositionStore!(dispositions) |
                                              retCh!((false, "Stake burn split failed"))
                                            }
                                          }
                                        }
                                      }
                                    }
                                    (false, error) => {
                                      protocolStakeDispositionStore!(dispositions) |
                                      retCh!((false, error))
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => {
                            protocolStakeDispositionStore!(dispositions) |
                            retCh!((false, "Unknown protocol stake disposition"))
                          }
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized protocol stake disposition"))
                }
              }
            }
          } |
          contract SystemVault(@"protocolResolveValidatorFuel", @validatorPk, @generation, @outcome, @penaltyAddress, @penalty, @sysAuthToken, retCh) = {
            new sysAuthTokenOps(`sys:authToken:ops`), isValidTokenCh in {
              sysAuthTokenOps!("check", sysAuthToken, *isValidTokenCh) |
              for (@isValid <- isValidTokenCh) {
                if (isValid) {
                  new targetAddressCh in {
                    VaultAddress!("fromPublicKey", validatorPk, *targetAddressCh) |
                    for (@targetAddress <- targetAddressCh) {
                      new targetVaultCh in {
                        SystemVault!("find", targetAddress, *targetVaultCh) |
                        for (@targetVaultResult <- targetVaultCh) {
                          match targetVaultResult {
                            (true, _) => {
                              new resolveFuel in {
                                contract resolveFuel() = {
                                  new resolveCh in {
                                    @{targetAddress | bundle0{*_systemVault}}!(
                                      "_resolveValidatorFuel",
                                      generation,
                                      outcome,
                                      penaltyAddress,
                                      penalty,
                                      *resolveCh
                                    ) |
                                    for (@resolveResult <- resolveCh) {
                                      retCh!(resolveResult)
                                    }
                                  }
                                } |
                                if (outcome == "Guilty") {
                                  new penaltyVaultCh in {
                                    SystemVault!("findOrCreate", penaltyAddress, *penaltyVaultCh) |
                                    for (@penaltyVaultResult <- penaltyVaultCh) {
                                      match penaltyVaultResult {
                                        (true, _) => { resolveFuel!() }
                                        (false, error) => { retCh!((false, error)) }
                                      }
                                    }
                                  }
                                } else {
                                  resolveFuel!()
                                }
                              }
                            }
                            (false, error) => {
                              retCh!((false, error))
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  retCh!((false, "Unauthorized validator fuel resolution"))
                }
              }
            }
          } |
          // Either retrieves or creates corresponding System vault either.
          contract SystemVault(@"findOrCreate", @vaultAddress, retCh) = {
            new vaultAddressValidCh, vaultAddressValidEitherCh in {
              // Validate Vault address first.
              VaultAddress!("validate", vaultAddress, *vaultAddressValidCh) |
              @Either!("fromNillableError <-", *vaultAddressValidCh, *vaultAddressValidEitherCh) |
              for (@vaultAddressEither <- vaultAddressValidEitherCh) {
                match vaultAddressEither {
                  // Invalid Vault address returns Left.
                  (false, _) => {
                    retCh!(vaultAddressEither)
                  }
                  // Valid Vault address returns Right and we proceed with creation/search.
                  _ => {
                    new createVault, vaultCh, getVaultCh in {
                      TreeHashMap!("get", vaultMap, vaultAddress, *getVaultCh) |
                      for (@vault <- getVaultCh) {
                        if (vault != Nil) {
                          // If vault is in the store, return (true, vault).
                          retCh!((true, vault))
                        } else {
                          // If vault was not found in store, create it and put it in the store.
                          _create!(vaultAddress, *createVault, *vaultCh) |
                          for (vaultRetCh <- createVault) {
                            // Creates System vault and returns on vaultRetCh, consumed within _create contract.
                            _makeVault!(vaultAddress, 0, 0, *vaultRetCh) |
                            // Blocks until both the vault is created and set in the store.
                            for (@eitherVault <- vaultCh) {
                              retCh!(eitherVault)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          } |
          // Used during genesis to create PoS vault with initial balance = sum of initial bonds.
          // Can only be used to create the PoS vault, i.e. Vault address = "1111gW5kkGxHg7xDg6dRkZx2f7qxTizJzaCH9VEM1oJKWRvSX9Sk5".
          for (@"createWithBalance", @"1111gW5kkGxHg7xDg6dRkZx2f7qxTizJzaCH9VEM1oJKWRvSX9Sk5", @amount, retCh <- SystemVault) {
            new createVault, vaultCh in {
              _create!("1111gW5kkGxHg7xDg6dRkZx2f7qxTizJzaCH9VEM1oJKWRvSX9Sk5", *createVault, *vaultCh) |
              for (vaultRetCh <- createVault) {
                _makeVault!("1111gW5kkGxHg7xDg6dRkZx2f7qxTizJzaCH9VEM1oJKWRvSX9Sk5", amount, 0, *vaultRetCh) |
                for (@eitherVault <- vaultCh) {
                  retCh!(eitherVault)
                }
              }
            }
          } |
          // Retrieves vault corresponding to vaultAddress if one exists, creates a vault otherwise.
          // Returns either (true, vault) or (false, _) on retCh.
          contract _create(@vaultAddress, constructor, retCh) = {
            // The vault was not found, create a new one and set it in the vaultMap.
            new resCh, ackCh in {
              constructor!(*resCh) |
              for (@eitherVault <- resCh) {
                match eitherVault {
                  (true, vault) => {
                    TreeHashMap!("set", vaultMap, vaultAddress, vault, *ackCh) |
                    for (_ <- ackCh) {
                      retCh!(eitherVault)
                    }
                  }
                  (false, _)    => {
                    retCh!(eitherVault)
                  }
                }
              }
            }
          } |
          // Creates a System vault and returns Either on ret.
          contract _makeVault(@ownerVaultAddress, @initialGeneralAmount, @initialValidatorFuelAmount, ret) = {
            new generalPurseCh, validatorFuelPurseCh in {
              mint!("makePurse", initialGeneralAmount, *generalPurseCh) |
              mint!("makePurse", initialValidatorFuelAmount, *validatorFuelPurseCh) |
              for (generalPurse <- generalPurseCh & validatorFuelPurse <- validatorFuelPurseCh) {
                new systemVault in {
                  _newVault!(*systemVault, ownerVaultAddress, *generalPurse, *validatorFuelPurse) |
                  ret!((true, bundle+{*systemVault}))
                }
              }
            }
          } |
          // Supplies balance, transfer, and setLog methods on systemVault.
          contract _newVault(systemVault, @ownVaultAddress, purse, validatorFuelPurse) = {
            new logStore, validatorFuelState in {
              logStore!(Nil) |
              validatorFuelState!(("Available", -1, "", "", 0, Nil)) |
              contract systemVault(@"balance", ret) = {
                purse!("getBalance", *ret)
              } |
              contract systemVault(@"validatorFuelBalance", ret) = {
                validatorFuelPurse!("getBalance", *ret)
              } |
              // Transfers from systemVault to toVaultAddress.
              contract systemVault(@"transfer", @targetAddress, @amount, authKey, ret) = {
                new ret2 in {
                  _transferTemplate!(ownVaultAddress, *purse, targetAddress, amount, *authKey, *ret2) |
                  for (@result <- ret2) {
                    ret!(result) |
                    for (logCh <<- logStore) {
                      if (Nil != *logCh) {
                        new bd(`rho:block:data`), bdCh in {
                          bd!(*bdCh) |
                          for (@blockNumber, @timestamp, @sender <- bdCh) {
                            logCh!(["transfer", targetAddress, amount, result, blockNumber, timestamp, sender])
                          }
                        }
                      }
                    }
                  }
                }
              } |
              contract systemVault(@"fundValidatorFuel", @targetAddress, @amount, authKey, ret) = {
                new authKeyValidCh in {
                  @AuthKey!("check", *authKey, (*_systemVault, ownVaultAddress), *authKeyValidCh) |
                  for (@authKeyValid <- authKeyValidCh) {
                    if (authKeyValid and amount > 0) {
                      new targetVaultCh in {
                        SystemVault!("findOrCreate", targetAddress, *targetVaultCh) |
                        for (@targetVaultResult <- targetVaultCh) {
                          match targetVaultResult {
                            (true, _) => {
                              new fundCh in {
                                @{targetAddress | bundle0{*_systemVault}}!("_fundValidatorFuelFrom", *purse, amount, *fundCh) |
                                for (@fundResult <- fundCh) {
                                  ret!(fundResult)
                                }
                              }
                            }
                            (false, error) => {
                              ret!((false, error))
                            }
                          }
                        }
                      }
                    } else {
                      ret!((false, "Invalid AuthKey or validator fuel amount"))
                    }
                  }
                }
              } |
              contract systemVault(@"transferBatch", @transfers, authKey, ret) = {
                new authKeyValidCh in {
                  @AuthKey!("check", *authKey, (*_systemVault, ownVaultAddress), *authKeyValidCh) |
                  for (@authKeyValid <- authKeyValidCh) {
                    if (authKeyValid) {
                      new prepareCh in {
                        prepareTransferBatch!(transfers, [], Set(), 0, *prepareCh) |
                        for (@prepareResult <- prepareCh) {
                          match prepareResult {
                            (true, prepared, total) => {
                              new splitCh in {
                                purse!("split", total, *splitCh) |
                                for (@splitResult <- splitCh) {
                                  match splitResult {
                                    [reservedPurse] => {
                                      depositTransferBatch!(reservedPurse, prepared, *ret)
                                    }
                                    _ => {
                                      ret!((false, "Insufficient funds"))
                                    }
                                  }
                                }
                              }
                            }
                            (false, error, _) => {
                              ret!((false, error))
                            }
                          }
                        }
                      }
                    } else {
                      ret!((false, "Invalid AuthKey"))
                    }
                  }
                }
              } |
              // Set to Nil to disable logging
              contract systemVault(@"setLog", logCh, authKey, ret) = {
                new authKeyValidCh in {
                  @AuthKey!("check", *authKey, (*_systemVault, ownVaultAddress), *authKeyValidCh) |
                  for (@result <- authKeyValidCh) {
                    if (result) {
                      new ack in {
                        for (_ <- logStore) {
                          logStore!(*logCh) |
                          // Set logging on the purse so that we also see deposits into the vault
                          purse!("setLog", *logCh, *ack) |
                          for (_ <- ack) {
                            ret!(true)
                          }
                        }
                      }
                    } else {
                      ret!(false)
                    }
                  }
                }
              } |
              // Internal SystemVault method for making deposits between purses.
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_deposit", depositPurse, retCh) = {
                _depositTemplate!(*purse, *depositPurse, *retCh)
              } |
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_costSplit", @role, @amount, retCh) = {
                match role {
                  "General" => {
                    purse!("split", amount, *retCh)
                  }
                  "ValidatorFuel" => {
                    for (@fuelState <- validatorFuelState) {
                      match fuelState {
                        ("Available", _, _, _, _, _) => {
                          new splitCh in {
                            validatorFuelPurse!("split", amount, *splitCh) |
                            for (@splitResult <- splitCh) {
                              validatorFuelState!(fuelState) |
                              retCh!(splitResult)
                            }
                          }
                        }
                        _ => {
                          validatorFuelState!(fuelState) |
                          retCh!([])
                        }
                      }
                    }
                  }
                  _ => {
                    retCh!([])
                  }
                }
              } |
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_costDeposit", @role, depositPurse, retCh) = {
                match role {
                  "General" => {
                    _depositTemplate!(*purse, *depositPurse, *retCh)
                  }
                  "ValidatorFuel" => {
                    for (@fuelState <- validatorFuelState) {
                      match fuelState {
                        ("Available", _, _, _, _, _) => {
                          new depositCh in {
                            _depositTemplate!(*validatorFuelPurse, *depositPurse, *depositCh) |
                            for (@depositResult <- depositCh) {
                              validatorFuelState!(fuelState) |
                              retCh!(depositResult)
                            }
                          }
                        }
                        _ => {
                          validatorFuelState!(fuelState) |
                          retCh!((false, "Validator fuel is unavailable"))
                        }
                      }
                    }
                  }
                  _ => {
                    retCh!((false, "Unknown vault custody role"))
                  }
                }
              } |
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_fundValidatorFuelFrom", sourcePurse, @amount, retCh) = {
                for (@fuelState <- validatorFuelState) {
                  match fuelState {
                    ("Available", _, _, _, _, _) => {
                      new splitCh in {
                        sourcePurse!("split", amount, *splitCh) |
                        for (@splitResult <- splitCh) {
                          match splitResult {
                            [fundingPurse] => {
                              new depositCh in {
                                _depositTemplate!(*validatorFuelPurse, fundingPurse, *depositCh) |
                                for (@depositResult <- depositCh) {
                                  validatorFuelState!(fuelState) |
                                  retCh!(depositResult)
                                }
                              }
                            }
                            _ => {
                              validatorFuelState!(fuelState) |
                              retCh!((false, "Insufficient general custody"))
                            }
                          }
                        }
                      }
                    }
                    _ => {
                      validatorFuelState!(fuelState) |
                      retCh!((false, "Validator fuel is unavailable"))
                    }
                  }
                }
              } |
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_quarantineValidatorFuel", @generation, retCh) = {
                for (@fuelState <- validatorFuelState) {
                  match fuelState {
                    ("Pending", storedGeneration, _, _, _, _) => {
                      validatorFuelState!(fuelState) |
                      if (storedGeneration == generation) {
                        retCh!((true, Nil))
                      } else {
                        retCh!((false, "Conflicting validator fuel quarantine"))
                      }
                    }
                    ("Available", storedGeneration, _, _, _, _) => {
                      if (generation > storedGeneration) {
                        new balanceCh in {
                          validatorFuelPurse!("getBalance", *balanceCh) |
                          for (@balance <- balanceCh) {
                            if (balance == 0) {
                              validatorFuelState!(("Pending", generation, "", "", 0, Nil)) |
                              retCh!((true, Nil))
                            } else {
                              new splitCh in {
                                validatorFuelPurse!("split", balance, *splitCh) |
                                for (@splitResult <- splitCh) {
                                  match splitResult {
                                    [quarantinedPurse] => {
                                      validatorFuelState!(("Pending", generation, "", "", balance, quarantinedPurse)) |
                                      retCh!((true, Nil))
                                    }
                                    _ => {
                                      validatorFuelState!(fuelState) |
                                      retCh!((false, "Validator fuel quarantine failed"))
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      } else {
                        validatorFuelState!(fuelState) |
                        retCh!((false, "Validator fuel quarantine generation is not newer"))
                      }
                    }
                    _ => {
                      validatorFuelState!(fuelState) |
                      retCh!((false, "Malformed validator fuel state"))
                    }
                  }
                }
              } |
              contract @{ownVaultAddress | bundle0{*_systemVault}}(@"_resolveValidatorFuel", @generation, @outcome, @penaltyAddress, @penalty, retCh) = {
                for (@fuelState <- validatorFuelState) {
                  match fuelState {
                    ("Available", storedGeneration, storedOutcome, storedPenaltyAddress, storedPenalty, _) => {
                      validatorFuelState!(fuelState) |
                      if (
                        storedGeneration == generation and
                        storedOutcome == outcome and
                        storedPenaltyAddress == penaltyAddress and
                        storedPenalty == penalty
                      ) {
                        retCh!((true, Nil))
                      } else {
                        retCh!((false, "Conflicting validator fuel resolution"))
                      }
                    }
                    ("Pending", storedGeneration, _, _, amount, quarantinedPurse) => {
                      if (storedGeneration != generation) {
                        validatorFuelState!(fuelState) |
                        retCh!((false, "Validator fuel quarantine generation mismatch"))
                      } else {
                        match outcome {
                          "Vindicated" => {
                            if (amount == 0) {
                              validatorFuelState!(("Available", generation, outcome, penaltyAddress, penalty, Nil)) |
                              retCh!((true, Nil))
                            } else {
                              new returnCh in {
                                _depositTemplate!(*validatorFuelPurse, quarantinedPurse, *returnCh) |
                                for (@returnResult <- returnCh) {
                                  match returnResult {
                                    (true, _) => {
                                      validatorFuelState!(("Available", generation, outcome, penaltyAddress, penalty, Nil)) |
                                      retCh!((true, Nil))
                                    }
                                    (false, error) => {
                                      validatorFuelState!(fuelState) |
                                      retCh!((false, error))
                                    }
                                  }
                                }
                              }
                            }
                          }
                          "Guilty" => {
                            if (penalty < 0) {
                              validatorFuelState!(fuelState) |
                              retCh!((false, "Invalid validator fuel penalty"))
                            } else {
                              new penaltyAmountCh in {
                                if (penalty >= amount) { penaltyAmountCh!(amount) } else { penaltyAmountCh!(penalty) } |
                                for (@penaltyAmount <- penaltyAmountCh) {
                                  new penaltyCh in {
                                    splitAndDeposit!(quarantinedPurse, penaltyAddress, "General", penaltyAmount, *penaltyCh) |
                                    for (@penaltyResult <- penaltyCh) {
                                      match penaltyResult {
                                        (true, _) => {
                                          if (amount == penaltyAmount) {
                                            validatorFuelState!(("Available", generation, outcome, penaltyAddress, penalty, Nil)) |
                                            retCh!((true, Nil))
                                          } else {
                                            new returnCh in {
                                              _depositTemplate!(*validatorFuelPurse, quarantinedPurse, *returnCh) |
                                              for (@returnResult <- returnCh) {
                                                match returnResult {
                                                  (true, _) => {
                                                    validatorFuelState!(("Available", generation, outcome, penaltyAddress, penalty, Nil)) |
                                                    retCh!((true, Nil))
                                                  }
                                                  (false, error) => {
                                                    validatorFuelState!(fuelState) |
                                                    retCh!((false, error))
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                        (false, error) => {
                                          validatorFuelState!(fuelState) |
                                          retCh!((false, error))
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          "Burned" => {
                            validatorFuelState!(("Available", generation, outcome, penaltyAddress, penalty, Nil)) |
                            retCh!((true, Nil))
                          }
                          _ => {
                            validatorFuelState!(fuelState) |
                            retCh!((false, "Unknown validator fuel resolution"))
                          }
                        }
                      }
                    }
                    _ => {
                      validatorFuelState!(fuelState) |
                      retCh!((false, "Malformed validator fuel state"))
                    }
                  }
                }
              }
            }
          } |
          contract reserveAll(@pending, @reserved, retCh) = {
            match pending {
              [(address, role, amount) ...tail] => {
                if (amount > 0 and (role == "General" or role == "ValidatorFuel")) {
                  new getVaultCh, splitCh in {
                    TreeHashMap!("get", vaultMap, address, *getVaultCh) |
                    for (@vault <- getVaultCh) {
                      if (vault == Nil) {
                        failReservation!(reserved, "Funding vault not found", *retCh)
                      } else {
                        @{address | bundle0{*_systemVault}}!("_costSplit", role, amount, *splitCh) |
                        for (@splitResult <- splitCh) {
                          match splitResult {
                            [reservedPurse] => {
                              reserveAll!(tail, reserved ++ [(address, role, amount, reservedPurse)], *retCh)
                            }
                            _ => {
                              failReservation!(reserved, "Insufficient funds", *retCh)
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  failReservation!(reserved, "Cost reservation amount must be positive", *retCh)
                }
              }
              _ => {
                retCh!((true, reserved))
              }
            }
          } |
          contract refundReserved(@reserved, retCh) = {
            match reserved {
              [(address, role, _, reservedPurse) ...tail] => {
                new depositCh in {
                  @{address | bundle0{*_systemVault}}!("_costDeposit", role, reservedPurse, *depositCh) |
                  for (@depositResult <- depositCh) {
                    match depositResult {
                      (true, _) => {
                        refundReserved!(tail, *retCh)
                      }
                      (false, error) => {
                        retCh!((false, error))
                      }
                    }
                  }
                }
              }
              _ => {
                retCh!((true, Nil))
              }
            }
          } |
          contract failReservation(@reserved, @error, retCh) = {
            new refundCh in {
              refundReserved!(reserved, *refundCh) |
              for (@refundResult <- refundCh) {
                match refundResult {
                  (true, _) => {
                    retCh!((false, error))
                  }
                  (false, refundError) => {
                    retCh!((false, "Cost reservation rollback failed: " ++ refundError))
                  }
                }
              }
            }
          } |
          contract validateSettlement(@reserved, @charges, retCh) = {
            match reserved {
              [(reservedAddress, reservedRole, reservedAmount, _) ...reservedTail] => {
                match charges {
                  [(chargeAddress, chargeRole, burn, fee) ...chargeTail] => {
                    if (
                      reservedAddress == chargeAddress and
                      reservedRole == chargeRole and
                      burn >= 0 and
                      fee >= 0 and
                      burn + fee <= reservedAmount and
                      (chargeRole == "General" or (chargeRole == "ValidatorFuel" and fee == 0))
                    ) {
                      validateSettlement!(reservedTail, chargeTail, *retCh)
                    } else {
                      retCh!((false, "Invalid cost settlement allocation"))
                    }
                  }
                  _ => {
                    retCh!((false, "Cost settlement allocations do not match reservation"))
                  }
                }
              }
              _ => {
                match charges {
                  [] => {
                    retCh!((true, Nil))
                  }
                  _ => {
                    retCh!((false, "Cost settlement allocations do not match reservation"))
                  }
                }
              }
            }
          } |
          contract settleReserved(@reserved, @charges, @feeAddress, retCh) = {
            match reserved {
              [(sourceAddress, sourceRole, reservedAmount, reservedPurse) ...reservedTail] => {
                match charges {
                  [(sourceAddress, sourceRole, burn, fee) ...chargeTail] => {
                    new feeCh in {
                      splitAndDeposit!(reservedPurse, feeAddress, "General", fee, *feeCh) |
                      for (@feeResult <- feeCh) {
                        match feeResult {
                          (true, _) => {
                            new refundCh in {
                              splitAndDeposit!(reservedPurse, sourceAddress, sourceRole, reservedAmount - burn - fee, *refundCh) |
                              for (@refundResult <- refundCh) {
                                match refundResult {
                                  (true, _) => {
                                    settleReserved!(reservedTail, chargeTail, feeAddress, *retCh)
                                  }
                                  (false, error) => {
                                    retCh!((false, error))
                                  }
                                }
                              }
                            }
                          }
                          (false, error) => {
                            retCh!((false, error))
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    retCh!((false, "Cost settlement allocations do not match reservation"))
                  }
                }
              }
              _ => {
                retCh!((true, Nil))
              }
            }
          } |
          contract splitAndDeposit(purse, @targetAddress, @targetRole, @amount, retCh) = {
            if (amount == 0) {
              retCh!((true, Nil))
            } else {
              new splitCh in {
                purse!("split", amount, *splitCh) |
                for (@splitResult <- splitCh) {
                  match splitResult {
                    [splitPurse] => {
                      new depositCh in {
                        @{targetAddress | bundle0{*_systemVault}}!("_costDeposit", targetRole, splitPurse, *depositCh) |
                        for (@depositResult <- depositCh) {
                          retCh!(depositResult)
                        }
                      }
                    }
                    _ => {
                      retCh!((false, "Cost settlement purse split failed"))
                    }
                  }
                }
              }
            }
          } |
          contract prepareTransferBatch(@pending, @prepared, @seen, @total, retCh) = {
            match pending {
              [(targetAddress, amount) ...tail] => {
                if (seen.contains(targetAddress)) {
                  retCh!((false, "Transfer targets must be distinct", 0))
                } else if (amount > 0 and total <= 9223372036854775807 - amount) {
                  new validCh in {
                    VaultAddress!("validate", targetAddress, *validCh) |
                    for (@valid <- validCh) {
                      if (valid == Nil) {
                        prepareTransferBatch!(
                          tail,
                          prepared ++ [(targetAddress, amount)],
                          seen.add(targetAddress),
                          total + amount,
                          *retCh
                        )
                      } else {
                        retCh!((false, "Invalid target vault address", 0))
                      }
                    }
                  }
                } else {
                  retCh!((false, "Transfer amount must be positive and bounded", 0))
                }
              }
              [] => {
                if (prepared.length() > 0) {
                  retCh!((true, prepared, total))
                } else {
                  retCh!((false, "Transfer batch must not be empty", 0))
                }
              }
              _ => {
                retCh!((false, "Malformed transfer batch", 0))
              }
            }
          } |
          contract depositTransferBatch(reservedPurse, @pending, retCh) = {
            match pending {
              [(targetAddress, amount) ...tail] => {
                new targetVaultCh in {
                  SystemVault!("findOrCreate", targetAddress, *targetVaultCh) |
                  for (@targetVaultResult <- targetVaultCh) {
                    match targetVaultResult {
                      (true, _) => {
                        new depositCh in {
                          splitAndDeposit!(*reservedPurse, targetAddress, "General", amount, *depositCh) |
                          for (@depositResult <- depositCh) {
                            match depositResult {
                              (true, _) => {
                                depositTransferBatch!(*reservedPurse, tail, *retCh)
                              }
                              (false, error) => {
                                retCh!((false, error))
                              }
                            }
                          }
                        }
                      }
                      (false, error) => {
                        retCh!((false, error))
                      }
                    }
                  }
                }
              }
              [] => {
                retCh!((true, Nil))
              }
              _ => {
                retCh!((false, "Malformed prepared transfer batch"))
              }
            }
          } |
          // Checks all necessary validation and authentication prerequisites. If everything checks out,
          // amount is transferred from purse (ownVaultAddress) to vault at targetAddress.
          contract _transferTemplate(@ownVaultAddress, purse, @targetAddress, @amount, authKey, ret) = {
            new vaultAddressValid, vaultAddressValidEither, amountNonNegative,
                authKeyValidCh, authKeyValidEitherCh,
                parametersOkCh, parametersAndAuthOkCh,
                split, eitherPurseCh, doDeposit
            in {
              VaultAddress!("validate", targetAddress, *vaultAddressValid) |
              @Either!("fromNillableError <-", *vaultAddressValid, *vaultAddressValidEither) |
              @Either!("fromBoolean", amount > 0, "Amount must be positive value", *amountNonNegative) |
              @AuthKey!("check", *authKey, (*_systemVault, ownVaultAddress), *authKeyValidCh) |
              @Either!("fromBoolean <-", *authKeyValidCh, "Invalid AuthKey", *authKeyValidEitherCh) |
              @Either!("productR <-", *vaultAddressValidEither, *amountNonNegative, *parametersOkCh) |
              @Either!("productR <-", *parametersOkCh, *authKeyValidEitherCh, *parametersAndAuthOkCh) |
              @Either!("flatMap <-", *parametersAndAuthOkCh, *split, *eitherPurseCh) |
              for (_, retCh <- split) {
                new destPurseCh, depositSuccessCh in {
                  purse!("sprout", *destPurseCh) |
                  for (@destPurse <- destPurseCh) {
                    @destPurse!("deposit", amount, *purse, *depositSuccessCh) |
                    for (@depositSuccess <- depositSuccessCh) {
                      if (depositSuccess) {
                        retCh!((true, destPurse))
                      } else {
                        retCh!((false, "Insufficient funds"))
                      }
                    }
                  }
                }
              } |
              @Either!("flatMap <-", *eitherPurseCh, *doDeposit, *ret) |
              for (@p, retCh <- doDeposit) {
                @{targetAddress | bundle0{*_systemVault}}!("_deposit", p, *retCh)
              }
            }
          } |
          // Deposits the entire balance in the fromPurse to the toPurse.
          contract _depositTemplate(fromPurse, toPurse, retCh) = {
            new amountCh, depositSuccessCh in {
              toPurse!("getBalance", *amountCh) |
              for (@amount <- amountCh) {
                // Calls purse deposit method in MakeMint contract; adds amount to toPurse and subtracts from fromPurse.
                fromPurse!("deposit", amount, *toPurse, *depositSuccessCh) |
                @Either!("fromBoolean <-", *depositSuccessCh, "BUG FOUND: purse deposit failed", *retCh)
              }
            }
          } |

          rs!(
            "040f035630a5d2199184890b4b6b83440c842da0b6becca539f788f7b35d6e873561f673cd6ebe2e32236398a86f29dad992e8fba32534734300fcc5104bcfea0e".hexToBytes(),
            (9223372036854775807, bundle+{*SystemVault}),
            "3045022100c58cd73cd1a5c153d4edb3fc6e48aa2344c549a9225bde3def9b98c35e44399902205c3b615a1f19b8b2de23aecfea24dea30ae96eecd5f8bda1c125f47cb92a08d2".hexToBytes(),
            *uriOut
          )

        }
      }
    }
  }
}
