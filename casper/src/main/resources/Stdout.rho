// Stdout.rho — File I/O FIP §The Stdout agent.
//
// Wraps process stdout / stderr (`Fs.stdout()` and `Fs.stderr()`
// both return a Stdout instance wired to the respective handle) as a
// write-only, sequential-forward-only agent.  Backing primitives:
// fsWrite(fd, bytes, ret) and fsFlush(fd, ret) — the powerbox binds
// fd to the actual stdout/stderr at Fs construction; tests inject a
// mock over mockFdCell.
//
// ## Consensus discipline — stdio is INTRINSICALLY ORACULAR
//
// See Stdin.rho's matching section for the full rationale.  Summary:
// Stdout (and Stderr, which routes through this same agent) is a
// process-level side effect.  Follower validators MUST NOT re-execute
// the underlying `write(1, ...)` / `write(2, ...)` syscall on replay
// — doing so would emit output twice on the leader's node (once at
// commit time, once at replay time on the follower) and print
// leader-observed bytes on unrelated follower processes.
//
// Constructor deliberately takes NO `cmode` argument — mirrors
// Stdin.rho.  A consensus-mode Stdout cap would be a semantic
// contradiction; there is no code path that produces one.  The
// pin `stdio_agents_have_no_cmode_arg_and_stay_oracular` in
// `fileio_cost_spec.rs` enforces this at source-scan level.
//
// Deploys that write to stdout as a side effect should treat those
// writes as debug-only / leader-only — they will NOT be replayed
// on followers, and the tuplespace state MUST NOT depend on
// whether the write succeeded.  Consistent with the treatment of
// oracular file writes on non-Consensus caps.
//
// ## Delivered methods (spec §1105-1114)
//
//   constructor(@fd) — powerbox-provided process stdout / stderr fd
//   writeChars, writeBytes, writeLine, writeLines, writeString,
//   writeByteArray, flush, close.  Plus the mandatory catch-all
//   `default(...@args)` per spec §Argument conventions — routes
//   read-side methods (spec §1116) and unknown methods to
//   FSERR_UNSUPPORTED.
//
// ## Not supported (spec §1116)
//
//   Read methods (chars, bytes, lines, readLine) fall through the
//   default arm → [false, "FSERR_UNSUPPORTED", ...].
//
// ## Lifecycle (spec §1114)
//
// close() marks THIS Stdout cap as closed; subsequent calls return
// FSERR_CLOSED.  Does NOT close the underlying process fd (the
// powerbox owns that).  A fresh Fs!stdout() call after close returns
// a new Stdout cap that CAN still write.  Active streams held via
// bundle+ are NOT force-closed here — matches File.close's shallow-
// close deferral (M-11-2 analog).
//
// ## Reused helpers
//
// writeBytesLoop, writeCharsLoop, writeLinesLoop, fsWrite, fsFlush —
// all live in the shared outer scope (with_libs in tests; FsGenesis
// in prod) and are captured lexically by Stdout's method bodies.

new Stdout, stdoutFdP, stdoutStateP in {

  agent Stdout {
    constructor(@fd) {
      @[*private, *stdoutFdP]!(fd) |
      @[*private, *stdoutStateP]!("open")
    } |

    // -- writeByteArray(bytes) -------------------------------------
    //
    // Type-guarded on ByteArray shape.  Writes at the fd's current
    // position via fsWrite.  Normalizes fsWrite's `[true, nWritten]`
    // (or any `[true, ...]` shape) reply to bare `[true]` per spec
    // §1112.  Forwards `[false, code, msg]` failures unchanged.
    // Wraps any other shape in FSERR_IO.  No mode gate (Stdout is
    // inherently write-only).
    method writeByteArray(@bytes) {
      match bytes {
        b /\ ByteArray => {
          for (@state <- @[*private, *stdoutStateP]) {
            match state {
              "closed" => {
                @[*private, *stdoutStateP]!("closed") |
                return!([false, "FSERR_CLOSED", "stdout is closed"])
              }
              "open" => {
                for (@fd <<- @[*private, *stdoutFdP]) {
                  new writeCh in {
                    fsWrite!(fd, b, *writeCh) |
                    for (@reply <- writeCh) {
                      @[*private, *stdoutStateP]!("open") |
                      // m-15-1 hardening: greedy `[true, ..._]` match
                      // catches both `[true]` and `[true, nWritten]`
                      // shapes; either normalizes to `[true]`.
                      match reply {
                        [true, ..._]       => return!([true])
                        [false, code, msg] => return!([false, code, msg])
                        _ => return!([false, "FSERR_IO",
                          "fsWrite returned malformed reply"])
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *stdoutStateP]!("closed") |
                return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "bytes must be a ByteArray"])
      }
    } |

    // -- writeString(s) --------------------------------------------
    //
    // Bounded convenience: encode `s` as UTF-8 and delegate.  Type-
    // guarded on String.
    method writeString(@s) {
      match s {
        str /\ String => {
          for (@reply <- @(*this)!?("writeByteArray", str.toUtf8Bytes())) {
            return!(reply)
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "s must be a String"])
      }
    } |

    // -- writeBytes(byteStream) ------------------------------------
    //
    // Sequential ByteStream consumer.  Drains via the shared
    // writeBytesLoop helper (same one File.writeBytes uses).  The
    // input stream is closed by the loop on success or error.
    method writeBytes(@byteStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeBytesLoop!(byteStream, fd, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  @[*private, *stdoutStateP]!("open") |
                  // writeBytesLoop returns [true] on EOS or
                  // [false, code, msg] with a byte-count prefix on
                  // error.  Both shapes match spec §1108 directly.
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeChars(charStream) ------------------------------------
    //
    // Sequential CharStream consumer.  UTF-8-encodes each char via
    // toUtf8Bytes() as it drains; delegates to writeCharsLoop.
    method writeChars(@charStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  @[*private, *stdoutStateP]!("open") |
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeLine(charStream) -------------------------------------
    //
    // Drains charStream via writeCharsLoop, then appends LF (0x0A)
    // via fsWrite.  Line separator is always \n (spec §959).
    //
    // If the char-drain phase errors, forward that error unchanged
    // (do NOT append LF — partial line, no terminator).  If the
    // LF write fails after a successful drain, forward the LF error.
    method writeLine(@charStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                for (@charsReply <- loopRet) {
                  match charsReply {
                    [true] => {
                      new lfCh in {
                        fsWrite!(fd, "0a".hexToBytes(), *lfCh) |
                        for (@lfReply <- lfCh) {
                          match lfReply {
                            [true, _] => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([true])
                            }
                            [false, code, msg] => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([false, code, msg])
                            }
                            _ => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([false, "FSERR_IO",
                                "fsWrite for LF terminator returned malformed reply"])
                            }
                          }
                        }
                      }
                    }
                    _ => {
                      @[*private, *stdoutStateP]!("open") |
                      return!(charsReply)
                    }
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeLines(lineStream) ------------------------------------
    //
    // Drains an outer LineStream, calling writeLine per inner.
    // Releases stdoutStateP BEFORE the loop: writeLinesLoop calls
    // back into `*this!?("writeLine", inner)`, which acquires
    // stdoutStateP per iteration.  Holding it across the loop
    // would deadlock — same pattern as File.writeLines.
    method writeLines(@lineStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@_fd <<- @[*private, *stdoutFdP]) {
              @[*private, *stdoutStateP]!("open") |
              new loopRet in {
                writeLinesLoop!(*this, lineStream, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- flush() ---------------------------------------------------
    //
    // Forces durable write on the fd (spec §1113).  On stdio, this
    // flushes to the terminal / pipe buffer.
    //
    // M-15-1 hardening: shape-validate fsFlush's reply.  Every other
    // Stdout method that dispatches to a native primitive wraps
    // unexpected shapes in FSERR_IO; flush should too, so a future
    // primitive change can't propagate malformed replies to callers.
    method flush() {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new flushCh in {
                fsFlush!(fd, *flushCh) |
                for (@reply <- flushCh) {
                  @[*private, *stdoutStateP]!("open") |
                  match reply {
                    [true]             => return!([true])
                    [false, code, msg] => return!([false, code, msg])
                    _ => return!([false, "FSERR_IO",
                      "fsFlush returned malformed reply"])
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- close() ---------------------------------------------------
    //
    // Mark this Stdout cap "closed"; subsequent method calls return
    // FSERR_CLOSED via the state check.  Does NOT call fsClose —
    // the powerbox owns the process fd (spec §1114, same rule as
    // Stdin.close).  Active streams held via bundle+ are NOT force-
    // closed here — same shallow-close limitation as File.close
    // (M-11-2 deferral).
    method close() {
      for (@_state <- @[*private, *stdoutStateP]) {
        @[*private, *stdoutStateP]!("closed") |
        return!([true])
      }
    } |

    // -- Default arm -----------------------------------------------
    //
    // Catches read-side methods (chars, bytes, lines, readLine —
    // spec §1116) and any other unknown method with FSERR_UNSUPPORTED.
    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED",
          "unknown method or not supported on Stdout"])
      }
    }
  }
}
