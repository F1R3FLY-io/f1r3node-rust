// Buffer.rho — File I/O FIP §Buffers library (MVP slice).
//
// This is the first-pass implementation, covering:
//   - `Buffer` agent with: constructor, capacity, length, remaining,
//     isEmpty, isFull, unit, writeBytes, read, toByteArray, close,
//     beginFill, endFill, default.
//   - `Allocator` agent with `alloc(n, unit)`, `allocBytes`,
//     `allocUtf8`, `default`.
//
// Deferred to follow-up commits:
//   - `writeByte`, `slice`, `validUtf8PrefixLen`, `view`, `clear`
//     (§Buffer > Reads / Writes / Lifecycle).
//   - Publication to a fixed registry URN (currently the allocator is
//     minted but not published — tests scope it via inline `new`).
//   - The pairwise-merge helper `mergePairs` — for the MVP the `read`
//     method inlines a right-fold chunk gather.  A follow-up will
//     replace with the Θ(ℓ log ν) balanced pairwise merge required by
//     §Cost accounting > Buffers (currently Θ(ℓ ν) for ν chunks; still
//     correct, just costlier).
//
// State layout (spec §Buffers > Implementation notes):
//   metadata @[*private, *metaP]   — a 7-tuple or "REVOKED"
//   chunks   @[*private, *chunkP, j] — one segment per accepted write,
//                                       j ∈ [lo, hi); indices MONOTONIC
//                                       — clear() advances lo to hi.
//
// Concurrency: every named method acquires the metadata token via
// linear-receive with a free-variable pattern (spec §Metadata-token
// mutex), matches "REVOKED" first, does its work, and re-parks the
// token on every exit path.  The catch-all `_` arm makes the mutex
// robust against a hypothetical third payload shape.

new Buffer, Allocator, Rows, metaP, chunkP, innerP, rowsMetaP,
    gatherChunks, drainChunks,
    allocInnersLoop, parkInnersLoop,
    clearInnersLoop, closeInnersLoop in {

  // ==================================================================
  // Buffer agent
  // ==================================================================
  agent Buffer {
    constructor(@capBytes, @unit) {
      @[*private, *metaP]!((0, 0, capBytes, unit, "none", 0, 0))
    } |

    // -- Metadata queries (hold the token per spec §Metadata queries) --

    method capacity() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method length() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method remaining() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap - ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isEmpty() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == 0])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isFull() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method unit() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, _cap, u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, u])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Writes ------------------------------------------------------

    // writeBytes(xs) — always a (possibly short) success (spec §Write).
    // Parks ONE chunk at index `hi` with the k accepted bytes; k = 0
    // parks nothing (a full buffer cannot accumulate empty chunks).
    //
    // Type-guarded per spec §Buffers ("Every method that takes a numeric
    // or ByteArray argument guards it with match ... before any
    // arithmetic").  Without this guard, `xs.length()` on a non-ByteArray
    // caller-supplied value would raise MethodNotDefined — an
    // uncatchable interpreter error — inside the metadata critical
    // section, orphaning the token and bricking the buffer permanently.
    // The guard is BEFORE the token consumption so a bad arg never
    // touches state.
    method writeBytes(@xs) {
      match xs {
        b /\ ByteArray => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                // b is proven a ByteArray by the outer guard; .length()
                // and .slice() are safe here.
                match b.length() {
                  xsLen => {
                    match cap - ell {
                      room => {
                        match (xsLen <= room) {
                          true => {
                            match xsLen == 0 {
                              true => {
                                // Zero-length: park nothing.
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b) |
                                @[*private, *metaP]!(
                                  (ell + xsLen, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, xsLen])
                              }
                            }
                          }
                          false => {
                            // Short write.
                            match room == 0 {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b.slice(0, room)) |
                                @[*private, *metaP]!(
                                  (ell + room, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, room])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "xs must be a ByteArray"])
      }
    } |

    // -- Reads -------------------------------------------------------

    // read(n) — consume up to n bytes from position rho, advancing rho.
    // Refused with "BUFERR_FILLING" while a lease is held.
    //
    // MVP implementation: gathers chunks via a helper that reads each
    // chunk's segment linearly and re-sends it (storage-neutral).
    // Uses `gatherChunks` module-level helper that takes the
    // (privateName, chunkPName, lo, hi) so it can descend into the
    // instance's chunks.  See §Cost accounting > Buffers — MVP is
    // linear-fold; follow-up commit substitutes the balanced
    // pairwise merge.
    // read(n) — type-guarded per spec §Buffers.  Without the guard,
    // `n <= 0` on a non-Int caller-supplied `n` raises MethodNotDefined
    // inside the critical section, orphaning the token.
    method read(@n) {
      match n {
        i /\ Int => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                match lease {
                  "none" => {
                    // r = max(0, min(i, ell - rho))
                    match (i <= 0) {
                      true => {
                        @[*private, *metaP]!(meta) |
                        return!([true, "".hexToBytes()])
                      }
                      false => {
                        match (ell - rho) {
                          unread => {
                            match (unread <= 0) {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, "".hexToBytes()])
                              }
                              false => {
                                new gCh in {
                                  gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                  for (@allBytes <- gCh) {
                                    match (i <= unread) {
                                      true => {
                                        @[*private, *metaP]!(
                                          (ell, rho + i, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + i)])
                                      }
                                      false => {
                                        @[*private, *metaP]!(
                                          (ell, rho + unread, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + unread)])
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "fill in progress"])
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
      }
    } |

    // toByteArray(@cap) — copy of [0, ell), no cursor move.  Refused
    // under held lease.
    //
    // ## Materialization cap (slice 9c-ii)
    //
    // `cap` is the caller's budget for materialized bytes.  Signature
    // added to close spec §446's `FSERR_QUOTA_EXCEEDED` gap: pre-slice-
    // 9c-ii `toByteArray()` was unbounded (limited only by Buffer's
    // 1 GiB platform allocation cap), so a caller with no other budget
    // knowledge could be forced into a 1 GiB copy by a bloated buffer.
    //
    // Semantics:
    //   * non-Int cap                  → `[false, "BUFERR_INVALID_ARGUMENT", ...]`
    //   * cap < 0                      → `[false, "BUFERR_INVALID_CAPACITY", ...]`
    //   * ell > cap                    → `[false, "FSERR_QUOTA_EXCEEDED", ...]`
    //   * ell ≤ cap on non-lease meta  → `[true, bytes]` (0 ≤ i < ell)
    //
    // Cap validation runs BEFORE the meta peek so a malformed cap
    // fails fast without disturbing the buffer state cell.
    //
    // Callers: `File.writeFrom` / `File.writeFromAt` (arity-1 and
    // arity-2 wait:true variants) pass `67108864` (MAX_WRITE_BYTES
    // = 64 MiB), matching the downstream `fs_write` cap so an
    // over-cap buffer fails at materialization rather than syscall
    // dispatch.
    method toByteArray(@cap) {
      match cap {
        c /\ Int => {
          match c < 0 {
            true => return!(
              [false, "BUFERR_INVALID_CAPACITY", "cap must be non-negative"])
            false => {
              for (@meta <- @[*private, *metaP]) {
                match meta {
                  "REVOKED" => {
                    @[*private, *metaP]!("REVOKED") |
                    return!([false, "BUFERR_REVOKED", "buffer is closed"])
                  }
                  (ell, _rho, _cap, _u, lease, lo, hi) => {
                    match lease {
                      "none" => {
                        match ell > c {
                          true => {
                            @[*private, *metaP]!(meta) |
                            return!([false, "FSERR_QUOTA_EXCEEDED",
                              "buffer content size exceeds cap"])
                          }
                          false => {
                            match ell == 0 {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, "".hexToBytes()])
                              }
                              false => {
                                new gCh in {
                                  gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                  for (@allBytes <- gCh) {
                                    @[*private, *metaP]!(meta) |
                                    return!([true, allBytes.slice(0, ell)])
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      _ => {
                        @[*private, *metaP]!(meta) |
                        return!([false, "BUFERR_FILLING", "fill in progress"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "cap must be an integer"])
      }
    } |

    // -- Fill lease --------------------------------------------------

    method beginFill() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // Mint a fresh unforgeable name.  We return `*fillToken`
                // (the dereferenced name) rather than a bundle+ so that
                // endFill's equality check `lease == presented` sees the
                // same Par shape on both sides.  The name is still
                // unforgeable — a caller cannot construct it — and can
                // only be used by presenting it back to endFill.
                new fillToken in {
                  @[*private, *metaP]!((ell, rho, cap, u, *fillToken, lo, hi)) |
                  return!([true, *fillToken])
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "lease already held"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // endFill(presented) — release the lease iff `presented` matches
    // the active fillToken.
    //
    // Two-stage check fixes M-1: reject "no lease held" explicitly
    // BEFORE the equality comparison.  Without this, a caller passing
    // presented = "none" against lease "none" would get an
    // indistinguishable "success" reply even though no lease was ever
    // held — breaking ownership audits.
    method endFill(@presented) {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // No lease held; reject any presented token — including
                // presented == "none", which would otherwise falsely
                // report success (M-1 fix).
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "no lease held"])
              }
              _ => {
                // Lease is a Name.  `==` between Pars is total (structural
                // equality: identical Names → true, all other pairs →
                // false), so it never raises regardless of `presented`'s
                // type.
                match lease == presented {
                  true => {
                    @[*private, *metaP]!((ell, rho, cap, u, "none", lo, hi)) |
                    return!([true])
                  }
                  false => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "lease token mismatch"])
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Lifecycle ---------------------------------------------------

    // clear() — reset the buffer for reuse WITHOUT closing it.
    // Advances lo to hi (NEVER REWIND — consensus-safety invariant),
    // sets ell = rho = 0, releases any held lease.  Consumes stored
    // chunks so their storage is refunded within the deploy.
    //
    // Deliberately NOT lease-gated: this is the non-destructive
    // recovery path for a lease whose holder died or lost its token
    // (spec §Buffers > Fill lease > Abandonment).  Shipping clear() in
    // this phase (rather than deferring) gives the lease a
    // non-destructive escape hatch — otherwise the only recovery from
    // a stuck lease is close(), which revokes the buffer entirely.
    method clear() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                // NEVER REWIND lo — advance to hi.  This invariant is
                // load-bearing for consensus safety (spec §Buffers >
                // Implementation notes): a stale chunk-index observation
                // from a prior epoch must never collide with a
                // freshly-written chunk at the same index.
                @[*private, *metaP]!((0, 0, cap, u, "none", hi, hi)) |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // close() — replace metadata with "REVOKED" tombstone and drain
    // chunks (refunding storage within the deploy).  Deliberately not
    // lease-gated: it is a recovery path for a stuck lease.  Does not
    // remove the persistent dispatcher — the GC FIP reclaims that at
    // deploy end.
    method close() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
          (_ell, _rho, _cap, _u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                @[*private, *metaP]!("REVOKED") |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
        }
      }
    } |

    // -- Default arm -------------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Allocator agent — the buffer factory.
  // ==================================================================
  //
  // Capacity guards ordered `n <= n_max(unit)` BEFORE `n * 4` (avoid
  // Rholang's checked-Int multiplication overflow — spec §Formal
  // semantics > Allocation).
  //
  // L (platform capacity limit) = 1 GiB.  A quota-agent hook will
  // override this once §FSERR_QUOTA_EXCEEDED lands.
  agent Allocator {
    constructor() { Nil } |

    // alloc(nUnits, unit) — type-guarded per spec §Buffers.  Without
    // the Int guard, `nUnits <= 0` on a non-Int caller-supplied value
    // would raise MethodNotDefined, aborting the reduction and leaving
    // the caller's `!?` blocked forever (Mi-3 fix).
    method alloc(@nUnits, @unit) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match unit {
                "bytes" => {
                  match i > 1073741824 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i, "bytes")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                "utf8" => {
                  match i > 268435456 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                _ => return!([false, "BUFERR_INVALID_UNIT", "unit must be bytes or utf8"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    // Parameter name matches spec §430 (`nUnits`, not `n`).
    method allocBytes(@nUnits) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match i > 1073741824 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i, "bytes")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    method allocUtf8(@nUnits) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match i > 268435456 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    // allocRows(m, innerN, innerUnit) — spec §443:
    //   "a buffer of buffers: m inner byte buffers, each allocated
    //    by alloc(innerN, innerUnit)".
    //
    // Type-guards each arg per spec §Buffers.  Fails atomically: if
    // any inner buffer allocation would exceed the aggregate platform
    // cap, no inner is allocated.  Failure taxonomy: same as `alloc`
    // (BUFERR_INVALID_ARGUMENT / BUFERR_INVALID_CAPACITY /
    // BUFERR_INVALID_UNIT).
    //
    // The utf8 cap is 256 MB (m * innerN ≤ 2^28 units, each unit ≤ 4
    // bytes → aggregate ≤ 2^30 bytes).  Bytes cap is 1 GB aggregate.
    //
    // ## Known deferral — FSERR_QUOTA_EXCEEDED (spec §446)
    //
    // Spec §446 lists a fourth failure code, `FSERR_QUOTA_EXCEEDED`,
    // returned when a quota agent declines the reservation.  The
    // quota-agent hook is scheduled for a separate quota-infrastructure
    // slice; until then, only the three platform-cap failures above
    // are surfaced.  The M-13-2 atomicity fix in `allocInnersLoop`
    // makes the eventual quota wire-in a one-line change (forward the
    // quota agent's decline reply through the same first-failure
    // path).
    method allocRows(@m, @innerN, @innerUnit) {
      match m {
        mi /\ Int => {
          match innerN {
            ni /\ Int => {
              match mi <= 0 {
                true => return!(
                  [false, "BUFERR_INVALID_CAPACITY", "m must be positive"])
                false => {
                  match ni <= 0 {
                    true => return!(
                      [false, "BUFERR_INVALID_CAPACITY", "innerN must be positive"])
                    false => {
                      match innerUnit {
                        "bytes" => {
                          match mi > 1073741824 / ni {
                            true => return!(
                              [false, "BUFERR_INVALID_CAPACITY",
                               "aggregate m*innerN exceeds platform cap"])
                            false => {
                              new innersRet in {
                                allocInnersLoop!(mi, ni, "bytes", [], *innersRet) |
                                for (@innersReply <- innersRet) {
                                  match innersReply {
                                    [true, inners] => {
                                      for (@rowsHandle <- Rows!?(mi, "bytes", inners)) {
                                        return!([true, rowsHandle])
                                      }
                                    }
                                    _ => return!(innersReply)
                                  }
                                }
                              }
                            }
                          }
                        }
                        "utf8" => {
                          match mi > 268435456 / ni {
                            true => return!(
                              [false, "BUFERR_INVALID_CAPACITY",
                               "aggregate m*innerN exceeds platform cap"])
                            false => {
                              new innersRet in {
                                allocInnersLoop!(mi, ni * 4, "utf8", [], *innersRet) |
                                for (@innersReply <- innersRet) {
                                  match innersReply {
                                    [true, inners] => {
                                      for (@rowsHandle <- Rows!?(mi, "utf8", inners)) {
                                        return!([true, rowsHandle])
                                      }
                                    }
                                    _ => return!(innersReply)
                                  }
                                }
                              }
                            }
                          }
                        }
                        _ => return!(
                          [false, "BUFERR_INVALID_UNIT",
                           "innerUnit must be bytes or utf8"])
                      }
                    }
                  }
                }
              }
            }
            _ => return!(
              [false, "BUFERR_INVALID_ARGUMENT", "innerN must be an integer"])
          }
        }
        _ => return!(
          [false, "BUFERR_INVALID_ARGUMENT", "m must be an integer"])
      }
    } |

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Rows agent — the buffer-of-buffers (§Fixed-size line reading).
  //
  // A distinct type from Buffer: its "elements" are inner buffer
  // handles, not bytes.  The outer holds `m` inner buffers, all with
  // the same unit.  Callers reach an inner via `getAt(i)` and use it
  // as a normal Buffer (writeBytes, remaining, beginFill, etc.).
  //
  // ## Delivered methods (spec §578-583)
  //
  //   capacityRows, innerUnit, getAt, clear, close, default.
  //
  // ## State layout
  //
  //   rowsMetaP  → (m, unit, "live" | "revoked")
  //   innerP[i]  → inner buffer handle for i ∈ [0, m).  Parked once
  //                at construction (peek-only from getAt).
  //
  // Every method acquires the metadata token via linear-recv, checks
  // for the revoked tombstone, then does its work.  Methods that
  // touch every inner (clear, close) iterate via a module-level
  // helper contract to keep the metadata critical section bounded.
  // ==================================================================
  agent Rows {
    // Constructor is called by allocRows with an already-allocated
    // list of inner handles.  It parks each inner at its index
    // (via parkInnersLoop) and installs the "live" metadata token.
    constructor(@m, @unit, @inners) {
      @[*private, *rowsMetaP]!((m, unit, "live")) |
      parkInnersLoop!(*private, *innerP, 0, m, inners)
    } |

    method capacityRows() {
      for (@meta <<- @[*private, *rowsMetaP]) {
        match meta {
          (m, _unit, "live") => return!([true, m])
          (_m, _unit, "revoked") => return!(
            [false, "BUFERR_REVOKED", "rows is closed"])
          _ => return!(
            [false, "BUFERR_REVOKED", "rows state unrecognized"])
        }
      }
    } |

    method innerUnit() {
      for (@meta <<- @[*private, *rowsMetaP]) {
        match meta {
          (_m, unit, "live") => return!([true, unit])
          (_m, _unit, "revoked") => return!(
            [false, "BUFERR_REVOKED", "rows is closed"])
          _ => return!(
            [false, "BUFERR_REVOKED", "rows state unrecognized"])
        }
      }
    } |

    // getAt(i) — peek the inner handle at index i (no consumption).
    // Type-guarded on i; range-checked before touching innerP.
    method getAt(@i) {
      match i {
        idx /\ Int => {
          for (@meta <<- @[*private, *rowsMetaP]) {
            match meta {
              (m, _unit, "live") => {
                match idx < 0 {
                  true => return!(
                    [false, "BUFERR_OUT_OF_RANGE", "index must be non-negative"])
                  false => {
                    match idx >= m {
                      true => return!(
                        [false, "BUFERR_OUT_OF_RANGE",
                         "index out of range"])
                      false => {
                        for (@inner <<- @[*private, *innerP, idx]) {
                          return!([true, inner])
                        }
                      }
                    }
                  }
                }
              }
              (_m, _unit, "revoked") => return!(
                [false, "BUFERR_REVOKED", "rows is closed"])
              _ => return!(
                [false, "BUFERR_REVOKED", "rows state unrecognized"])
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "i must be an integer"])
      }
    } |

    // clear() — clears every inner buffer.  Fails if outer revoked.
    //
    // Best-effort on individual inners: `clearInnersLoop` consumes
    // each inner's `clear()` reply and continues regardless of
    // success or failure of that individual call.  Rationale: an
    // outer clear() is a bulk recovery operation; failing the whole
    // call because ONE inner was independently closed by another
    // party would leave callers unable to recover.  (m-13-1 docstring
    // fix: earlier text said replies were "propagated"; the code has
    // always been best-effort.)
    method clear() {
      for (@meta <- @[*private, *rowsMetaP]) {
        match meta {
          (m, unit, "live") => {
            new doneCh in {
              clearInnersLoop!(*private, *innerP, 0, m, *doneCh) |
              for (@_ <- doneCh) {
                @[*private, *rowsMetaP]!((m, unit, "live")) |
                return!([true])
              }
            }
          }
          (m, unit, "revoked") => {
            @[*private, *rowsMetaP]!((m, unit, "revoked")) |
            return!([false, "BUFERR_REVOKED", "rows is closed"])
          }
          _ => {
            @[*private, *rowsMetaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "rows state unrecognized"])
          }
        }
      }
    } |

    // close() — closes every inner buffer AND marks the outer
    // "revoked".  Idempotent on already-closed outer.
    method close() {
      for (@meta <- @[*private, *rowsMetaP]) {
        match meta {
          (m, unit, "live") => {
            new doneCh in {
              closeInnersLoop!(*private, *innerP, 0, m, *doneCh) |
              for (@_ <- doneCh) {
                @[*private, *rowsMetaP]!((m, unit, "revoked")) |
                return!([true])
              }
            }
          }
          (m, unit, "revoked") => {
            @[*private, *rowsMetaP]!((m, unit, "revoked")) |
            return!([true])
          }
          _ => {
            @[*private, *rowsMetaP]!(meta) |
            return!([true])
          }
        }
      }
    } |

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helper: gather chunks [lo, hi) into a single ByteArray.
  //
  // Takes `privateName` and `chunkPName` as parameters so it can
  // access an instance's chunks (the caller passes `*private, *chunkP`).
  // Uses a right-fold — cost is Θ(ℓ ν) not the spec-mandated
  // Θ(ℓ log ν).  A follow-up commit substitutes the balanced pairwise
  // merge via concatBytes.
  //
  // Storage-neutral: reads each chunk with a linear receive and
  // immediately re-parks it, so `hi - lo` chunks remain on the
  // tuplespace after this returns.
  // ==================================================================
  contract gatherChunks(@privateName, @chunkPName, @lo, @hi, ret) = {
    match hi - lo {
      0 => ret!("".hexToBytes())
      _ => {
        // Read chunk `lo`, re-park, then recurse on [lo+1, hi).
        for (@seg <- @[privateName, chunkPName, lo]) {
          @[privateName, chunkPName, lo]!(seg) |
          match hi - lo == 1 {
            true  => ret!(seg)
            false => {
              new tailCh in {
                gatherChunks!(privateName, chunkPName, lo + 1, hi, *tailCh) |
                for (@tail <- tailCh) {
                  // Concat via the linear-charged primitive.
                  ret!([seg, tail].concatBytes())
                }
              }
            }
          }
        }
      }
    }
  } |

  // ==================================================================
  // Module-level helper: drain chunks [lo, hi) — consume each chunk
  // WITHOUT re-parking, refunding its tuplespace storage.  Used by
  // clear() and close().
  //
  // Awaits each removal before signalling completion (spec §Concurrency
  // > Metadata-token mutex: "clear/close must await every chunk removal
  // before re-parking the metadata token, on every exit path" —
  // otherwise a concurrent read could observe a half-removed range).
  //
  // Signals completion by sending Nil on `done`.  The caller re-parks
  // the metadata token only after receiving on `done`.
  // ==================================================================
  contract drainChunks(@privateName, @chunkPName, @lo, @hi, done) = {
    match hi - lo {
      0 => done!(Nil)
      _ => {
        // Consume chunk `lo` (no re-park).
        for (@_seg <- @[privateName, chunkPName, lo]) {
          match hi - lo == 1 {
            true  => done!(Nil)
            false => drainChunks!(privateName, chunkPName, lo + 1, hi, *done)
          }
        }
      }
    }
  } |

  // ==================================================================
  // allocInnersLoop — recursively allocate `remaining` fresh inner
  // Buffers, each of capacity `capBytes` bytes and unit `unit`, and
  // accumulate them into a List via `acc`.  Returns `[true, inners]`
  // via `ret` on success, or `[false, code, msg]` on the first
  // Buffer-mint failure (spec §446: "on any failure it allocates no
  // inner buffers").  The accumulator is discarded on error, so
  // partially-allocated inner Buffers become unreachable and get
  // reclaimed by the deploy-end GC — no leak (M-13-2 fix).
  //
  // Note: Buffer's current implementation replies with a bare handle
  // rather than `[true, handle]`.  We shape-match both shapes so the
  // atomicity guarantee holds even if Buffer's reply format later
  // gains an ok-flag (matching Buffer!?'s !? sugar convention).
  //
  // Precondition: `remaining >= 0`, `capBytes > 0`.
  // ==================================================================
  contract allocInnersLoop(@remaining, @capBytes, @unit, @acc, ret) = {
    match remaining <= 0 {
      true  => ret!([true, acc])
      false => {
        // TODO(quota): when the FSERR_QUOTA_EXCEEDED quota-agent hook
        // lands (spec §446), invoke it here BEFORE Buffer!? and
        // forward its decline via the [false, _code, _msg] arm below.
        // The M-13-2 atomicity guarantee (discard the accumulator on
        // first failure) already handles the propagation shape.
        for (@bufReply <- Buffer!?(capBytes, unit)) {
          match bufReply {
            [true, bufHandle] => {
              allocInnersLoop!(remaining - 1, capBytes, unit,
                acc ++ [bufHandle], *ret)
            }
            [false, _code, _msg] => {
              // First-failure atomicity: discard the accumulator,
              // forward the error unchanged.  The already-allocated
              // buffers have no other holders and become unreachable.
              ret!(bufReply)
            }
            _ => {
              // Malformed reply — treat as a bare handle for
              // backward compat with Buffer's current constructor
              // shape (which returns just the handle).
              allocInnersLoop!(remaining - 1, capBytes, unit,
                acc ++ [bufReply], *ret)
            }
          }
        }
      }
    }
  } |

  // ==================================================================
  // parkInnersLoop — park each element of `inners` at
  // @[privateName, innerPName, i] for i in [0, m).  Used ONCE at
  // Rows construction; the parked handles are peeked (via <<-) by
  // getAt, so they stay in the tuplespace for the Rows instance's
  // lifetime.
  //
  // Precondition: inners.length() == m.
  // ==================================================================
  contract parkInnersLoop(@privateName, @innerPName, @i, @m, @inners) = {
    match i >= m {
      true  => Nil
      false => {
        @[privateName, innerPName, i]!(inners.nth(i)) |
        parkInnersLoop!(privateName, innerPName, i + 1, m, inners)
      }
    }
  } |

  // ==================================================================
  // clearInnersLoop — invoke `clear()` on each inner buffer parked at
  // @[privateName, innerPName, i] for i in [lo, hi).  Awaits each
  // reply sequentially before signalling `done`.  Ignores individual
  // clear failures; the outer Rows.clear reports [true] as long as
  // the loop completes.
  // ==================================================================
  contract clearInnersLoop(@privateName, @innerPName, @lo, @hi, done) = {
    match lo >= hi {
      true => done!(Nil)
      false => {
        for (@inner <<- @[privateName, innerPName, lo]) {
          for (@_reply <- @inner!?("clear")) {
            clearInnersLoop!(privateName, innerPName, lo + 1, hi, *done)
          }
        }
      }
    }
  } |

  // ==================================================================
  // closeInnersLoop — invoke `close()` on each inner buffer parked at
  // @[privateName, innerPName, i] for i in [lo, hi).  Same
  // sequencing discipline as clearInnersLoop.
  // ==================================================================
  contract closeInnersLoop(@privateName, @innerPName, @lo, @hi, done) = {
    match lo >= hi {
      true => done!(Nil)
      false => {
        for (@inner <<- @[privateName, innerPName, lo]) {
          for (@_reply <- @inner!?("close")) {
            closeInnersLoop!(privateName, innerPName, lo + 1, hi, *done)
          }
        }
      }
    }
  }
}
