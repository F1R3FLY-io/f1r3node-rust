// Buffer.rho — File I/O FIP §Buffers library (MVP slice).
//
// This is the first-pass implementation, covering:
//   - `Buffer` agent with: constructor, capacity, length, remaining,
//     isEmpty, isFull, unit, writeBytes, read, toByteArray, close,
//     beginFill, endFill, default.
//   - `Allocator` agent with `alloc(n, unit)`, `allocBytes`,
//     `allocUtf8`, `default`.
//
// Deferred to follow-up commits:
//   - `writeByte`, `slice`, `validUtf8PrefixLen`, `view`, `clear`
//     (§Buffer > Reads / Writes / Lifecycle).
//   - `Rows` agent + `allocRows` (§Fixed-size line reading).
//   - Publication to a fixed registry URN (currently the allocator is
//     minted but not published — tests scope it via inline `new`).
//   - The pairwise-merge helper `mergePairs` — for the MVP the `read`
//     method inlines a right-fold chunk gather.  A follow-up will
//     replace with the Θ(ℓ log ν) balanced pairwise merge required by
//     §Cost accounting > Buffers (currently Θ(ℓ ν) for ν chunks; still
//     correct, just costlier).
//
// State layout (spec §Buffers > Implementation notes):
//   metadata @[*private, *metaP]   — a 7-tuple or "REVOKED"
//   chunks   @[*private, *chunkP, j] — one segment per accepted write,
//                                       j ∈ [lo, hi); indices MONOTONIC
//                                       — clear() advances lo to hi.
//
// Concurrency: every named method acquires the metadata token via
// linear-receive with a free-variable pattern (spec §Metadata-token
// mutex), matches "REVOKED" first, does its work, and re-parks the
// token on every exit path.  The catch-all `_` arm makes the mutex
// robust against a hypothetical third payload shape.

new Buffer, Allocator, metaP, chunkP, gatherChunks, drainChunks in {

  // ==================================================================
  // Buffer agent
  // ==================================================================
  agent Buffer {
    constructor(@capBytes, @unit) {
      @[*private, *metaP]!((0, 0, capBytes, unit, "none", 0, 0))
    } |

    // -- Metadata queries (hold the token per spec §Metadata queries) --

    method capacity() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method length() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method remaining() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap - ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isEmpty() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == 0])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isFull() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method unit() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, _cap, u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, u])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Writes ------------------------------------------------------

    // writeBytes(xs) — always a (possibly short) success (spec §Write).
    // Parks ONE chunk at index `hi` with the k accepted bytes; k = 0
    // parks nothing (a full buffer cannot accumulate empty chunks).
    //
    // Type-guarded per spec §Buffers ("Every method that takes a numeric
    // or ByteArray argument guards it with match ... before any
    // arithmetic").  Without this guard, `xs.length()` on a non-ByteArray
    // caller-supplied value would raise MethodNotDefined — an
    // uncatchable interpreter error — inside the metadata critical
    // section, orphaning the token and bricking the buffer permanently.
    // The guard is BEFORE the token consumption so a bad arg never
    // touches state.
    method writeBytes(@xs) {
      match xs {
        b /\ ByteArray => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                // b is proven a ByteArray by the outer guard; .length()
                // and .slice() are safe here.
                match b.length() {
                  xsLen => {
                    match cap - ell {
                      room => {
                        match (xsLen <= room) {
                          true => {
                            match xsLen == 0 {
                              true => {
                                // Zero-length: park nothing.
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b) |
                                @[*private, *metaP]!(
                                  (ell + xsLen, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, xsLen])
                              }
                            }
                          }
                          false => {
                            // Short write.
                            match room == 0 {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b.slice(0, room)) |
                                @[*private, *metaP]!(
                                  (ell + room, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, room])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "xs must be a ByteArray"])
      }
    } |

    // -- Reads -------------------------------------------------------

    // read(n) — consume up to n bytes from position rho, advancing rho.
    // Refused with "BUFERR_FILLING" while a lease is held.
    //
    // MVP implementation: gathers chunks via a helper that reads each
    // chunk's segment linearly and re-sends it (storage-neutral).
    // Uses `gatherChunks` module-level helper that takes the
    // (privateName, chunkPName, lo, hi) so it can descend into the
    // instance's chunks.  See §Cost accounting > Buffers — MVP is
    // linear-fold; follow-up commit substitutes the balanced
    // pairwise merge.
    // read(n) — type-guarded per spec §Buffers.  Without the guard,
    // `n <= 0` on a non-Int caller-supplied `n` raises MethodNotDefined
    // inside the critical section, orphaning the token.
    method read(@n) {
      match n {
        i /\ Int => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                match lease {
                  "none" => {
                    // r = max(0, min(i, ell - rho))
                    match (i <= 0) {
                      true => {
                        @[*private, *metaP]!(meta) |
                        return!([true, "".hexToBytes()])
                      }
                      false => {
                        match (ell - rho) {
                          unread => {
                            match (unread <= 0) {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, "".hexToBytes()])
                              }
                              false => {
                                new gCh in {
                                  gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                  for (@allBytes <- gCh) {
                                    match (i <= unread) {
                                      true => {
                                        @[*private, *metaP]!(
                                          (ell, rho + i, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + i)])
                                      }
                                      false => {
                                        @[*private, *metaP]!(
                                          (ell, rho + unread, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + unread)])
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "fill in progress"])
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
      }
    } |

    // toByteArray() — copy of [0, ell), no cursor move.  Refused under
    // held lease.
    method toByteArray() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, lease, lo, hi) => {
            match lease {
              "none" => {
                match ell == 0 {
                  true => {
                    @[*private, *metaP]!(meta) |
                    return!([true, "".hexToBytes()])
                  }
                  false => {
                    new gCh in {
                      gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                      for (@allBytes <- gCh) {
                        @[*private, *metaP]!(meta) |
                        return!([true, allBytes.slice(0, ell)])
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "fill in progress"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Fill lease --------------------------------------------------

    method beginFill() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // Mint a fresh unforgeable name.  We return `*fillToken`
                // (the dereferenced name) rather than a bundle+ so that
                // endFill's equality check `lease == presented` sees the
                // same Par shape on both sides.  The name is still
                // unforgeable — a caller cannot construct it — and can
                // only be used by presenting it back to endFill.
                new fillToken in {
                  @[*private, *metaP]!((ell, rho, cap, u, *fillToken, lo, hi)) |
                  return!([true, *fillToken])
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "lease already held"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // endFill(presented) — release the lease iff `presented` matches
    // the active fillToken.
    //
    // Two-stage check fixes M-1: reject "no lease held" explicitly
    // BEFORE the equality comparison.  Without this, a caller passing
    // presented = "none" against lease "none" would get an
    // indistinguishable "success" reply even though no lease was ever
    // held — breaking ownership audits.
    method endFill(@presented) {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // No lease held; reject any presented token — including
                // presented == "none", which would otherwise falsely
                // report success (M-1 fix).
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "no lease held"])
              }
              _ => {
                // Lease is a Name.  `==` between Pars is total (structural
                // equality: identical Names → true, all other pairs →
                // false), so it never raises regardless of `presented`'s
                // type.
                match lease == presented {
                  true => {
                    @[*private, *metaP]!((ell, rho, cap, u, "none", lo, hi)) |
                    return!([true])
                  }
                  false => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "lease token mismatch"])
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Lifecycle ---------------------------------------------------

    // clear() — reset the buffer for reuse WITHOUT closing it.
    // Advances lo to hi (NEVER REWIND — consensus-safety invariant),
    // sets ell = rho = 0, releases any held lease.  Consumes stored
    // chunks so their storage is refunded within the deploy.
    //
    // Deliberately NOT lease-gated: this is the non-destructive
    // recovery path for a lease whose holder died or lost its token
    // (spec §Buffers > Fill lease > Abandonment).  Shipping clear() in
    // this phase (rather than deferring) gives the lease a
    // non-destructive escape hatch — otherwise the only recovery from
    // a stuck lease is close(), which revokes the buffer entirely.
    method clear() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                // NEVER REWIND lo — advance to hi.  This invariant is
                // load-bearing for consensus safety (spec §Buffers >
                // Implementation notes): a stale chunk-index observation
                // from a prior epoch must never collide with a
                // freshly-written chunk at the same index.
                @[*private, *metaP]!((0, 0, cap, u, "none", hi, hi)) |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // close() — replace metadata with "REVOKED" tombstone and drain
    // chunks (refunding storage within the deploy).  Deliberately not
    // lease-gated: it is a recovery path for a stuck lease.  Does not
    // remove the persistent dispatcher — the GC FIP reclaims that at
    // deploy end.
    method close() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
          (_ell, _rho, _cap, _u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                @[*private, *metaP]!("REVOKED") |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
        }
      }
    } |

    // -- Default arm -------------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Allocator agent — the buffer factory.
  // ==================================================================
  //
  // Capacity guards ordered `n <= n_max(unit)` BEFORE `n * 4` (avoid
  // Rholang's checked-Int multiplication overflow — spec §Formal
  // semantics > Allocation).
  //
  // L (platform capacity limit) = 1 GiB.  A quota-agent hook will
  // override this once §FSERR_QUOTA_EXCEEDED lands.
  agent Allocator {
    constructor() { Nil } |

    // alloc(nUnits, unit) — type-guarded per spec §Buffers.  Without
    // the Int guard, `nUnits <= 0` on a non-Int caller-supplied value
    // would raise MethodNotDefined, aborting the reduction and leaving
    // the caller's `!?` blocked forever (Mi-3 fix).
    method alloc(@nUnits, @unit) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match unit {
                "bytes" => {
                  match i > 1073741824 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i, "bytes")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                "utf8" => {
                  match i > 268435456 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                _ => return!([false, "BUFERR_INVALID_UNIT", "unit must be bytes or utf8"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    method allocBytes(@n) {
      match n {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "n must be positive"])
            false => {
              match i > 1073741824 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i, "bytes")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
      }
    } |

    method allocUtf8(@n) {
      match n {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "n must be positive"])
            false => {
              match i > 268435456 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
      }
    } |

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helper: gather chunks [lo, hi) into a single ByteArray.
  //
  // Takes `privateName` and `chunkPName` as parameters so it can
  // access an instance's chunks (the caller passes `*private, *chunkP`).
  // Uses a right-fold — cost is Θ(ℓ ν) not the spec-mandated
  // Θ(ℓ log ν).  A follow-up commit substitutes the balanced pairwise
  // merge via concatBytes.
  //
  // Storage-neutral: reads each chunk with a linear receive and
  // immediately re-parks it, so `hi - lo` chunks remain on the
  // tuplespace after this returns.
  // ==================================================================
  contract gatherChunks(@privateName, @chunkPName, @lo, @hi, ret) = {
    match hi - lo {
      0 => ret!("".hexToBytes())
      _ => {
        // Read chunk `lo`, re-park, then recurse on [lo+1, hi).
        for (@seg <- @[privateName, chunkPName, lo]) {
          @[privateName, chunkPName, lo]!(seg) |
          match hi - lo == 1 {
            true  => ret!(seg)
            false => {
              new tailCh in {
                gatherChunks!(privateName, chunkPName, lo + 1, hi, *tailCh) |
                for (@tail <- tailCh) {
                  // Concat via the linear-charged primitive.
                  ret!([seg, tail].concatBytes())
                }
              }
            }
          }
        }
      }
    }
  } |

  // ==================================================================
  // Module-level helper: drain chunks [lo, hi) — consume each chunk
  // WITHOUT re-parking, refunding its tuplespace storage.  Used by
  // clear() and close().
  //
  // Awaits each removal before signalling completion (spec §Concurrency
  // > Metadata-token mutex: "clear/close must await every chunk removal
  // before re-parking the metadata token, on every exit path" —
  // otherwise a concurrent read could observe a half-removed range).
  //
  // Signals completion by sending Nil on `done`.  The caller re-parks
  // the metadata token only after receiving on `done`.
  // ==================================================================
  contract drainChunks(@privateName, @chunkPName, @lo, @hi, done) = {
    match hi - lo {
      0 => done!(Nil)
      _ => {
        // Consume chunk `lo` (no re-park).
        for (@_seg <- @[privateName, chunkPName, lo]) {
          match hi - lo == 1 {
            true  => done!(Nil)
            false => drainChunks!(privateName, chunkPName, lo + 1, hi, *done)
          }
        }
      }
    }
  }
}
