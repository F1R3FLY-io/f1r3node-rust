//scalapackage coop.rchain.rholang.math

//requires NonNegativeNumber, TestSet
new
  rl(`rho:registry:lookup`), RhoSpecCh, NonNegativeNumberCh,
  test_initialize_with_negative_value, test_initialize_with_nonnegative_value,
  test_operations_with_negative_numbers, test_subtract_too_much, test_add_successful,
  test_subtract_successful, test_add_past_long_max, test_bigint_arguments,
  test_add_past_upper_bound
in {
  rl!(`rho:id:zphjgsfy13h1k85isc8rtwtgt3t9zzt5pjd5ihykfmyapfc4wt3x5h`, *RhoSpecCh) |
  for(@(_, RhoSpec) <- RhoSpecCh) {
    @RhoSpec!("testSuite",
      [
        ("Initially negative balances are be converted to 0.", *test_initialize_with_negative_value),
        ("Positive initial balances are preserved.", *test_initialize_with_nonnegative_value),
        ("Adding or subtracting a negative number fails.", *test_operations_with_negative_numbers),
        ("Subtracting an amount larger than the balance fails.", *test_subtract_too_much),
        ("Adding a positive number works if there's no overflow.", *test_add_successful),
        ("Subtracting a positive number less than or equal to the balance works", *test_subtract_successful),
        ("Addition past 2^63-1 does not overflow", *test_add_past_long_max),
        ("BigInt arguments are accepted", *test_bigint_arguments),
        ("Addition past 2^256-1 fails and keeps the value", *test_add_past_upper_bound)
      ])
  } |

  rl!(`rho:lang:nonNegativeNumber`, *NonNegativeNumberCh) |
  for(@(_, NonNegativeNumber) <- NonNegativeNumberCh) {
    contract test_initialize_with_negative_value(rhoSpec, _, ackCh) = {
      new ch1 in {
        @NonNegativeNumber!(-1, *ch1) |
        for (v1 <- ch1) {
          v1!("value", *ch1) |
          rhoSpec!("assert", (0n, "== <-", *ch1), "-1 is converted to 0", *ackCh)
        }
      }
    } |

    contract test_initialize_with_nonnegative_value(rhoSpec, _, ackCh) = {
      new ch1, ch2 in {
        @NonNegativeNumber!(0, *ch1) |
        @NonNegativeNumber!(1, *ch2) |
        for (v1 <- ch1 & v2 <- ch2) {
          v1!("value", *ch1) |
          v2!("value", *ch2) |
          rhoSpec!("assertMany",
            [
              ((0n, "== <-", *ch1), "0 stays the same"),
              ((1n, "== <-", *ch2), "1 stays the same"),
            ],
            *ackCh)
        }
      }
    } |

    contract test_operations_with_negative_numbers(rhoSpec, _, ackCh) = {
      new ch, ch1, ch2 in {
        @NonNegativeNumber!(0, *ch) |
        for (v <- ch) {
          v!("add", -1, *ch1) |
          v!("sub", -1, *ch2) |
          rhoSpec!("assertMany",
            [
              ((false, "== <-", *ch1), "Adding a negative number fails"),
              ((false, "== <-", *ch2), "Subtracting a negative number fails"),
            ],
            *ackCh)
        }
      }
    } |

    contract test_subtract_too_much(rhoSpec, _, ackCh) = {
      new ch in {
        @NonNegativeNumber!(0, *ch) |
        for (v <- ch) {
          v!("sub", 1, *ch) |
          rhoSpec!("assert", (false, "== <-", *ch), "subtracting fails", *ackCh)
        }
      }
    } |

    contract test_add_successful(rhoSpec, _, ackCh) = {
      new ch in {
        @NonNegativeNumber!(0, *ch) |
        for (nn <- ch) {
          nn!("add", 1, *ch) |
          for (@result <- ch) {
            nn!("value", *ch) |
            rhoSpec!("assertMany",
              [
                ((true, "==", result), "add succeeds"),
                ((1n, "== <-", *ch), "result is correct"),
              ],
              *ackCh)
          }
        }
      }
    } |

    contract test_subtract_successful(rhoSpec, _, ackCh) = {
      new ch in {
        @NonNegativeNumber!(2, *ch) |
        for (nn <- ch) {
          nn!("sub", 1, *ch) |
          for (@result <- ch) {
            nn!("value", *ch) |
            rhoSpec!("assertMany",
              [
                ((true, "==", result), "sub succeeds"),
                ((1n, "== <-", *ch), "result is correct"),
              ],
              *ackCh)
          }
        }
      }
    } |

    contract test_add_past_long_max(rhoSpec, _, ackCh) = {
      new ch, addCh, subCh, valueCh in {
        @NonNegativeNumber!(9223372036854775757, *ch) |
        for (nn <- ch) {
          nn!("add", 9223372036854775757, *addCh) |
          for (@added <- addCh) {
            nn!("sub", 9223372036854775757, *subCh) |
            for (@subtracted <- subCh) {
              nn!("value", *valueCh) |
              rhoSpec!("assertMany",
                [
                  ((true, "==", added), "add past 2^63-1 succeeds"),
                  ((true, "==", subtracted), "sub back succeeds"),
                  ((9223372036854775757n, "== <-", *valueCh), "round trip keeps the exact value"),
                ],
                *ackCh)
            }
          }
        }
      }
    } |

    contract test_bigint_arguments(rhoSpec, _, ackCh) = {
      new ch, addCh, subCh, valueCh in {
        @NonNegativeNumber!(1000000000000000000000000000000n, *ch) |
        for (nn <- ch) {
          nn!("add", 1n, *addCh) |
          for (@added <- addCh) {
            nn!("sub", 1000000000000000000000000000000n, *subCh) |
            for (@subtracted <- subCh) {
              nn!("value", *valueCh) |
              rhoSpec!("assertMany",
                [
                  ((true, "==", added), "BigInt add succeeds"),
                  ((true, "==", subtracted), "BigInt sub succeeds"),
                  ((1n, "== <-", *valueCh), "BigInt result is correct"),
                ],
                *ackCh)
            }
          }
        }
      }
    } |

    contract test_add_past_upper_bound(rhoSpec, _, ackCh) = {
      new ch, atMaxCh, pastMaxCh, valueCh in {
        @NonNegativeNumber!(0n, *ch) |
        for (nn <- ch) {
          nn!("add", 115792089237316195423570985008687907853269984665640564039457584007913129639935n, *atMaxCh) |
          for (@atMax <- atMaxCh) {
            nn!("add", 1, *pastMaxCh) |
            for (@pastMax <- pastMaxCh) {
              nn!("value", *valueCh) |
              rhoSpec!("assertMany",
                [
                  ((true, "==", atMax), "add up to 2^256-1 succeeds"),
                  ((false, "==", pastMax), "add past 2^256-1 fails"),
                  ((115792089237316195423570985008687907853269984665640564039457584007913129639935n, "== <-", *valueCh), "the value stays at 2^256-1"),
                ],
                *ackCh)
            }
          }
        }
      }
    }
  }
}
