new
  rl(`rho:registry:lookup`), RhoSpecCh,
  getBlockData(`rho:block:data`),
  setBlockData(`rho:test:block:data:set`),
  stdlog(`rho:io:stdlog`),
  test_get_block_data
in {
  rl!(`rho:id:zphjgsfy13h1k85isc8rtwtgt3t9zzt5pjd5ihykfmyapfc4wt3x5h`, *RhoSpecCh) |
  for(@(_, RhoSpec) <- RhoSpecCh) {
    @RhoSpec!("testSuite",
      [
        ("rho:block:data returns", *test_get_block_data)
      ])
  } |

  contract test_get_block_data(rhoSpec, _, ackCh) = {
    new retCh, setCh in {
      getBlockData!(*retCh) |
      for (@blockNumber, @timestamp, @sender <- retCh) {
        setBlockData!("blockNumber", 1, *setCh) |
        for (_ <- setCh) {
          rhoSpec!("assertMany",
            [
              ((0, "==", timestamp), "timestamp is zero"),
              ((0, "==", blockNumber), "the blocknumber is zero"),
              (("00".hexToBytes(), "==", sender), "sender is 0x00")
            ], *ackCh)
        }
      }
    }
  }
}
