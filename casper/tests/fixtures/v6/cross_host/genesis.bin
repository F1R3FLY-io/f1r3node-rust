A.¸æÓL†âáú²‹ÃëJ!yîu]øÎL±—¶=â§ìç…Ó¢Ë‰&UYÄ.¦k“ÎMÒöûm8Û¸`&‚œÃÄÎ&
new
  File, fdP, stateP, cmodeP, Dir, rootP,
  Stream, paramsP, gatherN, foldLoop, forEachLoop, foldChunksLoop,
  Buffer, Allocator, Rows, metaP, chunkP, innerP, rowsMetaP,
  gatherChunks, drainChunks, allocInnersLoop, parkInnersLoop,
  clearInnersLoop, closeInnersLoop,
  // M-13 (A1-F-10, 2026-09-04) writeByte helpers.  Buffer.rho's own
  // outer `new` binds these; `lib_body` strips that outer scope
  // when pasting Buffer's body into the composed source, so the
  // composed outer scope must re-bind them here or the pasted
  // `contract hexDigit(...)` binds `hexDigit` as a ContextFree
  // name and the downstream `hexDigit!(...)` call collides.  The
  // comment in the M-13 anchor claimed these were added at
  // composition time; that commit landed the Buffer-side binding
  // and the anchor comment but the composed-scope re-binding did
  // not.  Fix (2026-09-08): re-bind at the composed outer scope.
  hexDigit, intToOneByte,
  Stdin, stdinFdP, stdinStateP,
  Stdout, stdoutFdP, stdoutStateP,
  Fs, fsBundleP,
  fsStdinFdP, fsStdoutFdP, fsStderrFdP,
  // Ambient-authority off-switch (2026-09-03).  Module-level cell
  // shared across every Fs instance; flipped by Fs.revoke().
  // Initialized to `false` at composition time by the module body.
  // See Fs.rho's top-of-file docstring + FIP Â§Revocation.
  fsRevokedP,
  openFileImpl, openFileImplInner, openDirImpl, openDirImplInner, joinRel,
  // parseRwxToBits + parseRwxLoop retired 2026-09-04 (mode-consistency
  // migration â€” chmod now takes Int mode-bits matching stat.mode).
  writeBytesLoop, writeBytesAtLoop, writeCharsLoop, writeLinesLoop,
  readLinesIntoLoop, drainToNextLF,
  codepointLen, concatStringsLoop, scanLineForLF,
  // Phase 8 slice 8a â€” LockToken agent + per-instance state key.
  // See File.rho's module-level `new` docstring for the design
  // rationale; must be bound at THIS outer scope because File.rho
  // gets its own top-level `new` stripped by `lib_body` at
  // composition time.
  LockToken, lockStateP,
  // Phase 8 slice 8c â€” auto-acquire helpers for options-map-taking
  // method variants (spec Â§1181).  Encapsulate the acquire â†’
  // inner-action â†’ release dance so per-method variants avoid
  // duplicating ~50 lines of Rholang wraps each.  Defined at the
  // end of File.rho; bound here for the same reason as LockToken
  // (File.rho's top-level `new` is stripped by lib_body).
  withSequentialLock, withRangeLock,
  // Phase 8 slice 8d â€” hand-off helpers for stream-lifetime-locked
  // method variants (chars, bytes, lines, bytesAt).  Acquire the
  // lock and hand the LockId to the caller via lockOut; the caller's
  // stream constructor stores it in the existing lockCell so release
  // fires from stream termination as today.
  acquireRangeForStream, acquireSequentialForStream,
  // RH-2 (2026-09-04) stream-lifetime release-once helper â€” every
  // stream producer's termination path invokes this to fire
  // fsReleaseLock exactly once regardless of how many termination
  // paths race.  See File.rho's `contract releaseSeqLockOnce` for
  // the invariant.
  releaseSeqLockOnce,
  // Phase 8 slice 8d-2 â€” companion loop for writeLines arity-2 that
  // threads the options map (with wait:true) to each internal writeLine
  // arity-2 call.  Same shape as writeLinesLoop but arity 5 not 4.
  writeLinesLoopWithOptions,
  fsOpen(`rho:io:fs:native:1.0.0/open`),
  fsClose(`rho:io:fs:native:1.0.0/close`),
  fsRead(`rho:io:fs:native:1.0.0/read`),
  fsReadAt(`rho:io:fs:native:1.0.0/readAt`),
  fsWrite(`rho:io:fs:native:1.0.0/write`),
  fsWriteAt(`rho:io:fs:native:1.0.0/writeAt`),
  fsSeek(`rho:io:fs:native:1.0.0/seek`),
  fsTell(`rho:io:fs:native:1.0.0/tell`),
  fsSize(`rho:io:fs:native:1.0.0/size`),
  fsFlush(`rho:io:fs:native:1.0.0/flush`),
  fsStat(`rho:io:fs:native:1.0.0/stat`),
  fsExists(`rho:io:fs:native:1.0.0/exists`),
  fsTruncate(`rho:io:fs:native:1.0.0/truncate`),
  fsChmod(`rho:io:fs:native:1.0.0/chmod`),
  fsChown(`rho:io:fs:native:1.0.0/chown`),
  fsRemoveFile(`rho:io:fs:native:1.0.0/removeFile`),
  fsRemoveDir(`rho:io:fs:native:1.0.0/removeDir`),
  fsRename(`rho:io:fs:native:1.0.0/rename`),
  fsCopyFile(`rho:io:fs:native:1.0.0/copyFile`),
  fsEntries(`rho:io:fs:native:1.0.0/entries`),
  fsEntriesStreamOpen(`rho:io:fs:native:1.0.0/entriesStreamOpen`),
  fsEntriesStreamNext(`rho:io:fs:native:1.0.0/entriesStreamNext`),
  fsEntriesStreamClose(`rho:io:fs:native:1.0.0/entriesStreamClose`),
  fsQuarantine(`rho:io:fs:native:1.0.0/quarantine`),
  fsLockRange(`rho:io:fs:native:1.0.0/lockRange`),
  fsLockSequential(`rho:io:fs:native:1.0.0/lockSequential`),
  fsReleaseLock(`rho:io:fs:native:1.0.0/releaseLock`),
  fsReleaseAllForHolder(`rho:io:fs:native:1.0.0/releaseAllForHolder`),
  rs(`rho:registry:insertSigned:secp256k1`),
  uriOut,
  // PB-B-3 (2026-08-24): Versioned Registry publication.  `v1Api`
  // is VersionedRegistry.rho's internal API channel; we bind it
  // directly (rather than going through `rho:registry:1.0.0` +
  // `getReg`) because we already have URN-binding scope at outer
  // `new`.  `insertVersion("serve", "fs", "1.0.0", fs, *ret)`
  // stores `fs` in the store under
  // `(FS_GENERATOR_PUB_KEY_HEX, "fs")["1.0.0"]`, resolvable via
  // `rho:serve:1.0.0:<FS_GENERATOR_PUB_KEY_HEX>:fs:1.0.0`.  Same
  // `fs` Par as insertSigned publishes at `rho:id:<hash>`, so
  // both URIs resolve to the same underlying cap.  `insertVerRet`
  // is drained (`for(_ <- insertVerRet)`) to enforce a happens-
  // before edge between the mutator and any subsequent lookup in
  // the same deploy; genesis is the sole registrant under this
  // pk_hex/proj pair by construction so it cannot collide.
  v1Api(`rho:registry:v1:internal`), insertVerRet, allocInsertVerRet
in {
  

  agent File {
    // M-26-2 review fix: validate `cmode` at mint time.  Only the two
    // Rholang string literals "oracular" and "consensus" are accepted;
    // any other value (Nil, Int, tuple, mistyped string) causes the
    // agent to REVOKE its own state so subsequent method calls fail
    // fast with a clear diagnostic rather than silently defaulting.
    // Today only openFileImpl in Dir.rho reaches this constructor and
    // it always passes the parent Dir's known-good `cmode`; the
    // validation is defense-in-depth against a FUTURE library added
    // to the composed `new` scope that mints File caps with an
    // attacker-chosen cmode.
    constructor(@fd, @canonRoot, @rel, @mode, @cmode) {
      match cmode {
        "oracular" \/ "consensus" => {
          @[*private, *fdP]!((fd, canonRoot, rel, mode)) |
          @[*private, *stateP]!("open") |
          @[*private, *cmodeP]!(cmode)
        }
        _ => {
          @[*private, *fdP]!("REVOKED") |
          @[*private, *stateP]!("closed") |
          @[*private, *cmodeP]!("consensus")
        }
      }
    } |

    // -- writeByteArray ---------------------------------------------
    //
    // Phase 8 slice 8a step 4e-1: acquires a whole-file sequential
    // lock around the fsWrite call.  Sequential (not range) because
    // writeByteArray operates at the file's cursor â€” consistent with
    // spec Â§Sequential vs. positional and FIP Â§1143's "one active
    // sequential stream per File" invariant.  Under Prep A's rule,
    // sequential remains STRICT even for same-holder: an explicit
    // lockRange or another sequential stream on the same cap will
    // block this write with FSERR_BUSY (correct â€” the cursor is a
    // per-cap shared resource that concurrent operations MUST
    // serialize on).  Zero-length write short-circuits before both
    // the lock (LockRegistry rejects, but sequential doesn't have a
    // length arg â€” different reason: match pre-lock no-op semantics).
    method writeByteArray(@bytes) {
      match bytes {
        b /\ ByteArray => {
          for (@state <- @[*private, *stateP]) {
            match state {
              "closed" => {
                @[*private, *stateP]!("closed") |
                return!([false, "FSERR_CLOSED", "file is closed"])
              }
              "open" => {
                for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                  match params {
                    (fd, _root, _rel, mode) => {
                      match mode {
                        "r" => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_UNSUPPORTED", "read-only file"])
                        }
                        _ => {
                          new lockCh in {
                            // holder MUST be *this â€” cross-cap
                            // coordination depends on it.
                            fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                            for (@lockReply <- lockCh) {
                              match lockReply {
                                [true, lid] => {
                                  new retCh in {
                                    fsWrite!(fd, b, *retCh) |
                                    for (@reply <- retCh) {
                                      new relCh in {
                                        fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                        for (@_relReply <- relCh) {
                                          @[*private, *stateP]!("open") |
                                          return!(reply)
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  // Lock acquire failed â€” forward.
                                  @[*private, *stateP]!("open") |
                                  return!(lockReply)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    _ => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_IO", "fd params malformed"])
                    }
                  }
                }
              }
              _ => {
                @[*private, *stateP]!("closed") |
                return!([false, "FSERR_CLOSED", "file state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "bytes must be a ByteArray"])
      }
    } |

    // -- writeByteArray (arity-2, options-map variant) â€” slice 8c
    //
    // Per spec Â§1181: sequential producers accept an optional trailing
    // `{"wait": true}` options-map argument.  On active-sequential-
    // stream conflict, wait:true blocks until acquisition instead of
    // returning FSERR_BUSY.  Default: fail.
    //
    // Delegates the acquire/release dance to `withSequentialLock`
    // helper â€” no per-method body duplication.  stateP is released
    // early (after the state check) so a concurrent close() on this
    // cap can proceed while the wait is parked (see slice 8b sub-6
    // review-fix B3 for the concurrent-close rationale).
    method writeByteArray(@bytes, @options) {
      match bytes {
        b /\ ByteArray => {
          match options.get("wait") {
            wOpt /\ (Nil \/ Bool) => {
              // Normalize Nil â†’ false; Bool â†’ itself.
              new waitCh in {
                match wOpt {
                  Nil            => waitCh!(false)
                  bb /\ Bool     => waitCh!(bb)
                } |
                for (@w <- waitCh) {
                  for (@state <- @[*private, *stateP]) {
                    match state {
                      "closed" => {
                        @[*private, *stateP]!("closed") |
                        return!([false, "FSERR_CLOSED", "file is closed"])
                      }
                      "open" => {
                        // Early stateP release (slice 8b B3 pattern).
                        @[*private, *stateP]!("open") |
                        for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                          match params {
                            (fd, _root, _rel, mode) => {
                              match mode {
                                "r" => return!([false, "FSERR_UNSUPPORTED", "read-only file"])
                                _   => {
                                  new innerCh, retCh in {
                                    // Inner action: on receiving a
                                    // callback, do fsWrite and reply.
                                    for (@cb <- innerCh) {
                                      new writeCh in {
                                        fsWrite!(fd, b, *writeCh) |
                                        for (@writeReply <- writeCh) { @cb!(writeReply) }
                                      }
                                    } |
                                    withSequentialLock!(fd, *this, cmode, w, *innerCh, *retCh) |
                                    for (@r <- retCh) { return!(r) }
                                  }
                                }
                              }
                            }
                            _ => return!([false, "FSERR_IO", "fd params malformed"])
                          }
                        }
                      }
                      _ => {
                        @[*private, *stateP]!("closed") |
                        return!([false, "FSERR_CLOSED", "file state unrecognized"])
                      }
                    }
                  }
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "bytes must be a ByteArray"])
      }
    } |

    // -- writeString(s) ---------------------------------------------
    method writeString(@s) {
      match s {
        str /\ String => {
          for (@reply <- @(*this)!?("writeByteArray", str.toUtf8Bytes())) {
            return!(reply)
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "s must be a String"])
      }
    } |

    // -- writeString(s, options) â€” slice 8d-2 arity-2 variant
    //
    // Per spec Â§1181: sequential producers accept a trailing options
    // map for wait:true.  writeString delegates to writeByteArray;
    // the arity-2 variant simply forwards options to writeByteArray's
    // slice-8c arity-2 form.  wait extraction + FSERR_BAD_ARG on
    // non-Bool wait happens inside writeByteArray arity-2, so this
    // wrapper is just a pass-through.
    method writeString(@s, @options) {
      match s {
        str /\ String => {
          for (@reply <- @(*this)!?("writeByteArray", str.toUtf8Bytes(), options)) {
            return!(reply)
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "s must be a String"])
      }
    } |

    // -- readN(n) ---------------------------------------------------
    //
    // Spec: Â§Read-side stream producers > Bounded convenience.  A
    // bounded, non-streaming read that returns the next n bytes at
    // cursor as a single ByteArray.  Streaming callers use `bytes()`;
    // callers that want to fill a preallocated buffer use
    // `readInto(buf)`.  readN covers the middle ground: a bounded
    // read into a fresh ByteArray reply payload, useful for
    // verification / probing / small-fixture reads where allocating
    // a Buffer would be overkill.
    //
    // n = 0 is a no-op returning [true, empty ByteArray] â€” matches
    // Unix read(2) semantics.  Negative n is rejected as FSERR_BAD_ARG.
    method readN(@n) {
      match n {
        i /\ Int => {
          match i < 0 {
            true => return!([false, "FSERR_BAD_ARG", "n must be non-negative"])
            false => {
              match i == 0 {
                true => return!([true, "".hexToBytes()])
                false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    // RH-A5-2 fix (2026-09-04): wrap fsRead in
                    // fsLockSequential to serialize the cursor
                    // mutation.  Prior slice let concurrent
                    // readN + writeByteArray on the same cap race
                    // the shared kernel cursor â€” under Consensus a
                    // divergent cursor would flip reply payloads
                    // across validators.  Now mirrors every other
                    // cursor-mutating peer method (writeByteArray,
                    // bytes, chars, lines, readLine, readInto,
                    // writeChars, writeLine, writeLines).
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockCh in {
                            fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                            for (@lockReply <- lockCh) {
                              match lockReply {
                                [true, lid] => {
                                  new retCh in {
                                    fsRead!(fd, i, *retCh) |
                                    for (@reply <- retCh) {
                                      new relCh in {
                                        fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                        for (@_relReply <- relCh) {
                                          @[*private, *stateP]!("open") |
                                          return!(reply)
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  @[*private, *stateP]!("open") |
                                  return!(lockReply)
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "n must be an integer"])
      }
    } |

    // -- seek(offset, whence) ---------------------------------------
    method seek(@offset, @whence) {
      match offset {
        o /\ Int => {
          match whence {
            w /\ String => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new retCh in {
                            fsSeek!(fd, o, w, *retCh) |
                            for (@reply <- retCh) {
                              @[*private, *stateP]!("open") |
                              return!(reply)
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "whence must be a String"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- tell() -----------------------------------------------------
    method tell() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  new retCh in {
                    fsTell!(fd, *retCh) |
                    for (@reply <- retCh) {
                      @[*private, *stateP]!("open") |
                      return!(reply)
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- size() -----------------------------------------------------
    method size() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  new retCh in {
                    fsSize!(fd, *retCh) |
                    for (@reply <- retCh) {
                      @[*private, *stateP]!("open") |
                      return!(reply)
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- flush() ----------------------------------------------------
    method flush() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  new retCh in {
                    fsFlush!(fd, *retCh) |
                    for (@reply <- retCh) {
                      @[*private, *stateP]!("open") |
                      return!(reply)
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- close() ----------------------------------------------------
    method close() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([true])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // Phase 8 slice 8a step 4f: sweep every lock held via
                  // this cap BEFORE dispatching fsClose.  Spec Â§File >
                  // close: "Implicitly releases every range lock held
                  // via this File cap (both implicit locks on active
                  // streams and explicit lockRange locks whose lockToken
                  // was issued by this cap); any subsequent
                  // lockToken!release() on those tokens returns
                  // [false, FSERR_CLOSED, ...]."  The sweep is scoped
                  // by HolderId (Blake2b256(*this)) so locks held on
                  // the same (dev, inode) via other File caps survive
                  // â€” each fresh-mint cap has its own per-instance
                  // `this` name (from `new this, private in { ... }`
                  // in the agent-block desugaring), so distinct caps
                  // produce distinct HolderIds.
                  //
                  // holder MUST be *this â€” cross-cap coordination
                  // depends on it; same invariant as the auto-acquire
                  // wraps in every positional / sequential method.
                  //
                  // Rationale for sweep-before-close ordering: fsClose
                  // drops the OS fd, at which point subsequent
                  // fs_release_lock calls would still succeed at the
                  // LockRegistry layer (the registry is keyed on
                  // (dev, inode), not fd â€” see lock.rs Â§Cross-cap
                  // forgery safety), but stranding locks past the
                  // fd close is a foot-gun: the closed-File caller
                  // can no longer meaningfully act on them, and any
                  // cross-cap holder waiting on the same range is
                  // blocked until deploy-end auto-release (Â§Explicit
                  // locks MUST) sweeps.  Sweeping here closes the gap.
                  new sweepCh in {
                    fsReleaseAllForHolder!(*this, *sweepCh) |
                    // reply is `[true, N]` â€” count intentionally
                    // discarded here.  The N is exposed via the
                    // native handler's WAL entry (surfaced to observers
                    // via `journal_write`); Rholang callers only need
                    // the "close succeeded" signal.
                    for (@_sweepReply <- sweepCh) {
                      new retCh in {
                        fsClose!(fd, *retCh) |
                        for (@reply <- retCh) {
                          @[*private, *stateP]!("closed") |
                          match reply {
                            [true] => return!([true])
                            _      => return!(reply)
                          }
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("closed") |
                  return!([true])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([true])
          }
        }
      }
    } |

    // -- truncate(n) ------------------------------------------------
    //
    // Spec Â§File.truncate: requires write-capable mode.  Unlike path-
    // based mutation methods (removeFile, chmod, etc.), truncate is
    // fd-based, so no `cmode` is threaded to the native â€” the native
    // resolves the file via the fd table and applies the (already-
    // baked-into-the-fd) cmode at open time.  Rholang readers
    // comparing this method to path-based mutations will notice the
    // divergence; it is intentional.
    method truncate(@n) {
      match n {
        i /\ Int => {
          match i < 0 {
            true => return!([false, "FSERR_BAD_ARG", "n must be non-negative"])
            false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => {
                              @[*private, *stateP]!("open") |
                              return!([false, "FSERR_UNSUPPORTED",
                                "truncate requires a write-capable mode"])
                            }
                            _ => {
                              new retCh in {
                                fsTruncate!(fd, i, *retCh) |
                                for (@reply <- retCh) {
                                  @[*private, *stateP]!("open") |
                                  return!(reply)
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "n must be an integer"])
      }
    } |

    // -- chmod(mode) ------------------------------------------------
    //
    // Spec Â§File > Permissions: "Available only if the file
    // was opened in a write-capable mode; FSERR_UNSUPPORTED otherwise."
    // Read-only Files reject chmod (M-1 fix).
    //
    // Uses the stored `rel` from the fd tuple (B-3 fix) â€” the prior
    // slice passed `""` and every real call broke on Phase 1's
    // safe_descend, which returns QuarantineError::Empty on empty rel.
    // Mode-consistency fix (2026-09-04): input is now POSIX mode bits
    // as `Int`, matching `stat.mode`'s emission shape.  Round-trips
    // trivially: `stat(rel).get("mode") â†’ chmod(mode)`.  Callers who
    // want the human-readable rwx string decode the integer themselves
    // (this is `stat`'s asymmetry too â€” machine-parseable on the wire,
    // format for humans at the caller layer).  Range [0, 0o7777] per
    // POSIX; higher bits (setuid / setgid / sticky) are accepted at
    // this layer but the native handler masks against 0o777 anyway
    // (setuid semantics are unsafe under the sandbox and intentionally
    // not exposed â€” see spec Â§Metadata > mode field).
    method chmod(@mode) {
      match mode {
        m /\ Int => {
          match m < 0 or m > 4095 {
            true => return!([false, "FSERR_BAD_ARG",
              "mode must be an Int in [0, 0o7777]"])
            false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    // H-29-3 lift (2026-08-26): Consensus caps now
                    // supported â€” fs_chmod journals a Chmod WAL entry
                    // pre-syscall, symmetric on leader and follower.
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (_fd, canonRoot, rel, fmode) => {
                          match fmode {
                            "r" => {
                              @[*private, *stateP]!("open") |
                              return!([false, "FSERR_UNSUPPORTED",
                                "chmod requires a write-capable mode"])
                            }
                            _ => {
                              new retCh in {
                                fsChmod!(canonRoot, rel, m, cmode, *retCh) |
                                for (@reply <- retCh) {
                                  @[*private, *stateP]!("open") |
                                  return!(reply)
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "mode must be an Int"])
      }
    } |

    // -- chown(owner, group) ---------------------------------------
    //
    // Spec Â§File > Permissions: write-capable mode only.
    // Uses stored `rel` (B-3 fix); gated on write-mode (M-1 fix).
    method chown(@owner, @group) {
      new ownerOk, groupOk in {
        match owner {
          s /\ String => {
            match s {
              "" => ownerOk!([false, "FSERR_BAD_ARG",
                "owner must be non-empty or Nil"])
              _  => ownerOk!([true, s])
            }
          }
          Nil => ownerOk!([true, Nil])
          _ => ownerOk!([false, "FSERR_BAD_ARG",
            "owner must be String or Nil"])
        } |
        match group {
          s /\ String => {
            match s {
              "" => groupOk!([false, "FSERR_BAD_ARG",
                "group must be non-empty or Nil"])
              _  => groupOk!([true, s])
            }
          }
          Nil => groupOk!([true, Nil])
          _ => groupOk!([false, "FSERR_BAD_ARG",
            "group must be String or Nil"])
        } |
        for (@ov <- ownerOk; @gv <- groupOk) {
          match [ov, gv] {
            [[true, o], [true, g]] => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (_fd, canonRoot, rel, fmode) => {
                          match fmode {
                            "r" => {
                              @[*private, *stateP]!("open") |
                              return!([false, "FSERR_UNSUPPORTED",
                                "chown requires a write-capable mode"])
                            }
                            _ => {
                              new retCh in {
                                // Forward the cap's `cmode` to
                                // `fsChown`.  Post-H-29-3 lift
                                // (2026-08-26): Consensus caps
                                // journal a Chown WAL entry and
                                // perform the fchownat syscall;
                                // NSS-mapping symmetry across
                                // validators is an operator
                                // responsibility.
                                fsChown!(canonRoot, rel, o, g, cmode, *retCh) |
                                for (@reply <- retCh) {
                                  @[*private, *stateP]!("open") |
                                  return!(reply)
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
            [[false, _, _], _] => return!(ov)
            [_, [false, _, _]] => return!(gv)
            _ => return!([false, "FSERR_IO", "chown validation malformed"])
          }
        }
      }
    } |

    // -- lockRange(offset, length, mode) ---------------------------
    //
    // Phase 8 slice 8a step 4c-2 â€” spec Â§Explicit locks.  Acquire a
    // positional range lock over `[offset, offset+length)` in mode
    // `mode âˆˆ {"r", "w"}` and return a LockToken the caller can
    // `release` when done.  Held until `release` OR deploy-end auto-
    // release (Â§Explicit locks MUST) OR File.close's sweep of every
    // lock held via this cap (Â§File > close).
    //
    // Composition with implicit locks: same-holder overlapping
    // acquires never conflict per spec Â§Range locks (2026-08-12
    // refinement).  A caller holding an explicit `lockRange(0, 1024,
    // "w")` may continue to invoke `writeBytesAt` / `bytesAt` / etc.
    // on the same cap; the positional call's implicit auto-acquire
    // coexists with the explicit lock rather than tripping FSERR_BUSY.
    // Cross-cap acquires (distinct holder) still coordinate under the
    // normal read-vs-write rules.
    //
    // Mode attenuation (spec Â§Explicit locks): a "w" lock request on
    // a File opened "r" is refused with FSERR_UNSUPPORTED â€” the
    // attenuation matches every other write-capable method.
    //
    // Same-holder self-conflict is not possible from THIS cap because
    // the LockRegistry's same-holder-skip rule (X-1 Â§Slice-1 addendum)
    // permits overlapping same-holder acquires; the two entries coexist
    // and each releases independently.
    method lockRange(@offset, @length, @mode) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match length {
                len /\ Int => {
                  match len <= 0 {
                    true => return!([false, "FSERR_BAD_ARG",
                      "length must be > 0 (LockRegistry rejects zero-length ranges as BadArg)"])
                    false => {
                      match mode {
                        m /\ String => {
                          match m {
                            "r" \/ "w" => {
                              for (@state <- @[*private, *stateP]) {
                                match state {
                                  "closed" => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file is closed"])
                                  }
                                  "open" => {
                                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                                      match params {
                                        (fd, _root, _rel, fmode) => {
                                          // Mode attenuation: "w" lock requires write-capable file mode.
                                          match [m, fmode] {
                                            ["w", "r"] => {
                                              @[*private, *stateP]!("open") |
                                              return!([false, "FSERR_UNSUPPORTED",
                                                "cannot acquire write lock on read-only file"])
                                            }
                                            _ => {
                                              new lockCh in {
                                                // holder MUST be *this â€” cross-cap coordination
                                                // depends on it.  Each fresh-mint File cap has a
                                                // unique per-instance `this` (from `new this,
                                                // private in { ... }` in the agent-block
                                                // desugaring), hashed by fs_lock_range to a
                                                // stable HolderId via Blake2b256.  Passing
                                                // `*stateP` (or any other MODULE-level binding)
                                                // would collapse every cap to a single holder
                                                // and break Â§Range locks' different-holder rule.
                                                fsLockRange!(fd, off, len, m, *this, cmode, false, *lockCh) |
                                                for (@reply <- lockCh) {
                                                  @[*private, *stateP]!("open") |
                                                  match reply {
                                                    [true, lid] => {
                                                      // Mint a LockToken agent wrapping the LockId;
                                                      // return the bundle+ handle to the caller.
                                                      for (@token <- LockToken!?(lid, *this)) {
                                                        return!([true, token])
                                                      }
                                                    }
                                                    _ => return!(reply)
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                        _ => {
                                          @[*private, *stateP]!("open") |
                                          return!([false, "FSERR_IO", "fd params malformed"])
                                        }
                                      }
                                    }
                                  }
                                  _ => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                                  }
                                }
                              }
                            }
                            _ => return!([false, "FSERR_BAD_ARG",
                              "mode must be \"r\" or \"w\""])
                          }
                        }
                        _ => return!([false, "FSERR_BAD_ARG",
                          "mode must be a String"])
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "length must be an integer"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- lockRange (arity-4, options-map variant) â€” Phase 8 slice 8b sub-4
    //
    // Explicit range-lock acquisition with per-spec Â§Explicit locks
    // + Â§1181 options-map argument.  Callers pass `{"wait": true}`
    // to opt into blocking acquisition; on lock conflict, the acquire
    // parks in the LockRegistry's FIFO waiter queue (slice 8b sub-1)
    // and admits when the conflicting holder releases (deploy end via
    // sub-3, explicit release via LockToken, or File.close sweep).
    //
    // Options extraction: `options.get("wait")` returns Nil for
    // absent key (spec Â§Options-map convention); we normalize
    // wait âˆˆ {Nil, false} â†’ false, wait == true â†’ true, anything
    // else â†’ FSERR_BAD_ARG.  This mirrors the native's Bool-only
    // wait argument.
    //
    // Method body deliberately duplicates the arity-3 method above.
    // Rholang agent methods don't cross-invoke cleanly (would nest
    // stateP-linear-receive â†’ deadlock).  Any change to the shared
    // structure (offset/length/mode validation, state-machine dance,
    // mode attenuation) MUST be mirrored across both methods; a
    // drift-detector test lives at rholang/tests/file_dir_check.rs
    // in the slice-8b integration suite.
    //
    // The arity-3 method remains as a backward-compatible convenience
    // for callers that don't need wait:true (defaults wait:false).
    // Both call the same native (arity-8, wait: Bool at slot 7); the
    // arity-3 relies on the native's legacy 7-arg shim to default
    // wait:false â€” sub-4 does NOT tighten that shim.
    method lockRange(@offset, @length, @mode, @options) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match length {
                len /\ Int => {
                  match len <= 0 {
                    true => return!([false, "FSERR_BAD_ARG",
                      "length must be > 0 (LockRegistry rejects zero-length ranges as BadArg)"])
                    false => {
                      match mode {
                        m /\ String => {
                          match m {
                            "r" \/ "w" => {
                              // Extract wait option.  Nil (absent) or
                              // literal false â†’ wait:false (fail-fast);
                              // literal true â†’ wait:true (park on
                              // conflict).  Any other value is
                              // rejected as FSERR_BAD_ARG.
                              // ## Sub-6 review-fix (2026-08-12): early
                              // stateP release
                              //
                              // The stateP linear cell is put back to
                              // "open" IMMEDIATELY after the state
                              // check, BEFORE the fsLockRange native
                              // call.  Rationale: under wait:true, the
                              // native's `admit.await` can block
                              // indefinitely (until a conflicting
                              // holder releases or the deploy ends).
                              // Holding stateP through that wait would
                              // block every other method on the same
                              // cap â€” including `close()`, the
                              // caller's escape hatch.  Releasing
                              // early accepts a small semantic window
                              // where "open" is observed while a lock
                              // is pending; concurrent callers on
                              // this cap proceed at the LockRegistry
                              // level (which is thread-safe by design)
                              // rather than blocking at the stateP
                              // gate.
                              //
                              // Concurrent-close scenario: close()
                              // takes stateP, sets "closed", calls
                              // fs_release_all_for_holder which
                              // cancels this method's parked waiter
                              // (sub-6 review-fix added
                              // cancel_all_waiters_for_holder to that
                              // sweep) â†’ this method's `admit.await`
                              // returns Err(Cancelled) â†’ produces
                              // FSERR_CANCELLED reply.  Deterministic
                              // closure of the wait attempt.
                              //
                              // The arity-3 method above deliberately
                              // keeps the tight stateP hold pattern â€”
                              // it's always wait:false, so the native
                              // returns quickly and the concurrency
                              // window is negligible.  Only the
                              // arity-4 method needs the early
                              // release.
                              match options.get("wait") {
                                Nil => {
                                  // Nil â†’ wait:false.  Body identical
                                  // to the Bool branch modulo `false`
                                  // literal vs. bound `w`.
                                  for (@state <- @[*private, *stateP]) {
                                    match state {
                                      "closed" => {
                                        @[*private, *stateP]!("closed") |
                                        return!([false, "FSERR_CLOSED", "file is closed"])
                                      }
                                      "open" => {
                                        @[*private, *stateP]!("open") |
                                        for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                                          match params {
                                            (fd, _root, _rel, fmode) => {
                                              match [m, fmode] {
                                                ["w", "r"] => {
                                                  return!([false, "FSERR_UNSUPPORTED",
                                                    "cannot acquire write lock on read-only file"])
                                                }
                                                _ => {
                                                  new lockCh in {
                                                    // Native arity-8 with wait:false.
                                                    fsLockRange!(fd, off, len, m, *this, cmode, false, *lockCh) |
                                                    for (@reply <- lockCh) {
                                                      match reply {
                                                        [true, lid] => {
                                                          for (@token <- LockToken!?(lid, *this)) {
                                                            return!([true, token])
                                                          }
                                                        }
                                                        _ => return!(reply)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            _ => {
                                              return!([false, "FSERR_IO", "fd params malformed"])
                                            }
                                          }
                                        }
                                      }
                                      _ => {
                                        @[*private, *stateP]!("closed") |
                                        return!([false, "FSERR_CLOSED", "file state unrecognized"])
                                      }
                                    }
                                  }
                                }
                                w /\ Bool => {
                                  for (@state <- @[*private, *stateP]) {
                                    match state {
                                      "closed" => {
                                        @[*private, *stateP]!("closed") |
                                        return!([false, "FSERR_CLOSED", "file is closed"])
                                      }
                                      "open" => {
                                        @[*private, *stateP]!("open") |
                                        for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                                          match params {
                                            (fd, _root, _rel, fmode) => {
                                              match [m, fmode] {
                                                ["w", "r"] => {
                                                  return!([false, "FSERR_UNSUPPORTED",
                                                    "cannot acquire write lock on read-only file"])
                                                }
                                                _ => {
                                                  new lockCh in {
                                                    // Native arity-8 with caller-supplied wait.
                                                    fsLockRange!(fd, off, len, m, *this, cmode, w, *lockCh) |
                                                    for (@reply <- lockCh) {
                                                      match reply {
                                                        [true, lid] => {
                                                          for (@token <- LockToken!?(lid, *this)) {
                                                            return!([true, token])
                                                          }
                                                        }
                                                        _ => return!(reply)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            _ => {
                                              return!([false, "FSERR_IO", "fd params malformed"])
                                            }
                                          }
                                        }
                                      }
                                      _ => {
                                        @[*private, *stateP]!("closed") |
                                        return!([false, "FSERR_CLOSED", "file state unrecognized"])
                                      }
                                    }
                                  }
                                }
                                _ => return!([false, "FSERR_BAD_ARG",
                                  "options.wait must be Bool"])
                              }
                            }
                            _ => return!([false, "FSERR_BAD_ARG",
                              "mode must be \"r\" or \"w\""])
                          }
                        }
                        _ => return!([false, "FSERR_BAD_ARG",
                          "mode must be a String"])
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "length must be an integer"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- bytes() ---------------------------------------------------
    //
    // Sequential ByteStream producer.  Reads bytes from the file's
    // current cursor position, advancing the fd's cursor as it goes.
    //
    // ## Element type
    //
    // Per spec Â§Stream specializations > ByteStream, the element type
    // is `u8` and the chunk container is `ByteArray`.  Rholang has no
    // separate byte type â€” Int is 64-bit and there's no total Int-to-
    // single-byte conversion, so this MVP represents each element as
    // a 1-byte `ByteArray` slice.  The chunk builder still returns a
    // properly-packed ByteArray via `List.concatBytes()`, so callers
    // that only use `chunk(n)` observe the spec's shape.  A follow-up
    // slice will migrate elements to Int once we have a Rholang
    // primitive for it.
    //
    // ## Efficiency
    //
    // A per-element fsRead(fd, 1) would issue one syscall per byte;
    // instead the producer buffers a 4KB chunk internally and vends
    // 1-byte slices from that chunk, refilling on exhaustion.  This
    // is a per-Stream cell â€” it does NOT survive close-and-recreate.
    //
    // ## Concurrency
    //
    // Spec Â§Read-side stream producers says only one sequential
    // producer may hold the cursor at a time; a second call should
    // return FSERR_BUSY.  This MVP does not enforce the exclusion â€”
    // Phase 8 lands cursor-lease tracking with `{"wait": true}`
    // semantics.  Two live sequential streams today will interleave
    // reads on the same fd; the caller must not create overlapping
    // sequential streams.  Positional producers (bytesAt) are safe
    // to interleave with sequential ones by design.
    //
    // ## Cross-deploy hazard note (post slice-27, 2026-08-04)
    //
    // Slice 27 reverted the earlier Fs memoization: every `openFile`
    // call now mints a FRESH File cap, so two deploys that both call
    // `openFile("shared")` receive DISTINCT File caps (each with its
    // own fd from `fs_open` on the same canonical path).  FIP Â§Fresh-
    // mint per open enshrines the guarantee.  The Phase-5-documented
    // "don't create overlapping sequential streams" discipline is
    // therefore per-File-cap; two deploys running on the same logical
    // name each get their own cursor, and each deploy separately
    // observes the same-cap sequential-producer exclusion.  Shards
    // that need to SHARE a cursor across deploys must exchange a File
    // cap out of band; there is no built-in cap-sharing mechanism.
    method bytes() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // Phase 8 slice 8a step 4e-2: sequential lock spans the
                  // ByteStream's lifetime.  Acquired at mint, released
                  // via a separate lockCell guard (same pattern as
                  // bytesAt from step 4d-2b) on stream termination:
                  //   - EOF via fsRead returning zero bytes
                  //   - fsRead error
                  // The lockCell guards against amplifying release
                  // syscalls when a caller polls next() repeatedly after
                  // EOS.  Caller-driven early abandonment leaks the lock
                  // until File.close sweep (step 4f) or deploy-end auto-
                  // release (step 5).
                  new lockCh in {
                    // holder MUST be *this â€” cross-cap coordination
                    // depends on it.
                    fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                    for (@lockReply <- lockCh) {
                      match lockReply {
                        [true, lid] => {
                          new byteProducer, byteBuilder, pendingCell, lockCell in {
                            pendingCell!(("".hexToBytes(), 0)) |
                            lockCell!((lid, false, *this)) |

                            contract byteProducer(retCh) = {
                              for (@(pending, idx) <- pendingCell) {
                                match idx < pending.length() {
                                  true => {
                                    pendingCell!((pending, idx + 1)) |
                                    retCh!([true, pending.slice(idx, idx + 1)])
                                  }
                                  false => {
                                    new readCh in {
                                      fsRead!(fd, 4096, *readCh) |
                                      for (@reply <- readCh) {
                                        match reply {
                                          [true, ba /\ ByteArray] => {
                                            match ba.length() {
                                              0 => {
                                                // TERMINATION: EOF.
                                                new relDoneCh in {
                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                  for (_ <- relDoneCh) {
                                                    pendingCell!((pending, idx)) |
                                                    retCh!([false, "EOS", "end of file"])
                                                  }
                                                }
                                              }
                                              _ => {
                                                pendingCell!((ba, 1)) |
                                                retCh!([true, ba.slice(0, 1)])
                                              }
                                            }
                                          }
                                          _ => {
                                            // TERMINATION: fsRead error.
                                            new relDoneCh in {
                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                              for (_ <- relDoneCh) {
                                                pendingCell!((pending, idx)) |
                                                retCh!(reply)
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            } |

                            contract byteBuilder(@values, retCh) = {
                              match values {
                                v /\ List => retCh!([true, v.concatBytes()])
                                _ => retCh!([false, "FSERR_IO",
                                  "chunk builder expected List"])
                              }
                            } |

                            for (@streamHandle <- Stream!?(*byteProducer, *byteBuilder)) {
                              @[*private, *stateP]!("open") |
                              return!([true, streamHandle])
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!(lockReply)
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- bytes(options) â€” slice 8d-3-stream arity-1 variant
    //
    // Per spec Â§1181.  Stream-lifetime lock (release fires from
    // byteProducer termination via lockCell guard) â€” uses
    // acquireSequentialForStream hand-off helper to acquire the lock
    // and hand back the LockId, then stream construction is
    // identical to arity-0.
    //
    // Body deliberately duplicates the arity-0 method (identical
    // stream construction after the acquire) â€” Rholang agent methods
    // don't cross-invoke cleanly.  Any change to the byteProducer /
    // lockCell / stream-termination guards MUST be mirrored across
    // both methods.
    method bytes(@options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new byteProducer, byteBuilder, pendingCell, lockCell in {
                                      pendingCell!(("".hexToBytes(), 0)) |
                                      lockCell!((lid, false, *this)) |

                                      contract byteProducer(retCh) = {
                                        for (@(pending, idx) <- pendingCell) {
                                          match idx < pending.length() {
                                            true => {
                                              pendingCell!((pending, idx + 1)) |
                                              retCh!([true, pending.slice(idx, idx + 1)])
                                            }
                                            false => {
                                              new readCh in {
                                                fsRead!(fd, 4096, *readCh) |
                                                for (@reply <- readCh) {
                                                  match reply {
                                                    [true, ba /\ ByteArray] => {
                                                      match ba.length() {
                                                        0 => {
                                                          new relDoneCh in {
                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                            for (_ <- relDoneCh) {
                                                              pendingCell!((pending, idx)) |
                                                              retCh!([false, "EOS", "end of file"])
                                                            }
                                                          }
                                                        }
                                                        _ => {
                                                          pendingCell!((ba, 1)) |
                                                          retCh!([true, ba.slice(0, 1)])
                                                        }
                                                      }
                                                    }
                                                    _ => {
                                                      new relDoneCh in {
                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                        for (_ <- relDoneCh) {
                                                          pendingCell!((pending, idx)) |
                                                          retCh!(reply)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |

                                      contract byteBuilder(@values, retCh) = {
                                        match values {
                                          v /\ List => retCh!([true, v.concatBytes()])
                                          _ => retCh!([false, "FSERR_IO",
                                            "chunk builder expected List"])
                                        }
                                      } |

                                      for (@streamHandle <- Stream!?(*byteProducer, *byteBuilder)) {
                                        return!([true, streamHandle])
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- bytesAt(offset, length) -----------------------------------
    //
    // Positional ByteStream producer.  Reads `length` bytes starting
    // at absolute file offset `offset` via fsReadAt (pread(2)); does
    // not touch the sequential cursor.  Multiple positional streams
    // may coexist on the same File.
    //
    // `length` may be `Nil` to mean "to EOF".  The producer tracks
    // (currentOffset, remaining) internally; `remaining` is `Nil` for
    // to-EOF mode, else a positive Int decreasing toward 0.
    method bytesAt(@offset, @length) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              // length must be Nil OR non-negative Int.
              new lenOk in {
                match length {
                  n /\ Int => {
                    match n < 0 {
                      true => lenOk!([false, "FSERR_BAD_ARG",
                        "length must be non-negative"])
                      false => lenOk!([true, n])
                    }
                  }
                  Nil => lenOk!([true, Nil])
                  _ => lenOk!([false, "FSERR_BAD_ARG",
                    "length must be Int or Nil"])
                } |
                for (@lenValidated <- lenOk) {
                  match lenValidated {
                    [false, code, msg] => return!([false, code, msg])
                    [true, validLen] => {
                      for (@state <- @[*private, *stateP]) {
                        match state {
                          "closed" => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file is closed"])
                          }
                          "open" => {
                            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                              match params {
                                (fd, _root, _rel, _mode) => {
                                  // Phase 8 slice 8a step 4d-2b â€” stream-lifetime
                                  // range lock.  Spec Â§Range locks: "positional
                                  // stream implicitly acquires a range lock over
                                  // its byte range for the stream's lifetime."
                                  //
                                  // Lock extent:
                                  // - length=Int n: (off, n) â€” exactly the bytes
                                  //   the stream may vend.
                                  // - length=Nil (to-EOF): (off, 2^62) â€” a
                                  //   pessimistic sentinel wider than any real
                                  //   file (4 EB, leaves ample headroom against
                                  //   i64::MAX overflow in the LockRegistry's
                                  //   saturating-add overlap check).  Any
                                  //   concurrent writer at any offset >= our
                                  //   start conflicts, which matches the
                                  //   "unbounded read of a mutable file" semantic.
                                  //
                                  // Release: fires exactly once from patProducer's
                                  // three termination paths (length-exhausted EOS,
                                  // EOF EOS, fsReadAt error) guarded by a
                                  // separate `lockCell` holding `(lockId, released:Bool)`.
                                  // Repeated post-EOS polls hit the released branch
                                  // and skip the syscall â€” bounded, not amplifying.
                                  //
                                  // Caller-driven early abandonment (consumer drops
                                  // stream without consuming to EOS): the lock
                                  // leaks until File.close's sweep (step 4f) or
                                  // deploy-end auto-release (step 5).  Matches spec
                                  // Â§Explicit locks' MUST auto-release-at-deploy-end
                                  // safety net.
                                  new lockLenCh in {
                                    match validLen {
                                      Nil => lockLenCh!(4611686018427387904)
                                      n /\ Int => lockLenCh!(n)
                                    } |
                                    for (@lockLen <- lockLenCh) {
                                      match lockLen {
                                        0 => {
                                          // Zero-length: mint an empty stream
                                          // directly, no lock needed.  Preserves
                                          // pre-lock semantic that a bytesAt(_, 0)
                                          // stream is immediately-EOS.  LockRegistry
                                          // would reject len=0 as BadArg; short-
                                          // circuit both syscalls.
                                          new patProducer, patBuilder in {
                                            contract patProducer(retCh) = {
                                              retCh!([false, "EOS", "length exhausted"])
                                            } |
                                            contract patBuilder(@values, retCh) = {
                                              match values {
                                                v /\ List => retCh!([true, v.concatBytes()])
                                                _ => retCh!([false, "FSERR_IO",
                                                  "chunk builder expected List"])
                                              }
                                            } |
                                            for (@streamHandle <- Stream!?(*patProducer, *patBuilder)) {
                                              @[*private, *stateP]!("open") |
                                              return!([true, streamHandle])
                                            }
                                          }
                                        }
                                        _ => {
                                          new lockCh in {
                                            // holder MUST be *this â€” cross-cap
                                            // coordination depends on it.
                                            fsLockRange!(fd, off, lockLen, "r", *this, cmode, false, *lockCh) |
                                            for (@lockReply <- lockCh) {
                                              match lockReply {
                                                [true, lid] => {
                                                  new patProducer, patBuilder, posCell, lockCell in {
                                                    // posCell: (nextOffset, remaining,
                                                    //           pending, idx)
                                                    // - remaining: Nil or Int (bytes still
                                                    //   allowed to read from user's length)
                                                    // - pending: 4KB chunk from last fsReadAt
                                                    // - idx: index into pending
                                                    //
                                                    // lockCell: (lockId, released:Bool)
                                                    // - separate from posCell so state-shape
                                                    //   changes to posCell (adding fields
                                                    //   later, migrating to BTreeMap, etc.)
                                                    //   don't churn the release-guard logic.
                                                    // - released=false â†’ first termination
                                                    //   releases once and flips to true.
                                                    // - released=true â†’ subsequent termination
                                                    //   paths skip the syscall (bounded).
                                                    posCell!((off, validLen, "".hexToBytes(), 0)) |
                                                    lockCell!((lid, false, *this)) |

                                                    contract patProducer(retCh) = {
                                                      for (@(nextOff, rem, pending, idx) <- posCell) {
                                                        match idx < pending.length() {
                                                          true => {
                                                            posCell!((nextOff, rem, pending, idx + 1)) |
                                                            retCh!([true, pending.slice(idx, idx + 1)])
                                                          }
                                                          false => {
                                                            // Need to refill.  Compute how
                                                            // many bytes we may still read
                                                            // and cap the request accordingly.
                                                            new nToReadCh in {
                                                              match rem {
                                                                Nil => nToReadCh!(4096)
                                                                r /\ Int => {
                                                                  match r <= 0 {
                                                                    true => nToReadCh!(0)
                                                                    false => {
                                                                      match r < 4096 {
                                                                        true => nToReadCh!(r)
                                                                        false => nToReadCh!(4096)
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              } |
                                                              for (@nToRead <- nToReadCh) {
                                                                match nToRead {
                                                                  0 => {
                                                                    // TERMINATION: length exhausted.
                                                                    // Release-once via lockCell.
                                                                    new relDoneCh in {
                                                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                      for (_ <- relDoneCh) {
                                                                        posCell!((nextOff, rem, pending, idx)) |
                                                                        retCh!([false, "EOS",
                                                                          "length exhausted"])
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => {
                                                                    new readCh in {
                                                                      fsReadAt!(fd, nextOff, nToRead, *readCh) |
                                                                      for (@reply <- readCh) {
                                                                        match reply {
                                                                          [true, ba /\ ByteArray] => {
                                                                            match ba.length() {
                                                                              0 => {
                                                                                // TERMINATION: EOF.
                                                                                new relDoneCh in {
                                                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                  for (_ <- relDoneCh) {
                                                                                    posCell!((nextOff, rem, pending, idx)) |
                                                                                    retCh!([false, "EOS", "end of file"])
                                                                                  }
                                                                                }
                                                                              }
                                                                              got => {
                                                                                // Update pending, advance offset,
                                                                                // decrement remaining (if Int).
                                                                                new newRemCh in {
                                                                                  match rem {
                                                                                    Nil => newRemCh!(Nil)
                                                                                    r /\ Int => newRemCh!(r - got)
                                                                                  } |
                                                                                  for (@newRem <- newRemCh) {
                                                                                    posCell!((nextOff + got, newRem, ba, 1)) |
                                                                                    retCh!([true, ba.slice(0, 1)])
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                          _ => {
                                                                            // TERMINATION: fsReadAt error.
                                                                            new relDoneCh in {
                                                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                              for (_ <- relDoneCh) {
                                                                                posCell!((nextOff, rem, pending, idx)) |
                                                                                retCh!(reply)
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    } |

                                                    contract patBuilder(@values, retCh) = {
                                                      match values {
                                                        v /\ List => retCh!([true, v.concatBytes()])
                                                        _ => retCh!([false, "FSERR_IO",
                                                          "chunk builder expected List"])
                                                      }
                                                    } |

                                                    for (@streamHandle <- Stream!?(*patProducer, *patBuilder)) {
                                                      @[*private, *stateP]!("open") |
                                                      return!([true, streamHandle])
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  // Lock acquire failed â€” forward.
                                                  @[*private, *stateP]!("open") |
                                                  return!(lockReply)
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  @[*private, *stateP]!("open") |
                                  return!([false, "FSERR_IO", "fd params malformed"])
                                }
                              }
                            }
                          }
                          _ => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file state unrecognized"])
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- bytesAt(offset, length, options) â€” slice 8d-3-stream-2 arity-3
    //
    // Per spec Â§1181.  Stream-lifetime range lock â€” uses
    // acquireRangeForStream hand-off helper to acquire the lock and
    // hand back the LockId, then stream construction is identical to
    // arity-2.
    //
    // Body deliberately duplicates the arity-2 method (identical
    // stream construction after the acquire) â€” Rholang agent methods
    // don't cross-invoke cleanly.  Any change to the patProducer /
    // lockCell / stream-termination guards MUST be mirrored across
    // both methods.
    method bytesAt(@offset, @length, @options) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              new lenOk in {
                match length {
                  n /\ Int => {
                    match n < 0 {
                      true => lenOk!([false, "FSERR_BAD_ARG",
                        "length must be non-negative"])
                      false => lenOk!([true, n])
                    }
                  }
                  Nil => lenOk!([true, Nil])
                  _ => lenOk!([false, "FSERR_BAD_ARG",
                    "length must be Int or Nil"])
                } |
                for (@lenValidated <- lenOk) {
                  match lenValidated {
                    [false, code, msg] => return!([false, code, msg])
                    [true, validLen] => {
                      match options.get("wait") {
                        wOpt /\ (Nil \/ Bool) => {
                          new waitCh in {
                            match wOpt {
                              Nil        => waitCh!(false)
                              bb /\ Bool => waitCh!(bb)
                            } |
                            for (@w <- waitCh) {
                              for (@state <- @[*private, *stateP]) {
                                match state {
                                  "closed" => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file is closed"])
                                  }
                                  "open" => {
                                    @[*private, *stateP]!("open") |
                                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                                      match params {
                                        (fd, _root, _rel, _mode) => {
                                          new lockLenCh in {
                                            match validLen {
                                              Nil => lockLenCh!(4611686018427387904)
                                              n /\ Int => lockLenCh!(n)
                                            } |
                                            for (@lockLen <- lockLenCh) {
                                              match lockLen {
                                                0 => {
                                                  // Zero-length: mint an empty
                                                  // stream directly, no lock
                                                  // needed (identical to arity-2).
                                                  new patProducer, patBuilder in {
                                                    contract patProducer(retCh) = {
                                                      retCh!([false, "EOS", "length exhausted"])
                                                    } |
                                                    contract patBuilder(@values, retCh) = {
                                                      match values {
                                                        v /\ List => retCh!([true, v.concatBytes()])
                                                        _ => retCh!([false, "FSERR_IO",
                                                          "chunk builder expected List"])
                                                      }
                                                    } |
                                                    for (@streamHandle <- Stream!?(*patProducer, *patBuilder)) {
                                                      return!([true, streamHandle])
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  new lockOut, acqRet in {
                                                    acquireRangeForStream!(fd, off, lockLen, "r", *this, cmode, w, *lockOut, *acqRet) |
                                                    for (@acqReply <- acqRet) {
                                                      match acqReply {
                                                        [true] => {
                                                          for (@lid <- lockOut) {
                                                            new patProducer, patBuilder, posCell, lockCell in {
                                                              posCell!((off, validLen, "".hexToBytes(), 0)) |
                                                              lockCell!((lid, false, *this)) |

                                                              contract patProducer(retCh) = {
                                                                for (@(nextOff, rem, pending, idx) <- posCell) {
                                                                  match idx < pending.length() {
                                                                    true => {
                                                                      posCell!((nextOff, rem, pending, idx + 1)) |
                                                                      retCh!([true, pending.slice(idx, idx + 1)])
                                                                    }
                                                                    false => {
                                                                      new nToReadCh in {
                                                                        match rem {
                                                                          Nil => nToReadCh!(4096)
                                                                          r /\ Int => {
                                                                            match r <= 0 {
                                                                              true => nToReadCh!(0)
                                                                              false => {
                                                                                match r < 4096 {
                                                                                  true => nToReadCh!(r)
                                                                                  false => nToReadCh!(4096)
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        } |
                                                                        for (@nToRead <- nToReadCh) {
                                                                          match nToRead {
                                                                            0 => {
                                                                              new relDoneCh in {
                                                                                releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                for (_ <- relDoneCh) {
                                                                                  posCell!((nextOff, rem, pending, idx)) |
                                                                                  retCh!([false, "EOS",
                                                                                    "length exhausted"])
                                                                                }
                                                                              }
                                                                            }
                                                                            _ => {
                                                                              new readCh in {
                                                                                fsReadAt!(fd, nextOff, nToRead, *readCh) |
                                                                                for (@reply <- readCh) {
                                                                                  match reply {
                                                                                    [true, ba /\ ByteArray] => {
                                                                                      match ba.length() {
                                                                                        0 => {
                                                                                          new relDoneCh in {
                                                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                            for (_ <- relDoneCh) {
                                                                                              posCell!((nextOff, rem, pending, idx)) |
                                                                                              retCh!([false, "EOS", "end of file"])
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                        got => {
                                                                                          new newRemCh in {
                                                                                            match rem {
                                                                                              Nil => newRemCh!(Nil)
                                                                                              r /\ Int => newRemCh!(r - got)
                                                                                            } |
                                                                                            for (@newRem <- newRemCh) {
                                                                                              posCell!((nextOff + got, newRem, ba, 1)) |
                                                                                              retCh!([true, ba.slice(0, 1)])
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                    _ => {
                                                                                      new relDoneCh in {
                                                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                        for (_ <- relDoneCh) {
                                                                                          posCell!((nextOff, rem, pending, idx)) |
                                                                                          retCh!(reply)
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              } |

                                                              contract patBuilder(@values, retCh) = {
                                                                match values {
                                                                  v /\ List => retCh!([true, v.concatBytes()])
                                                                  _ => retCh!([false, "FSERR_IO",
                                                                    "chunk builder expected List"])
                                                                }
                                                              } |

                                                              for (@streamHandle <- Stream!?(*patProducer, *patBuilder)) {
                                                                return!([true, streamHandle])
                                                              }
                                                            }
                                                          }
                                                        }
                                                        _ => return!(acqReply)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                                      }
                                    }
                                  }
                                  _ => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                                  }
                                }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
                      }
                    }
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- writeBytes(byteStream) ------------------------------------
    //
    // Sequential ByteStream consumer.  Drains `byteStream` via next()
    // in a loop, forwarding each byte to `fsWrite(fd, ...)` at the
    // current cursor.  Advances the cursor.  On success (producer
    // EOS): returns `[true]`.  On mid-stream error (either the
    // producer errored or fsWrite failed): returns `[false, code,
    // "wrote N bytes before failure: MSG"]` with the running byte
    // count interpolated in.  The input stream is closed on every
    // exit path (success and failure) so producer resources release
    // cleanly.
    //
    // Read-only File rejects with FSERR_UNSUPPORTED (spec Â§File >
    // Write-side stream consumers implicitly requires write mode).
    //
    // Concurrency: like bytes(), this is a sequential operation that
    // should exclude any other sequential stream on the same File.
    // Phase 8 will add the cursor-lease exclusion; today two callers
    // that racily invoke writeBytes/bytes/readN interleave on the fd.
    method writeBytes(@byteStream) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, mode) => {
                  match mode {
                    "r" => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_UNSUPPORTED",
                        "writeBytes requires a write-capable mode"])
                    }
                    _ => {
                      // Phase 8 slice 8a step 4e-1: sequential lock spans
                      // the entire writeBytesLoop drain â€” writeBytes is a
                      // sequential ByteStream consumer at the file's
                      // cursor.  Lock released after the loop's finalReply.
                      new lockCh in {
                        // holder MUST be *this â€” cross-cap coordination
                        // depends on it.
                        fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                        for (@lockReply <- lockCh) {
                          match lockReply {
                            [true, lid] => {
                              new loopRet in {
                                writeBytesLoop!(byteStream, fd, 0, *loopRet) |
                                for (@finalReply <- loopRet) {
                                  new relCh in {
                                    fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                    for (@_relReply <- relCh) {
                                      @[*private, *stateP]!("open") |
                                      return!(finalReply)
                                    }
                                  }
                                }
                              }
                            }
                            _ => {
                              @[*private, *stateP]!("open") |
                              return!(lockReply)
                            }
                          }
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- writeBytes(byteStream, options) â€” slice 8c arity-2 variant
    //
    // Per spec Â§1181.  Wait extraction + withSequentialLock delegation.
    // Inner action: writeBytesLoop over the byteStream.  stateP released
    // early to allow concurrent close() to proceed during wait:true parking.
    method writeBytes(@byteStream, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => return!([false, "FSERR_UNSUPPORTED",
                              "writeBytes requires a write-capable mode"])
                            _   => {
                              new innerCh, retCh in {
                                for (@cb <- innerCh) {
                                  new loopRet in {
                                    writeBytesLoop!(byteStream, fd, 0, *loopRet) |
                                    for (@finalReply <- loopRet) { @cb!(finalReply) }
                                  }
                                } |
                                withSequentialLock!(fd, *this, cmode, w, *innerCh, *retCh) |
                                for (@r <- retCh) { return!(r) }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- writeBytesAt(offset, maxLength, byteStream) --------------
    //
    // Positional ByteStream consumer via fsWriteAt.  Writes up to
    // `maxLength` bytes starting at absolute file offset `offset`;
    // does NOT touch the sequential cursor.  Stops early on EOS.
    //
    // `maxLength` is required per spec Â§Read-side stream producers >
    // Positional consumers (line ~953): "the range lock needs to know
    // the write's extent when the lock is acquired, not when the
    // stream drains".  Passing 0 makes this a no-op.
    //
    // Type-guarded on offset (Int, non-negative) and maxLength (Int,
    // non-negative).  Read-only File rejects.  Input stream closed on
    // every exit path.
    method writeBytesAt(@offset, @maxLength, @byteStream) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match maxLength {
                mx /\ Int => {
                  match mx < 0 {
                    true => return!([false, "FSERR_BAD_ARG",
                      "maxLength must be non-negative"])
                    false => {
                      for (@state <- @[*private, *stateP]) {
                        match state {
                          "closed" => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file is closed"])
                          }
                          "open" => {
                            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                              match params {
                                (fd, _root, _rel, fmode) => {
                                  match fmode {
                                    "r" => {
                                      @[*private, *stateP]!("open") |
                                      return!([false, "FSERR_UNSUPPORTED",
                                        "writeBytesAt requires a write-capable mode"])
                                    }
                                    _ => {
                                      // Phase 8 slice 8a step 4d-2 â€” acquire a
                                      // positional write lock over the DECLARED
                                      // maxLength before dispatching the drain
                                      // loop.  Spec Â§959: "The range-lock needs
                                      // to know the write's extent when the
                                      // lock is acquired... or a concurrent
                                      // positional writer at a higher offset
                                      // would conflict spuriously."  Actual
                                      // bytes written may be shorter if the
                                      // byteStream exhausts early; the lock
                                      // still covers the full declared range
                                      // for its lifetime.  Release fires after
                                      // the loop terminates (success OR error).
                                      match mx <= 0 {
                                        true => {
                                          // Zero-maxLength: loop would fire 0
                                          // writes and return success; skip
                                          // both the lock (BadArg on len=0)
                                          // and the loop.
                                          @[*private, *stateP]!("open") |
                                          return!([true, 0])
                                        }
                                        false => {
                                          new lockCh in {
                                            // holder MUST be *this â€” cross-cap
                                            // coordination depends on it.
                                            fsLockRange!(fd, off, mx, "w", *this, cmode, false, *lockCh) |
                                            for (@lockReply <- lockCh) {
                                              match lockReply {
                                                [true, lid] => {
                                                  new loopRet in {
                                                    writeBytesAtLoop!(byteStream, fd, off, mx, 0, *loopRet) |
                                                    for (@finalReply <- loopRet) {
                                                      new relCh in {
                                                        // Release once the loop
                                                        // has drained its ack,
                                                        // regardless of loop
                                                        // outcome.  Errors from
                                                        // the loop forward
                                                        // through finalReply.
                                                        fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                                        for (@_relReply <- relCh) {
                                                          @[*private, *stateP]!("open") |
                                                          return!(finalReply)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  // Lock acquire failed â€”
                                                  // forward (typically
                                                  // FSERR_BUSY).
                                                  @[*private, *stateP]!("open") |
                                                  return!(lockReply)
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  @[*private, *stateP]!("open") |
                                  return!([false, "FSERR_IO", "fd params malformed"])
                                }
                              }
                            }
                          }
                          _ => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file state unrecognized"])
                          }
                        }
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "maxLength must be an integer"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- writeBytesAt(offset, maxLength, byteStream, options) â€” slice 8c
    //
    // Arity-4 variant per spec Â§1181.  Positional consumer with wait
    // extraction; delegates the acquire/release dance to withRangeLock.
    // Inner action: writeBytesAtLoop.  stateP released early for
    // concurrent-close-during-wait safety (slice 8b sub-6 B3 pattern).
    method writeBytesAt(@offset, @maxLength, @byteStream, @options) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match maxLength {
                mx /\ Int => {
                  match mx < 0 {
                    true => return!([false, "FSERR_BAD_ARG",
                      "maxLength must be non-negative"])
                    false => {
                      match options.get("wait") {
                        wOpt /\ (Nil \/ Bool) => {
                          new waitCh in {
                            match wOpt {
                              Nil        => waitCh!(false)
                              bb /\ Bool => waitCh!(bb)
                            } |
                            for (@w <- waitCh) {
                              for (@state <- @[*private, *stateP]) {
                                match state {
                                  "closed" => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file is closed"])
                                  }
                                  "open" => {
                                    @[*private, *stateP]!("open") |
                                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                                      match params {
                                        (fd, _root, _rel, fmode) => {
                                          match fmode {
                                            "r" => return!([false, "FSERR_UNSUPPORTED",
                                              "writeBytesAt requires a write-capable mode"])
                                            _   => {
                                              match mx <= 0 {
                                                true => return!([true, 0])
                                                false => {
                                                  new innerCh, retCh in {
                                                    for (@cb <- innerCh) {
                                                      new loopRet in {
                                                        writeBytesAtLoop!(byteStream, fd, off, mx, 0, *loopRet) |
                                                        for (@finalReply <- loopRet) { @cb!(finalReply) }
                                                      }
                                                    } |
                                                    withRangeLock!(fd, off, mx, "w", *this, cmode, w, *innerCh, *retCh) |
                                                    for (@r <- retCh) { return!(r) }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                                      }
                                    }
                                  }
                                  _ => {
                                    @[*private, *stateP]!("closed") |
                                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                                  }
                                }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "maxLength must be an integer"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- chars() ---------------------------------------------------
    //
    // Sequential CharStream producer.  Iterates the file's UTF-8
    // content codepoint-by-codepoint from the current cursor,
    // emitting 1-codepoint Strings per `next()` (spec Â§327).
    //
    // ## Codepoint framing
    //
    // Rholang has no char-based String access â€” `String.slice` is
    // byte-indexed and panics on non-UTF-8-boundary offsets.  The
    // producer therefore works in ByteArrays throughout: it reads a
    // 4KB chunk, and for each `next()` it (a) looks at the byte at
    // `idx` to determine the codepoint length via the standard UTF-8
    // start-byte pattern (module helper `codepointLen`), (b)
    // slices `pending[idx..idx+n]` from the ByteArray (byte-level,
    // total), and (c) `decodeUtf8`s that slice to yield the 1-
    // codepoint String.
    //
    // ## Refill across codepoint boundary
    //
    // A 4KB fsRead may end mid-codepoint.  When `idx+n > pending
    // .length()` the producer preserves the unconsumed tail
    // (`pending.slice(idx, end)`), fsReads more bytes, concatBytes-
    // joins them, and resets `idx = 0` before retrying.  Truncated
    // UTF-8 at EOF surfaces as FSERR_IO "truncated UTF-8 at EOF"
    // rather than a decode panic.
    //
    // ## Concurrency
    //
    // Same MVP note as `bytes()`: this is a sequential producer that
    // should exclude other sequential streams on the same File.
    // Phase 8 lands cursor-lease exclusion; today two live sequential
    // streams on the same File interleave reads on the fd.
    method chars() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // Phase 8 slice 8a step 4e-2: sequential lock spans the
                  // CharStream's lifetime.  Release-once via lockCell on
                  // any of the 7 termination paths (5 error variants +
                  // 2 EOS variants).  Same pattern as bytes()/bytesAt.
                  new lockCh in {
                    // holder MUST be *this â€” cross-cap coordination
                    // depends on it.
                    fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                    for (@lockReply <- lockCh) {
                      match lockReply {
                        [true, lid] => {
                          new charProducer, charBuilder, pendingCell, lockCell in {
                            pendingCell!(("".hexToBytes(), 0, false)) |
                            lockCell!((lid, false, *this)) |

                            contract charProducer(retCh) = {
                              for (@(pending, idx, eofSeen) <- pendingCell) {
                                match idx >= pending.length() {
                                  true => {
                                    // Fully consumed; either refill or EOS.
                                    match eofSeen {
                                      true => {
                                        // TERMINATION: EOS via eofSeen.
                                        new relDoneCh in {
                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                          for (_ <- relDoneCh) {
                                            pendingCell!((pending, idx, true)) |
                                            retCh!([false, "EOS", "end of file"])
                                          }
                                        }
                                      }
                                      false => {
                                        new readCh in {
                                          fsRead!(fd, 4096, *readCh) |
                                          for (@reply <- readCh) {
                                            match reply {
                                              [true, ba /\ ByteArray] => {
                                                match ba.length() {
                                                  0 => {
                                                    // TERMINATION: EOS via zero-byte read.
                                                    new relDoneCh in {
                                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                      for (_ <- relDoneCh) {
                                                        pendingCell!((pending, idx, true)) |
                                                        retCh!([false, "EOS", "end of file"])
                                                      }
                                                    }
                                                  }
                                                  _ => {
                                                    pendingCell!((ba, 0, false)) |
                                                    charProducer!(*retCh)
                                                  }
                                                }
                                              }
                                              _ => {
                                                // TERMINATION: fsRead error on refill.
                                                new relDoneCh in {
                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                  for (_ <- relDoneCh) {
                                                    pendingCell!((pending, idx, eofSeen)) |
                                                    retCh!(reply)
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  false => {
                                    // Bytes available at idx; determine
                                    // codepoint length from the start byte.
                                    new lenCh in {
                                      codepointLen!(pending.nth(idx), *lenCh) |
                                      for (@n <- lenCh) {
                                        match n {
                                          -1 => {
                                            // TERMINATION: invalid UTF-8.
                                            new relDoneCh in {
                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                              for (_ <- relDoneCh) {
                                                pendingCell!((pending, idx, eofSeen)) |
                                                retCh!([false, "FSERR_IO",
                                                  "invalid UTF-8 start byte"])
                                              }
                                            }
                                          }
                                          _ => {
                                            match idx + n <= pending.length() {
                                              true => {
                                                // Have the full codepoint; slice
                                                // and decode.  Non-terminating.
                                                pendingCell!((pending, idx + n, eofSeen)) |
                                                retCh!([true,
                                                  pending.slice(idx, idx + n).decodeUtf8()])
                                              }
                                              false => {
                                                // Incomplete at end of pending;
                                                // refill or fail if EOF.
                                                match eofSeen {
                                                  true => {
                                                    // TERMINATION: truncated UTF-8 at EOF (eofSeen).
                                                    new relDoneCh in {
                                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                      for (_ <- relDoneCh) {
                                                        pendingCell!((pending, idx, true)) |
                                                        retCh!([false, "FSERR_IO",
                                                          "truncated UTF-8 at EOF"])
                                                      }
                                                    }
                                                  }
                                                  false => {
                                                    new readCh in {
                                                      fsRead!(fd, 4096, *readCh) |
                                                      for (@reply <- readCh) {
                                                        match reply {
                                                          [true, ba /\ ByteArray] => {
                                                            match ba.length() {
                                                              0 => {
                                                                // TERMINATION: truncated UTF-8 at EOF (zero-read).
                                                                new relDoneCh in {
                                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                  for (_ <- relDoneCh) {
                                                                    pendingCell!((pending, idx, true)) |
                                                                    retCh!([false, "FSERR_IO",
                                                                      "truncated UTF-8 at EOF"])
                                                                  }
                                                                }
                                                              }
                                                              _ => {
                                                                // Merge tail + new bytes.
                                                                pendingCell!((
                                                                  [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                                  0,
                                                                  false
                                                                )) |
                                                                charProducer!(*retCh)
                                                              }
                                                            }
                                                          }
                                                          _ => {
                                                            // TERMINATION: fsRead error on tail refill.
                                                            new relDoneCh in {
                                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                              for (_ <- relDoneCh) {
                                                                pendingCell!((pending, idx, eofSeen)) |
                                                                retCh!(reply)
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            } |

                            contract charBuilder(@vals, retCh) = {
                              match vals {
                                v /\ List => concatStringsLoop!(v, "", *retCh)
                                _ => retCh!([false, "FSERR_IO",
                                  "chunk builder expected List"])
                              }
                            } |

                            for (@streamHandle <- Stream!?(*charProducer, *charBuilder)) {
                              @[*private, *stateP]!("open") |
                              return!([true, streamHandle])
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!(lockReply)
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- chars(options) â€” slice 8d-3-stream-2 arity-1 variant
    //
    // Per spec Â§1181.  Stream-lifetime sequential lock â€” uses
    // acquireSequentialForStream hand-off helper, stream construction
    // identical to arity-0.
    //
    // Body deliberately duplicates the arity-0 method (identical
    // charProducer / lockCell / codepoint machinery after the acquire).
    // Any change to the producer state or termination guards MUST be
    // mirrored across both methods.
    method chars(@options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new charProducer, charBuilder, pendingCell, lockCell in {
                                      pendingCell!(("".hexToBytes(), 0, false)) |
                                      lockCell!((lid, false, *this)) |

                                      contract charProducer(retCh) = {
                                        for (@(pending, idx, eofSeen) <- pendingCell) {
                                          match idx >= pending.length() {
                                            true => {
                                              match eofSeen {
                                                true => {
                                                  new relDoneCh in {
                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                    for (_ <- relDoneCh) {
                                                      pendingCell!((pending, idx, true)) |
                                                      retCh!([false, "EOS", "end of file"])
                                                    }
                                                  }
                                                }
                                                false => {
                                                  new readCh in {
                                                    fsRead!(fd, 4096, *readCh) |
                                                    for (@reply <- readCh) {
                                                      match reply {
                                                        [true, ba /\ ByteArray] => {
                                                          match ba.length() {
                                                            0 => {
                                                              new relDoneCh in {
                                                                releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                for (_ <- relDoneCh) {
                                                                  pendingCell!((pending, idx, true)) |
                                                                  retCh!([false, "EOS", "end of file"])
                                                                }
                                                              }
                                                            }
                                                            _ => {
                                                              pendingCell!((ba, 0, false)) |
                                                              charProducer!(*retCh)
                                                            }
                                                          }
                                                        }
                                                        _ => {
                                                          new relDoneCh in {
                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                            for (_ <- relDoneCh) {
                                                              pendingCell!((pending, idx, eofSeen)) |
                                                              retCh!(reply)
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            false => {
                                              new lenCh in {
                                                codepointLen!(pending.nth(idx), *lenCh) |
                                                for (@n <- lenCh) {
                                                  match n {
                                                    -1 => {
                                                      new relDoneCh in {
                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                        for (_ <- relDoneCh) {
                                                          pendingCell!((pending, idx, eofSeen)) |
                                                          retCh!([false, "FSERR_IO",
                                                            "invalid UTF-8 start byte"])
                                                        }
                                                      }
                                                    }
                                                    _ => {
                                                      match idx + n <= pending.length() {
                                                        true => {
                                                          pendingCell!((pending, idx + n, eofSeen)) |
                                                          retCh!([true,
                                                            pending.slice(idx, idx + n).decodeUtf8()])
                                                        }
                                                        false => {
                                                          match eofSeen {
                                                            true => {
                                                              new relDoneCh in {
                                                                releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                for (_ <- relDoneCh) {
                                                                  pendingCell!((pending, idx, true)) |
                                                                  retCh!([false, "FSERR_IO",
                                                                    "truncated UTF-8 at EOF"])
                                                                }
                                                              }
                                                            }
                                                            false => {
                                                              new readCh in {
                                                                fsRead!(fd, 4096, *readCh) |
                                                                for (@reply <- readCh) {
                                                                  match reply {
                                                                    [true, ba /\ ByteArray] => {
                                                                      match ba.length() {
                                                                        0 => {
                                                                          new relDoneCh in {
                                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                            for (_ <- relDoneCh) {
                                                                              pendingCell!((pending, idx, true)) |
                                                                              retCh!([false, "FSERR_IO",
                                                                                "truncated UTF-8 at EOF"])
                                                                            }
                                                                          }
                                                                        }
                                                                        _ => {
                                                                          pendingCell!((
                                                                            [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                                            0,
                                                                            false
                                                                          )) |
                                                                          charProducer!(*retCh)
                                                                        }
                                                                      }
                                                                    }
                                                                    _ => {
                                                                      new relDoneCh in {
                                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                        for (_ <- relDoneCh) {
                                                                          pendingCell!((pending, idx, eofSeen)) |
                                                                          retCh!(reply)
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |

                                      contract charBuilder(@vals, retCh) = {
                                        match vals {
                                          v /\ List => concatStringsLoop!(v, "", *retCh)
                                          _ => retCh!([false, "FSERR_IO",
                                            "chunk builder expected List"])
                                        }
                                      } |

                                      for (@streamHandle <- Stream!?(*charProducer, *charBuilder)) {
                                        return!([true, streamHandle])
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- readLine() ------------------------------------------------
    //
    // Single-shot CharStream over the next line from the cursor.
    // Yields 1-codepoint Strings until LF (spec Â§926); the LF byte
    // is consumed (cursor advances past it) but NOT emitted.  If
    // the cursor is at EOF, the stream is pre-exhausted â€” the first
    // next() returns [false, "EOS", ...].  An unterminated final
    // line (bytes exist but no LF before EOF) is drained through
    // the returned stream, ending in EOS on the call that would
    // have needed more bytes.
    //
    // ## Line terminator (MVP: LF only)
    //
    // Same limitation as linesAsStrings â€” spec Â§923's full `\R`
    // class deferred; CR/CRLF/NEL/LS/PS/FF/VT not stripped.
    //
    // ## Structure vs. chars()
    //
    // Producer state is chars()'s (pending, idx, eofSeen) plus a
    // `doneAtLF` flag that turns the stream into an EOS-forever
    // sink once LF has been consumed.  Codepoint framing (via
    // codepointLen + decodeUtf8) is identical.
    //
    // ## Known limitation â€” partial drain leaves fd cursor mid-chunk
    //
    // The producer buffers up to 4KB per fsRead into a private
    // `lineCell`; the fd's kernel cursor advances by the fsRead
    // length, but the caller "logically" consumes only up to the
    // last emitted codepoint.  If the caller drops the returned
    // stream before reaching EOS (either the LF terminator or
    // file EOF), the fd cursor is left at the end of the last
    // fsRead chunk â€” up to 4KB PAST the position the caller thinks
    // they're at.  Subsequent fd-cursor-based operations (readN,
    // tell, chars, another readLine) then see a stale position.
    //
    // The only clean fixes require either (a) a stream-close hook
    // that seeks back to the logical position, or (b) a proper
    // cursor-lease exclusion protocol (Phase 8's `{"wait": true}`
    // + FSERR_BUSY infrastructure).  For MVP: drain readLine
    // streams to completion before touching the fd via other
    // methods.  This limitation is inherited by chars() and bytes()
    // as well; readLine's single-line contract makes the
    // interleaving hazard more likely to arise in practice.
    method readLine() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // Phase 8 slice 8a step 4e-3: sequential lock spans the
                  // single-line CharStream's lifetime.  Same release-once
                  // lockCell pattern as bytes()/chars().  readLine's
                  // stream is single-shot (one line then EOS) so most
                  // consumers only see one termination event; the guard
                  // still protects against buggy consumers polling next()
                  // repeatedly after EOS.
                  //
                  // 9 termination paths, all guarded: 2 EOS variants
                  // (repeat-post-LF, actual EOF) + 1 LF-consumption EOS
                  // + 5 error variants (initial fsRead error, invalid
                  // UTF-8 start, truncated-at-EOF Ã—2, tail-refill error).
                  new lockCh in {
                    // holder MUST be *this â€” cross-cap coordination
                    // depends on it.
                    fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                    for (@lockReply <- lockCh) {
                      match lockReply {
                        [true, lid] => {
                          new lineProducer, lineBuilder, lineCell, lockCell in {
                            // State: (pending, idx, eofSeen, doneAtLF).
                            lineCell!(("".hexToBytes(), 0, false, false)) |
                            lockCell!((lid, false, *this)) |

                            contract lineProducer(retCh) = {
                              for (@(pending, idx, eofSeen, doneAtLF) <- lineCell) {
                                match doneAtLF {
                                  true => {
                                    // TERMINATION: repeat poll after LF.
                                    new relDoneCh in {
                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                      for (_ <- relDoneCh) {
                                        lineCell!((pending, idx, eofSeen, true)) |
                                        retCh!([false, "EOS", "end of line"])
                                      }
                                    }
                                  }
                                  false => {
                                    match idx >= pending.length() {
                                      true => {
                                        // Consumed all pending; refill or EOS.
                                        match eofSeen {
                                          true => {
                                            // TERMINATION: EOS via eofSeen.
                                            new relDoneCh in {
                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                              for (_ <- relDoneCh) {
                                                lineCell!((pending, idx, true, false)) |
                                                retCh!([false, "EOS", "end of file"])
                                              }
                                            }
                                          }
                                          false => {
                                            new readCh in {
                                              fsRead!(fd, 4096, *readCh) |
                                              for (@reply <- readCh) {
                                                match reply {
                                                  [true, ba /\ ByteArray] => {
                                                    match ba.length() {
                                                      0 => {
                                                        // TERMINATION: EOS via zero-read.
                                                        new relDoneCh in {
                                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                          for (_ <- relDoneCh) {
                                                            lineCell!((pending, idx, true, false)) |
                                                            retCh!([false, "EOS", "end of file"])
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        lineCell!((ba, 0, false, false)) |
                                                        lineProducer!(*retCh)
                                                      }
                                                    }
                                                  }
                                                  _ => {
                                                    // TERMINATION: fsRead error on initial refill.
                                                    new relDoneCh in {
                                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                      for (_ <- relDoneCh) {
                                                        lineCell!((pending, idx, eofSeen, false)) |
                                                        retCh!(reply)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                      false => {
                                        // Bytes available at idx.  Check for LF
                                        // FIRST â€” if pending[idx] == 0x0A,
                                        // consume it and mark done.
                                        new byteAt in {
                                          byteAt!(pending.nth(idx)) |
                                          for (@b <- byteAt) {
                                            match b {
                                              10 => {
                                                // LF: consume and terminate.  Seek
                                                // fd back to the byte-after-LF so a
                                                // subsequent readLine (or any other
                                                // cursor-based op) sees the correct
                                                // position.  Without this rewind,
                                                // the fd cursor is left at the end
                                                // of the last fsRead chunk (up to
                                                // 4096 bytes past LF), stranding
                                                // any unread tail.
                                                new overshotCh in {
                                                  overshotCh!(pending.length() - (idx + 1)) |
                                                  for (@overshot <- overshotCh) {
                                                    match overshot > 0 {
                                                      true => {
                                                        new seekCh in {
                                                          fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                                          for (@_seekReply <- seekCh) {
                                                            // TERMINATION: LF found, with seek-back.
                                                            new relDoneCh in {
                                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                              for (_ <- relDoneCh) {
                                                                lineCell!((pending, idx + 1, eofSeen, true)) |
                                                                retCh!([false, "EOS", "end of line"])
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      false => {
                                                        // TERMINATION: LF found, no seek needed.
                                                        new relDoneCh in {
                                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                          for (_ <- relDoneCh) {
                                                            lineCell!((pending, idx + 1, eofSeen, true)) |
                                                            retCh!([false, "EOS", "end of line"])
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              _ => {
                                                // Regular codepoint start byte;
                                                // same slice+decode as chars().
                                                new lenCh in {
                                                  codepointLen!(b, *lenCh) |
                                                  for (@n <- lenCh) {
                                                    match n {
                                                      -1 => {
                                                        // TERMINATION: invalid UTF-8.
                                                        new relDoneCh in {
                                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                          for (_ <- relDoneCh) {
                                                            lineCell!((pending, idx, eofSeen, false)) |
                                                            retCh!([false, "FSERR_IO",
                                                              "invalid UTF-8 start byte"])
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        match idx + n <= pending.length() {
                                                          true => {
                                                            // Non-terminating: codepoint decoded.
                                                            lineCell!((pending, idx + n, eofSeen, false)) |
                                                            retCh!([true,
                                                              pending.slice(idx, idx + n).decodeUtf8()])
                                                          }
                                                          false => {
                                                            match eofSeen {
                                                              true => {
                                                                // TERMINATION: truncated UTF-8 (eofSeen).
                                                                new relDoneCh in {
                                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                  for (_ <- relDoneCh) {
                                                                    lineCell!((pending, idx, true, false)) |
                                                                    retCh!([false, "FSERR_IO",
                                                                      "truncated UTF-8 at EOF"])
                                                                  }
                                                                }
                                                              }
                                                              false => {
                                                                new readCh in {
                                                                  fsRead!(fd, 4096, *readCh) |
                                                                  for (@reply <- readCh) {
                                                                    match reply {
                                                                      [true, ba /\ ByteArray] => {
                                                                        match ba.length() {
                                                                          0 => {
                                                                            // TERMINATION: truncated UTF-8 (zero-read).
                                                                            new relDoneCh in {
                                                                              releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                              for (_ <- relDoneCh) {
                                                                                lineCell!((pending, idx, true, false)) |
                                                                                retCh!([false, "FSERR_IO",
                                                                                  "truncated UTF-8 at EOF"])
                                                                              }
                                                                            }
                                                                          }
                                                                          _ => {
                                                                            // Non-terminating: tail-refill success.
                                                                            lineCell!((
                                                                              [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                                              0,
                                                                              false,
                                                                              false
                                                                            )) |
                                                                            lineProducer!(*retCh)
                                                                          }
                                                                        }
                                                                      }
                                                                      _ => {
                                                                        // TERMINATION: fsRead error on tail refill.
                                                                        new relDoneCh in {
                                                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                          for (_ <- relDoneCh) {
                                                                            lineCell!((pending, idx, eofSeen, false)) |
                                                                            retCh!(reply)
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            } |

                            contract lineBuilder(@vals, retCh) = {
                              match vals {
                                v /\ List => concatStringsLoop!(v, "", *retCh)
                                _ => retCh!([false, "FSERR_IO",
                                  "chunk builder expected List"])
                              }
                            } |

                            for (@streamHandle <- Stream!?(*lineProducer, *lineBuilder)) {
                              @[*private, *stateP]!("open") |
                              return!([true, streamHandle])
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!(lockReply)
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- readLine(options) â€” slice 8d-3-stream-2 arity-1 variant
    //
    // Per spec Â§1181.  Stream-lifetime sequential lock â€” uses
    // acquireSequentialForStream hand-off helper, stream construction
    // identical to arity-0.
    //
    // Body deliberately duplicates the arity-0 method (all 9
    // termination paths preserved: 2 EOS variants + LF-consumption EOS
    // + 5 error variants).  Any change to lineProducer / lockCell
    // guards MUST be mirrored across both methods.
    method readLine(@options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new lineProducer, lineBuilder, lineCell, lockCell in {
                                      lineCell!(("".hexToBytes(), 0, false, false)) |
                                      lockCell!((lid, false, *this)) |

                                      contract lineProducer(retCh) = {
                                        for (@(pending, idx, eofSeen, doneAtLF) <- lineCell) {
                                          match doneAtLF {
                                            true => {
                                              new relDoneCh in {
                                                releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                for (_ <- relDoneCh) {
                                                  lineCell!((pending, idx, eofSeen, true)) |
                                                  retCh!([false, "EOS", "end of line"])
                                                }
                                              }
                                            }
                                            false => {
                                              match idx >= pending.length() {
                                                true => {
                                                  match eofSeen {
                                                    true => {
                                                      new relDoneCh in {
                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                        for (_ <- relDoneCh) {
                                                          lineCell!((pending, idx, true, false)) |
                                                          retCh!([false, "EOS", "end of file"])
                                                        }
                                                      }
                                                    }
                                                    false => {
                                                      new readCh in {
                                                        fsRead!(fd, 4096, *readCh) |
                                                        for (@reply <- readCh) {
                                                          match reply {
                                                            [true, ba /\ ByteArray] => {
                                                              match ba.length() {
                                                                0 => {
                                                                  new relDoneCh in {
                                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                    for (_ <- relDoneCh) {
                                                                      lineCell!((pending, idx, true, false)) |
                                                                      retCh!([false, "EOS", "end of file"])
                                                                    }
                                                                  }
                                                                }
                                                                _ => {
                                                                  lineCell!((ba, 0, false, false)) |
                                                                  lineProducer!(*retCh)
                                                                }
                                                              }
                                                            }
                                                            _ => {
                                                              new relDoneCh in {
                                                                releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                for (_ <- relDoneCh) {
                                                                  lineCell!((pending, idx, eofSeen, false)) |
                                                                  retCh!(reply)
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                                false => {
                                                  new byteAt in {
                                                    byteAt!(pending.nth(idx)) |
                                                    for (@b <- byteAt) {
                                                      match b {
                                                        10 => {
                                                          new overshotCh in {
                                                            overshotCh!(pending.length() - (idx + 1)) |
                                                            for (@overshot <- overshotCh) {
                                                              match overshot > 0 {
                                                                true => {
                                                                  new seekCh in {
                                                                    fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                                                    for (@_seekReply <- seekCh) {
                                                                      new relDoneCh in {
                                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                        for (_ <- relDoneCh) {
                                                                          lineCell!((pending, idx + 1, eofSeen, true)) |
                                                                          retCh!([false, "EOS", "end of line"])
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                                false => {
                                                                  new relDoneCh in {
                                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                    for (_ <- relDoneCh) {
                                                                      lineCell!((pending, idx + 1, eofSeen, true)) |
                                                                      retCh!([false, "EOS", "end of line"])
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                        _ => {
                                                          new lenCh in {
                                                            codepointLen!(b, *lenCh) |
                                                            for (@n <- lenCh) {
                                                              match n {
                                                                -1 => {
                                                                  new relDoneCh in {
                                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                    for (_ <- relDoneCh) {
                                                                      lineCell!((pending, idx, eofSeen, false)) |
                                                                      retCh!([false, "FSERR_IO",
                                                                        "invalid UTF-8 start byte"])
                                                                    }
                                                                  }
                                                                }
                                                                _ => {
                                                                  match idx + n <= pending.length() {
                                                                    true => {
                                                                      lineCell!((pending, idx + n, eofSeen, false)) |
                                                                      retCh!([true,
                                                                        pending.slice(idx, idx + n).decodeUtf8()])
                                                                    }
                                                                    false => {
                                                                      match eofSeen {
                                                                        true => {
                                                                          new relDoneCh in {
                                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                            for (_ <- relDoneCh) {
                                                                              lineCell!((pending, idx, true, false)) |
                                                                              retCh!([false, "FSERR_IO",
                                                                                "truncated UTF-8 at EOF"])
                                                                            }
                                                                          }
                                                                        }
                                                                        false => {
                                                                          new readCh in {
                                                                            fsRead!(fd, 4096, *readCh) |
                                                                            for (@reply <- readCh) {
                                                                              match reply {
                                                                                [true, ba /\ ByteArray] => {
                                                                                  match ba.length() {
                                                                                    0 => {
                                                                                      new relDoneCh in {
                                                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                        for (_ <- relDoneCh) {
                                                                                          lineCell!((pending, idx, true, false)) |
                                                                                          retCh!([false, "FSERR_IO",
                                                                                            "truncated UTF-8 at EOF"])
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                    _ => {
                                                                                      lineCell!((
                                                                                        [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                                                        0,
                                                                                        false,
                                                                                        false
                                                                                      )) |
                                                                                      lineProducer!(*retCh)
                                                                                    }
                                                                                  }
                                                                                }
                                                                                _ => {
                                                                                  new relDoneCh in {
                                                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                                    for (_ <- relDoneCh) {
                                                                                      lineCell!((pending, idx, eofSeen, false)) |
                                                                                      retCh!(reply)
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |

                                      contract lineBuilder(@vals, retCh) = {
                                        match vals {
                                          v /\ List => concatStringsLoop!(v, "", *retCh)
                                          _ => retCh!([false, "FSERR_IO",
                                            "chunk builder expected List"])
                                        }
                                      } |

                                      for (@streamHandle <- Stream!?(*lineProducer, *lineBuilder)) {
                                        return!([true, streamHandle])
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- lines() ----------------------------------------------------
    //
    // Outer `LineStream` (a Stream whose elements are inner
    // `CharStream`s, one per line).  Splits on LF (0x0A) per the same
    // MVP terminator rule as `linesAsStrings` â€” full `\R` support is
    // deferred.  Each inner emits the characters of one line
    // (terminator excluded) then EOS.
    //
    // ## Single-active-inner rule (spec Â§349)
    //
    // Outer and its currently-produced inner share the file's cursor
    // (via a private `sourceCell` holding `(pending, idx, eofSeen)`).
    // Only one inner is active at a time.  When outer.next() is
    // called while an inner is still open, the outer:
    //   1. Sets the inner's status to "revoked".
    //   2. Drains the source past the inner's current line's LF.
    //   3. Then produces a fresh inner over the next line.
    //
    // ## Drained inners fail closed (spec Â§357)
    //
    // A caller who retains a handle to an inner drained by the outer
    // and later invokes next/chunk/fold sees
    // `[false, "FSERR_CLOSED", ...]`, NOT silent-read-wrong-data.
    // This is enforced by the inner's producer reading its status
    // cell first and short-circuiting on "revoked".
    //
    // ## chunk() unsupported on LineStream (spec Â§111)
    //
    // LineStream chunking would require multiple concurrently-active
    // inners sharing the cursor, breaking the single-active-inner
    // invariant.  The outer's chunk builder always returns
    // `[false, "FSERR_UNSUPPORTED", ...]` so any `chunk` call fails
    // cleanly.
    //
    // ## Known limitation â€” inner.close() is shallow (spec Â§353)
    //
    // Spec Â§353 says "Closing an inner. Advances the source past the
    // inner's logical group boundary (past the current line's
    // terminator)."  This MVP returns the inner as a bare
    // Stream.close() â€” it marks the inner's Stream state as "closed"
    // but does NOT advance the shared sourceCell past the LF.
    //
    // Practical impact is zero for compliant callers.  The source
    // drain happens naturally on the next outer.next() call (which
    // detects innerStatusCh still == "open" and force-drains).  Callers
    // that use outer.next() / fold / forEach after inner.close() get
    // the same source advancement they would have gotten had close()
    // done the drain itself.  Only a caller that closes inner AND
    // never touches the outer again observes a difference (the source
    // cursor sits mid-line inside sourceCell) â€” but that state is
    // dead because nothing reads it.
    //
    // ## Known limitation â€” outer.close() is shallow (spec Â§355)
    //
    // Spec Â§355 says "Closing the outer.  Closes any active inner
    // first, then releases the source cursor."  This MVP returns the
    // outer as a bare Stream.close() â€” it marks the outer's Stream
    // state as "closed" but does NOT force-drain the active inner or
    // release sourceCell.  Same rationale as above: the sourceCell,
    // activeInnerCell, and innerStatusCh tuples remain live in the
    // tuplespace but no compliant caller can observe them (they're
    // only reachable through outer's producer, which is unreachable
    // once outer's Stream state is "closed").  A follow-up slice can
    // wrap both handles in a shim agent whose close() runs the spec
    // drain before delegating to Stream.close().
    method lines() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // Phase 8 slice 8a step 4e-4: sequential lock spans
                  // the OUTER LineStream's lifetime.  Inner CharStreams
                  // (one per line) share the outer lock â€” no per-inner
                  // acquire.  Under the single-active-inner rule
                  // (spec Â§349), only one inner is live at a time and
                  // outer.next() revokes it before minting the next,
                  // so once outer terminates, no inner is left doing
                  // I/O.  Release-once via lockCell at the 3 outer
                  // termination paths (EOF-via-empty-source, EOF-via-
                  // zero-read, fsRead-error).
                  new lockCh in {
                    // holder MUST be *this â€” cross-cap coordination
                    // depends on it.
                    fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                    for (@lockReply <- lockCh) {
                      match lockReply {
                        [true, lid] => {
                          new sourceCell, activeInnerCell,
                              scanForLFRefilling, outerMint,
                              outerProducer, outerBuilder, lockCell in {
                    // Shared source state: bytes read ahead of the
                    // consumer, plus cursor and EOF flag.
                    sourceCell!(("".hexToBytes(), 0, false)) |
                    // Nil means no inner currently active.
                    activeInnerCell!(Nil) |
                    // Release-once guard for outer termination.
                    lockCell!((lid, false, *this)) |

                    // scanForLFRefilling(pending, idx, eofSeen, ret)
                    // â€” starting at idx in pending, find the next LF
                    // (refilling via fsRead as needed).  Returns
                    // (newPending, newIdx, newEof) via ret, where
                    // newIdx is either lfPos+1 (LF consumed) or
                    // newPending.length() (no LF, hit EOF).  On fsRead
                    // error, returns (pending, idx, eofSeen) via ret
                    // â€” the caller decides how to surface the fsRead
                    // failure.
                    //
                    // This helper does NOT touch sourceCell â€” callers
                    // pass the state in and receive updated state
                    // back, so the caller can hold sourceCell (or
                    // any other lock) atomically across the drain.
                    contract scanForLFRefilling(@pending, @idx, @eofSeen, ret) = {
                      new scanRet in {
                        // scanLineForLF's `cap` counts CODEPOINTS.
                        // pending.length() is a BYTE count, and every
                        // codepoint occupies â‰¥1 byte, so bytes+1 is a
                        // strict upper bound on the codepoint count of
                        // pending â€” the quota (`cpCount >= cap`) can
                        // never trigger during our drain (we don't
                        // want quota errors here; the caller of
                        // scanForLFRefilling is doing an unbounded
                        // line skip, not a bounded-cap scan).
                        scanLineForLF!(pending, idx, 0,
                          pending.length() + 1, *scanRet) |
                        for (@scanReply <- scanRet) {
                          match scanReply {
                            [true, "LF_FOUND", lfPos, _] => {
                              ret!((pending, lfPos + 1, eofSeen))
                            }
                            _ => {
                              match eofSeen {
                                true => {
                                  ret!(
                                    (pending, pending.length(), true))
                                }
                                false => {
                                  new readCh in {
                                    fsRead!(fd, 4096, *readCh) |
                                    for (@rr <- readCh) {
                                      match rr {
                                        [true, ba /\ ByteArray] => {
                                          match ba.length() {
                                            0 => {
                                              ret!(
                                                (pending,
                                                 pending.length(),
                                                 true))
                                            }
                                            _ => {
                                              new nextP in {
                                                nextP!(
                                                  [pending.slice(idx,
                                                     pending.length()),
                                                   ba].concatBytes()) |
                                                for (@np <- nextP) {
                                                  scanForLFRefilling!(
                                                    np, 0, false, *ret)
                                                }
                                              }
                                            }
                                          }
                                        }
                                        _ => {
                                          // fsRead error surface â€” return
                                          // original state, caller must
                                          // detect and forward.
                                          ret!(
                                            (pending, idx, eofSeen))
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    } |

                    // outerMint(pending, idx, eofSeen, retCh) â€” mint
                    // a fresh inner CharStream over the given source
                    // state, publish it to activeInnerCell, and put
                    // sourceCell back at (pending, idx, eofSeen).
                    // Reply on retCh with [true, innerHandle].
                    //
                    // Called ONLY when we're ready to hand back a new
                    // inner (caller has already decided idx < length
                    // and inner-slot is free).
                    contract outerMint(@pending, @idx, @eofSeen, retCh) = {
                      new innerStatusCh, innerProducer, innerBuilder in {
                        innerStatusCh!("open") |

                        // Inner chunk builder: same shape as
                        // CharStream / readLine builder.
                        contract innerBuilder(@vals, cbRet) = {
                          match vals {
                            v /\ List =>
                              concatStringsLoop!(v, "", *cbRet)
                            _ => cbRet!(
                              [false, "FSERR_IO",
                               "chunk builder expected List"])
                          }
                        } |

                        // Inner CharStream producer.  Acquisition
                        // order (matches outerProducer): innerStatusCh
                        // FIRST, then sourceCell.
                        contract innerProducer(ipRet) = {
                          for (@stat <- innerStatusCh) {
                            match stat {
                              "revoked" => {
                                innerStatusCh!("revoked") |
                                ipRet!(
                                  [false, "FSERR_CLOSED",
                                   "inner drained by outer"])
                              }
                              "eos" => {
                                innerStatusCh!("eos") |
                                ipRet!(
                                  [false, "EOS", "end of line"])
                              }
                              "open" => {
                                for (@(p, i, eof) <- sourceCell) {
                                  match i >= p.length() {
                                    true => {
                                      match eof {
                                        true => {
                                          sourceCell!((p, i, true)) |
                                          innerStatusCh!("eos") |
                                          ipRet!(
                                            [false, "EOS",
                                             "end of file"])
                                        }
                                        false => {
                                          new readCh in {
                                            fsRead!(fd, 4096, *readCh) |
                                            for (@rr <- readCh) {
                                              match rr {
                                                [true, ba /\ ByteArray] => {
                                                  match ba.length() {
                                                    0 => {
                                                      sourceCell!(
                                                        (p, i, true)) |
                                                      innerStatusCh!("eos") |
                                                      ipRet!(
                                                        [false, "EOS",
                                                         "end of file"])
                                                    }
                                                    _ => {
                                                      sourceCell!(
                                                        (ba, 0, false)) |
                                                      innerStatusCh!("open") |
                                                      innerProducer!(*ipRet)
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  sourceCell!((p, i, eof)) |
                                                  innerStatusCh!("open") |
                                                  ipRet!(rr)
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                    false => {
                                      match p.nth(i) {
                                        10 => {
                                          sourceCell!(
                                            (p, i + 1, eof)) |
                                          innerStatusCh!("eos") |
                                          ipRet!(
                                            [false, "EOS",
                                             "end of line"])
                                        }
                                        b => {
                                          new lenCh in {
                                            codepointLen!(b, *lenCh) |
                                            for (@n <- lenCh) {
                                              match n {
                                                -1 => {
                                                  sourceCell!((p, i, eof)) |
                                                  innerStatusCh!("open") |
                                                  ipRet!(
                                                    [false, "FSERR_IO",
                                                     "invalid UTF-8 start byte"])
                                                }
                                                _ => {
                                                  match i + n <= p.length() {
                                                    true => {
                                                      sourceCell!(
                                                        (p, i + n, eof)) |
                                                      innerStatusCh!("open") |
                                                      ipRet!(
                                                        [true,
                                                         p.slice(i, i + n).decodeUtf8()])
                                                    }
                                                    false => {
                                                      match eof {
                                                        true => {
                                                          sourceCell!((p, i, true)) |
                                                          innerStatusCh!("open") |
                                                          ipRet!(
                                                            [false, "FSERR_IO",
                                                             "truncated UTF-8 at EOF"])
                                                        }
                                                        false => {
                                                          new readCh in {
                                                            fsRead!(fd, 4096, *readCh) |
                                                            for (@rr <- readCh) {
                                                              match rr {
                                                                [true, ba /\ ByteArray] => {
                                                                  match ba.length() {
                                                                    0 => {
                                                                      sourceCell!((p, i, true)) |
                                                                      innerStatusCh!("open") |
                                                                      ipRet!(
                                                                        [false, "FSERR_IO",
                                                                         "truncated UTF-8 at EOF"])
                                                                    }
                                                                    _ => {
                                                                      sourceCell!(
                                                                        ([p.slice(i, p.length()),
                                                                          ba].concatBytes(),
                                                                         0, false)) |
                                                                      innerStatusCh!("open") |
                                                                      innerProducer!(*ipRet)
                                                                    }
                                                                  }
                                                                }
                                                                _ => {
                                                                  sourceCell!((p, i, eof)) |
                                                                  innerStatusCh!("open") |
                                                                  ipRet!(rr)
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              _ => {
                                innerStatusCh!(stat) |
                                ipRet!(
                                  [false, "FSERR_IO",
                                   "inner state unrecognized"])
                              }
                            }
                          }
                        } |

                        for (@innerHandle <-
                          Stream!?(*innerProducer, *innerBuilder)) {
                          activeInnerCell!(*innerStatusCh) |
                          sourceCell!((pending, idx, eofSeen)) |
                          retCh!([true, innerHandle])
                        }
                      }
                    } |

                    // Outer LineStream producer.
                    //
                    // Acquisition order: activeInnerCell â†’ (optionally
                    // innerStatusCh) â†’ sourceCell.  Inner producer
                    // uses innerStatusCh â†’ sourceCell â€” a strict
                    // subset â€” so the two never deadlock.
                    //
                    // The old design had drainSourcePastLF and outer
                    // both take-and-put sourceCell in separate
                    // transactions with a signalling gap in between.
                    // Concurrent scheduling meant outer's re-read
                    // sometimes picked up an unrelated (stale) tuple
                    // and inner2 saw the wrong position.  New design
                    // holds sourceCell for the WHOLE outer.next()
                    // operation â€” no gap, no race.
                    contract outerProducer(retCh) = {
                      // Step 1: consult and revoke active inner.
                      // DO NOT put activeInnerCell back here â€” the
                      // final activeInnerCell state is set exactly
                      // ONCE at the terminal step (mint or EOS).
                      // Putting it back Nil here AND letting
                      // outerMint put back *statusCh would leave TWO
                      // tuples parked, and the next outer.next() call
                      // would non-deterministically pick one â€” often
                      // the stale Nil, so revokeActiveInner would
                      // skip the drain and inner2 would start mid-
                      // way through inner1's line.  (Bug found via
                      // debug tracing.)
                      new needsDrainCh in {
                        for (@innerRef <- activeInnerCell) {
                          match innerRef {
                            Nil => needsDrainCh!(false)
                            _ => {
                              for (@innerStatus <- @innerRef) {
                                match innerStatus {
                                  "open" => {
                                    @innerRef!("revoked") |
                                    needsDrainCh!(true)
                                  }
                                  _ => {
                                    @innerRef!("revoked") |
                                    needsDrainCh!(false)
                                  }
                                }
                              }
                            }
                          }
                        } |
                        for (@needsDrain <- needsDrainCh) {
                          for (@(pending, idx, eofSeen) <- sourceCell) {
                            new drainedCh in {
                              match needsDrain {
                                true => scanForLFRefilling!(
                                  pending, idx, eofSeen, *drainedCh)
                                false => drainedCh!(
                                  (pending, idx, eofSeen))
                              } |
                              for (@(p, i, eof) <- drainedCh) {
                                match i >= p.length() {
                                  true => {
                                    match eof {
                                      true => {
                                        // TERMINATION: EOF via empty source.
                                        new relDoneCh in {
                                          releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                          for (_ <- relDoneCh) {
                                            activeInnerCell!(Nil) |
                                            sourceCell!((p, i, true)) |
                                            retCh!(
                                              [false, "EOS",
                                               "end of file"])
                                          }
                                        }
                                      }
                                      false => {
                                        new readCh in {
                                          fsRead!(fd, 4096, *readCh) |
                                          for (@rr <- readCh) {
                                            match rr {
                                              [true, ba /\ ByteArray] => {
                                                match ba.length() {
                                                  0 => {
                                                    // TERMINATION: EOF via zero-read.
                                                    new relDoneCh in {
                                                      releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                      for (_ <- relDoneCh) {
                                                        activeInnerCell!(Nil) |
                                                        sourceCell!((p, i, true)) |
                                                        retCh!(
                                                          [false, "EOS",
                                                           "end of file"])
                                                      }
                                                    }
                                                  }
                                                  _ => {
                                                    outerMint!(
                                                      ba, 0, false, *retCh)
                                                  }
                                                }
                                              }
                                              _ => {
                                                // TERMINATION: fsRead error.
                                                new relDoneCh in {
                                                  releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                  for (_ <- relDoneCh) {
                                                    activeInnerCell!(Nil) |
                                                    sourceCell!((p, i, eof)) |
                                                    retCh!(rr)
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  false => {
                                    outerMint!(p, i, eof, *retCh)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    } |

                    // Outer chunk builder: chunk() unsupported on
                    // LineStream (spec Â§111).
                    contract outerBuilder(@_vals, cbRet) = {
                      cbRet!(
                        [false, "FSERR_UNSUPPORTED",
                         "chunk unsupported on LineStream (single-active-inner rule)"])
                    } |

                    for (@outerHandle <-
                      Stream!?(*outerProducer, *outerBuilder)) {
                      @[*private, *stateP]!("open") |
                      return!([true, outerHandle])
                    }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!(lockReply)
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- lines(options) â€” slice 8d-3-stream-2 arity-1 variant
    //
    // Per spec Â§1181.  Stream-lifetime sequential lock â€” uses
    // acquireSequentialForStream hand-off helper, outer LineStream
    // construction identical to arity-0.
    //
    // Body deliberately duplicates the arity-0 method (identical
    // outer/inner producer wiring, sourceCell, activeInnerCell,
    // scanForLFRefilling helper, and single-active-inner rule).  Any
    // change to the outer/inner protocol MUST be mirrored across both
    // methods.
    method lines(@options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new sourceCell, activeInnerCell,
                                        scanForLFRefilling, outerMint,
                                        outerProducer, outerBuilder, lockCell in {
                                      sourceCell!(("".hexToBytes(), 0, false)) |
                                      activeInnerCell!(Nil) |
                                      lockCell!((lid, false, *this)) |

                                      contract scanForLFRefilling(@pending, @idx, @eofSeen, ret) = {
                                        new scanRet in {
                                          scanLineForLF!(pending, idx, 0,
                                            pending.length() + 1, *scanRet) |
                                          for (@scanReply <- scanRet) {
                                            match scanReply {
                                              [true, "LF_FOUND", lfPos, _] => {
                                                ret!((pending, lfPos + 1, eofSeen))
                                              }
                                              _ => {
                                                match eofSeen {
                                                  true => {
                                                    ret!(
                                                      (pending, pending.length(), true))
                                                  }
                                                  false => {
                                                    new readCh in {
                                                      fsRead!(fd, 4096, *readCh) |
                                                      for (@rr <- readCh) {
                                                        match rr {
                                                          [true, ba /\ ByteArray] => {
                                                            match ba.length() {
                                                              0 => {
                                                                ret!(
                                                                  (pending,
                                                                   pending.length(),
                                                                   true))
                                                              }
                                                              _ => {
                                                                new nextP in {
                                                                  nextP!(
                                                                    [pending.slice(idx,
                                                                       pending.length()),
                                                                     ba].concatBytes()) |
                                                                  for (@np <- nextP) {
                                                                    scanForLFRefilling!(
                                                                      np, 0, false, *ret)
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                          _ => {
                                                            ret!(
                                                              (pending, idx, eofSeen))
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |

                                      contract outerMint(@pending, @idx, @eofSeen, retCh) = {
                                        new innerStatusCh, innerProducer, innerBuilder in {
                                          innerStatusCh!("open") |

                                          contract innerBuilder(@vals, cbRet) = {
                                            match vals {
                                              v /\ List =>
                                                concatStringsLoop!(v, "", *cbRet)
                                              _ => cbRet!(
                                                [false, "FSERR_IO",
                                                 "chunk builder expected List"])
                                            }
                                          } |

                                          contract innerProducer(ipRet) = {
                                            for (@stat <- innerStatusCh) {
                                              match stat {
                                                "revoked" => {
                                                  innerStatusCh!("revoked") |
                                                  ipRet!(
                                                    [false, "FSERR_CLOSED",
                                                     "inner drained by outer"])
                                                }
                                                "eos" => {
                                                  innerStatusCh!("eos") |
                                                  ipRet!(
                                                    [false, "EOS", "end of line"])
                                                }
                                                "open" => {
                                                  for (@(p, i, eof) <- sourceCell) {
                                                    match i >= p.length() {
                                                      true => {
                                                        match eof {
                                                          true => {
                                                            sourceCell!((p, i, true)) |
                                                            innerStatusCh!("eos") |
                                                            ipRet!(
                                                              [false, "EOS",
                                                               "end of file"])
                                                          }
                                                          false => {
                                                            new readCh in {
                                                              fsRead!(fd, 4096, *readCh) |
                                                              for (@rr <- readCh) {
                                                                match rr {
                                                                  [true, ba /\ ByteArray] => {
                                                                    match ba.length() {
                                                                      0 => {
                                                                        sourceCell!(
                                                                          (p, i, true)) |
                                                                        innerStatusCh!("eos") |
                                                                        ipRet!(
                                                                          [false, "EOS",
                                                                           "end of file"])
                                                                      }
                                                                      _ => {
                                                                        sourceCell!(
                                                                          (ba, 0, false)) |
                                                                        innerStatusCh!("open") |
                                                                        innerProducer!(*ipRet)
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => {
                                                                    sourceCell!((p, i, eof)) |
                                                                    innerStatusCh!("open") |
                                                                    ipRet!(rr)
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      false => {
                                                        match p.nth(i) {
                                                          10 => {
                                                            sourceCell!(
                                                              (p, i + 1, eof)) |
                                                            innerStatusCh!("eos") |
                                                            ipRet!(
                                                              [false, "EOS",
                                                               "end of line"])
                                                          }
                                                          b => {
                                                            new lenCh in {
                                                              codepointLen!(b, *lenCh) |
                                                              for (@n <- lenCh) {
                                                                match n {
                                                                  -1 => {
                                                                    sourceCell!((p, i, eof)) |
                                                                    innerStatusCh!("open") |
                                                                    ipRet!(
                                                                      [false, "FSERR_IO",
                                                                       "invalid UTF-8 start byte"])
                                                                  }
                                                                  _ => {
                                                                    match i + n <= p.length() {
                                                                      true => {
                                                                        sourceCell!(
                                                                          (p, i + n, eof)) |
                                                                        innerStatusCh!("open") |
                                                                        ipRet!(
                                                                          [true,
                                                                           p.slice(i, i + n).decodeUtf8()])
                                                                      }
                                                                      false => {
                                                                        match eof {
                                                                          true => {
                                                                            sourceCell!((p, i, true)) |
                                                                            innerStatusCh!("open") |
                                                                            ipRet!(
                                                                              [false, "FSERR_IO",
                                                                               "truncated UTF-8 at EOF"])
                                                                          }
                                                                          false => {
                                                                            new readCh in {
                                                                              fsRead!(fd, 4096, *readCh) |
                                                                              for (@rr <- readCh) {
                                                                                match rr {
                                                                                  [true, ba /\ ByteArray] => {
                                                                                    match ba.length() {
                                                                                      0 => {
                                                                                        sourceCell!((p, i, true)) |
                                                                                        innerStatusCh!("open") |
                                                                                        ipRet!(
                                                                                          [false, "FSERR_IO",
                                                                                           "truncated UTF-8 at EOF"])
                                                                                      }
                                                                                      _ => {
                                                                                        sourceCell!(
                                                                                          ([p.slice(i, p.length()),
                                                                                            ba].concatBytes(),
                                                                                           0, false)) |
                                                                                        innerStatusCh!("open") |
                                                                                        innerProducer!(*ipRet)
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                  _ => {
                                                                                    sourceCell!((p, i, eof)) |
                                                                                    innerStatusCh!("open") |
                                                                                    ipRet!(rr)
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  innerStatusCh!(stat) |
                                                  ipRet!(
                                                    [false, "FSERR_IO",
                                                     "inner state unrecognized"])
                                                }
                                              }
                                            }
                                          } |

                                          for (@innerHandle <-
                                            Stream!?(*innerProducer, *innerBuilder)) {
                                            activeInnerCell!(*innerStatusCh) |
                                            sourceCell!((pending, idx, eofSeen)) |
                                            retCh!([true, innerHandle])
                                          }
                                        }
                                      } |

                                      contract outerProducer(retCh) = {
                                        new needsDrainCh in {
                                          for (@innerRef <- activeInnerCell) {
                                            match innerRef {
                                              Nil => needsDrainCh!(false)
                                              _ => {
                                                for (@innerStatus <- @innerRef) {
                                                  match innerStatus {
                                                    "open" => {
                                                      @innerRef!("revoked") |
                                                      needsDrainCh!(true)
                                                    }
                                                    _ => {
                                                      @innerRef!("revoked") |
                                                      needsDrainCh!(false)
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          } |
                                          for (@needsDrain <- needsDrainCh) {
                                            for (@(pending, idx, eofSeen) <- sourceCell) {
                                              new drainedCh in {
                                                match needsDrain {
                                                  true => scanForLFRefilling!(
                                                    pending, idx, eofSeen, *drainedCh)
                                                  false => drainedCh!(
                                                    (pending, idx, eofSeen))
                                                } |
                                                for (@(p, i, eof) <- drainedCh) {
                                                  match i >= p.length() {
                                                    true => {
                                                      match eof {
                                                        true => {
                                                          new relDoneCh in {
                                                            releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                            for (_ <- relDoneCh) {
                                                              activeInnerCell!(Nil) |
                                                              sourceCell!((p, i, true)) |
                                                              retCh!(
                                                                [false, "EOS",
                                                                 "end of file"])
                                                            }
                                                          }
                                                        }
                                                        false => {
                                                          new readCh in {
                                                            fsRead!(fd, 4096, *readCh) |
                                                            for (@rr <- readCh) {
                                                              match rr {
                                                                [true, ba /\ ByteArray] => {
                                                                  match ba.length() {
                                                                    0 => {
                                                                      new relDoneCh in {
                                                                        releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                        for (_ <- relDoneCh) {
                                                                          activeInnerCell!(Nil) |
                                                                          sourceCell!((p, i, true)) |
                                                                          retCh!(
                                                                            [false, "EOS",
                                                                             "end of file"])
                                                                        }
                                                                      }
                                                                    }
                                                                    _ => {
                                                                      outerMint!(
                                                                        ba, 0, false, *retCh)
                                                                    }
                                                                  }
                                                                }
                                                                _ => {
                                                                  new relDoneCh in {
                                                                    releaseSeqLockOnce!(*lockCell, *relDoneCh) |
                                                                    for (_ <- relDoneCh) {
                                                                      activeInnerCell!(Nil) |
                                                                      sourceCell!((p, i, eof)) |
                                                                      retCh!(rr)
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                    false => {
                                                      outerMint!(p, i, eof, *retCh)
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      } |

                                      contract outerBuilder(@_vals, cbRet) = {
                                        cbRet!(
                                          [false, "FSERR_UNSUPPORTED",
                                           "chunk unsupported on LineStream (single-active-inner rule)"])
                                      } |

                                      for (@outerHandle <-
                                        Stream!?(*outerProducer, *outerBuilder)) {
                                        return!([true, outerHandle])
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- linesAsStrings(perLineCap) --------------------------------
    //
    // Sequential Stream[String] producer.  Each next() yields one
    // line of the file â€” bytes up to (but excluding) the next LF â€”
    // as a decoded String.  A final unterminated line (file doesn't
    // end with LF) is emitted as its own element; a trailing LF
    // does NOT emit a following empty line (POSIX text convention).
    //
    // ## Cap enforcement
    //
    // `perLineCap` bounds the code point count per line.  If a line
    // exceeds the cap before its terminator is found, next() returns
    // FSERR_QUOTA_EXCEEDED and the stream transitions to error.  Cap
    // is enforced during byte scanning by counting codepoint-start
    // bytes (b < 128 OR b >= 194 per our UTF-8 lead-byte pattern) â€”
    // no need to fully decode.
    //
    // ## Line terminator (MVP: LF only)
    //
    // Spec Â§923 says `\R` â€” the Unicode line-break class covering
    // LF, CR, CRLF, NEL, LS, PS, FF, VT.  This MVP recognizes LF
    // (0x0A) only.  CR and CRLF are NOT stripped; a Windows CRLF
    // file yields lines with a trailing CR byte in each String
    // element.  Full `\R` support is deferred to a follow-up slice.
    //
    // ## Type-guard on cap
    //
    // Cap must be a non-negative Int.  A cap of 0 rejects every
    // line (including the empty one at EOF, which is not emitted
    // anyway).  Non-Int cap â†’ FSERR_BAD_ARG.
    method linesAsStrings(@perLineCap) {
      match perLineCap {
        cap /\ Int => {
          match cap < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "perLineCap must be non-negative"])
            false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lineProducer, lineBuilder, lineCell in {
                            // State: (pending, lineStart, scanPos,
                            //         cpSoFar, eofSeen)
                            lineCell!(("".hexToBytes(), 0, 0, 0, false)) |

                            contract lineProducer(retCh) = {
                              for (@(pending, lineStart, scanPos, cpSoFar, eofSeen) <- lineCell) {
                                new scanRet in {
                                  scanLineForLF!(pending, scanPos, cpSoFar, cap, *scanRet) |
                                  for (@scanReply <- scanRet) {
                                    match scanReply {
                                      [true, "LF_FOUND", lfPos, _endCp] => {
                                        // Emit line pending[lineStart..lfPos].
                                        lineCell!((pending, lfPos + 1, lfPos + 1, 0, eofSeen)) |
                                        retCh!([true,
                                          pending.slice(lineStart, lfPos).decodeUtf8()])
                                      }
                                      [true, "END", newCp] => {
                                        match eofSeen {
                                          true => {
                                            // Final line: pending[lineStart..end].
                                            // Empty â†’ EOS; else emit as last line
                                            // and set state so next call yields EOS.
                                            match lineStart >= pending.length() {
                                              true => {
                                                lineCell!((pending, lineStart, scanPos, cpSoFar, true)) |
                                                retCh!([false, "EOS", "end of file"])
                                              }
                                              false => {
                                                // Consume the tail; next call
                                                // will see lineStart == length
                                                // and return EOS.
                                                lineCell!((pending, pending.length(),
                                                          pending.length(), 0, true)) |
                                                retCh!([true,
                                                  pending.slice(lineStart, pending.length()).decodeUtf8()])
                                              }
                                            }
                                          }
                                          false => {
                                            // Refill: preserve tail, fsRead,
                                            // resume scan at new tail-length.
                                            new readCh in {
                                              fsRead!(fd, 4096, *readCh) |
                                              for (@reply <- readCh) {
                                                match reply {
                                                  [true, ba /\ ByteArray] => {
                                                    match ba.length() {
                                                      0 => {
                                                        // EOF while refilling; retry
                                                        // (scanPos preserved).
                                                        lineCell!((pending, lineStart, scanPos, newCp, true)) |
                                                        lineProducer!(*retCh)
                                                      }
                                                      _ => {
                                                        // Adjust indices: tail
                                                        // = pending[lineStart..end]
                                                        // becomes new [0..tail.length()].
                                                        new tail in {
                                                          tail!(pending.slice(lineStart, pending.length())) |
                                                          for (@t <- tail) {
                                                            new newPending in {
                                                              newPending!([t, ba].concatBytes()) |
                                                              for (@np <- newPending) {
                                                                lineCell!((np, 0, t.length(), newCp, false)) |
                                                                lineProducer!(*retCh)
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                  _ => {
                                                    lineCell!((pending, lineStart, scanPos, cpSoFar, eofSeen)) |
                                                    retCh!(reply)
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                      [false, code, msg] => {
                                        // Scan-side error (e.g., quota
                                        // exceeded).  Preserve state; Stream
                                        // will transition to error on the
                                        // next() reply.
                                        lineCell!((pending, lineStart, scanPos, cpSoFar, eofSeen)) |
                                        retCh!([false, code, msg])
                                      }
                                      _ => {
                                        lineCell!((pending, lineStart, scanPos, cpSoFar, eofSeen)) |
                                        retCh!([false, "FSERR_IO",
                                          "scanLineForLF returned malformed reply"])
                                      }
                                    }
                                  }
                                }
                              }
                            } |

                            // Chunk container for Stream[String]: fold via
                            // `++`.  Same shape as CharStream builder.
                            contract lineBuilder(@vals, retCh) = {
                              match vals {
                                v /\ List => concatStringsLoop!(v, "", *retCh)
                                _ => retCh!([false, "FSERR_IO",
                                  "chunk builder expected List"])
                              }
                            } |

                            for (@streamHandle <- Stream!?(*lineProducer, *lineBuilder)) {
                              @[*private, *stateP]!("open") |
                              return!([true, streamHandle])
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "perLineCap must be an integer"])
      }
    } |

    // -- forEachLine(handler, perLineCap) --------------------------
    //
    // Convenience: linesAsStrings(perLineCap) then Stream.forEach on
    // it.  Handler is invoked once per line with (returnCh, lineStr);
    // handler must reply on returnCh for the fold to advance.
    //
    // Reply matches Stream.forEach: [true] on success, [false, ...]
    // on error (either producer error or handler error).
    method forEachLine(@handler, @perLineCap) {
      for (@laReply <- @(*this)!?("linesAsStrings", perLineCap)) {
        match laReply {
          [true, stream] => {
            for (@r <- @stream!?("forEach", handler)) {
              return!(r)
            }
          }
          _ => return!(laReply)
        }
      }
    } |

    // -- writeChars(charStream) ------------------------------------
    //
    // Sequential CharStream consumer.  Drains `charStream` via
    // next() in a loop, encoding each 1-codepoint String element to
    // UTF-8 bytes via `toUtf8Bytes()` and forwarding to
    // `fsWrite(fd, ...)` at the current cursor.  Advances the cursor.
    //
    // Success (producer EOS): returns [true].  On mid-stream failure
    // (producer error, fsWrite error, or producer emits a non-String
    // element): returns [false, code, "wrote N bytes before failure:
    // MSG"] with the running byte count interpolated per spec Â§938.
    // Input stream is closed on every exit path.
    //
    // Read-only File rejects with FSERR_UNSUPPORTED.  Producer
    // elements that are NOT String are surfaced as FSERR_IO rather
    // than silently coerced â€” this catches producer bugs (e.g., a
    // ByteStream mistakenly handed to writeChars).
    method writeChars(@charStream) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, mode) => {
                  match mode {
                    "r" => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_UNSUPPORTED",
                        "writeChars requires a write-capable mode"])
                    }
                    _ => {
                      // Phase 8 slice 8a step 4e-1: sequential lock around
                      // the entire writeCharsLoop drain â€” writeChars is a
                      // sequential CharStream consumer at the cursor.
                      new lockCh in {
                        // holder MUST be *this â€” cross-cap coordination
                        // depends on it.
                        fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                        for (@lockReply <- lockCh) {
                          match lockReply {
                            [true, lid] => {
                              new loopRet in {
                                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                                for (@finalReply <- loopRet) {
                                  new relCh in {
                                    fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                    for (@_relReply <- relCh) {
                                      @[*private, *stateP]!("open") |
                                      return!(finalReply)
                                    }
                                  }
                                }
                              }
                            }
                            _ => {
                              @[*private, *stateP]!("open") |
                              return!(lockReply)
                            }
                          }
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- writeChars(charStream, options) â€” slice 8d-2 arity-2 variant
    //
    // Per spec Â§1181.  Same pattern as writeBytes arity-2 (slice 8c):
    // wait extraction + withSequentialLock delegation + early stateP
    // release for concurrent-close safety.  Inner action: writeCharsLoop.
    method writeChars(@charStream, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => return!([false, "FSERR_UNSUPPORTED",
                              "writeChars requires a write-capable mode"])
                            _   => {
                              new innerCh, retCh in {
                                for (@cb <- innerCh) {
                                  new loopRet in {
                                    writeCharsLoop!(charStream, fd, 0, *loopRet) |
                                    for (@finalReply <- loopRet) { @cb!(finalReply) }
                                  }
                                } |
                                withSequentialLock!(fd, *this, cmode, w, *innerCh, *retCh) |
                                for (@r <- retCh) { return!(r) }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- writeLine(charStream) -------------------------------------
    //
    // Drains `charStream` via writeChars-style loop, then appends a
    // single LF byte (0x0A) at the current cursor.  Cursor advances
    // past both the char content and the LF.  Success: [true].
    //
    // Line separator on write side is always `\n` (LF) per spec Â§959.
    // Callers needing CRLF write it into the stream themselves via
    // writeString or writeChars.
    //
    // If the char-drain phase errors, we forward that error and do
    // NOT append LF (partial line, no terminator).  If the LF write
    // fails after a successful drain, we forward the LF-write error.
    method writeLine(@charStream) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, mode) => {
                  match mode {
                    "r" => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_UNSUPPORTED",
                        "writeLine requires a write-capable mode"])
                    }
                    _ => {
                      // Phase 8 slice 8a step 4e-1: sequential lock spans
                      // BOTH the char-drain loop AND the LF-terminator
                      // fsWrite â€” so a concurrent sequential caller can't
                      // interleave between the line body and its LF.  This
                      // is what makes writeLine "atomic per line" rather
                      // than "atomic per char" â€” critical for readLine
                      // consumers that rely on LF delimiting exactly one
                      // line's worth of chars.
                      new lockCh in {
                        // holder MUST be *this â€” cross-cap coordination
                        // depends on it.
                        fsLockSequential!(fd, *this, cmode, false, *lockCh) |
                        for (@lockReply <- lockCh) {
                          match lockReply {
                            [true, lid] => {
                              new loopRet in {
                                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                                for (@charsReply <- loopRet) {
                                  match charsReply {
                                    [true] => {
                                      // Append LF (0x0A) at the current cursor.
                                      new lfCh in {
                                        fsWrite!(fd, "0a".hexToBytes(), *lfCh) |
                                        for (@lfReply <- lfCh) {
                                          new relCh in {
                                            fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                            for (@_relReply <- relCh) {
                                              match lfReply {
                                                [true, _] => {
                                                  @[*private, *stateP]!("open") |
                                                  return!([true])
                                                }
                                                [false, code, msg] => {
                                                  // Forward fsWrite's error unchanged
                                                  // â€” spec Â§938 reply shape preserved.
                                                  @[*private, *stateP]!("open") |
                                                  return!([false, code, msg])
                                                }
                                                _ => {
                                                  // Malformed fsWrite reply â€” normalize
                                                  // to FSERR_IO so callers pattern-
                                                  // matching [true] | [false, code, msg]
                                                  // never see an unexpected shape.
                                                  @[*private, *stateP]!("open") |
                                                  return!([false, "FSERR_IO",
                                                    "fsWrite for LF terminator returned malformed reply"])
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {
                                      // Char-drain failed â€” release lock and forward.
                                      new relCh in {
                                        fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                        for (@_relReply <- relCh) {
                                          @[*private, *stateP]!("open") |
                                          return!(charsReply)
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                            _ => {
                              @[*private, *stateP]!("open") |
                              return!(lockReply)
                            }
                          }
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- writeLine(charStream, options) â€” slice 8d-2 arity-2 variant
    //
    // Per spec Â§1181.  Inner action: writeCharsLoop for the line body,
    // then fsWrite(LF) if the loop succeeded.  On char-drain failure,
    // the LF is NOT appended (partial line, no terminator).  Same
    // atomicity guarantee as arity-1: the sequential lock spans BOTH
    // the char-drain and the LF-terminator write, so concurrent
    // sequential callers can't interleave between them.
    method writeLine(@charStream, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => return!([false, "FSERR_UNSUPPORTED",
                              "writeLine requires a write-capable mode"])
                            _   => {
                              new innerCh, retCh in {
                                for (@cb <- innerCh) {
                                  new loopRet in {
                                    writeCharsLoop!(charStream, fd, 0, *loopRet) |
                                    for (@charsReply <- loopRet) {
                                      match charsReply {
                                        [true] => {
                                          // Append LF (0x0A).
                                          new lfCh in {
                                            fsWrite!(fd, "0a".hexToBytes(), *lfCh) |
                                            for (@lfReply <- lfCh) {
                                              match lfReply {
                                                [true, _] => @cb!([true])
                                                [false, code, msg] => @cb!([false, code, msg])
                                                _ => @cb!([false, "FSERR_IO",
                                                  "fsWrite for LF terminator returned malformed reply"])
                                              }
                                            }
                                          }
                                        }
                                        _ => @cb!(charsReply)
                                      }
                                    }
                                  }
                                } |
                                withSequentialLock!(fd, *this, cmode, w, *innerCh, *retCh) |
                                for (@r <- retCh) { return!(r) }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- writeLines(lineStream) ------------------------------------
    //
    // Drains an outer `LineStream` (e.g., from `otherFile!lines()`
    // or `stdin!lines()`), writing each inner `CharStream` as a full
    // line via the existing `writeLine(inner)` method.  Terminator
    // is always LF (spec Â§959, matching writeLine).
    //
    // Sequential; holds the file cursor for the whole call.  Success:
    // `[true]`.  On any inner-write failure or LineStream error,
    // returns `[false, code,
    //   "wrote N lines before failure: MSG"]` and closes the input
    // lineStream (best-effort).  N is the number of lines
    // successfully written (INCLUDING their LFs) before the failure.
    //
    // Cursor discipline: on both success and failure, `stateP` is
    // restored to "open"; the file itself remains usable.  Only the
    // LineStream is closed on exit.
    //
    // Mode gate: requires a write-capable mode (e.g. "w" or "r+");
    // returns FSERR_UNSUPPORTED with no side effects.
    //
    // ## Atomicity scope (Phase 8 slice 8a step 4e-1)
    //
    // **Atomicity is per-line, NOT per-writeLines.**  writeLines
    // releases `stateP` early (below) so `writeLinesLoop` can call
    // back into `writeLine` per inner-line iteration.  Each `writeLine`
    // call independently acquires + releases a whole-file sequential
    // lock (spec Â§1143) â€” so between two internal writeLine calls,
    // another sequential caller (from another File cap on the same
    // physical file, or from another Par branch on this cap) can slip
    // in and interleave its own writes.
    //
    // For cross-call atomic multi-line writes, callers must hold an
    // explicit `lockRange(offset, length, "w")` covering the target
    // region for the duration of the `writeLines` call.  Under Prep A's
    // same-holder skip rule, the explicit range lock and the internal
    // sequential-per-writeLine locks... wait, no: sequential is STRICT
    // same-holder.  An outer explicit range lock does NOT compose with
    // an inner sequential lock via the same cap â€” they conflict.
    // Concretely, a caller who does `file!lockRange(0, N, "w")` and
    // then `file!writeLines(stream)` will trip FSERR_BUSY on the very
    // first internal writeLine because the outer range lock prevents
    // sequential acquisition.  To atomicize multi-line writes across
    // caps, the outer range lock must be held via a DIFFERENT cap on
    // the same (dev, inode) â€” cross-cap coordination blocks other
    // sequential attempts while this cap does per-line writeLine.
    //
    // A future refactor could hoist the sequential lock to writeLines'
    // entry (acquire once, hold across the loop, split writeLine into
    // public + internal variants where internal skips its own acquire).
    // Deferred as YAGNI unless a concrete use case surfaces.
    method writeLines(@lineStream) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (_fd, _root, _rel, mode) => {
                  match mode {
                    "r" => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_UNSUPPORTED",
                        "writeLines requires a write-capable mode"])
                    }
                    _ => {
                      // Release stateP BEFORE starting the loop:
                      // writeLinesLoop calls back into writeLine
                      // (a File method that acquires stateP), so
                      // holding it here would deadlock.  Each
                      // writeLine per iteration is responsible for
                      // its own stateP acquire/release.
                      @[*private, *stateP]!("open") |
                      new loopRet in {
                        writeLinesLoop!(*this, lineStream, 0, *loopRet) |
                        for (@finalReply <- loopRet) {
                          return!(finalReply)
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- writeLines(lineStream, options) â€” slice 8d-2 arity-2 variant
    //
    // Per spec Â§1181.  writeLines has no OUTER lock; each internal
    // writeLine call independently acquires + releases a whole-file
    // sequential lock.  The arity-2 variant threads options through
    // to each internal writeLine so wait:true is honored per-line.
    // Uses writeLinesLoopWithOptions helper (module-level, defined
    // near writeLinesLoop) that mirrors writeLinesLoop but calls
    // writeLine arity-2 with the passed options map.
    //
    // Wait extraction validation happens here at the outer method;
    // the loop-level dispatch passes the (already-validated) options
    // through to writeLine arity-2, whose own wait extraction is a
    // no-op re-check (idempotent).
    method writeLines(@lineStream, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@_w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]) {
                      match params {
                        (_fd, _root, _rel, mode) => {
                          match mode {
                            "r" => {
                              @[*private, *stateP]!("open") |
                              return!([false, "FSERR_UNSUPPORTED",
                                "writeLines requires a write-capable mode"])
                            }
                            _ => {
                              // Release stateP before starting loop
                              // (same rationale as arity-1: internal
                              // writeLine calls re-acquire stateP).
                              @[*private, *stateP]!("open") |
                              new loopRet in {
                                writeLinesLoopWithOptions!(*this, lineStream, options, 0, *loopRet) |
                                for (@finalReply <- loopRet) {
                                  return!(finalReply)
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- readInto(buf) ---------------------------------------------
    //
    // Fill `buf` from the file's current cursor position, up to
    // `buf!remaining()` bytes.  Advances the cursor by nRead.  Reply
    // is `[true, [nRead, eof]]` per spec Â§967.
    //
    // ## Fill-lease discipline (per spec Â§978)
    //
    // Order:
    //   1. beginFill â†’ get token.  Doing this BEFORE peeking
    //      remaining is a review-fix (M-9a-1) that shrinks a TOCTOU
    //      window: with the lease held, no concurrent filler can
    //      change buffer state.  (Buffer's writeBytes doesn't require
    //      the lease, so raw non-fill writers can still race â€” but
    //      that's the "single-filler discipline" the spec assumes.)
    //   2. Peek buf.remaining() and buf.unit() under the lease.
    //      Guard remaining as Int (m-9a-1).
    //   3. fsRead(fd, remBytes) into a chunk.
    //   4. UTF-8 boundary rule (B-9a-1 fix, spec Â§976): if unit is
    //      "utf8", truncate the chunk to validUtf8PrefixLen so we
    //      never write a partial multi-byte sequence into the buffer.
    //   5. buf.writeBytes(truncated-chunk) â†’ actualN.  Buffer may
    //      still short-write (concurrent non-fill writer shrank
    //      remaining, or unit truncation).
    //   6. If any bytes are unwritten (chunk.length() > actualN),
    //      seek the fd BACK by the overshoot so the next call sees
    //      those bytes at the cursor.  Prevents silent data loss
    //      (M-9a-1 + B-9a-1 partial-write recovery).
    //   7. endFill(token) â€” released on every exit path (including
    //      errors).
    //   8. Reply [true, [actualN, eof]] where eof reflects whether
    //      the ORIGINAL fsRead returned 0 bytes.
    //
    // ## Cursor-relative TOCTOU (2026-08-26 clarification â€” Phase 8
    // review follow-up F-cursor)
    //
    // The lock range `[cursor, cursor + remBytes)` is derived from a
    // `fsTell` snapshot taken IMMEDIATELY BEFORE `fsLockRange`.
    // Between that snapshot and the `fsRead` that actually consumes
    // bytes at the cursor, no other method on the same cap can
    // advance the cursor:
    //
    //   * The outer `for (@state <- @[*private, *stateP])` at the
    //     top of `readInto` LINEAR-receives the state token.  Any
    //     concurrent method on the same File cap blocks on the
    //     `stateP` cell until this method re-parks it (`stateP!(
    //     "open")` on every exit path).
    //   * fsTell â†’ fsLockRange â†’ fsRead all happen while stateP is
    //     held, so no in-cap method can advance the cursor between
    //     snapshot and syscall.
    //
    // What the lock does NOT protect:
    //
    //   * Cross-cap access from a DIFFERENT File cap opened on the
    //     same `(dev, inode)` (spec Â§938 shared-Fs caveat).  Range
    //     locks are keyed on `(dev, inode)`, so a second cap's
    //     `fsRead`/`fsWrite` at the same range WILL be serialized
    //     via `fsLockRange` â€” that IS the point of the lock.
    //   * Raw `fs_read`/`fs_write` from a hostile deploy that
    //     bypasses File.rho entirely.  Phase 8 assumes File.rho is
    //     the sole path.
    //
    // Rejected alternatives (see plan doc Â§Concurrency partition
    // 2026-08-12 refinement): no lock (violates spec Â§978); whole-
    // file lock (pessimistic beyond need); pass cursor via caller
    // (FIP-breaking API change).
    //
    // ## Deferred (Phase 8)
    //
    // Multi-fsRead loop for POSIX short reads â€” a follow-up
    // slice can wrap this in a retry loop until buffer fills or EOF.
    //
    // ## Reachability (PB-B-5, 2026-09-01)
    //
    // Buffer-taking methods (this one, `writeFrom`, `readAtInto`,
    // `writeFromAt`, `readLineInto`, `readLinesInto`) require the
    // caller to hold a `Buffer` cap.  PB-B-5 published the
    // `Allocator` at `rho:serve:1.0.0:<pk>:buffer:1.0.0`, so any
    // deploy can now obtain a Buffer via the resolver.  Previously
    // these methods were reachable only from tests scoping Allocator
    // via inline `new`; post-PB-B-5 they are live production paths.
    method readInto(@buf) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  // (1) Acquire lease FIRST (M-9a-1 TOCTOU narrowing).
                  for (@leaseReply <- @buf!?("beginFill")) {
                    match leaseReply {
                      [true, token] => {
                        // (2a) Peek remaining, type-guarded (m-9a-1).
                        for (@remReply <- @buf!?("remaining")) {
                          match remReply {
                            [true, remBytes /\ Int] => {
                              // (2b) Peek unit for UTF-8 boundary rule.
                              for (@unitReply <- @buf!?("unit")) {
                                match unitReply {
                                  [true, unit] => {
                                    // Phase 8 slice 8a step 4d-1 â€” cursor-relative
                                    // read.  fsTell before fsLockRange so the lock
                                    // covers exactly [cursor, cursor+remBytes),
                                    // which is what fsRead will touch.  Skip both
                                    // syscalls when remBytes <= 0 (LockRegistry
                                    // rejects zero-length as BadArg, and fsRead(0)
                                    // is a no-op).
                                    match remBytes <= 0 {
                                      true => {
                                        for (@_endReply <- @buf!?("endFill", token)) {
                                          @[*private, *stateP]!("open") |
                                          return!([true, [0, false]])
                                        }
                                      }
                                      false => {
                                        new tellCh in {
                                          fsTell!(fd, *tellCh) |
                                          for (@tellReply <- tellCh) {
                                            match tellReply {
                                              [true, tellPos /\ Int] => {
                                                new lockCh in {
                                                  // holder MUST be *this â€” cross-cap
                                                  // coordination depends on it.
                                                  fsLockRange!(fd, tellPos, remBytes, "r", *this, cmode, false, *lockCh) |
                                                  for (@lockReply <- lockCh) {
                                                    match lockReply {
                                                      [true, lid] => {
                                                        // (3) fsRead.
                                                        new readCh in {
                                                          fsRead!(fd, remBytes, *readCh) |
                                                          for (@readReply <- readCh) {
                                                            new relCh in {
                                                              // Release lock immediately after fsRead;
                                                              // the disk-range exclusion is only needed
                                                              // for the syscall itself.  Subsequent
                                                              // writeBytes + seek-back operate on the
                                                              // fd's cursor / user-space buffer, not
                                                              // on the disk range.
                                                              fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                                              for (@_relReply <- relCh) {
                                                                match readReply {
                                                                  [true, chunk /\ ByteArray] => {
                                                                    // (4) UTF-8 truncation.
                                                                    new toWrite in {
                                                                      match unit == "utf8" {
                                                                        true => {
                                                                          match chunk.length() {
                                                                            0 => toWrite!(chunk)
                                                                            _ => toWrite!(chunk.slice(0, chunk.validUtf8PrefixLen()))
                                                                          }
                                                                        }
                                                                        false => toWrite!(chunk)
                                                                      } |
                                                                      for (@writeChunk <- toWrite) {
                                                                        // (5) writeBytes.
                                                                        new wCh in {
                                                                          @buf!(*wCh, "writeBytes", writeChunk) |
                                                                          for (@wReply <- wCh) {
                                                                            match wReply {
                                                                              [true, actualN] => {
                                                                                // (6) Seek back for unwritten bytes
                                                                                // (UTF-8 truncation OR buffer short-write).
                                                                                new overshotCh in {
                                                                                  overshotCh!(chunk.length() - actualN) |
                                                                                  for (@overshot <- overshotCh) {
                                                                                    match overshot > 0 {
                                                                                      true => {
                                                                                        new seekCh in {
                                                                                          fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                                                                          for (@_seekReply <- seekCh) {
                                                                                            for (@_endReply <- @buf!?("endFill", token)) {
                                                                                              @[*private, *stateP]!("open") |
                                                                                              return!([true, [actualN, chunk.length() == 0]])
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                      false => {
                                                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                                                          @[*private, *stateP]!("open") |
                                                                                          return!([true, [actualN, chunk.length() == 0]])
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                              _ => {
                                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                                  @[*private, *stateP]!("open") |
                                                                                  return!(wReply)
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => {
                                                                    // fsRead failed; release lease.
                                                                    for (@_endReply <- @buf!?("endFill", token)) {
                                                                      @[*private, *stateP]!("open") |
                                                                      return!(readReply)
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        // Lock acquire failed â€” release lease, forward.
                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                          @[*private, *stateP]!("open") |
                                                          return!(lockReply)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              _ => {
                                                // fsTell failed â€” release lease, forward.
                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                  @[*private, *stateP]!("open") |
                                                  return!(tellReply)
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  _ => {
                                    for (@_endReply <- @buf!?("endFill", token)) {
                                      @[*private, *stateP]!("open") |
                                      return!(unitReply)
                                    }
                                  }
                                }
                              }
                            }
                            _ => {
                              // Malformed remaining reply (m-9a-1 guard).
                              for (@_endReply <- @buf!?("endFill", token)) {
                                @[*private, *stateP]!("open") |
                                return!([false, "FSERR_IO",
                                  "buffer.remaining() returned malformed reply"])
                              }
                            }
                          }
                        }
                      }
                      _ => {
                        // beginFill failed; no lease to release.
                        @[*private, *stateP]!("open") |
                        return!(leaseReply)
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- readInto(buf, options) â€” slice 8d-3-bounded arity-2 variant
    //
    // Per spec Â§1181.  Same shape as readInto arity-1 but with wait
    // extraction + withRangeLock delegation.  Inner action: fsRead
    // (release fires after the syscall; UTF-8 truncation + buffer
    // writeBytes + seek-back happen post-lock).
    method readInto(@buf, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          for (@leaseReply <- @buf!?("beginFill")) {
                            match leaseReply {
                              [true, token] => {
                                for (@remReply <- @buf!?("remaining")) {
                                  match remReply {
                                    [true, remBytes /\ Int] => {
                                      for (@unitReply <- @buf!?("unit")) {
                                        match unitReply {
                                          [true, unit] => {
                                            match remBytes <= 0 {
                                              true => {
                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                  return!([true, [0, false]])
                                                }
                                              }
                                              false => {
                                                new tellCh in {
                                                  fsTell!(fd, *tellCh) |
                                                  for (@tellReply <- tellCh) {
                                                    match tellReply {
                                                      [true, tellPos /\ Int] => {
                                                        new innerCh, retCh in {
                                                          for (@cb <- innerCh) {
                                                            new readCh in {
                                                              fsRead!(fd, remBytes, *readCh) |
                                                              for (@r <- readCh) { @cb!(r) }
                                                            }
                                                          } |
                                                          withRangeLock!(fd, tellPos, remBytes, "r",
                                                                         *this, cmode, w, *innerCh, *retCh) |
                                                          for (@readReply <- retCh) {
                                                            match readReply {
                                                              [true, chunk /\ ByteArray] => {
                                                                new toWrite in {
                                                                  match unit == "utf8" {
                                                                    true => {
                                                                      match chunk.length() {
                                                                        0 => toWrite!(chunk)
                                                                        _ => toWrite!(chunk.slice(0, chunk.validUtf8PrefixLen()))
                                                                      }
                                                                    }
                                                                    false => toWrite!(chunk)
                                                                  } |
                                                                  for (@writeChunk <- toWrite) {
                                                                    new wCh in {
                                                                      @buf!(*wCh, "writeBytes", writeChunk) |
                                                                      for (@wReply <- wCh) {
                                                                        match wReply {
                                                                          [true, actualN] => {
                                                                            new overshotCh in {
                                                                              overshotCh!(chunk.length() - actualN) |
                                                                              for (@overshot <- overshotCh) {
                                                                                match overshot > 0 {
                                                                                  true => {
                                                                                    new seekCh in {
                                                                                      fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                                                                      for (@_seekReply <- seekCh) {
                                                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                                                          return!([true, [actualN, chunk.length() == 0]])
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                  false => {
                                                                                    for (@_endReply <- @buf!?("endFill", token)) {
                                                                                      return!([true, [actualN, chunk.length() == 0]])
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                          _ => {
                                                                            for (@_endReply <- @buf!?("endFill", token)) {
                                                                              return!(wReply)
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                              _ => {
                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                  return!(readReply)
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                          return!(tellReply)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                          _ => {
                                            for (@_endReply <- @buf!?("endFill", token)) {
                                              return!(unitReply)
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {
                                      for (@_endReply <- @buf!?("endFill", token)) {
                                        return!([false, "FSERR_IO",
                                          "buffer.remaining() returned malformed reply"])
                                      }
                                    }
                                  }
                                }
                              }
                              _ => return!(leaseReply)
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- writeFrom(buf) --------------------------------------------
    //
    // Drain the filled region `[0, buf!length())` of `buf` to the
    // file at the current cursor position; advance cursor.  Reply is
    // `[true, nWritten]` per spec Â§971.  Write-mode gated.
    //
    // ## No fill lease
    //
    // Per spec Â§978: "writeFrom is a drain, not a fill, and does not
    // take the lease."  This means a concurrent filler can be
    // modifying the buffer during the drain â€” see spec Â§Fill lease
    // > Disclosure.  The caller is responsible for ensuring buffer
    // content coherence (single-filler discipline).
    //
    // ## Empty buffer
    //
    // `buf!toByteArray()` on an empty buffer returns
    // `[true, empty-bytes]`; we then fsWrite 0 bytes and reply
    // `[true, 0]`.
    //
    // ## Lease conflict
    //
    // If a fill lease is currently held on `buf`, `toByteArray`
    // returns `[false, "BUFERR_FILLING", ...]` per Buffer.rho.  We
    // forward that error unchanged â€” the caller can retry after the
    // filler releases.
    method writeFrom(@buf) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
              match params {
                (fd, _root, _rel, mode) => {
                  match mode {
                    "r" => {
                      @[*private, *stateP]!("open") |
                      return!([false, "FSERR_UNSUPPORTED",
                        "writeFrom requires a write-capable mode"])
                    }
                    _ => {
                      for (@baReply <- @buf!?("toByteArray", 67108864)) {
                        match baReply {
                          [true, bytes /\ ByteArray] => {
                            // Phase 8 slice 8a step 4d-1 â€” cursor-relative
                            // write.  fsTell before fsLockRange so the lock
                            // covers exactly [cursor, cursor+bytes.length()),
                            // matching what fsWrite will touch.  Skip both
                            // syscalls on empty payload â€” LockRegistry
                            // rejects len=0 as BadArg, and fsWrite(0) would
                            // return [true, 0] anyway.
                            match bytes.length() <= 0 {
                              true => {
                                @[*private, *stateP]!("open") |
                                return!([true, 0])
                              }
                              false => {
                                new tellCh in {
                                  fsTell!(fd, *tellCh) |
                                  for (@tellReply <- tellCh) {
                                    match tellReply {
                                      [true, tellPos /\ Int] => {
                                        new lockCh in {
                                          // holder MUST be *this â€” cross-cap
                                          // coordination depends on it.
                                          fsLockRange!(fd, tellPos, bytes.length(), "w", *this, cmode, false, *lockCh) |
                                          for (@lockReply <- lockCh) {
                                            match lockReply {
                                              [true, lid] => {
                                                new writeCh in {
                                                  fsWrite!(fd, bytes, *writeCh) |
                                                  for (@writeReply <- writeCh) {
                                                    new relCh in {
                                                      fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                                      for (@_relReply <- relCh) {
                                                        match writeReply {
                                                          [true, n] => {
                                                            @[*private, *stateP]!("open") |
                                                            return!([true, n])
                                                          }
                                                          _ => {
                                                            @[*private, *stateP]!("open") |
                                                            return!(writeReply)
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              _ => {
                                                @[*private, *stateP]!("open") |
                                                return!(lockReply)
                                              }
                                            }
                                          }
                                        }
                                      }
                                      _ => {
                                        @[*private, *stateP]!("open") |
                                        return!(tellReply)
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => {
                            // toByteArray failed (revoked or lease
                            // conflict) â€” forward.
                            @[*private, *stateP]!("open") |
                            return!(baReply)
                          }
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- writeFrom(buf, options) â€” slice 8d-3-bounded arity-2 variant
    //
    // Per spec Â§1181.  Same shape as writeFrom arity-1 but with wait
    // extraction and withRangeLock delegation.  Inner action: fsWrite
    // at the current cursor (via fsTell to compute the lock range).
    method writeFrom(@buf, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => return!([false, "FSERR_UNSUPPORTED",
                              "writeFrom requires a write-capable mode"])
                            _   => {
                              for (@baReply <- @buf!?("toByteArray", 67108864)) {
                                match baReply {
                                  [true, bytes /\ ByteArray] => {
                                    match bytes.length() <= 0 {
                                      true => return!([true, 0])
                                      false => {
                                        new tellCh in {
                                          fsTell!(fd, *tellCh) |
                                          for (@tellReply <- tellCh) {
                                            match tellReply {
                                              [true, tellPos /\ Int] => {
                                                new innerCh, retCh in {
                                                  for (@cb <- innerCh) {
                                                    new writeCh in {
                                                      fsWrite!(fd, bytes, *writeCh) |
                                                      for (@wReply <- writeCh) { @cb!(wReply) }
                                                    }
                                                  } |
                                                  withRangeLock!(fd, tellPos, bytes.length(), "w",
                                                                 *this, cmode, w, *innerCh, *retCh) |
                                                  for (@r <- retCh) { return!(r) }
                                                }
                                              }
                                              _ => return!(tellReply)
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  _ => return!(baReply)
                                }
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
      }
    } |

    // -- readAtInto(offset, buf) -----------------------------------
    //
    // Positional variant of readInto (spec Â§968).  Reads from
    // absolute file offset `offset` into `buf` via `fsReadAt`.  Does
    // NOT touch the sequential cursor â€” multiple positional readers
    // may coexist (subject to Phase 8 range locks).
    //
    // ## Same discipline as readInto
    //
    // Fill-lease acquired FIRST (M-9a-1 pattern), then peek
    // remaining + unit, then fsReadAt, then UTF-8 truncation if
    // unit == "utf8", then writeBytes.
    //
    // ## No seek-back
    //
    // Unlike readInto, readAtInto's fsReadAt does not advance any
    // cursor.  If the buffer accepts fewer bytes than fsReadAt
    // returned (due to UTF-8 truncation or a raced non-fill writer
    // shrinking the buffer), the caller simply re-invokes with
    // `offset + actualN` to resume â€” no rewind needed.
    //
    // ## Read allowed on read-only files
    //
    // Reading doesn't require write mode (same as readInto).
    method readAtInto(@offset, @buf) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          for (@leaseReply <- @buf!?("beginFill")) {
                            match leaseReply {
                              [true, token] => {
                                for (@remReply <- @buf!?("remaining")) {
                                  match remReply {
                                    [true, remBytes /\ Int] => {
                                      for (@unitReply <- @buf!?("unit")) {
                                        match unitReply {
                                          [true, unit] => {
                                            // Phase 8 slice 8a step 4d-1 â€” acquire
                                            // a positional read lock over
                                            // [off, off+remBytes) around fsReadAt.
                                            // holder MUST be *this â€” cross-cap
                                            // coordination depends on it.  Zero-
                                            // length reads (remBytes == 0) hit the
                                            // native's BadArg branch and short-
                                            // circuit before fsReadAt fires; the
                                            // lease + stateP cleanup still runs.
                                            match remBytes <= 0 {
                                              true => {
                                                // Zero-remaining: skip lock+read,
                                                // return [true, [0, false]].  Not
                                                // an error â€” buffer is already full.
                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                  @[*private, *stateP]!("open") |
                                                  return!([true, [0, false]])
                                                }
                                              }
                                              false => {
                                                new lockCh in {
                                                  fsLockRange!(fd, off, remBytes, "r", *this, cmode, false, *lockCh) |
                                                  for (@lockReply <- lockCh) {
                                                    match lockReply {
                                                      [true, lid] => {
                                                        new readCh in {
                                                          fsReadAt!(fd, off, remBytes, *readCh) |
                                                          for (@readReply <- readCh) {
                                                            new relCh in {
                                                              // Release the lock IMMEDIATELY after
                                                              // fsReadAt returns â€” the read result is
                                                              // already in memory; buffer copy + endFill
                                                              // don't need disk-range exclusion.
                                                              fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                                              for (@_relReply <- relCh) {
                                                                match readReply {
                                                                  [true, chunk /\ ByteArray] => {
                                                                    // UTF-8 truncation for utf8 buffers.
                                                                    new toWrite in {
                                                                      match unit == "utf8" {
                                                                        true => {
                                                                          match chunk.length() {
                                                                            0 => toWrite!(chunk)
                                                                            _ => toWrite!(chunk.slice(0, chunk.validUtf8PrefixLen()))
                                                                          }
                                                                        }
                                                                        false => toWrite!(chunk)
                                                                      } |
                                                                      for (@writeChunk <- toWrite) {
                                                                        new wCh in {
                                                                          @buf!(*wCh, "writeBytes", writeChunk) |
                                                                          for (@wReply <- wCh) {
                                                                            match wReply {
                                                                              [true, actualN] => {
                                                                                // No seek-back for positional
                                                                                // reads â€” the fd cursor is
                                                                                // unchanged by fsReadAt.
                                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                                  @[*private, *stateP]!("open") |
                                                                                  return!([true, [actualN, chunk.length() == 0]])
                                                                                }
                                                                              }
                                                                              _ => {
                                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                                  @[*private, *stateP]!("open") |
                                                                                  return!(wReply)
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => {
                                                                    for (@_endReply <- @buf!?("endFill", token)) {
                                                                      @[*private, *stateP]!("open") |
                                                                      return!(readReply)
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        // Lock acquire failed â€”
                                                        // release lease, forward
                                                        // acquire error.
                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                          @[*private, *stateP]!("open") |
                                                          return!(lockReply)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                          _ => {
                                            for (@_endReply <- @buf!?("endFill", token)) {
                                              @[*private, *stateP]!("open") |
                                              return!(unitReply)
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {
                                      for (@_endReply <- @buf!?("endFill", token)) {
                                        @[*private, *stateP]!("open") |
                                        return!([false, "FSERR_IO",
                                          "buffer.remaining() returned malformed reply"])
                                      }
                                    }
                                  }
                                }
                              }
                              _ => {
                                @[*private, *stateP]!("open") |
                                return!(leaseReply)
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- writeFromAt(offset, buf) ----------------------------------
    //
    // Positional variant of writeFrom (spec Â§972).  Writes buf's
    // filled region to absolute offset `offset` via `fsWriteAt`.
    // Does NOT touch the sequential cursor.  Does NOT take the fill
    // lease (spec Â§978).  Write-mode gated.
    // -- readAtInto(offset, buf, options) â€” slice 8d-3-bounded arity-3
    //
    // Per spec Â§1181.  Positional variant of readInto with wait
    // extraction + withRangeLock delegation.  Inner action: fsReadAt.
    // No seek-back (cursor unchanged by fsReadAt).
    method readAtInto(@offset, @buf, @options) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match options.get("wait") {
                wOpt /\ (Nil \/ Bool) => {
                  new waitCh in {
                    match wOpt {
                      Nil        => waitCh!(false)
                      bb /\ Bool => waitCh!(bb)
                    } |
                    for (@w <- waitCh) {
                      for (@state <- @[*private, *stateP]) {
                        match state {
                          "closed" => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file is closed"])
                          }
                          "open" => {
                            @[*private, *stateP]!("open") |
                            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                              match params {
                                (fd, _root, _rel, _mode) => {
                                  for (@leaseReply <- @buf!?("beginFill")) {
                                    match leaseReply {
                                      [true, token] => {
                                        for (@remReply <- @buf!?("remaining")) {
                                          match remReply {
                                            [true, remBytes /\ Int] => {
                                              for (@unitReply <- @buf!?("unit")) {
                                                match unitReply {
                                                  [true, unit] => {
                                                    match remBytes <= 0 {
                                                      true => {
                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                          return!([true, [0, false]])
                                                        }
                                                      }
                                                      false => {
                                                        new innerCh, retCh in {
                                                          for (@cb <- innerCh) {
                                                            new readCh in {
                                                              fsReadAt!(fd, off, remBytes, *readCh) |
                                                              for (@r <- readCh) { @cb!(r) }
                                                            }
                                                          } |
                                                          withRangeLock!(fd, off, remBytes, "r",
                                                                         *this, cmode, w, *innerCh, *retCh) |
                                                          for (@readReply <- retCh) {
                                                            match readReply {
                                                              [true, chunk /\ ByteArray] => {
                                                                new toWrite in {
                                                                  match unit == "utf8" {
                                                                    true => {
                                                                      match chunk.length() {
                                                                        0 => toWrite!(chunk)
                                                                        _ => toWrite!(chunk.slice(0, chunk.validUtf8PrefixLen()))
                                                                      }
                                                                    }
                                                                    false => toWrite!(chunk)
                                                                  } |
                                                                  for (@writeChunk <- toWrite) {
                                                                    new wCh in {
                                                                      @buf!(*wCh, "writeBytes", writeChunk) |
                                                                      for (@wReply <- wCh) {
                                                                        match wReply {
                                                                          [true, actualN] => {
                                                                            for (@_endReply <- @buf!?("endFill", token)) {
                                                                              return!([true, [actualN, chunk.length() == 0]])
                                                                            }
                                                                          }
                                                                          _ => {
                                                                            for (@_endReply <- @buf!?("endFill", token)) {
                                                                              return!(wReply)
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                              _ => {
                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                  return!(readReply)
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                  _ => {
                                                    for (@_endReply <- @buf!?("endFill", token)) {
                                                      return!(unitReply)
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            _ => {
                                              for (@_endReply <- @buf!?("endFill", token)) {
                                                return!([false, "FSERR_IO",
                                                  "buffer.remaining() returned malformed reply"])
                                              }
                                            }
                                          }
                                        }
                                      }
                                      _ => return!(leaseReply)
                                    }
                                  }
                                }
                                _ => return!([false, "FSERR_IO", "fd params malformed"])
                              }
                            }
                          }
                          _ => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file state unrecognized"])
                          }
                        }
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    method writeFromAt(@offset, @buf) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, mode) => {
                          match mode {
                            "r" => {
                              @[*private, *stateP]!("open") |
                              return!([false, "FSERR_UNSUPPORTED",
                                "writeFromAt requires a write-capable mode"])
                            }
                            _ => {
                              for (@baReply <- @buf!?("toByteArray", 67108864)) {
                                match baReply {
                                  [true, bytes /\ ByteArray] => {
                                    // Phase 8 slice 8a step 4d-1 â€” acquire a
                                    // positional write lock over
                                    // [off, off+bytes.length()) around fsWriteAt.
                                    // holder MUST be *this â€” cross-cap
                                    // coordination depends on it.  Zero-length
                                    // writes short-circuit before both lock
                                    // acquire and fsWriteAt (the native rejects
                                    // len=0 as BadArg; skip both to match
                                    // "empty buffer â†’ [true, 0]" semantics).
                                    match bytes.length() <= 0 {
                                      true => {
                                        @[*private, *stateP]!("open") |
                                        return!([true, 0])
                                      }
                                      false => {
                                        new lockCh in {
                                          fsLockRange!(fd, off, bytes.length(), "w", *this, cmode, false, *lockCh) |
                                          for (@lockReply <- lockCh) {
                                            match lockReply {
                                              [true, lid] => {
                                                new writeCh in {
                                                  fsWriteAt!(fd, off, bytes, *writeCh) |
                                                  for (@writeReply <- writeCh) {
                                                    new relCh in {
                                                      fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see Â§Release-reply discards in LockToken docstring
                                                      for (@_relReply <- relCh) {
                                                        match writeReply {
                                                          [true, n] => {
                                                            @[*private, *stateP]!("open") |
                                                            return!([true, n])
                                                          }
                                                          _ => {
                                                            @[*private, *stateP]!("open") |
                                                            return!(writeReply)
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              _ => {
                                                // Lock acquire failed â€” forward.
                                                @[*private, *stateP]!("open") |
                                                return!(lockReply)
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  _ => {
                                    @[*private, *stateP]!("open") |
                                    return!(baReply)
                                  }
                                }
                              }
                            }
                          }
                        }
                        _ => {
                          @[*private, *stateP]!("open") |
                          return!([false, "FSERR_IO", "fd params malformed"])
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- writeFromAt(offset, buf, options) â€” slice 8d-3-bounded arity-3
    //
    // Per spec Â§1181.  Positional variant of writeFrom with wait
    // extraction + withRangeLock delegation.  Inner action: fsWriteAt
    // at the given offset.
    method writeFromAt(@offset, @buf, @options) {
      match offset {
        off /\ Int => {
          match off < 0 {
            true => return!([false, "FSERR_BAD_ARG",
              "offset must be non-negative"])
            false => {
              match options.get("wait") {
                wOpt /\ (Nil \/ Bool) => {
                  new waitCh in {
                    match wOpt {
                      Nil        => waitCh!(false)
                      bb /\ Bool => waitCh!(bb)
                    } |
                    for (@w <- waitCh) {
                      for (@state <- @[*private, *stateP]) {
                        match state {
                          "closed" => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file is closed"])
                          }
                          "open" => {
                            @[*private, *stateP]!("open") |
                            for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                              match params {
                                (fd, _root, _rel, mode) => {
                                  match mode {
                                    "r" => return!([false, "FSERR_UNSUPPORTED",
                                      "writeFromAt requires a write-capable mode"])
                                    _   => {
                                      for (@baReply <- @buf!?("toByteArray", 67108864)) {
                                        match baReply {
                                          [true, bytes /\ ByteArray] => {
                                            match bytes.length() <= 0 {
                                              true => return!([true, 0])
                                              false => {
                                                new innerCh, retCh in {
                                                  for (@cb <- innerCh) {
                                                    new writeCh in {
                                                      fsWriteAt!(fd, off, bytes, *writeCh) |
                                                      for (@wReply <- writeCh) { @cb!(wReply) }
                                                    }
                                                  } |
                                                  withRangeLock!(fd, off, bytes.length(), "w",
                                                                 *this, cmode, w, *innerCh, *retCh) |
                                                  for (@r <- retCh) { return!(r) }
                                                }
                                              }
                                            }
                                          }
                                          _ => return!(baReply)
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => return!([false, "FSERR_IO", "fd params malformed"])
                              }
                            }
                          }
                          _ => {
                            @[*private, *stateP]!("closed") |
                            return!([false, "FSERR_CLOSED", "file state unrecognized"])
                          }
                        }
                      }
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "options.wait must be Bool"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "offset must be an integer"])
      }
    } |

    // -- readLineInto(buf) -----------------------------------------
    //
    // Line-oriented buffer-taking read (spec Â§969).  Reply:
    //   [true, [nRead, {"eof": Bool, "truncated": Bool}]]
    //
    // ## Behavior matrix
    //
    //   buf.remaining() == 0 (full buffer):
    //     nRead=0, eof=false, truncated=true
    //     Preflight â€” do NOT fsRead(0), which would falsely return
    //     [true, ""] and be misinterpreted as EOF (M-1 review fix).
    //
    //   fsRead returns 0 bytes:
    //     nRead=0, eof=true, truncated=false
    //
    //   LF found at pos K, all content bytes fit in buf:
    //     content = chunk[0..K], write to buf, seek past LF.
    //     nRead=K, eof=false, truncated=false
    //
    //   LF found at K, content had to be truncated (utf8 boundary
    //   or buf short-write):
    //     Write actualN < K bytes.  Do NOT consume LF.  Seek back so
    //     the byte after actualN is available on the next call.
    //     nRead=actualN, eof=false, truncated=true
    //
    //   No LF, chunk shorter than requested:
    //     Heuristic â€” treat as EOF (unterminated final line).  See
    //     "Known limitation" below.  Write content (utf8-truncated
    //     if needed).  Seek back unwritten trailing bytes.
    //     nRead=actualN, eof=true, truncated=false.
    //
    //   No LF, chunk fills the request (line longer than buf):
    //     Write actualN bytes.  Seek back overshoot.
    //     nRead=actualN, eof=false, truncated=true
    //
    //   unit == "utf8" AND content starts with an invalid UTF-8
    //   byte (validUtf8PrefixLen == 0 on non-empty content):
    //     FSERR_IO "invalid UTF-8 at cursor" (m-1 review fix).
    //     Without this preflight, a caller loop would spin forever:
    //     truncated=true, actualN=0, no progress across retries.
    //
    // ## Fill-lease + write-mode discipline
    //
    // Lease acquired FIRST (M-9a-1 pattern).  Lease RELEASED before
    // fsSeek (m-2 review fix) so long-tail seek syscalls don't
    // starve other buffer users.  No mode gate (reads).
    //
    // ## Known limitation â€” short-read EOF heuristic (M-3)
    //
    // Distinguishing "fsRead returned less than requested because
    // EOF" from "fsRead returned less than requested for a non-EOF
    // reason" (POSIX signal interruption, non-blocking fd, network
    // fs) requires a second probe read.  The current MVP assumes
    // short read == EOF because our mock fsRead is deterministic
    // and only short-reads at EOF.  Against a real filesystem with
    // adverse conditions, this can produce a false eof=true.
    //
    // Callers targeting non-standard filesystems should verify
    // against fsSize() or re-invoke readLineInto after seeing
    // eof=true to confirm.  A follow-up slice can promote this to
    // a definitive probe (single fsRead(1) after ambiguous short
    // read).
    method readLineInto(@buf) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  for (@leaseReply <- @buf!?("beginFill")) {
                    match leaseReply {
                      [true, token] => {
                        for (@remReply <- @buf!?("remaining")) {
                          match remReply {
                            [true, remBytes /\ Int] => {
                              // M-1 review fix: preflight full-buffer case
                              // (remaining == 0).  fsRead(fd, 0) returns 0
                              // bytes, which our code would misinterpret as
                              // EOF.  Return truncated=true, eof=false so
                              // callers loop-until-eof see the real state.
                              match remBytes {
                                0 => {
                                  for (@_endReply <- @buf!?("endFill", token)) {
                                    @[*private, *stateP]!("open") |
                                    return!([true, [0,
                                      {"eof": false, "truncated": true}]])
                                  }
                                }
                                _ => {
                              for (@unitReply <- @buf!?("unit")) {
                                match unitReply {
                                  [true, unit] => {
                                    new readCh in {
                                      fsRead!(fd, remBytes, *readCh) |
                                      for (@readReply <- readCh) {
                                        match readReply {
                                          [true, chunk /\ ByteArray] => {
                                            match chunk.length() {
                                              0 => {
                                                // Case: EOF, nothing to write.
                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                  @[*private, *stateP]!("open") |
                                                  return!([true, [0,
                                                    {"eof": true, "truncated": false}]])
                                                }
                                              }
                                              chunkLen => {
                                                // Scan for LF.
                                                new scanRet in {
                                                  // cap = chunkLen (never triggers quota â€” we
                                                  // just want the LF position).
                                                  scanLineForLF!(chunk, 0, 0, chunkLen + 1, *scanRet) |
                                                  for (@scanReply <- scanRet) {
                                                    // Determine content bytes.
                                                    new contentCh, lfFoundCh in {
                                                      match scanReply {
                                                        [true, "LF_FOUND", lfPos, _] => {
                                                          contentCh!(chunk.slice(0, lfPos)) |
                                                          lfFoundCh!(true)
                                                        }
                                                        _ => {
                                                          contentCh!(chunk) |
                                                          lfFoundCh!(false)
                                                        }
                                                      } |
                                                      for (@content <- contentCh; @lfFound <- lfFoundCh) {
                                                        // UTF-8 boundary rule + m-1 preflight for
                                                        // invalid start byte (validUtf8PrefixLen
                                                        // returns 0 on non-empty content).  The
                                                        // wrapping shape is [true, chunkToWrite]
                                                        // or [false, code, msg] so the downstream
                                                        // logic can short-circuit on error.
                                                        new toWriteOrErr in {
                                                          match unit == "utf8" {
                                                            true => {
                                                              match content.length() {
                                                                0 => toWriteOrErr!([true, content])
                                                                _ => {
                                                                  match content.validUtf8PrefixLen() {
                                                                    0 => toWriteOrErr!([false, "FSERR_IO",
                                                                      "invalid UTF-8 at cursor"])
                                                                    validLen => toWriteOrErr!(
                                                                      [true, content.slice(0, validLen)])
                                                                  }
                                                                }
                                                              }
                                                            }
                                                            false => toWriteOrErr!([true, content])
                                                          } |
                                                          for (@wrapped <- toWriteOrErr) {
                                                            match wrapped {
                                                              [false, code, msg] => {
                                                                // m-1: invalid UTF-8; release
                                                                // lease and surface FSERR_IO.
                                                                for (@_endReply <- @buf!?("endFill", token)) {
                                                                  @[*private, *stateP]!("open") |
                                                                  return!([false, code, msg])
                                                                }
                                                              }
                                                              [true, writeChunk] => {
                                                            new wCh in {
                                                              @buf!(*wCh, "writeBytes", writeChunk) |
                                                              for (@wReply <- wCh) {
                                                                match wReply {
                                                                  [true, actualN] => {
                                                                    // Compute the consumed fd
                                                                    // position and truncated
                                                                    // flag.  Rules:
                                                                    //  - LF found and all
                                                                    //    content fit: consume
                                                                    //    lfPos+1, not truncated
                                                                    //  - LF found but content
                                                                    //    truncated: consume
                                                                    //    actualN (leave LF for
                                                                    //    next call), truncated=T
                                                                    //  - No LF: consume actualN,
                                                                    //    truncated=(chunkLen ==
                                                                    //    remBytes; else eof)
                                                                    new consumeCh, truncCh, eofCh in {
                                                                      match lfFound {
                                                                        true => {
                                                                          match actualN == content.length() {
                                                                            true => {
                                                                              // consume includes LF
                                                                              consumeCh!(content.length() + 1) |
                                                                              truncCh!(false) |
                                                                              eofCh!(false)
                                                                            }
                                                                            false => {
                                                                              consumeCh!(actualN) |
                                                                              truncCh!(true) |
                                                                              eofCh!(false)
                                                                            }
                                                                          }
                                                                        }
                                                                        false => {
                                                                          // No LF.  If chunk short-
                                                                          // read AND all content
                                                                          // fit â†’ probable EOF.
                                                                          consumeCh!(actualN) |
                                                                          match actualN == content.length() {
                                                                            true => {
                                                                              // All content written; if
                                                                              // chunk was short vs remBytes,
                                                                              // treat as EOF.
                                                                              match chunkLen < remBytes {
                                                                                true => {
                                                                                  truncCh!(false) |
                                                                                  eofCh!(true)
                                                                                }
                                                                                false => {
                                                                                  truncCh!(true) |
                                                                                  eofCh!(false)
                                                                                }
                                                                              }
                                                                            }
                                                                            false => {
                                                                              // Content couldn't be
                                                                              // fully written; truncated.
                                                                              truncCh!(true) |
                                                                              eofCh!(false)
                                                                            }
                                                                          }
                                                                        }
                                                                      } |
                                                                      for (@consume <- consumeCh; @truncated <- truncCh; @eof <- eofCh) {
                                                                        // m-2 review fix: release the fill
                                                                        // lease BEFORE the seek so long-tail
                                                                        // syscalls don't starve other buffer
                                                                        // users.  The buffer is already fully
                                                                        // written; seek is fd-only cleanup.
                                                                        for (@_endReply <- @buf!?("endFill", token)) {
                                                                          new overshotCh in {
                                                                            overshotCh!(chunkLen - consume) |
                                                                            for (@overshot <- overshotCh) {
                                                                              match overshot > 0 {
                                                                                true => {
                                                                                  new seekCh in {
                                                                                    fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                                                                    for (@_seekReply <- seekCh) {
                                                                                      @[*private, *stateP]!("open") |
                                                                                      return!([true, [actualN,
                                                                                        {"eof": eof, "truncated": truncated}]])
                                                                                    }
                                                                                  }
                                                                                }
                                                                                false => {
                                                                                  @[*private, *stateP]!("open") |
                                                                                  return!([true, [actualN,
                                                                                    {"eof": eof, "truncated": truncated}]])
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => {
                                                                    for (@_endReply <- @buf!?("endFill", token)) {
                                                                      @[*private, *stateP]!("open") |
                                                                      return!(wReply)
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                              }  // close [true, writeChunk] arm
                                                            }    // close match wrapped
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                          _ => {
                                            for (@_endReply <- @buf!?("endFill", token)) {
                                              @[*private, *stateP]!("open") |
                                              return!(readReply)
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  _ => {
                                    for (@_endReply <- @buf!?("endFill", token)) {
                                      @[*private, *stateP]!("open") |
                                      return!(unitReply)
                                    }
                                  }
                                }
                              }
                                }  // close _ arm of match remBytes
                              }    // close match remBytes
                            }
                            _ => {
                              for (@_endReply <- @buf!?("endFill", token)) {
                                @[*private, *stateP]!("open") |
                                return!([false, "FSERR_IO",
                                  "buffer.remaining() returned malformed reply"])
                              }
                            }
                          }
                        }
                      }
                      _ => {
                        @[*private, *stateP]!("open") |
                        return!(leaseReply)
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- readLineInto(buf, options) â€” NB-readLineInto slice (2026-09-02)
    //
    // Arity-2 wait-variant, per spec Â§978 "line-based [buffer-fill]
    // methods hold the whole-file cursor.  All five accept the
    // optional `{"wait": true}` options-map argument."  Mirrors the
    // arity-1 `readLine(options)` pattern: acquires the whole-file
    // sequential lock via `acquireSequentialForStream!` with the
    // caller-supplied `wait` flag, then delegates to arity-1
    // `readLineInto` for the actual fill, then releases the lock
    // on every exit path.
    //
    // Options-map shape:
    //   {"wait": Bool}   â€” Nil / missing / false â†’ immediate BUSY
    //                      on conflict; true â†’ parks until admitted
    //                      by the sequential-lock waiter queue.
    //
    // Rejection: any non-Bool / non-Nil value at "wait" returns
    // FSERR_BAD_ARG (parity with `readInto(buf, options)`).
    //
    // Backward compatibility: arity-1 `readLineInto(buf)` is
    // unchanged (does NOT acquire the sequential lock â€” pre-existing
    // spec-noncompliance vs. Â§978, tracked as a separate slice).
    // Callers wanting the spec's "hold the whole-file cursor"
    // semantic MUST use this arity-2 variant.
    method readLineInto(@buf, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new innerRet in {
                                      @(*this)!(*innerRet, "readLineInto", buf) |
                                      for (@reply <- innerRet) {
                                        new relCh in {
                                          fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see LockToken Â§Release-reply discards
                                          for (@_r <- relCh) {
                                            return!(reply)
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG",
          "options.get(\"wait\") must be Bool or Nil"])
      }
    } |

    // -- readLinesInto(rows) ---------------------------------------
    //
    // Fill each inner buffer of `rows` with one line from the file,
    // stopping when either `rows.capacityRows()` inners are filled
    // OR the file reaches EOF.  Returns
    //   `[true, [nLines, {"eof": bool, "truncated": bool}]]`
    // per spec Â§970.
    //
    // ## Fill algorithm (spec Â§587-607, MVP: LF-only terminator)
    //
    // For each inner slot i in [0, m):
    //   1. inner â† rows.getAt(i); inner.clear()
    //   2. readLineInto(inner)  â€” fills up to LF or capacity, per
    //      slice 12 semantics
    //   3. If truncated: drain source past next LF (overflow drop),
    //      setting truncatedAny = true; a drain that hits EOF sets
    //      eofSeen = true.
    //   4. If eof reached: stop (may include the current unterminated
    //      final line if it had content).
    //
    // ## Difference from `readLineInto` overflow semantics
    //
    // `readLineInto` leaves the source cursor mid-line on truncation
    // (caller must re-call with a fresh buffer to continue the line).
    // `readLinesInto` DROPS the overflow: after a full inner, we read
    // and discard bytes until the next LF, then advance to the next
    // inner.  This matches spec Â§635-645 and gives the bounded-memory
    // guarantee of the "buffer of buffers" pattern.
    //
    // ## Concurrency partition
    //
    // Same as readLineInto: line-based, holds the whole-file cursor.
    // Mixing with in-flight byte-level calls yields FSERR_BUSY (not
    // enforced in this MVP â€” see Â§Concurrency deferrals).
    //
    // ## Known limitation â€” LF-only terminator (spec Â§618-631)
    //
    // Spec Â§618 says split on `\R` (Unicode line-break class).  This
    // MVP recognizes only LF (0x0A), matching `linesAsStrings` and
    // `lines()`.  CR, CRLF, NEL, LS, PS, FF, VT are treated as
    // content.  A follow-up slice adds full `\R` support in one place
    // (scanLineForLF) which propagates to all three line methods.
    //
    // ## Known limitation â€” short-read EOF heuristic (M-3, slice 12)
    //
    // Inherits the M-3 ambiguity from `readLineInto`: a chunk that
    // fills the inner buffer EXACTLY without an LF is treated as
    // overflow (marked truncated, drain runs).  In the rare case where
    // the file's last line happens to be exactly capacity bytes with
    // no trailing LF, we'll over-classify it as truncated and drain
    // (find nothing â†’ EOF).
    method readLinesInto(@rows) {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file is closed"])
          }
          "open" => {
            for (@params <<- @[*private, *fdP]) {
              match params {
                (fd, _root, _rel, _mode) => {
                  for (@capReply <- @rows!?("capacityRows")) {
                    match capReply {
                      [true, m /\ Int] => {
                        // Release stateP BEFORE the loop: the loop
                        // calls back into readLineInto per inner
                        // (which acquires stateP), so holding it here
                        // would deadlock â€” same pattern as writeLines.
                        @[*private, *stateP]!("open") |
                        new loopRet in {
                          readLinesIntoLoop!(*this, fd, rows, m, 0, 0,
                            false, false, *loopRet) |
                          for (@finalReply <- loopRet) {
                            return!(finalReply)
                          }
                        }
                      }
                      _ => {
                        @[*private, *stateP]!("open") |
                        return!(capReply)
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!("open") |
                  return!([false, "FSERR_IO", "fd params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "file state unrecognized"])
          }
        }
      }
    } |

    // -- readLinesInto(rows, options) â€” NB-readLineInto slice (2026-09-02)
    //
    // Arity-2 wait-variant, symmetric with `readLineInto(buf, options)`.
    // Per spec Â§978, `readLinesInto` is line-based and holds the
    // whole-file cursor; accepts `{"wait": true}`.  Same
    // acquire-delegate-release shape: acquire the sequential lock
    // via `acquireSequentialForStream!`, delegate to arity-1
    // `readLinesInto(rows)` for the fill loop, release on every
    // exit path.
    //
    // Note: arity-1 `readLinesInto(rows)` internally calls
    // `readLineInto(inner)` in a loop.  Under arity-2 those inner
    // calls happen while we hold the whole-file sequential lock â€”
    // they see no conflict from arity-1's internal fsRead/fsSeek
    // (no lock acquisitions there) and produce their usual replies.
    // The outer sequential lock is what Â§978 requires; the inner
    // arity-1 calls' spec-noncompliance re: not-acquiring-a-lock
    // is the pre-existing gap tracked separately.
    method readLinesInto(@rows, @options) {
      match options.get("wait") {
        wOpt /\ (Nil \/ Bool) => {
          new waitCh in {
            match wOpt {
              Nil        => waitCh!(false)
              bb /\ Bool => waitCh!(bb)
            } |
            for (@w <- waitCh) {
              for (@state <- @[*private, *stateP]) {
                match state {
                  "closed" => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file is closed"])
                  }
                  "open" => {
                    @[*private, *stateP]!("open") |
                    for (@params <<- @[*private, *fdP]; @cmode <<- @[*private, *cmodeP]) {
                      match params {
                        (fd, _root, _rel, _mode) => {
                          new lockOut, acqRet in {
                            acquireSequentialForStream!(fd, *this, cmode, w, *lockOut, *acqRet) |
                            for (@acqReply <- acqRet) {
                              match acqReply {
                                [true] => {
                                  for (@lid <- lockOut) {
                                    new innerRet in {
                                      @(*this)!(*innerRet, "readLinesInto", rows) |
                                      for (@reply <- innerRet) {
                                        new relCh in {
                                          fsReleaseLock!(lid, *this, *relCh) |  // reply discarded â€” see LockToken Â§Release-reply discards
                                          for (@_r <- relCh) {
                                            return!(reply)
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => return!(acqReply)
                              }
                            }
                          }
                        }
                        _ => return!([false, "FSERR_IO", "fd params malformed"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *stateP]!("closed") |
                    return!([false, "FSERR_CLOSED", "file state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG",
          "options.get(\"wait\") must be Bool or Nil"])
      }
    } |

    // -- Default arm -----------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Phase 8 slice 8a step 4c-2 â€” LockToken agent.
  // ==================================================================
  //
  // Wraps an opaque `LockId` returned by `fs_lock_range` /
  // `fs_lock_sequential`.  Sole method `release` calls
  // `fs_release_lock` and marks the state cell "released" so a
  // second call returns FSERR_CLOSED idempotently.
  //
  // ## Lifecycle
  //
  // - **Mint**: `File.lockRange` calls `LockToken!?(lockId, *this)`
  //   passing the acquiring cap's `*this` as the holder identity
  //   captured at acquire time; the agent's constructor stashes
  //   `(lockId, holder)` in a per-instance state cell and returns
  //   `bundle+{*this}` â€” the LockToken handle the caller holds.
  // - **Release (explicit)**: caller sends `!?("release")`; the
  //   release method linearly consumes the state cell, calls
  //   `fs_release_lock(lockId, holder)` if active â€” passing the
  //   holder captured at mint, NOT LockToken's own `*this` â€” marks
  //   "released", and forwards the native's reply.
  // - **Release (implicit, via File.close)**: `File.close` invokes
  //   `fs_release_all_for_holder(*this)` (step 4f) which sweeps
  //   every lock owned by this cap's holder.  Subsequent
  //   `token!release()` returns FSERR_CLOSED via the unknown-LockId
  //   branch of `fs_release_lock` â€” spec Â§File > close.
  // - **Release (implicit, via deploy-end)**: `WalDeployScope::end`
  //   (step 5) invokes `release_all_for_deploy(scope)` which sweeps
  //   every lock owned by this deploy.  Same FSERR_CLOSED semantics
  //   for post-sweep `release`.
  //
  // ## Idempotence
  //
  // Second `release` on an already-released token sees the "released"
  // sentinel in the state cell and returns
  // `[false, "FSERR_CLOSED", "lock already released"]` â€” matches
  // `File.close` / `Stream.close` idempotence style.
  //
  // ## Ocap attenuation
  //
  // The bundled `LockToken` handle is send-only (bundle+); anyone
  // holding it may invoke `release`.  Callers who want to hand out
  // "hold this token but don't release it" use the standard forwarder
  // pattern (spec Â§Ocap patterns > Attenuation via forwarder) â€” no
  // LockToken-specific machinery.
  //
  // ## Release-reply discards (anchor for File.rho callers)
  //
  // Both this agent's `release` method and the auto-acquire wraps in
  // `File`'s positional methods (`readInto`, `readAtInto`, `writeFrom`,
  // `writeFromAt`, `writeBytesAt`, `bytesAt`) discard the reply from
  // `fsReleaseLock` via `for (@_r <- relCh)` or `for (@_relReply <- relCh)`.
  // The only failure mode `fs_release_lock` surfaces is `FSERR_CLOSED`
  // (unknown LockId), which happens if a concurrent `File.close` sweep
  // (step 4f) or deploy-end auto-release (step 5) already released the
  // lock â€” nothing to do about it either way at this point in the flow.
  // Discarding is safe by construction; call sites carry a short inline
  // reference to this docstring for future readers.
  agent LockToken {
    // S4.7 follow-up (2026-09-11 hardening): constructor takes BOTH
    // the lockId AND the acquiring cap's holder identity.  State
    // cell payload bumped from `lid` to `(lid, holder)` so `release`
    // passes the SAME holder to `fs_release_lock` (arity 3) that
    // the acquire side passed to `fs_lock_range` /
    // `fs_lock_sequential`.  Without this, LockToken's own `*this`
    // (a distinct unforgeable name) would be passed as the release
    // holder â†’ mismatch at LockRegistry â†’ FSERR_CLOSED.  Every mint
    // site (`LockToken!?(lid, *this)`) carries the correct holder
    // end-to-end.
    //
    // ## X-6b M-05 (2026-09-12, branch-review-2026-09-11.md Track B)
    //
    // **CRITICAL â€” stateP is scoped per LockToken instance, NEVER
    // shared across File caps.**  Each `LockToken!?(lid, *this)`
    // mint gets a fresh `stateP` GPrivate name via the agent
    // constructor's `new this, private in { ... }` desugaring.  Do
    // NOT refactor to hoist stateP to a shared cell (e.g., a
    // module-level "all-locks state map" for observability) without
    // reading this note.
    //
    // Rationale: today's linear consume `for (@state <- @[*private,
    // *lockStateP])` on release serializes CONCURRENT release
    // attempts on the SAME token (D3 FuturesUnordered can
    // interleave releases when a par branch also drops the token).
    // Sharing stateP across tokens would fold that serialization
    // over MULTIPLE independent tokens â€” a call chain like
    // `File.readN â†’ withSequentialLock â†’ callback` on cap A that
    // acquires a subordinate lock on cap B would then serialize
    // with any release path on cap B.  Under the current
    // NB-7 cycle-detection surface (docs/consensus-invariants.md
    // Â§ 8) this would surface as a deadlock hazard the wait-for
    // graph doesn't model (it tracks range acquires + wait:true
    // deferred acquires, not shared-stateP contention).
    //
    // Future refactor guardrails:
    // - If stateP is ever peeked non-linearly (`<<-`) for read-only
    //   introspection, that's SAFE â€” no serialization, no cycle.
    //   The linear `<-` on the release side is what enforces the
    //   discipline.
    // - If a future feature genuinely needs cross-cap coordination
    //   (e.g., a coalesced release that atomically drops N locks),
    //   route it through LockRegistry's `release_all_for_deploy`
    //   instead of shared stateP.  The registry's cycle-detection
    //   is the authoritative gate; token-level linearity is a
    //   per-token safety net.
    constructor(@lid, @holder) {
      @[*private, *lockStateP]!((lid, holder))
    } |
    method release() {
      // Linear consume serializes concurrent release attempts on the
      // same LockToken (D3 FuturesUnordered can interleave method
      // sends from Par branches sharing the token).
      for (@state <- @[*private, *lockStateP]) {
        match state {
          (lockId /\ Int, holder) => {
            // Active: mark released BEFORE the native dispatch so a
            // concurrent second release sees "released" immediately
            // and returns FSERR_CLOSED without racing the fs_release
            // syscall.
            @[*private, *lockStateP]!("released") |
            new relCh in {
              // Reply is FORWARDED, not discarded â€” this is the sole
              // explicit-release surface, so the caller sees success/error
              // directly (unlike auto-acquire wraps that discard).
              // Post-hardening: pass the stashed `holder` (captured
              // at constructor time), NOT LockToken's own `*this`.
              fsReleaseLock!(lockId, holder, *relCh) |
              for (@reply <- relCh) {
                return!(reply)
              }
            }
          }
          _ => {
            // Already released, or state cell holds an unknown value
            // â€” treat as released.  Restore state as-is and return
            // idempotent FSERR_CLOSED.
            @[*private, *lockStateP]!(state) |
            return!([false, "FSERR_CLOSED", "lock already released"])
          }
        }
      }
    } |
    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED",
          "unknown LockToken method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helpers.
  // ==================================================================

  // writeBytesLoop â€” tail-recursive stream drain for writeBytes.
  //
  // Loop state:
  //   stream        the ByteStream handle to drain
  //   fd            the target file descriptor
  //   bytesWritten  running total (for error-message interpolation)
  //   ret           where to send the final reply
  //
  // Each iteration:
  //   1. stream.next() â†’ reply
  //   2. reply == [true, chunk] â†’ fsWrite(fd, chunk); on success
  //      recur with bytesWritten + n; on failure close stream and
  //      return [false, code, "wrote N bytes before failure: MSG"]
  //   3. reply == [false, "EOS", _] â†’ close stream, return [true]
  //   4. reply == [false, code, msg] â†’ close stream, forward with
  //      the byte-count prefix
  //   5. malformed reply â†’ close stream, FSERR_IO
  //
  // The stream close is best-effort; its reply is ignored because the
  // consumer's result is already determined by the loop outcome.
  contract writeBytesLoop(@stream, @fd, @bytesWritten, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, chunk] => {
          new writeCh in {
            fsWrite!(fd, chunk, *writeCh) |
            for (@writeReply <- writeCh) {
              match writeReply {
                [true, n] => writeBytesLoop!(stream, fd, bytesWritten + n, *ret)
                [false, code, msg] => {
                  // M-1 review fix: guard msg type before interpolation.
                  // Rholang's %% operator raises ReduceError if a map
                  // value is not String/Int/Bool/Uri.  Because this
                  // interpolation sits inside a `for/ret!` continuation,
                  // a raise would prevent `ret!` from ever firing â€”
                  // silently bricking the caller.  Non-String msg is
                  // substituted with a placeholder so a reply always
                  // reaches the caller.
                  new nm in {
                    match msg {
                      s /\ String => nm!(s)
                      _           => nm!("[non-string msg suppressed]")
                    } |
                    for (@normalizedMsg <- nm) {
                      for (@_ <- @stream!?("close")) {
                        ret!([false, code,
                          "wrote ${n} bytes before failure: ${m}" %%
                            {"n": bytesWritten, "m": normalizedMsg}])
                      }
                    }
                  }
                }
                _ => {
                  for (@_ <- @stream!?("close")) {
                    ret!([false, "FSERR_IO",
                      "wrote ${n} bytes before fsWrite returned malformed reply" %%
                        {"n": bytesWritten}])
                  }
                }
              }
            }
          }
        }
        [false, "EOS", _] => {
          for (@_ <- @stream!?("close")) { ret!([true]) }
        }
        [false, code, msg] => {
          // M-1 review fix: guard msg type before interpolation (see
          // note on the fsWrite failure arm above).
          new nm in {
            match msg {
              s /\ String => nm!(s)
              _           => nm!("[non-string msg suppressed]")
            } |
            for (@normalizedMsg <- nm) {
              for (@_ <- @stream!?("close")) {
                ret!([false, code,
                  "wrote ${n} bytes before producer failure: ${m}" %%
                    {"n": bytesWritten, "m": normalizedMsg}])
              }
            }
          }
        }
        _ => {
          for (@_ <- @stream!?("close")) {
            ret!([false, "FSERR_IO",
              "wrote ${n} bytes before producer returned malformed reply" %%
                {"n": bytesWritten}])
          }
        }
      }
    }
  } |

  // writeBytesAtLoop â€” same shape as writeBytesLoop but positional.
  //
  // Extra state:
  //   nextOff       the next absolute offset to write at
  //   remaining     bytes still allowed under the maxLength cap;
  //                 0 â†’ stop (cap reached, treat as success)
  //
  // Producer chunks larger than `remaining` are truncated to `remaining`
  // before fsWriteAt.  On a successful partial write of n < requested,
  // the loop advances nextOff by n and re-enters with the un-written
  // tail... except the producer's 1-byte-per-next() convention makes
  // this trivial (n is always 0 or 1).  For future producers that vend
  // multi-byte chunks, we forward whatever fsWriteAt actually wrote.
  contract writeBytesAtLoop(@stream, @fd, @nextOff, @remaining, @bytesWritten, ret) = {
    match remaining {
      0 => {
        for (@_ <- @stream!?("close")) { ret!([true]) }
      }
      _ => {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, chunk] => {
              // Cap the chunk at `remaining` bytes.
              new toWrite in {
                match chunk.length() <= remaining {
                  true  => toWrite!(chunk)
                  false => toWrite!(chunk.slice(0, remaining))
                } |
                for (@c <- toWrite) {
                  new writeCh in {
                    fsWriteAt!(fd, nextOff, c, *writeCh) |
                    for (@writeReply <- writeCh) {
                      match writeReply {
                        [true, n] => {
                          writeBytesAtLoop!(stream, fd, nextOff + n,
                            remaining - n, bytesWritten + n, *ret)
                        }
                        [false, code, msg] => {
                          // M-1 review fix: guard msg type (see
                          // writeBytesLoop's fsWrite failure arm).
                          new nm in {
                            match msg {
                              s /\ String => nm!(s)
                              _           => nm!("[non-string msg suppressed]")
                            } |
                            for (@normalizedMsg <- nm) {
                              for (@_ <- @stream!?("close")) {
                                ret!([false, code,
                                  "wrote ${n} bytes before failure: ${m}" %%
                                    {"n": bytesWritten, "m": normalizedMsg}])
                              }
                            }
                          }
                        }
                        _ => {
                          for (@_ <- @stream!?("close")) {
                            ret!([false, "FSERR_IO",
                              "wrote ${n} bytes before fsWriteAt returned malformed reply" %%
                                {"n": bytesWritten}])
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            [false, "EOS", _] => {
              for (@_ <- @stream!?("close")) { ret!([true]) }
            }
            [false, code, msg] => {
              // M-1 review fix: guard msg type before interpolation.
              new nm in {
                match msg {
                  s /\ String => nm!(s)
                  _           => nm!("[non-string msg suppressed]")
                } |
                for (@normalizedMsg <- nm) {
                  for (@_ <- @stream!?("close")) {
                    ret!([false, code,
                      "wrote ${n} bytes before producer failure: ${m}" %%
                        {"n": bytesWritten, "m": normalizedMsg}])
                  }
                }
              }
            }
            _ => {
              for (@_ <- @stream!?("close")) {
                ret!([false, "FSERR_IO",
                  "wrote ${n} bytes before producer returned malformed reply" %%
                    {"n": bytesWritten}])
              }
            }
          }
        }
      }
    }
  } |

  // writeCharsLoop â€” tail-recursive drain of a CharStream.
  //
  // Same shape as writeBytesLoop but the producer emits String
  // elements (1 codepoint each per spec Â§327); this loop encodes
  // each via `.toUtf8Bytes()` before dispatching to fsWrite.  A
  // producer that emits a non-String value is caught by the inner
  // type-guard and surfaces as FSERR_IO â€” this preserves the
  // "write-side consumers close the stream and reply cleanly on
  // any producer misbehavior" contract from writeBytes.
  //
  // Error msg is guarded per M-1: non-String msg from producer or
  // fsWrite is substituted with a placeholder so the caller always
  // gets a reply.
  contract writeCharsLoop(@stream, @fd, @bytesWritten, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, str] => {
          match str {
            s /\ String => {
              new writeCh in {
                fsWrite!(fd, s.toUtf8Bytes(), *writeCh) |
                for (@writeReply <- writeCh) {
                  match writeReply {
                    [true, n] => writeCharsLoop!(stream, fd, bytesWritten + n, *ret)
                    [false, code, msg] => {
                      new nm in {
                        match msg {
                          m /\ String => nm!(m)
                          _           => nm!("[non-string msg suppressed]")
                        } |
                        for (@normalizedMsg <- nm) {
                          for (@_ <- @stream!?("close")) {
                            ret!([false, code,
                              "wrote ${n} bytes before failure: ${m}" %%
                                {"n": bytesWritten, "m": normalizedMsg}])
                          }
                        }
                      }
                    }
                    _ => {
                      for (@_ <- @stream!?("close")) {
                        ret!([false, "FSERR_IO",
                          "wrote ${n} bytes before fsWrite returned malformed reply" %%
                            {"n": bytesWritten}])
                      }
                    }
                  }
                }
              }
            }
            _ => {
              for (@_ <- @stream!?("close")) {
                ret!([false, "FSERR_IO",
                  "wrote ${n} bytes before producer returned non-String element" %%
                    {"n": bytesWritten}])
              }
            }
          }
        }
        [false, "EOS", _] => {
          for (@_ <- @stream!?("close")) { ret!([true]) }
        }
        [false, code, msg] => {
          new nm in {
            match msg {
              m /\ String => nm!(m)
              _           => nm!("[non-string msg suppressed]")
            } |
            for (@normalizedMsg <- nm) {
              for (@_ <- @stream!?("close")) {
                ret!([false, code,
                  "wrote ${n} bytes before producer failure: ${m}" %%
                    {"n": bytesWritten, "m": normalizedMsg}])
              }
            }
          }
        }
        _ => {
          for (@_ <- @stream!?("close")) {
            ret!([false, "FSERR_IO",
              "wrote ${n} bytes before producer returned malformed reply" %%
                {"n": bytesWritten}])
          }
        }
      }
    }
  } |

  // writeLinesLoop â€” tail-recursive LineStream drain for writeLines.
  //
  // Each iteration:
  //   1. outer.next() â†’ reply
  //   2. reply == [true, innerCharStream] â†’
  //        fileHandle!writeLine(innerCharStream); on success recur
  //        with linesWritten + 1; on failure close outer and return
  //        [false, code, "wrote N lines before failure: MSG"]
  //   3. reply == [false, "EOS", _] â†’ close outer, return [true]
  //   4. reply == [false, code, msg] â†’ close outer, forward with
  //      the line-count prefix
  //   5. malformed reply â†’ close outer, FSERR_IO
  //
  // The inner CharStream is drained by writeLine's own writeCharsLoop
  // (which closes the inner on exit); we do NOT re-close it here.
  // Phase 8 slice 8d-2 companion: writeLinesLoopWithOptions â€”
  // same as writeLinesLoop but calls writeLine arity-2 with an
  // options map, so wait:true is threaded per-line for the arity-2
  // writeLines caller.  Delegates line-by-line atomicity to
  // writeLine arity-2 (each internal call re-extracts wait from
  // the passed options map).
  contract writeLinesLoopWithOptions(@fileHandle, @lineStream, @options, @linesWritten, ret) = {
    for (@reply <- @lineStream!?("next")) {
      match reply {
        [true, innerStream] => {
          for (@wReply <- @fileHandle!?("writeLine", innerStream, options)) {
            match wReply {
              [true] => writeLinesLoopWithOptions!(
                fileHandle, lineStream, options, linesWritten + 1, *ret)
              [false, code, msg] => {
                new nm in {
                  match msg {
                    m /\ String => nm!(m)
                    _           => nm!("[non-string msg suppressed]")
                  } |
                  for (@normalizedMsg <- nm) {
                    for (@_ <- @lineStream!?("close")) {
                      ret!([false, code,
                        "wrote ${n} lines before failure: ${m}" %%
                          {"n": linesWritten, "m": normalizedMsg}])
                    }
                  }
                }
              }
              _ => {
                for (@_ <- @lineStream!?("close")) {
                  ret!([false, "FSERR_IO",
                    "wrote ${n} lines before writeLine returned malformed reply" %%
                      {"n": linesWritten}])
                }
              }
            }
          }
        }
        [false, "EOS", _] => {
          for (@_ <- @lineStream!?("close")) { ret!([true]) }
        }
        [false, code, msg] => {
          new nm in {
            match msg {
              m /\ String => nm!(m)
              _           => nm!("[non-string msg suppressed]")
            } |
            for (@normalizedMsg <- nm) {
              for (@_ <- @lineStream!?("close")) {
                ret!([false, code,
                  "wrote ${n} lines before producer failure: ${m}" %%
                    {"n": linesWritten, "m": normalizedMsg}])
              }
            }
          }
        }
        _ => {
          for (@_ <- @lineStream!?("close")) {
            ret!([false, "FSERR_IO",
              "wrote ${n} lines before producer returned malformed reply" %%
                {"n": linesWritten}])
          }
        }
      }
    }
  } |

  contract writeLinesLoop(@fileHandle, @lineStream, @linesWritten, ret) = {
    for (@reply <- @lineStream!?("next")) {
      match reply {
        [true, innerStream] => {
          for (@wReply <- @fileHandle!?("writeLine", innerStream)) {
            match wReply {
              [true] => writeLinesLoop!(
                fileHandle, lineStream, linesWritten + 1, *ret)
              [false, code, msg] => {
                new nm in {
                  match msg {
                    m /\ String => nm!(m)
                    _           => nm!("[non-string msg suppressed]")
                  } |
                  for (@normalizedMsg <- nm) {
                    for (@_ <- @lineStream!?("close")) {
                      ret!([false, code,
                        "wrote ${n} lines before failure: ${m}" %%
                          {"n": linesWritten, "m": normalizedMsg}])
                    }
                  }
                }
              }
              _ => {
                for (@_ <- @lineStream!?("close")) {
                  ret!([false, "FSERR_IO",
                    "wrote ${n} lines before writeLine returned malformed reply" %%
                      {"n": linesWritten}])
                }
              }
            }
          }
        }
        [false, "EOS", _] => {
          for (@_ <- @lineStream!?("close")) { ret!([true]) }
        }
        [false, code, msg] => {
          new nm in {
            match msg {
              m /\ String => nm!(m)
              _           => nm!("[non-string msg suppressed]")
            } |
            for (@normalizedMsg <- nm) {
              for (@_ <- @lineStream!?("close")) {
                ret!([false, code,
                  "wrote ${n} lines before producer failure: ${m}" %%
                    {"n": linesWritten, "m": normalizedMsg}])
              }
            }
          }
        }
        _ => {
          for (@_ <- @lineStream!?("close")) {
            ret!([false, "FSERR_IO",
              "wrote ${n} lines before producer returned malformed reply" %%
                {"n": linesWritten}])
          }
        }
      }
    }
  } |

  // readLinesIntoLoop â€” per-inner fill iterator for readLinesInto.
  //
  // Loop state: (fileH, fd, rows, m, i, nLines, truncAny, eofSeen).
  //
  // Per iteration (i < m and not eofSeen):
  //   1. rows.getAt(i) â†’ inner.
  //   2. inner.clear().
  //   3. fileH.readLineInto(inner) â†’ per-line reply.
  //   4. Decide:
  //      - eof=true, nRead=0: EOF hit with no content; stop without
  //        counting a line.
  //      - eof=true, nRead>0: unterminated final line; count it, stop.
  //      - eof=false, truncated=false: normal line; count and recurse.
  //      - eof=false, truncated=true: line overflowed inner; drain
  //        source past next LF (via drainToNextLF), count, recurse
  //        with truncAny=true and possibly eofSeen updated.
  //
  // On error from getAt, clear, or readLineInto, forward as-is.
  contract readLinesIntoLoop(@fileH, @fd, @rows, @m, @i, @nLines,
                             @truncAny, @eofSeen, ret) = {
    match i >= m {
      true => ret!(
        [true, [nLines, {"eof": eofSeen, "truncated": truncAny}]])
      false => {
        match eofSeen {
          true => ret!(
            [true, [nLines, {"eof": true, "truncated": truncAny}]])
          false => {
            for (@getReply <- @rows!?("getAt", i)) {
              match getReply {
                [true, inner] => {
                  for (@clearReply <- @inner!?("clear")) {
                    match clearReply {
                      [true] => {
                        for (@readReply <- @fileH!?("readLineInto", inner)) {
                          match readReply {
                            [true, [nRead /\ Int,
                                    {"eof": eofFlag,
                                     "truncated": truncFlag}]] => {
                              match eofFlag {
                                true => {
                                  match nRead {
                                    0 => ret!(
                                      [true, [nLines,
                                              {"eof": true,
                                               "truncated": truncAny}]])
                                    _ => ret!(
                                      [true, [nLines + 1,
                                              {"eof": true,
                                               "truncated": truncAny}]])
                                  }
                                }
                                false => {
                                  match truncFlag {
                                    true => {
                                      // Overflow: drain past next LF.
                                      new drainRet in {
                                        drainToNextLF!(fd, *drainRet) |
                                        for (@drainReply <- drainRet) {
                                          match drainReply {
                                            [true, eofDuringDrain] => {
                                              readLinesIntoLoop!(fileH, fd,
                                                rows, m, i + 1,
                                                nLines + 1, true,
                                                eofDuringDrain, *ret)
                                            }
                                            _ => ret!(drainReply)
                                          }
                                        }
                                      }
                                    }
                                    false => {
                                      readLinesIntoLoop!(fileH, fd,
                                        rows, m, i + 1, nLines + 1,
                                        truncAny, false, *ret)
                                    }
                                  }
                                }
                              }
                            }
                            _ => ret!(readReply)
                          }
                        }
                      }
                      _ => ret!(clearReply)
                    }
                  }
                }
                _ => ret!(getReply)
              }
            }
          }
        }
      }
    }
  } |

  // drainToNextLF â€” read and discard bytes from the file until the
  // next LF (consumed) or EOF (not consumed).  Returns
  //   [true, hitEof]
  // where hitEof=true iff we reached EOF without seeing an LF.
  // Forwards fsRead / fsSeek errors as-is.
  //
  // Uses a chunked approach: fsRead a 4096-byte block, scan for LF;
  // if found, seek back to just past the LF; if not, recurse for
  // more.  When fsRead returns 0 bytes, we're at EOF.
  contract drainToNextLF(@fd, ret) = {
    new readCh in {
      fsRead!(fd, 4096, *readCh) |
      for (@reply <- readCh) {
        match reply {
          [true, ba /\ ByteArray] => {
            match ba.length() {
              0 => ret!([true, true])
              _ => {
                new scanRet in {
                  scanLineForLF!(ba, 0, 0, ba.length() + 1, *scanRet) |
                  for (@scanReply <- scanRet) {
                    match scanReply {
                      [true, "LF_FOUND", lfPos, _] => {
                        // fsRead consumed the whole ba.  Seek back
                        // to just past the LF (ba.length() - (lfPos+1)
                        // bytes back).  M-13-1 fix: shape-match the
                        // fsSeek reply and forward errors â€” previously
                        // the seek reply was discarded, silently
                        // masking a wrong-position fd if seek failed.
                        new overshotCh in {
                          overshotCh!(ba.length() - (lfPos + 1)) |
                          for (@overshot <- overshotCh) {
                            match overshot > 0 {
                              true => {
                                new seekCh in {
                                  fsSeek!(fd, 0 - overshot, "cur", *seekCh) |
                                  for (@seekReply <- seekCh) {
                                    match seekReply {
                                      [true, _] => ret!([true, false])
                                      [true]    => ret!([true, false])
                                      _         => ret!(seekReply)
                                    }
                                  }
                                }
                              }
                              false => ret!([true, false])
                            }
                          }
                        }
                      }
                      _ => {
                        // No LF in this chunk; recurse.
                        drainToNextLF!(fd, *ret)
                      }
                    }
                  }
                }
              }
            }
          }
          _ => ret!(reply)
        }
      }
    }
  } |

  // codepointLen â€” given the first byte of a UTF-8 codepoint,
  // return how many bytes the codepoint occupies:
  //   1 for ASCII (b < 128)
  //   2 for 2-byte lead     (194 <= b < 224)
  //   3 for 3-byte lead     (224 <= b < 240)
  //   4 for 4-byte lead     (240 <= b < 245)
  //   -1 for invalid start  (128 <= b < 194, or b >= 245)
  //
  // A caller receiving -1 should surface FSERR_IO "invalid UTF-8".
  //
  // ## Boundary rationale
  //
  // The exclusions at 192/193 and 245-247 close two classes of RFC
  // 3629 invalid UTF-8 that Rust's `String::from_utf8_lossy` would
  // otherwise substitute with U+FFFD:
  //
  //   - 0xC0 and 0xC1 are 2-byte leads that can only encode overlong
  //     forms of U+0000..U+007F (ASCII, already representable in one
  //     byte).  Overlong encodings are ill-formed per RFC 3629.
  //     Without this check, our 2-byte slice would decode to two
  //     replacement chars, violating the "1 codepoint per next()"
  //     contract of Â§CharStream.
  //
  //   - 0xF5, 0xF6, 0xF7 are 4-byte leads whose codepoints exceed the
  //     Unicode maximum U+10FFFF.  Same "multi-replacement-char"
  //     failure mode as above.
  //
  //   - 0xFE and 0xFF are never valid UTF-8 leads (rejected via the
  //     `>= 245` check).
  //
  //   - Continuation bytes (10xxxxxx, 128â€“191) at codepoint-start
  //     position are also invalid.
  contract codepointLen(@b, ret) = {
    match b < 128 {
      true => ret!(1)
      false => {
        match b < 194 {
          true => ret!(-1)
          false => {
            match b < 224 {
              true => ret!(2)
              false => {
                match b < 240 {
                  true => ret!(3)
                  false => {
                    match b < 245 {
                      true => ret!(4)
                      false => ret!(-1)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // concatStringsLoop â€” tail-recursive String concatenation over a
  // List[String].  Used by CharStream's chunk builder to fold
  // 1-codepoint elements into a single String.  Rholang's built-in
  // List has no map/reduce; a manual loop with `++` is the idiom.
  contract concatStringsLoop(@lst, @acc, ret) = {
    match lst {
      [] => ret!([true, acc])
      [head ...tail] => {
        match head {
          h /\ String => concatStringsLoop!(tail, acc ++ h, *ret)
          _ => ret!([false, "FSERR_IO",
            "chunk element was not a String"])
        }
      }
    }
  } |

  // scanLineForLF â€” tail-recursive byte scan for LF (0x0A) starting
  // at `pos` in `bytes`.  Counts codepoint-start bytes along the way
  // and fails with FSERR_QUOTA_EXCEEDED if the running count would
  // exceed `cap`.
  //
  // Reply shapes:
  //   [true, "LF_FOUND", pos-of-LF, cpCount]  â€” LF at position;
  //     caller emits bytes[lineStart..pos-of-LF] and advances past LF
  //   [true, "END", cpCount]                    â€” reached end of buffer
  //     without finding LF; caller decides refill vs emit-final-vs-EOS
  //   [false, "FSERR_QUOTA_EXCEEDED", msg]      â€” line exceeded cap
  //
  // Codepoint-start rule: a byte b is treated as a codepoint start
  // if b < 128 (ASCII) OR b >= 194 (multi-byte lead per
  // codepointLen's tightened boundaries).  Continuation bytes and
  // invalid leads (128-193, 245+) don't advance the count.  This
  // matches how many code points the decoded String will contain for
  // well-formed UTF-8; malformed input may see decodeUtf8 substitute
  // U+FFFD, which would advance the "actual" count slightly â€” the
  // cap check is thus a conservative under-estimate for malformed
  // input, biased safe.
  contract scanLineForLF(@bytes, @pos, @cpCount, @cap, ret) = {
    match pos >= bytes.length() {
      true => ret!([true, "END", cpCount])
      false => {
        new byteAt in {
          byteAt!(bytes.nth(pos)) |
          for (@b <- byteAt) {
            match b {
              10 => ret!([true, "LF_FOUND", pos, cpCount])
              _ => {
                new isLead in {
                  match b < 128 {
                    true => isLead!(true)
                    false => {
                      match b < 194 {
                        true  => isLead!(false)  // continuation / invalid
                        false => isLead!(true)   // multi-byte lead
                      }
                    }
                  } |
                  for (@lead <- isLead) {
                    match lead {
                      true => {
                        match cpCount >= cap {
                          true => ret!([false, "FSERR_QUOTA_EXCEEDED",
                            "line exceeds perLineCap code points"])
                          false => scanLineForLF!(bytes, pos + 1, cpCount + 1, cap, *ret)
                        }
                      }
                      false => scanLineForLF!(bytes, pos + 1, cpCount, cap, *ret)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // ---------------------------------------------------------------
  // Phase 8 slice 8c (2026-08-13) â€” auto-acquire helpers for
  // options-map-taking method variants (spec Â§1181).
  //
  // Each helper encapsulates the acquire â†’ inner-action â†’ release
  // dance.  Per-method options-map variants pass an `innerCh` that
  // listens for a callback channel; on receipt, the inner action
  // performs its native call and sends the reply on the callback.
  // The helper then releases the lock and forwards the inner reply
  // to `retCh`.
  //
  // On lock acquisition failure (FSERR_BUSY, FSERR_CANCELLED,
  // FSERR_QUOTA_EXCEEDED, ...), the inner action is NOT invoked;
  // the lock-error reply is forwarded to `retCh` unchanged.
  //
  // Both helpers accept `wait: Bool` and pass it to the arity-8/5
  // native calls (fsLockRange arity-8, fsLockSequential arity-5).
  //
  // ## Inner-action reply protocol (RH-A5-18)
  //
  // The `innerCh` contract MUST reply exactly ONCE on its callback
  // channel: zero replies leaves the lock held (the helper's
  // `for (@innerReply <- innerCallback)` blocks forever); more than
  // one reply races with the release path and produces undefined
  // ordering.  These helpers do NOT validate the reply shape or
  // count â€” a misbehaving inner action strands the lock until deploy
  // end (the auto-release sweep at `WalDeployScope::Drop` catches
  // it, but only after the deploy terminates).
  // ---------------------------------------------------------------

  contract withSequentialLock(@fd, holder, @cmode, @wait, innerCh, retCh) = {
    new lockCh in {
      // Native fsLockSequential arity-5 (fd, holder, cmode, wait, ack).
      fsLockSequential!(fd, *holder, cmode, wait, *lockCh) |
      for (@lockReply <- lockCh) {
        match lockReply {
          [true, lid] => {
            // Invoke the inner action with a fresh callback channel.
            // The inner action's for-listener matches on innerCh,
            // binds the callback name, does its native call, and
            // sends the reply on the callback.
            new callback in {
              innerCh!(*callback) |
              for (@innerReply <- callback) {
                new relCh in {
                  // S4.7 follow-up: pass `*holder` (contract param)
                  // â€” the caller's cap dispatch channel that was
                  // also passed to fsLockSequential above.  `*this`
                  // is invalid outside an agent scope.
                  fsReleaseLock!(lid, *holder, *relCh) |
                  for (@_ <- relCh) { retCh!(innerReply) }
                }
              }
            }
          }
          _ => retCh!(lockReply)
        }
      }
    }
  } |

  contract withRangeLock(@fd, @offset, @length, @mode, holder, @cmode, @wait, innerCh, retCh) = {
    new lockCh in {
      // Native fsLockRange arity-8 (fd, off, len, mode, holder, cmode, wait, ack).
      fsLockRange!(fd, offset, length, mode, *holder, cmode, wait, *lockCh) |
      for (@lockReply <- lockCh) {
        match lockReply {
          [true, lid] => {
            new callback in {
              innerCh!(*callback) |
              for (@innerReply <- callback) {
                new relCh in {
                  // S4.7 follow-up: mirror of withSequentialLock â€”
                  // pass `*holder` from the contract param.
                  fsReleaseLock!(lid, *holder, *relCh) |
                  for (@_ <- relCh) { retCh!(innerReply) }
                }
              }
            }
          }
          _ => retCh!(lockReply)
        }
      }
    }
  } |

  // ---------------------------------------------------------------
  // Phase 8 slice 8d (2026-08-13) â€” hand-off helpers for stream-
  // lifetime-locked methods (chars, bytes, lines, bytesAt).
  //
  // These methods differ from bounded-scope methods (writeByteArray,
  // writeBytes, writeBytesAt) in that their lock spans the STREAM'S
  // LIFETIME.  Release fires from the stream's producer function on
  // termination (EOS / EOF / error), NOT from a bounded inner-action
  // returning.  The withSequentialLock / withRangeLock helpers from
  // slice 8c drive both acquire and release; they don't fit here.
  //
  // The hand-off pattern: the helper acquires the lock and hands the
  // LockId to the caller via `lockOut`, then signals success via
  // `retCh`.  The caller's stream constructor stores the LockId in
  // its existing `lockCell` (or equivalent) and returns the stream
  // handle to the outer caller as usual.  Release remains a per-
  // stream-termination-path concern of the stream's producer function.
  //
  // On lock acquisition failure, the helper forwards the lock-error
  // reply on retCh (no lockOut send); the caller matches the [false,
  // ...] arm and returns the error without constructing a stream.
  //
  // Both helpers accept `wait: Bool` and pass it to the arity-8/5
  // native calls.  Wait:true cancellation surfaces via the ordinary
  // sub-2 native path (RecvError â†’ Cancelled â†’ FSERR_CANCELLED reply
  // on retCh).
  //
  // Ordering note: `lockOut!(lid)` and `retCh!([true])` are parallel
  // sends.  Rholang message queuing means the lockOut send is safe
  // to fire before the caller's `for (@lid <- lockOut)` listens â€”
  // the message sits in the channel until consumed.  Callers MUST
  // wait for retCh's `[true]` before reading lockOut (retCh being
  // false-shaped means acquire failed and no lockOut message will
  // arrive; reading lockOut in that case would hang forever).
  // ---------------------------------------------------------------

  contract acquireRangeForStream(@fd, @offset, @length, @mode, holder,
                                 @cmode, @wait, lockOut, retCh) = {
    new lockCh in {
      fsLockRange!(fd, offset, length, mode, *holder, cmode, wait, *lockCh) |
      for (@lockReply <- lockCh) {
        match lockReply {
          [true, lid] => { lockOut!(lid) | retCh!([true]) }
          _           => retCh!(lockReply)
        }
      }
    }
  } |

  contract acquireSequentialForStream(@fd, holder, @cmode, @wait, lockOut, retCh) = {
    new lockCh in {
      fsLockSequential!(fd, *holder, cmode, wait, *lockCh) |
      for (@lockReply <- lockCh) {
        match lockReply {
          [true, lid] => { lockOut!(lid) | retCh!([true]) }
          _           => retCh!(lockReply)
        }
      }
    }
  } |

  // ---------------------------------------------------------------
  // RH-2 stream-lifetime release-once helper (2026-09-04)
  // ---------------------------------------------------------------
  //
  // Every stream producer (bytes/chars/lines/bytesAt/readLine/
  // readInto/readLineInto) holds a `lockCell` cell carrying
  // `(lockId, released_bool)` and fires the release on the FIRST
  // termination path it reaches (EOS / error / caller-abandonment).
  // Pre-RH-2 the release ceremony was hand-inlined at every
  // termination site (~50 identical `for (@lockState <- lockCell)`
  // blocks across the 7 stream methods): read cell â†’ if (lid,
  // false) flip to (lid, true) + fsReleaseLock, else preserve.
  // The review flagged this as a load-bearing hazard â€” any future
  // fix to release-once bookkeeping must be applied at every one
  // manually or the arity-1 (primary) and arity-N+1 (options)
  // variants would silently diverge.
  //
  // Post-RH-2 every termination path invokes this helper:
  //
  //   new relDoneCh in {
  //     releaseSeqLockOnce!(*lockCell, *relDoneCh) |
  //     for (_ <- relDoneCh) { <tail â€” pendingCell + retCh reply> }
  //   }
  //
  // The tail runs AFTER the release completes (sequential in the
  // (lid, false) branch) OR AFTER the cell-restore fires (immediate
  // in the (lid, true) branch, no fsReleaseLock).  This preserves
  // the pre-RH-2 parallel-vs-sequential ordering of tail sends.
  //
  // The `already` arm matches ANY payload the cell can carry
  // (idempotent-release invariant: (lid, true) or any other
  // tuple shape); it never fires fsReleaseLock a second time.
  //
  // S4.7 follow-up (2026-09-11): the lockCell tuple format bumped
  // from `(lockId, released_bool)` to `(lockId, released_bool,
  // holder)` so this helper can pass the acquiring cap's holder
  // identity to `fs_release_lock` (arity 3 post-hardening).
  // Every seed site in File.rho stores `(lid, false, *this)` where
  // `this` is the acquiring File cap.  On termination, this helper
  // extracts and forwards the holder to `fsReleaseLock!`.  See
  // auto-memory `fileio_wave4_security_followups.md` Â§ Item 2.
  contract releaseSeqLockOnce(lockCell, doneCh) = {
    for (@lockState <- lockCell) {
      match lockState {
        (lockId, false, holder) => {
          lockCell!((lockId, true, holder)) |
          new relCh in {
            fsReleaseLock!(lockId, holder, *relCh) |
            for (@_r <- relCh) { doneCh!(Nil) }
          }
        }
        already => {
          lockCell!(already) |
          doneCh!(Nil)
        }
      }
    }
  }

  |
  

  agent Dir {
    // M-26-2 review fix: validate `cmode` at mint time.  See File.rho's
    // matching constructor.  A malformed cmode causes rootP to hold a
    // REVOKED sentinel so every subsequent method's `match params`
    // falls into its FSERR_IO arm.
    constructor(@canonRoot, @subPath, @mode, @cmode, @FileCtorCh) {
      match cmode {
        "oracular" \/ "consensus" => {
          @[*private, *rootP]!((canonRoot, subPath, mode, FileCtorCh)) |
          @[*private, *cmodeP]!(cmode)
        }
        _ => {
          @[*private, *rootP]!("REVOKED") |
          @[*private, *cmodeP]!("consensus")
        }
      }
    } |

    // -- stat(rel) --------------------------------------------------
    // Slice 26: peeks the persistent `cmodeP` cell and forwards the
    // consensus mode string to `fsStat` â€” the native handler uses
    // this to decide whether to omit host-transient fields
    // (mtime/ctime/atime/owner/group).
    method stat(@rel) {
      match rel {
        r /\ String => {
          for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
            match params {
              (canonRoot, subPath, _mode, _fileCtor) => {
                new joinedCh in {
                  joinRel!(subPath, r, *joinedCh) |
                  for (@joined <- joinedCh) {
                    new retCh in {
                      fsStat!(canonRoot, joined, cmode, *retCh) |
                      for (@reply <- retCh) { return!(reply) }
                    }
                  }
                }
              }
              _ => return!([false, "FSERR_IO", "root params malformed"])
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- entries() --------------------------------------------------
    //
    // Returns [true, EntryStream] â€” a Stream whose elements are per-
    // entry record Maps (see spec Â§Dir > Listing).  Read op; allowed
    // on both "r" and "r+" Dirs.
    //
    // Backing native is the per-fd streaming primitive:
    // `entriesStreamOpen(root, rel, cmode, ack)` allocates a stream fd
    // and `entriesStreamNext(streamFd, ack)` yields one entry per call
    // (or a 2-element `[false, "EOS"]` terminator).  The producer
    // wrapper below adapts the 2-element EOS into the 3-element
    // `[false, "EOS", msg]` shape the Stream producer contract
    // expects (Stream.rho Â§next()).  Callers see the standard
    // Â§Stream.next() / .chunk(n) / .fold(...) surface unchanged.
    //
    // Streaming-backing slice Step 5 (2026-08-25 pickup): swapped
    // from the prior bulk `fs_entries` list-materialization backing.
    // The bulk backing was subject to the `MAX_ENTRIES = 65_536` cap
    // in the native handler; the streaming primitive is uncapped
    // (one entry per Next call, no per-open list materialization).
    // Same caller-facing Stream API â€” no Dir.rho consumer changes.
    //
    // Fd lifecycle: `entriesStreamClose` is called from the producer
    // wrapper on EOS AND on every error branch (including the
    // defensive malformed-reply arm) so the dir fd is released
    // promptly.  A consumer that drops the Stream before EOS (via
    // `Stream.close()` or by dropping the cap entirely) currently
    // leaks the fd within the runtime lifetime: `DirHandleTable::
    // close_all_for_deploy` exists at the Rust layer but is NOT
    // wired into `WalDeployScope::Drop` (Step 5 review-fixup â€”
    // deployed-end sweep is a separately deferred item in the
    // Deferred items catalog).  The current mitigations are the
    // per-runtime `MAX_OPEN_FDS = 1024` cap and per-block runtime
    // respawn via `RuntimeManager::spawn_runtime` â€” both of which
    // bound the leak to a single block's worth of Rholang activity.
    //
    // Root-Dir limitation carried over from the bulk backing: with
    // subPath == "", `entriesStreamOpen` with empty rel triggers
    // safe_descend's "empty relative path" rejection.  Root-Dir
    // listing is deferred to a native tweak (accept empty rel as
    // "list root itself").
    method entries() {
      for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
        match params {
          (canonRoot, subPath, _mode, _fileCtor) => {
            new openRetCh in {
              fsEntriesStreamOpen!(canonRoot, subPath, cmode, *openRetCh) |
              for (@openReply <- openRetCh) {
                match openReply {
                  [true, streamFd] => {
                    new entryProducer, entryBuilder in {
                      // Producer wrapper: each `next()` from the
                      // Stream drives one `entriesStreamNext`.  Reply
                      // adaptation:
                      //   [true, entry]        â†’ [true, entry]
                      //   [false, "EOS"]       â†’ [false, "EOS", "..."]
                      //     (2-element native terminator â†’ 3-element
                      //      Stream producer terminator).  The EOS
                      //      shape is pinned by
                      //      `handlers.rs::fs_entries_stream_next`'s
                      //      terminator branch as strictly 2-element â€”
                      //      a future native-side change that emits
                      //      `[false, "EOS", msg]` (3-element) would
                      //      silently route through the malformed arm
                      //      below.  Load-bearing coupling; any
                      //      handler-side EOS-shape change requires
                      //      updating this match arm.
                      //   [false, code, msg]   â†’ close fd, forward.
                      //   _ (malformed)        â†’ close fd, forward
                      //                          FSERR_IO.  Defensive;
                      //                          the native cannot
                      //                          currently reach this
                      //                          arm, but the close
                      //                          keeps fd-lifecycle
                      //                          invariants intact if
                      //                          it ever does.
                      contract entryProducer(rc) = {
                        new nextRetCh in {
                          fsEntriesStreamNext!(streamFd, *nextRetCh) |
                          for (@nextReply <- nextRetCh) {
                            match nextReply {
                              [true, entry] => rc!([true, entry])
                              [false, "EOS"] => {
                                new closeRetCh in {
                                  fsEntriesStreamClose!(streamFd, *closeRetCh) |
                                  for (@_ <- closeRetCh) {
                                    rc!([false, "EOS", "no more entries"])
                                  }
                                }
                              }
                              [false, code, msg] => {
                                new closeRetCh in {
                                  fsEntriesStreamClose!(streamFd, *closeRetCh) |
                                  for (@_ <- closeRetCh) {
                                    rc!([false, code, msg])
                                  }
                                }
                              }
                              _ => {
                                new closeRetCh in {
                                  fsEntriesStreamClose!(streamFd, *closeRetCh) |
                                  for (@_ <- closeRetCh) {
                                    rc!([false, "FSERR_IO",
                                      "entriesStreamNext returned malformed reply"])
                                  }
                                }
                              }
                            }
                          }
                        }
                      } |
                      contract entryBuilder(@vals, rc) = {
                        // EntryStream chunk container is List of records
                        // per spec Â§337 â€” identity build.
                        rc!([true, vals])
                      } |
                      for (@stream <- Stream!?(*entryProducer, *entryBuilder)) {
                        return!([true, stream])
                      }
                    }
                  }
                  _ => return!(openReply)
                }
              }
            }
          }
          _ => return!([false, "FSERR_IO", "root params malformed"])
        }
      }
    } |

    // -- exists(rel) ------------------------------------------------
    //
    // Consensus ban-lift (2026-09-04): the B1 slice (2026-09-03) had
    // banned Consensus dispatch at the Rholang layer because the
    // native `fs_exists` URN's arity-3 shape carried no cmode signal
    // for Phase-5 re-execute + verify to gate on.  This slice bumps
    // the URN arity 3 â†’ 4 (adding cmode), threads cmode into the
    // fsExists! call below, and mirrors fs_stat's Phase-5 verify in
    // the native handler.  Callers under Consensus now get an
    // authoritatively-verified `[true, Bool]` reply; a divergent
    // follower FS trips `FSERR_CONSENSUS_DIVERGENCE` instead of
    // silently returning a leader-lie.
    method exists(@rel) {
      match rel {
        r /\ String => {
          for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
            match params {
              (canonRoot, subPath, _mode, _fileCtor) => {
                new joinedCh in {
                  joinRel!(subPath, r, *joinedCh) |
                  for (@joined <- joinedCh) {
                    new retCh in {
                      fsExists!(canonRoot, joined, cmode, *retCh) |
                      for (@reply <- retCh) { return!(reply) }
                    }
                  }
                }
              }
              _ => return!([false, "FSERR_IO", "root params malformed"])
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- openFile(rel, mode) ----------------------------------------
    //
    // Mode-attenuates monotonically against the Dir's own mode.
    // Slice 26: peeks `cmodeP` and threads consensusMode into
    // openFileImpl so the minted File inherits the parent Dir's mode.
    // B4 (2026-09-03): spec Â§Dir > Composition requires options-map
    // signatures (matches `Fs.openFile`/`openDir` shape).  Prior
    // shape took positional `@mode`; changed to `@options` with
    // extraction pattern mirroring `Fs.openFile` at Fs.rho:305-330.
    method openFile(@rel, @options) {
      match rel {
        r /\ String => {
          new modeCh in {
            // M-22 (2026-09-04, RH-A5-3): type-guard mode value.
            match options {
              {} => modeCh!("r")
              {"mode": v /\ String ..._} => modeCh!(v)
              {"mode": _ ..._} => modeCh!(
                (false, "FSERR_BAD_ARG", "mode must be a String"))
              {_ : _ ..._} => modeCh!("r")
              _ => modeCh!(Nil)
            } |
            for (@requestedMode <- modeCh) {
              match requestedMode {
                Nil => return!([false, "FSERR_BAD_ARG", "options must be a Map"])
                (false, code, msg) => return!([false, code, msg])
                m /\ String => {
                  for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                    match params {
                      (canonRoot, subPath, dirMode, fileCtor) => {
                        // Mode whitelist via \/ disjunction â€” patterns
                        // match if m equals any of the alternatives.
                        match m {
                          "r" => openFileImpl!(canonRoot, subPath, r, "r", cmode, fileCtor, *return)
                          // Spec Â§File modes lists 8 POSIX forms;
                          // the write-capable set is gated on an
                          // `"r+"` Dir attenuation below.
                          "w" \/ "w+" \/ "wx" \/ "w+x" \/ "a" \/ "a+" \/ "r+" => {
                            match dirMode {
                              "r+" => openFileImpl!(canonRoot, subPath, r, m, cmode, fileCtor, *return)
                              _ => return!([false, "FSERR_UNSUPPORTED",
                                "requested mode exceeds Dir attenuation"])
                            }
                          }
                          _ => return!([false, "FSERR_BAD_ARG", "unknown file mode"])
                        }
                      }
                      _ => return!([false, "FSERR_IO", "root params malformed"])
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "mode must be a String"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- openDir(rel, options) --------------------------------------
    //
    // B4 (2026-09-03): options-map signature per spec Â§Dir >
    // Composition â€” supports `mode` and `path` (path: true enables
    // `mkdir -p`-style ancestor creation per spec Â§Options, requires
    // "r+" Dir mode).  Prior shape took bare `@mode` positional.
    //
    // Mints a nested Dir sharing this Dir's immutable canonRoot, with
    // subPath extended by `rel`.  Validated at mint time via fsStat
    // (M-2): a rel that escapes the sandbox (`..`) or names a non-
    // existent / non-directory path fails eagerly rather than yielding
    // a broken handle whose every method later errors.
    //
    // `options.path: true` is currently accepted but unimplemented â€”
    // returns FSERR_UNSUPPORTED because `openDirImpl` doesn't do
    // mkdir -p yet.  Ships stub so callers can migrate to the
    // options-map shape without needing path=true to work.
    method openDir(@rel, @options) {
      match rel {
        r /\ String => {
          match options {
            m /\ Map => {
              // A5-RH-A5-1 fix (2026-09-04): extract options.get("path")
              // and reject `path: true` with FSERR_UNSUPPORTED.
              // Pre-fix, `path: true` was silently dropped by the
              // `{"mode": modeVal ..._}` remainder pattern; a caller
              // writing `dir!("openDir", "subdir", {"path": true})`
              // got an ordinary openDir on an existing subdir and a
              // misleading FSERR_BAD_ARG on a missing one.  Full
              // implementation (mkdir -p) is deferred; explicit
              // rejection lets callers know the feature isn't ready.
              match options.get("path") {
                true => return!([false, "FSERR_UNSUPPORTED", "path=true not yet implemented"])
                _ => {
                  new modeCh in {
                    match options.get("mode") {
                      Nil          => modeCh!("r")   // default
                      s /\ String  => modeCh!(s)
                      _            => modeCh!(Nil)   // signal bad type
                    } |
                    for (@requestedMode <- modeCh) {
                      match requestedMode {
                        Nil => return!([false, "FSERR_BAD_ARG", "mode must be a String"])
                        m /\ String => {
                          for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                            match params {
                              (canonRoot, subPath, dirMode, fileCtor) => {
                                match m {
                                  "r" => openDirImpl!(canonRoot, subPath, r, "r", cmode, fileCtor, *return)
                                  "r+" => {
                                    match dirMode {
                                      "r+" => openDirImpl!(canonRoot, subPath, r, m, cmode, fileCtor, *return)
                                      _ => return!([false, "FSERR_UNSUPPORTED",
                                        "requested mode exceeds Dir attenuation"])
                                    }
                                  }
                                  _ => return!([false, "FSERR_BAD_ARG",
                                    "dir mode must be \"r\" or \"r+\""])
                                }
                              }
                              _ => return!([false, "FSERR_IO", "root params malformed"])
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "options must be a Map"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- removeFile(rel) --------------------------------------------
    method removeFile(@rel) {
      match rel {
        r /\ String => {
          // H-29-3 lift (2026-08-26): Consensus caps now supported â€”
          // fs_remove_file journals a RemoveFile WAL entry pre-
          // syscall, symmetric on leader and follower.  Forward
          // cmode to the native and let it dispatch.
          for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
            match params {
              (canonRoot, subPath, dirMode, _fileCtor) => {
                match dirMode {
                  "r+" => {
                    new joinedCh in {
                      joinRel!(subPath, r, *joinedCh) |
                      for (@joined <- joinedCh) {
                        new retCh in {
                          fsRemoveFile!(canonRoot, joined, cmode, *retCh) |
                          for (@reply <- retCh) { return!(reply) }
                        }
                      }
                    }
                  }
                  _ => return!([false, "FSERR_UNSUPPORTED",
                    "removeFile requires \"r+\" Dir mode"])
                }
              }
              _ => return!([false, "FSERR_IO", "root params malformed"])
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- removeDir(rel, options) ------------------------------------
    //
    // B4 (2026-09-03): options-map signature per spec Â§Dir >
    // Mutation â€” supports `recursive: Bool` (default `false`).  Prior
    // shape took bare `@recursive` positional.
    method removeDir(@rel, @options) {
      match rel {
        r /\ String => {
          new recursiveCh in {
            // M-22 (2026-09-04, RH-A5-3): type-guard `recursive`
            // value.  A `{"recursive": Nil}` (or any non-Bool value
            // at the key) now returns the accurate "recursive must
            // be a Bool" error instead of collapsing through the
            // Nil sentinel and producing the misleading "options
            // must be a Map" reply.
            match options {
              {} => recursiveCh!(false)
              {"recursive": v /\ Bool ..._} => recursiveCh!(v)
              {"recursive": _ ..._} => recursiveCh!(
                (false, "FSERR_BAD_ARG", "recursive must be a Bool", 0))
              {_ : _ ..._} => recursiveCh!(false)
              _ => recursiveCh!(Nil)
            } |
            for (@recursive <- recursiveCh) {
              match recursive {
                Nil => return!([false, "FSERR_BAD_ARG", "options must be a Map", 0])
                (false, code, msg, count) => return!([false, code, msg, count])
                b /\ Bool => {
              // DD-RemoveDirReplyShape (2026-09-03): unified per-entry-
              // count reply.  Every removeDir code path (non-recursive,
              // recursive Oracular, recursive Consensus) returns
              // `[true, nDeleted]` on success and
              // `[false, code, msg, nDeletedBeforeError]` on failure
              // at the Rholang boundary.
              //
              // Consensus recursive additionally carries a per-entry
              // manifest at the native layer for follower re-execution
              // (R5(b) reply protocol): native returns
              //   `[true, nDeleted, [[path, kind], ...]]`
              //   `[false, code, msg, nDeleted, [[path, kind], ...]]`
              // This method truncates the reply to the first 2 (success)
              // or 4 (failure) elements before forwarding upward, so
              // callers see a uniform shape regardless of cmode +
              // recursive.
              //
              // Prior H-29-3-lift shape (surfaced the manifest at the
              // Rholang boundary) was superseded by the unified
              // `[true, nDeleted]` shape â€” see FIP Â§Dir.removeDir.
                  for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                    match params {
                      (canonRoot, subPath, dirMode, _fileCtor) => {
                        match dirMode {
                          "r+" => {
                            new joinedCh in {
                              joinRel!(subPath, r, *joinedCh) |
                              for (@joined <- joinedCh) {
                                new retCh in {
                                  fsRemoveDir!(canonRoot, joined, b, cmode, *retCh) |
                                  for (@reply <- retCh) {
                                    // Unwrap the 5-element Consensus recursive
                                    // replies to the 4-element uniform failure
                                    // shape (or 2-element uniform success).
                                    match reply {
                                      [true, n /\ Int, _manifest] => return!([true, n])
                                      [false, code, msg, n /\ Int, _manifest] =>
                                        return!([false, code, msg, n])
                                      _ => return!(reply)
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => return!([false, "FSERR_UNSUPPORTED",
                            "removeDir requires \"r+\" Dir mode", 0])
                        }
                      }
                      _ => return!([false, "FSERR_IO", "root params malformed", 0])
                    }
                  }
                }
                _ => return!([false, "FSERR_BAD_ARG", "recursive must be a Bool", 0])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String", 0])
      }
    } |

    // -- rename(from, to) -------------------------------------------
    method rename(@from, @to) {
      match from {
        f /\ String => {
          match to {
            t /\ String => {
              // H-29-3 lift (2026-08-26): Consensus caps now supported.
              for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                match params {
                  (canonRoot, subPath, dirMode, _fileCtor) => {
                    match dirMode {
                      "r+" => {
                        new jFromCh, jToCh in {
                          joinRel!(subPath, f, *jFromCh) |
                          joinRel!(subPath, t, *jToCh) |
                          for (@jFrom <- jFromCh; @jTo <- jToCh) {
                            new retCh in {
                              // Phase 1 fs_rename signature:
                              // (fromRootCanon, fromRel, toRootCanon, toRel, cmode, ack)
                              fsRename!(canonRoot, jFrom, canonRoot, jTo, cmode, *retCh) |
                              for (@reply <- retCh) { return!(reply) }
                            }
                          }
                        }
                      }
                      _ => return!([false, "FSERR_UNSUPPORTED",
                        "rename requires \"r+\" Dir mode"])
                    }
                  }
                  _ => return!([false, "FSERR_IO", "root params malformed"])
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "to must be a String"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "from must be a String"])
      }
    } |

    // -- copyFile(from, to) -----------------------------------------
    method copyFile(@from, @to) {
      match from {
        f /\ String => {
          match to {
            t /\ String => {
              // H-29-3 lift (2026-08-26): Consensus caps now supported.
              for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                match params {
                  (canonRoot, subPath, dirMode, _fileCtor) => {
                    match dirMode {
                      "r+" => {
                        new jFromCh, jToCh in {
                          joinRel!(subPath, f, *jFromCh) |
                          joinRel!(subPath, t, *jToCh) |
                          for (@jFrom <- jFromCh; @jTo <- jToCh) {
                            new retCh in {
                              fsCopyFile!(canonRoot, jFrom, canonRoot, jTo, cmode, *retCh) |
                              for (@reply <- retCh) { return!(reply) }
                            }
                          }
                        }
                      }
                      _ => return!([false, "FSERR_UNSUPPORTED",
                        "copyFile requires \"r+\" Dir mode"])
                    }
                  }
                  _ => return!([false, "FSERR_IO", "root params malformed"])
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "to must be a String"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "from must be a String"])
      }
    } |

    // -- chmod(rel, mode) -------------------------------------------
    // Mode-consistency fix (2026-09-04): input is Int mode bits (see
    // File.chmod for rationale); range [0, 0o7777].
    method chmod(@rel, @mode) {
      match rel {
        r /\ String => {
          match mode {
            m /\ Int => {
              match m < 0 or m > 4095 {
                true => return!([false, "FSERR_BAD_ARG",
                  "mode must be an Int in [0, 0o7777]"])
                false => {
                  // H-29-3 lift (2026-08-26): Consensus caps now supported.
                  for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                    match params {
                      (canonRoot, subPath, dirMode, _fileCtor) => {
                        match dirMode {
                          "r+" => {
                            new joinedCh in {
                              joinRel!(subPath, r, *joinedCh) |
                              for (@joined <- joinedCh) {
                                new retCh in {
                                  fsChmod!(canonRoot, joined, m, cmode, *retCh) |
                                  for (@reply <- retCh) { return!(reply) }
                                }
                              }
                            }
                          }
                          _ => return!([false, "FSERR_UNSUPPORTED",
                            "chmod requires \"r+\" Dir mode"])
                        }
                      }
                      _ => return!([false, "FSERR_IO", "root params malformed"])
                    }
                  }
                }
              }
            }
            _ => return!([false, "FSERR_BAD_ARG", "mode must be an Int"])
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- chown(rel, owner, group) -----------------------------------
    method chown(@rel, @owner, @group) {
      match rel {
        r /\ String => {
          new ownerOk, groupOk in {
                match owner {
                  s /\ String => {
                    match s {
                      "" => ownerOk!([false, "FSERR_BAD_ARG",
                        "owner must be non-empty or Nil"])
                      _  => ownerOk!([true, s])
                    }
                  }
                  Nil => ownerOk!([true, Nil])
                  _ => ownerOk!([false, "FSERR_BAD_ARG",
                    "owner must be String or Nil"])
                } |
                match group {
                  s /\ String => {
                    match s {
                      "" => groupOk!([false, "FSERR_BAD_ARG",
                        "group must be non-empty or Nil"])
                      _  => groupOk!([true, s])
                    }
                  }
                  Nil => groupOk!([true, Nil])
                  _ => groupOk!([false, "FSERR_BAD_ARG",
                    "group must be String or Nil"])
                } |
                for (@ov <- ownerOk; @gv <- groupOk) {
                  match [ov, gv] {
                    [[true, o], [true, g]] => {
                      for (@params <<- @[*private, *rootP]; @cmode <<- @[*private, *cmodeP]) {
                        match params {
                          (canonRoot, subPath, dirMode, _fileCtor) => {
                            match dirMode {
                              "r+" => {
                                new joinedCh in {
                                  joinRel!(subPath, r, *joinedCh) |
                                  for (@joined <- joinedCh) {
                                    new retCh in {
                                      fsChown!(canonRoot, joined, o, g, cmode, *retCh) |
                                      for (@reply <- retCh) { return!(reply) }
                                    }
                                  }
                                }
                              }
                              _ => return!([false, "FSERR_UNSUPPORTED",
                                "chown requires \"r+\" Dir mode"])
                            }
                          }
                          _ => return!([false, "FSERR_IO", "root params malformed"])
                        }
                      }
                    }
                    [[false, _, _], _]  => return!(ov)
                    [_, [false, _, _]]  => return!(gv)
                    _ => return!([false, "FSERR_IO", "chown validation malformed"])
                  }
                }
              }
        }
        _ => return!([false, "FSERR_BAD_ARG", "rel must be a String"])
      }
    } |

    // -- Default arm -----------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helpers.
  // ==================================================================

  // joinRel â€” compose two segments of a relative path.  Callers may
  // pass an empty subPath (for the root Dir), in which case the result
  // is just the second segment; safe_descend rejects an empty rel with
  // QuarantineError::Empty, so this pattern must not produce "" or a
  // leading "/".
  contract joinRel(@subPath, @rel, ret) = {
    match subPath {
      "" => ret!(rel)
      _  => match rel {
        // Clone-self case: `dirCap!("openDir", "")` mints a fresh
        // Dir agent at the same (canonRoot, subPath) pair.  Without
        // this arm, join would yield `subPath ++ "/"` with a
        // trailing slash; `Path::components` normalizes it for
        // syscalls, but subsequent `joinRel(subPath_with_slash,
        // child)` produces `"a/b//child"` with a double-slash.
        // Preserve the parent's subPath spelling verbatim.
        "" => ret!(subPath)
        _  => ret!(subPath ++ "/" ++ rel)
      }
    }
  } |

  contract openFileImpl(@canonRoot, @subPath, @rel, @mode, @cmode, @fileCtor, ret) = {
    // H-27-2 review fix: validate `cmode` BEFORE issuing `fsOpen` so a
    // bad cmode doesn't allocate a kernel fd that the REVOKED-state
    // File constructor would then leak (File.close short-circuits on
    // `state = "closed"` without dispatching fsClose).  Rejects
    // unknown/typo/non-String cmode with FSERR_BAD_ARG at the mint
    // boundary â€” matches the fail-closed posture of `resolve_cmode`
    // in the native handlers (C-26-F1 review fix).
    match cmode {
      "oracular" \/ "consensus" => openFileImplInner!(
        canonRoot, subPath, rel, mode, cmode, fileCtor, *ret)
      _ => ret!(
        [false, "FSERR_BAD_ARG",
         "cmode must be String \"oracular\" or \"consensus\""])
    }
  } |

  // Extracted body from openFileImpl so the cmode validation above
  // can guard the entire mint pipeline (stat + open + agent-mint).
  // Signature/behavior identical to the pre-slice-27-review `openFileImpl`.
  contract openFileImplInner(@canonRoot, @subPath, @rel, @mode, @cmode, @fileCtor, ret) = {
    new joinedCh in {
      joinRel!(subPath, rel, *joinedCh) |
      for (@joined <- joinedCh) {
        // Stat-verify before opening (plan Â§294): if the target exists
        // and is a directory, reject with FSERR_BAD_ARG rather than
        // trying to open it as a file.  fsOpen would fail with EISDIR
        // on a directory in most modes, but the error mapping is
        // inconsistent across create/exclusive modes and Phase 1 native
        // implementations differ; short-circuiting here yields a stable
        // spec-defined error.
        //
        // If stat fails for any reason (not-found, permission, etc.),
        // we pass through to fsOpen â€” for creation modes (w/w+/wx/w+x/
        // a/a+) the target may legitimately not exist yet, and fsOpen
        // handles the create/exclusive semantics.  For read / r+
        // modes fsOpen will re-surface the appropriate error
        // (FSERR_NOTFOUND, etc.).
        //
        // Racy against a directory being created between stat and open;
        // the alternative (bind fd first, fstat inode) requires a
        // native we don't have.  A future slice could add a
        // `fs_open_if_not_dir` primitive to close the race.
        //
        // Slice 26: the mint-time `fsStat` uses the CAP's `cmode` so
        // the record shape is consistent â€” a consensus cap's mint
        // never leaks host-transient fields through the mint-path
        // stat check.
        new statRetCh in {
          fsStat!(canonRoot, joined, cmode, *statRetCh) |
          for (@statReply <- statRetCh) {
            new statOk in {
              match statReply {
                [true, rec] => {
                  match rec.get("kind") {
                    "dir" => statOk!([false, "FSERR_BAD_ARG",
                      "target is a directory; use openDir"])
                    _     => statOk!([true, Nil])
                  }
                }
                _ => statOk!([true, Nil])   // stat failed; let fsOpen handle it
              } |
              for (@decision <- statOk) {
                match decision {
                  [false, code, msg] => ret!([false, code, msg])
                  [true, _] => {
                    new openRetCh in {
                      // Slice 29 (PB-M-14): fsOpen takes the cap's
                      // `cmode` so the native handler can stash it
                      // in the FileHandle for subsequent WAL
                      // journaling on mutating ops (fs_write,
                      // fs_write_at, fs_truncate).
                      fsOpen!(canonRoot, joined, mode, cmode, *openRetCh) |
                      for (@openReply <- openRetCh) {
                        match openReply {
                          [true, fd] => {
                            // File carries (fd, canonRoot, joined, mode,
                            // cmode) â€” its chmod/chown/... methods
                            // dispatch to fs_* with a real rel (B-3 fix)
                            // and forward `cmode` to `fsChown` (slice
                            // 26) so chown short-circuits on consensus
                            // caps.
                            new fileCh in {
                              @fileCtor!(*fileCh, fd, canonRoot, joined, mode, cmode) |
                              for (@fileHandle <- fileCh) {
                                ret!([true, fileHandle])
                              }
                            }
                          }
                          _ => ret!(openReply)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // openDirImpl â€” mints a nested Dir agent for openDir.
  //
  // Validates at mint time via fsStat (M-2): if the composed path is
  // absent, non-directory, or escapes the sandbox (safe_descend rejects
  // `..`), the caller receives the underlying error instead of a
  // handle that later fails on every method.
  contract openDirImpl(@canonRoot, @subPath, @rel, @mode, @cmode, @fileCtor, ret) = {
    // H-27-2 review fix mirror: cmode validation before we call
    // `fsStat`/mint.  Dir mint doesn't allocate a kernel fd so there
    // is no fd-leak vector here, but the fail-closed posture is
    // consistent with openFileImpl and prevents a bogus-cmode Dir
    // from being minted (which would then REVOKE its own state
    // per the M-26-2 Dir constructor validation).
    match cmode {
      "oracular" \/ "consensus" => openDirImplInner!(
        canonRoot, subPath, rel, mode, cmode, fileCtor, *ret)
      _ => ret!(
        [false, "FSERR_BAD_ARG",
         "cmode must be String \"oracular\" or \"consensus\""])
    }
  } |

  contract openDirImplInner(@canonRoot, @subPath, @rel, @mode, @cmode, @fileCtor, ret) = {
    new joinedCh in {
      joinRel!(subPath, rel, *joinedCh) |
      for (@joined <- joinedCh) {
        match joined {
          // CRIT-1 fix (2026-08-06): root-Dir mint via `Fs.openDir`
          // carries `subPath=""` and `rel=""` (post-H-P7-8 Dir bundle
          // emit shape at `fs_genesis.rs::format_bundle_for_rholang`
          // â€” Dir entries stay `(canon_path, "")` so the sandbox root
          // is the provisioned path itself, not its parent).  joinRel
          // of two empty strings yields `""`, and Phase 1's
          // `safe_descend(root, "")` short-circuits to
          // `QuarantineError::Empty` â†’ every populated Dir bundle
          // entry would cascade to
          // `[false, "FSERR_BAD_ARG", "empty relative path"]`
          // silently.  Skip the mint-time fsStat verify in this
          // specific case: boot validation (`node/src/rust/
          // configuration/boot_validation.rs::validate_provisioning_
          // boot`, slice 23) has already confirmed the root exists,
          // is a directory (KindMismatch check), is not a symlink
          // (IsSymlink check), and holds no hard-linked children
          // (HardLinked walker), so mint-time verification is
          // redundant for the root.  Nested `Dir.openDir("child")`
          // still runs the fsStat verify because joined is non-empty
          // (`"child"` or `"parent/child"`).
          "" => {
            // Slice 26: child (root) Dir inherits parent's `cmode`.
            // Even though this is the "root" mint, we still pass
            // `cmode` through the Dir constructor for consistency
            // with the nested-mint path â€” same shape either way.
            new dirCh in {
              Dir!(*dirCh, canonRoot, joined, mode, cmode, fileCtor) |
              for (@dirHandle <- dirCh) {
                ret!([true, dirHandle])
              }
            }
          }
          _ => {
            new statRetCh in {
              fsStat!(canonRoot, joined, cmode, *statRetCh) |
              for (@statReply <- statRetCh) {
                match statReply {
                  [true, rec] => {
                    // Verify the path is actually a directory.  Reading
                    // `rec.get("kind")` returns Nil on absent key rather
                    // than raising â€” a malformed stat record therefore
                    // routes through the non-"dir" arm as FSERR_BAD_ARG
                    // rather than escaping the mint.
                    match rec.get("kind") {
                      "dir" => {
                        // Slice 26: child Dir inherits parent's `cmode`.
                        new dirCh in {
                          Dir!(*dirCh, canonRoot, joined, mode, cmode, fileCtor) |
                          for (@dirHandle <- dirCh) {
                            ret!([true, dirHandle])
                          }
                        }
                      }
                      _ => ret!([false, "FSERR_BAD_ARG",
                        "path exists but is not a directory"])
                    }
                  }
                  _ => ret!(statReply)
                }
              }
            }
          }
        }
      }
    }
  }

  // parseRwxToBits + parseRwxLoop RETIRED 2026-09-04: the mode-
  // consistency migration switched File.chmod and Dir.chmod to take
  // Int mode-bits directly (matching stat.mode's Int emission).  No
  // in-tree callers of the rwx-string parser remain.  A shard that
  // needs human-friendly rwx-string authoring can define a caller-
  // side helper â€” the deliberate split between machine-parseable
  // wire (Int) and human-friendly authoring (String) lives at the
  // caller boundary, not inside the shipped Rholang libs.

  |
  
new foldConcurrentDispatch, foldConcurrentWorker, mapReduceDispatch, mapReduceWorker, collectDone, collectPartials, foldPartials in {

  agent Stream {
    constructor(@producer, @chunkBuilder) {
      @[*private, *paramsP]!((producer, chunkBuilder)) |
      @[*private, *stateP]!("open")
    } |

    // -- next() -----------------------------------------------------
    method next() {
      for (@state <- @[*private, *stateP]) {
        match state {
          "closed" => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stream is closed"])
          }
          ("eos", msg) => {
            @[*private, *stateP]!(state) |
            return!([false, "EOS", msg])
          }
          ("error", code, msg) => {
            @[*private, *stateP]!(state) |
            return!([false, code, msg])
          }
          "open" => {
            // Peek at producer without consuming paramsP (params are
            // immutable while open).
            for (@params <<- @[*private, *paramsP]) {
              match params {
                (producer, _builder) => {
                  new retCh in {
                    @producer!(*retCh) |
                    for (@reply <- retCh) {
                      match reply {
                        [true, val] => {
                          @[*private, *stateP]!("open") |
                          return!([true, val])
                        }
                        [false, "EOS", msg] => {
                          @[*private, *stateP]!(("eos", msg)) |
                          return!([false, "EOS", msg])
                        }
                        [false, code, msg] => {
                          @[*private, *stateP]!(("error", code, msg)) |
                          return!([false, code, msg])
                        }
                        _ => {
                          @[*private, *stateP]!(("error", "FSERR_IO", "producer malformed reply")) |
                          return!([false, "FSERR_IO", "producer malformed reply"])
                        }
                      }
                    }
                  }
                }
                _ => {
                  @[*private, *stateP]!(("error", "FSERR_IO", "params malformed")) |
                  return!([false, "FSERR_IO", "params malformed"])
                }
              }
            }
          }
          _ => {
            @[*private, *stateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stream state unrecognized"])
          }
        }
      }
    } |

    // -- chunk(n) ---------------------------------------------------
    //
    // Type-guarded on n before touching state, matching the Buffer.rho
    // pattern for uncatchable-arithmetic safety.  Gathers up to n
    // values via internal next() dispatches, then packs the collected
    // list via the chunk-builder.  Peek at builder via <<- (peek)
    // reads paramsP without consuming â€” safe because params are
    // immutable while the stream is not closed.
    //
    // Phase 9 slice 9c-i: reply-payload cap.  `n` is capped at
    // `MAX_CHUNK_ITEMS = 65536` (matches Rust's `MAX_CHUNK_ITEMS`
    // constant in `rholang::rust::interpreter::io`).  Above the cap
    // the method returns `FSERR_QUOTA_EXCEEDED` before any gathering
    // starts.  Defense-in-depth against a caller requesting a
    // billion-item chunk that would allocate an unbounded reply list
    // AND against the per-item runtime cost cascading through
    // `gatherN` past the caller's intended budget.  LineStream chunk
    // returns `FSERR_UNSUPPORTED` earlier via the chunk-builder
    // dispatch, so this cap only bites `EntryStream.chunk(n)` and
    // `ByteStream.chunk(n)` â€” matching the plan doc Â§Phase 9 line
    // 1225 slice 9c deliverable.
    //
    // M-36 fix (2026-09-08, A8-F3): the cap is bound via
    // `match 65536 { MAX_CHUNK_ITEMS => ... }` so the guard reads
    // `i > MAX_CHUNK_ITEMS` rather than a bare `65536` literal.
    // Rholang has no shared-constant mechanism cross-file so the
    // pair-alignment with Rust `MAX_CHUNK_ITEMS` is enforced by the
    // source-scan pin `stream_chunk_enforces_max_chunk_items_cap` in
    // `fileio_cost_spec.rs`; the semantic drift check runs through
    // the fingerprint fold slot 11 in
    // `consensus_runtime_fingerprint`, so a per-validator patch of
    // this literal without a coordinated Rust-side change would
    // surface as a network_id mismatch at peering.
    method chunk(@n) {
      match 65536 { MAX_CHUNK_ITEMS =>
      match n {
        i /\ Int => {
          match i <= 0 {
            true => return!([false, "FSERR_BAD_ARG", "n must be positive"])
            false => match i > MAX_CHUNK_ITEMS {
              true => return!(
                [false, "FSERR_QUOTA_EXCEEDED",
                 "chunk n exceeds MAX_CHUNK_ITEMS=65536"])
              false => {
              // Early exit if already terminal.
              for (@state <<- @[*private, *stateP]) {
                match state {
                  "closed" => return!([false, "FSERR_CLOSED", "stream is closed"])
                  ("eos", msg) => return!([false, "EOS", msg])
                  ("error", code, msg) => return!([false, code, msg])
                  "open" => {
                    // Gather up to i values.
                    new gCh in {
                      gatherN!(*this, i, [], *gCh) |
                      for (@[values, terminal] <- gCh) {
                        match values {
                          [] => {
                            // Nothing gathered â€” terminal is EOS or error.
                            return!(terminal)
                          }
                          _ => {
                            // Peek builder from paramsP.
                            for (@params <<- @[*private, *paramsP]) {
                              match params {
                                (_p, cb) => {
                                  new packCh in {
                                    @cb!(values, *packCh) |
                                    for (@packed <- packCh) {
                                      // Shape-validate the builder's reply
                                      // per Mi-1: even a trusted (mint-
                                      // supplied) builder can have a bug
                                      // and return malformed data.
                                      // Accept [true, container] or
                                      // [false, code, msg]; any other
                                      // shape is a builder bug rather
                                      // than a stream error, but we
                                      // surface it as FSERR_IO so the
                                      // caller sees a defined error
                                      // rather than a shape-mismatched
                                      // reply that breaks their own
                                      // pattern match.
                                      //
                                      // X-8 F-01 (2026-09-13): bind
                                      // element names and reconstruct
                                      // the reply rather than returning
                                      // `packed` verbatim.  Prevents a
                                      // hypothetical greedy-wildcard
                                      // regression in Rholang's list-
                                      // pattern matcher from letting a
                                      // 3-element `[true, container,
                                      // extra]` slip through unnoticed
                                      // â€” with named binds, extra
                                      // elements force arity failure
                                      // and fall through to FSERR_IO.
                                      match packed {
                                        [true, container]      => return!([true, container])
                                        [false, code, msg]     => return!([false, code, msg])
                                        _                      => {
                                          return!([false, "FSERR_IO",
                                            "chunk-builder returned malformed reply"])
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => return!([false, "FSERR_IO", "params malformed"])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!([false, "FSERR_CLOSED", "stream state unrecognized"])
                }
              }
            }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "n must be an integer"])
      }
      }
    } |

    // -- close() ----------------------------------------------------
    method close() {
      for (@_state <- @[*private, *stateP]) {
        @[*private, *stateP]!("closed") |
        return!([true])
      }
    } |

    // -- fold(init, combine) ----------------------------------------
    method fold(@init, @combine) {
      new loopCh in {
        foldLoop!(*this, combine, init, *loopCh) |
        for (@result <- loopCh) {
          // Auto-close on exit (success, EOS, or error).
          for (@_ <- @(*this)!?("close")) {
            return!(result)
          }
        }
      }
    } |

    // -- forEach(handler) -------------------------------------------
    method forEach(@handler) {
      new loopCh in {
        forEachLoop!(*this, handler, *loopCh) |
        for (@result <- loopCh) {
          for (@_ <- @(*this)!?("close")) {
            return!(result)
          }
        }
      }
    } |

    // -- foldChunks(init, chunkSize, combineChunk) -----------------
    //
    // Sequential chunk-oriented fold (spec Â§184, Â§204).  Calls
    // `chunk(chunkSize)` in a loop; each container (never empty per
    // Â§chunk method) is passed to `combineChunk(retCh, acc, container)`
    // which sends the next accumulator back on `retCh`.  On EOS from
    // chunk, returns `[true, finalAccumulator]` without invoking
    // `combineChunk` again.
    //
    // Type-guarded on chunkSize before touching state (Mi-3 pattern).
    // Same close-on-exit and error-propagation semantics as fold.
    //
    // Not supported on LineStream: chunk itself returns
    // FSERR_UNSUPPORTED there, so foldChunks surfaces that same
    // error unchanged.
    method foldChunks(@init, @chunkSize, @combineChunk) {
      match chunkSize {
        i /\ Int => {
          match i <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "chunkSize must be positive"])
            false => {
              new loopCh in {
                foldChunksLoop!(*this, chunkSize, combineChunk,
                  init, *loopCh) |
                for (@result <- loopCh) {
                  for (@_ <- @(*this)!?("close")) {
                    return!(result)
                  }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "chunkSize must be an integer"])
      }
    } |

    // -- foldConcurrent(init, combine, workers) --------------------
    //
    // Parallel variant of `fold` (spec Â§228).  Spawns `workers`
    // concurrent worker loops sharing a single mutex-protected
    // accumulator cell.  Each worker pulls a value from the source
    // via `next()` (source-side lock serializes pulls) and then
    // enters the accumulator critical section:
    //
    //   for (@acc <- accP) { combine(acc, val) â†’ newAcc; accP!(newAcc) }
    //
    // Combines therefore run one at a time â€” but next() pulls and
    // any pre-combine work by other workers overlap freely, and the
    // update sequence sees the current acc on every step so no lost-
    // update race can occur.  This makes `combine` work with the
    // asymmetric `(acc, val) â†’ acc` signature the sequential `fold`
    // accepts (init is the initial acc; val is the stream's value
    // type; combine's output is acc-typed).  For symmetric monoid
    // combines with expensive per-value work, prefer `mapReduce`
    // (whose parallel workers run mapFn concurrently by design).
    //
    // Combines are strictly sequential under the accP mutex, so
    // associativity holds vacuously.  Commutativity IS still required:
    // workers race for the accP mutex after successful pulls, so a
    // lead can combine `(initâŠ•v2)âŠ•v1` when values arrived v1 before
    // v2.  Under replay the lead's scheduling is captured and replayed
    // to followers, so consensus is deterministic even if the callback
    // isn't strictly commutative â€” but local dev runs may vary if the
    // user's combine isn't commutative.
    //
    // Not supported on `LineStream` (would require multiple
    // concurrently-active inner streams sharing the source cursor,
    // violating the single-active-inner rule at Â§Concurrency).
    // Detected via a chunk-builder probe with an empty list: the
    // LineStream chunk-builder unconditionally replies
    // `[false, "FSERR_UNSUPPORTED", ...]`; every other specialization
    // returns `[true, <empty container>]`.  The probe does NOT touch
    // the source producer (chunk-builder is called directly, bypassing
    // gatherN), so it is non-destructive.
    //
    // Argument validation: `workers` must be a positive integer, at
    // most 256 (the impl's chosen quota per spec Â§253 â€” bounds spawn
    // cost).  Zero or negative returns `FSERR_BAD_ARG`; non-Int
    // returns `FSERR_BAD_ARG`; > 256 returns `FSERR_QUOTA_EXCEEDED`.
    method foldConcurrent(@init, @combine, @workers) {
      match workers {
        w /\ Int => {
          match w <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "workers must be positive"])
            false => {
              match w > 256 {
                true => return!(
                  [false, "FSERR_QUOTA_EXCEEDED",
                   "workers exceeds cap (256)"])
                false => {
              // LineStream detection: probe chunk-builder with [].
              // Peek at paramsP (params are immutable while open).
              for (@params <<- @[*private, *paramsP]) {
                match params {
                  (_p, cb) => {
                    new probeCh in {
                      @cb!([], *probeCh) |
                      for (@probeReply <- probeCh) {
                        match probeReply {
                          [false, "FSERR_UNSUPPORTED", _] => {
                            return!([false, "FSERR_UNSUPPORTED",
                              "foldConcurrent not supported for this specialization"])
                          }
                          _ => {
                            new loopCh in {
                              foldConcurrentDispatch!(
                                *this, combine, init, w, *loopCh) |
                              for (@result <- loopCh) {
                                // Auto-close on exit.
                                for (@_ <- @(*this)!?("close")) {
                                  return!(result)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!(
                    [false, "FSERR_IO", "params malformed"])
                }
              }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "workers must be an integer"])
      }
    } |

    // -- mapReduce(mapFn, reduceFn, init, workers) -----------------
    //
    // Two-phase parallel combinator (spec Â§257).  Each element is
    // transformed by `mapFn`, and mapped results are combined by
    // `reduceFn`.  Both phases may run up to `workers` invocations
    // concurrently; the runtime allocates the budget dynamically by
    // interleaving mapFn+reduceFn within each worker.
    //
    // `mapFn` shape:    `(returnCh, @value) => returnCh!(mappedValue)`
    // `reduceFn` shape: `(returnCh, @acc, @mapped) => returnCh!(newAcc)`
    //
    // Requires `reduceFn` to be commutative AND associative (same
    // replay-determinism vs. dev-run-variability caveat as
    // `foldConcurrent`).  Not supported on `LineStream` â€” same
    // chunk-builder probe as `foldConcurrent`.
    //
    // If either `mapFn` or `reduceFn` errors (replies `[false, ...]`),
    // the error propagates; the worker publishes ("err", code, msg)
    // to the collector and other workers drain toward EOS or their
    // own errors.  Auto-close on exit.
    //
    // Argument validation: `workers` must be a positive integer, at
    // most 256 (same cap as `foldConcurrent`, per spec Â§288 +
    // implementation-chosen quota).  Zero or negative returns
    // `FSERR_BAD_ARG`; non-Int returns `FSERR_BAD_ARG`; > 256 returns
    // `FSERR_QUOTA_EXCEEDED`.
    method mapReduce(@mapFn, @reduceFn, @init, @workers) {
      match workers {
        w /\ Int => {
          match w <= 0 {
            true => return!(
              [false, "FSERR_BAD_ARG", "workers must be positive"])
            false => {
              match w > 256 {
                true => return!(
                  [false, "FSERR_QUOTA_EXCEEDED",
                   "workers exceeds cap (256)"])
                false => {
              for (@params <<- @[*private, *paramsP]) {
                match params {
                  (_p, cb) => {
                    new probeCh in {
                      @cb!([], *probeCh) |
                      for (@probeReply <- probeCh) {
                        match probeReply {
                          [false, "FSERR_UNSUPPORTED", _] => {
                            return!([false, "FSERR_UNSUPPORTED",
                              "mapReduce not supported for this specialization"])
                          }
                          _ => {
                            new loopCh in {
                              mapReduceDispatch!(
                                *this, mapFn, reduceFn, init, w, *loopCh) |
                              for (@result <- loopCh) {
                                for (@_ <- @(*this)!?("close")) {
                                  return!(result)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => return!(
                    [false, "FSERR_IO", "params malformed"])
                }
              }
                }
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "workers must be an integer"])
      }
    } |

    // -- Default arm -----------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helpers.
  // ==================================================================

  // gatherN(stream, n, acc, ret) â€” pull up to n values from `stream`
  // via successive `next()` calls, accumulating in `acc`.  Returns
  // ret!([values, terminalReply]) where terminalReply is the last
  // reply from next() â€” either the last [true, val] appended, or the
  // EOS / error that stopped the gather.  If the FIRST call returns
  // a terminal reply, `values` is [] and the caller propagates the
  // terminal directly.
  contract gatherN(@stream, @n, @acc, ret) = {
    match n <= 0 {
      // M-P5-7 hardening: the n <= 0 case is a defensive fallback
      // (chunk() shape-validates n > 0 up front, so this arm never
      // fires in practice).  If it EVER did, return an unambiguously
      // terminal reply â€” [true, Nil] could be confused with a real
      // producer value; [false, "EOS", ...] cannot.
      true => ret!([acc, [false, "EOS", "gather limit reached"]])
      false => {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => gatherN!(stream, n - 1, acc ++ [val], *ret)
            _           => ret!([acc, reply])
          }
        }
      }
    }
  } |

  // foldLoop(stream, combine, acc, ret) â€” sequentially fetch values
  // and pass each to `combine`, chaining the accumulator.  Reply
  // [true, acc] on EOS; [false, code, msg] on any other error or on
  // a combine error.
  contract foldLoop(@stream, @combine, @acc, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, val] => {
          new combCh in {
            @combine!(*combCh, acc, val) |
            for (@combResult <- combCh) {
              match combResult {
                [false, code, msg] => ret!([false, code, msg])
                newAcc             => foldLoop!(stream, combine, newAcc, *ret)
              }
            }
          }
        }
        [false, "EOS", _]  => ret!([true, acc])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!([false, "FSERR_IO", "unexpected reply shape"])
      }
    }
  } |

  // forEachLoop(stream, handler, ret) â€” no accumulator; handler is
  // (returnCh, @value) => (side effect); returnCh!().
  contract forEachLoop(@stream, @handler, ret) = {
    for (@reply <- @stream!?("next")) {
      match reply {
        [true, val] => {
          new doneCh in {
            @handler!(*doneCh, val) |
            for (@_ <- doneCh) {
              forEachLoop!(stream, handler, *ret)
            }
          }
        }
        [false, "EOS", _]  => ret!([true])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!([false, "FSERR_IO", "unexpected reply shape"])
      }
    }
  } |

  // foldChunksLoop(stream, chunkSize, combineChunk, acc, ret) â€”
  // per iteration: call chunk(chunkSize), then hand the container
  // to combineChunk(retCh, acc, container).  Same acc-shape convention
  // as fold: combineChunk returns the new accumulator as a bare Par
  // (or [false, code, msg] to abort).  Terminals:
  //   [false, "EOS", _]  â†’ [true, acc]
  //   [false, code, msg] â†’ [false, code, msg] (forwarded)
  //   malformed          â†’ [false, "FSERR_IO", ...]
  contract foldChunksLoop(@stream, @chunkSize, @combineChunk,
                          @acc, ret) = {
    for (@reply <- @stream!?("chunk", chunkSize)) {
      match reply {
        [true, container] => {
          new combCh in {
            @combineChunk!(*combCh, acc, container) |
            for (@combResult <- combCh) {
              match combResult {
                [false, code, msg] => ret!([false, code, msg])
                newAcc             => foldChunksLoop!(
                  stream, chunkSize, combineChunk, newAcc, *ret)
              }
            }
          }
        }
        [false, "EOS", _]  => ret!([true, acc])
        [false, code, msg] => ret!([false, code, msg])
        _                  => ret!(
          [false, "FSERR_IO", "chunk returned malformed reply"])
      }
    }
  } |

  // ==================================================================
  // foldConcurrent / mapReduce helpers.
  // ==================================================================
  //
  // Design: private-per-worker partial pattern.  Each worker holds a
  // local partial encoded as either `[]` (no values seen yet) or
  // `[v]` (current partial value).  Worker's next-loop combines
  // sequentially into its own partial; on source EOS it publishes
  // ("ok", partial) to doneCh; on any error publishes ("err", code, msg)
  // and exits.  A collector receives exactly N messages from doneCh
  // (one per worker) and then a foldPartials pass folds the non-empty
  // partials into `init` via `combine` (or reduceFn for mapReduce).
  //
  // This gives the spec's promised "up to `workers` combine invocations
  // concurrent": at any moment, up to N workers are each running
  // their own combine (on their private partial), plus a small final
  // sequential fold over N partials.  Commutative+associative combine
  // makes the interleave irrelevant; non-commutative combine yields
  // the lead's scheduling, which replay captures for follower
  // determinism.

  // foldConcurrentDispatch(stream, combine, init, n, ret) â€” spawn
  // n workers sharing a single accP cell (protected by linear-
  // receive as a mutex).  When all N workers signal done, peek accP
  // for the final acc and reply [true, acc].  On any worker error,
  // record the first error and continue draining N signals (so no
  // worker is stranded), then reply [false, code, msg].
  contract foldConcurrentDispatch(@stream, @combine, @init, @n, ret) = {
    new accP, doneCh, spawner in {
      accP!(init) |
      contract spawner(@k) = {
        match k <= 0 {
          true  => Nil
          false => {
            foldConcurrentWorker!(stream, combine, *accP, *doneCh) |
            spawner!(k - 1)
          }
        }
      } |
      spawner!(n) |
      collectDone!(n, Nil, Nil, *doneCh, *accP, *ret)
    }
  } |

  // foldConcurrentWorker(stream, combine, accP, doneCh) â€” pull
  // next() in a tail-recursive loop; for each value, enter the
  // accP critical section, invoke combine, write the new acc back.
  // On source EOS publish ("ok", Nil) to doneCh and exit.  On any
  // error publish ("err", code, msg) and exit â€” the current acc is
  // preserved on the cell so it can be observed by the collector's
  // recovery arm (though the caller sees a failure response).
  contract foldConcurrentWorker(@stream, @combine, accP, doneCh) = {
    new loop in {
      contract loop() = {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => {
              for (@acc <- accP) {
                new combCh in {
                  @combine!(*combCh, acc, val) |
                  for (@combResult <- combCh) {
                    match combResult {
                      [false, code, msg] => {
                        // Restore acc so subsequent workers can
                        // continue draining toward EOS without
                        // deadlocking on accP.
                        accP!(acc) |
                        doneCh!(("err", code, msg))
                      }
                      newAcc => {
                        accP!(newAcc) |
                        loop!()
                      }
                    }
                  }
                }
              }
            }
            [false, "EOS", _]  => doneCh!(("ok", Nil))
            [false, code, msg] => doneCh!(("err", code, msg))
            _                  => doneCh!(
              ("err", "FSERR_IO", "worker unexpected reply"))
          }
        }
      } |
      loop!()
    }
  } |

  // mapReduceDispatch(stream, mapFn, reduceFn, init, n, ret) â€”
  // symmetric to foldConcurrentDispatch but spawns mapReduceWorkers
  // and uses reduceFn as the final combine.
  contract mapReduceDispatch(@stream, @mapFn, @reduceFn, @init, @n, ret) = {
    new doneCh, spawner in {
      contract spawner(@k) = {
        match k <= 0 {
          true  => Nil
          false => {
            mapReduceWorker!(stream, mapFn, reduceFn, *doneCh) |
            spawner!(k - 1)
          }
        }
      } |
      spawner!(n) |
      collectPartials!(n, [], Nil, Nil, *doneCh, reduceFn, init, *ret)
    }
  } |

  // mapReduceWorker(stream, mapFn, reduceFn, doneCh) â€” variant of
  // foldConcurrentWorker that runs mapFn(val) â†’ mapped, then
  // reduceFn(partial, mapped) â†’ newPartial.  Both mapFn and reduceFn
  // errors propagate to doneCh as ("err", code, msg).
  contract mapReduceWorker(@stream, @mapFn, @reduceFn, doneCh) = {
    new loop in {
      contract loop(@partial) = {
        for (@reply <- @stream!?("next")) {
          match reply {
            [true, val] => {
              new mapCh in {
                @mapFn!(*mapCh, val) |
                for (@mapReply <- mapCh) {
                  match mapReply {
                    [false, code, msg] => doneCh!(("err", code, msg))
                    mapped => {
                      match partial {
                        []      => loop!([mapped])
                        [curr] => {
                          new redCh in {
                            @reduceFn!(*redCh, curr, mapped) |
                            for (@redReply <- redCh) {
                              match redReply {
                                [false, code, msg] => doneCh!(("err", code, msg))
                                newVal             => loop!([newVal])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            [false, "EOS", _]  => doneCh!(("ok", partial))
            [false, code, msg] => doneCh!(("err", code, msg))
            _                  => doneCh!(
              ("err", "FSERR_IO", "worker unexpected reply"))
          }
        }
      } |
      loop!([])
    }
  } |

  // collectDone(remaining, errCode, errMsg, doneCh, accP, ret) â€”
  // drain `remaining` ("ok" or "err") messages from doneCh; on
  // completion, peek the shared accP for the final acc and reply
  // [true, acc] if no error was seen, else [false, code, msg]
  // (first-error-wins).  Draining all N signals is required so no
  // worker is stranded blocked on doneCh.
  contract collectDone(@remaining, @errCode, @errMsg,
                       doneCh, accP, ret) = {
    match remaining <= 0 {
      true => {
        match errCode {
          Nil => {
            for (@acc <<- accP) {
              ret!([true, acc])
            }
          }
          _ => ret!([false, errCode, errMsg])
        }
      }
      false => {
        for (@msg <- doneCh) {
          match msg {
            ("ok", _) => {
              collectDone!(
                remaining - 1, errCode, errMsg,
                *doneCh, *accP, *ret)
            }
            ("err", code, m) => {
              match errCode {
                Nil => collectDone!(
                  remaining - 1, code, m,
                  *doneCh, *accP, *ret)
                _ => collectDone!(
                  remaining - 1, errCode, errMsg,
                  *doneCh, *accP, *ret)
              }
            }
          }
        }
      }
    }
  } |

  // collectPartials(remaining, partials, errCode, errMsg, doneCh,
  //                 combineFn, init, ret) â€” drain `remaining` messages
  // from doneCh accumulating either partials or the first error seen.
  // When drained: if no error, foldPartials into init; else return
  // the first error as [false, code, msg].  Draining all N is
  // required so no worker is stranded blocked on doneCh.
  contract collectPartials(
      @remaining, @partials, @errCode, @errMsg,
      doneCh, @combineFn, @init, ret) = {
    match remaining <= 0 {
      true => {
        match errCode {
          Nil => foldPartials!(partials, combineFn, init, *ret)
          _   => ret!([false, errCode, errMsg])
        }
      }
      false => {
        for (@msg <- doneCh) {
          match msg {
            ("ok", partial) => {
              collectPartials!(
                remaining - 1, partials ++ [partial],
                errCode, errMsg,
                *doneCh, combineFn, init, *ret)
            }
            ("err", code, m) => {
              // First error wins; subsequent errors are dropped so
              // the caller sees the first-observed failure.
              match errCode {
                Nil => collectPartials!(
                  remaining - 1, partials, code, m,
                  *doneCh, combineFn, init, *ret)
                _ => collectPartials!(
                  remaining - 1, partials, errCode, errMsg,
                  *doneCh, combineFn, init, *ret)
              }
            }
          }
        }
      }
    }
  } |

  // foldPartials(partials, combineFn, acc, ret) â€” sequential fold of
  // a list of `[]`-or-`[v]` partials into `acc` via `combineFn`.
  // Empty partials (workers that saw no values) are skipped.  Any
  // combineFn error aborts and returns [false, code, msg].
  contract foldPartials(@partials, @combineFn, @acc, ret) = {
    match partials {
      [] => ret!([true, acc])
      [head ...tail] => {
        match head {
          []      => foldPartials!(tail, combineFn, acc, *ret)
          [v]    => {
            new combCh in {
              @combineFn!(*combCh, acc, v) |
              for (@r <- combCh) {
                match r {
                  [false, code, msg] => ret!([false, code, msg])
                  newAcc             => foldPartials!(
                    tail, combineFn, newAcc, *ret)
                }
              }
            }
          }
          _ => ret!(
            [false, "FSERR_IO", "worker partial had unexpected shape"])
        }
      }
    }
  }
}

  |
  

  // Hex-digit lookup.  `n` is in [0, 15]; out-of-range returns Nil
  // via the fall-through â€” writeByte guards on [0, 255] before
  // invoking so unreachable in current code.
  contract hexDigit(@n, ret) = {
    match n {
       0 => ret!("0")
       1 => ret!("1")
       2 => ret!("2")
       3 => ret!("3")
       4 => ret!("4")
       5 => ret!("5")
       6 => ret!("6")
       7 => ret!("7")
       8 => ret!("8")
       9 => ret!("9")
      10 => ret!("A")
      11 => ret!("B")
      12 => ret!("C")
      13 => ret!("D")
      14 => ret!("E")
      15 => ret!("F")
       _ => ret!(Nil)
    }
  } |

  // Int â†’ 1-byte ByteArray via 2-digit uppercase hex.
  contract intToOneByte(@n, ret) = {
    new hCh, lCh in {
      hexDigit!(n / 16, *hCh) |
      hexDigit!(n % 16, *lCh) |
      for (@h <- hCh; @l <- lCh) {
        ret!((h ++ l).hexToBytes())
      }
    }
  } |

  // ==================================================================
  // Buffer agent
  // ==================================================================
  agent Buffer {
    constructor(@capBytes, @unit) {
      @[*private, *metaP]!((0, 0, capBytes, unit, "none", 0, 0))
    } |

    // -- Metadata queries (hold the token per spec Â§Metadata queries) --

    method capacity() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method length() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method remaining() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, cap - ell])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isEmpty() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == 0])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method isFull() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, cap, _u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, ell == cap])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    method unit() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, _cap, u, _l, _lo, _hi) => {
            @[*private, *metaP]!(meta) |
            return!([true, u])
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Writes ------------------------------------------------------

    // writeBytes(xs) â€” always a (possibly short) success (spec Â§Write).
    // Parks ONE chunk at index `hi` with the k accepted bytes; k = 0
    // parks nothing (a full buffer cannot accumulate empty chunks).
    //
    // Type-guarded per spec Â§Buffers ("Every method that takes a numeric
    // or ByteArray argument guards it with match ... before any
    // arithmetic").  Without this guard, `xs.length()` on a non-ByteArray
    // caller-supplied value would raise MethodNotDefined â€” an
    // uncatchable interpreter error â€” inside the metadata critical
    // section, orphaning the token and bricking the buffer permanently.
    // The guard is BEFORE the token consumption so a bad arg never
    // touches state.
    method writeBytes(@xs) {
      match xs {
        b /\ ByteArray => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                // b is proven a ByteArray by the outer guard; .length()
                // and .slice() are safe here.
                match b.length() {
                  xsLen => {
                    match cap - ell {
                      room => {
                        match (xsLen <= room) {
                          true => {
                            match xsLen == 0 {
                              true => {
                                // Zero-length: park nothing.
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b) |
                                @[*private, *metaP]!(
                                  (ell + xsLen, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, xsLen])
                              }
                            }
                          }
                          false => {
                            // Short write.
                            match room == 0 {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, 0])
                              }
                              false => {
                                @[*private, *chunkP, hi]!(b.slice(0, room)) |
                                @[*private, *metaP]!(
                                  (ell + room, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, room])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "xs must be a ByteArray"])
      }
    } |

    // writeByte(x) â€” append one byte if room; error when full (spec
    // Â§Buffer > Writes).  Type-guarded per spec Â§Buffers: `x` must
    // be an Int in [0, 255].  M-13 (2026-09-04) â€” implements the
    // previously-deferred method.
    method writeByte(@x) {
      match x {
        n /\ Int => {
          match n < 0 or n > 255 {
            true => return!(
              [false, "BUFERR_INVALID_ARGUMENT", "x must be a byte in [0, 255]"])
            false => {
              for (@meta <- @[*private, *metaP]) {
                match meta {
                  "REVOKED" => {
                    @[*private, *metaP]!("REVOKED") |
                    return!([false, "BUFERR_REVOKED", "buffer is closed"])
                  }
                  (ell, rho, cap, u, lease, lo, hi) => {
                    match cap - ell {
                      room => {
                        match room > 0 {
                          false => {
                            @[*private, *metaP]!(meta) |
                            return!([false, "BUFERR_CAPACITY_EXCEEDED", "buffer full"])
                          }
                          true => {
                            new byteCh in {
                              intToOneByte!(n, *byteCh) |
                              for (@bytes <- byteCh) {
                                @[*private, *chunkP, hi]!(bytes) |
                                @[*private, *metaP]!(
                                  (ell + 1, rho, cap, u, lease, lo, hi + 1)) |
                                return!([true, 1])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "x must be an integer"])
      }
    } |

    // -- Reads -------------------------------------------------------

    // read(n) â€” consume up to n bytes from position rho, advancing rho.
    // Refused with "BUFERR_FILLING" while a lease is held.
    //
    // Gathers chunks via a helper that reads each chunk's segment
    // linearly and re-sends it (storage-neutral).  Uses `gatherChunks`
    // module-level helper that takes the (privateName, chunkPName,
    // lo, hi) so it can descend into the instance's chunks.  Balanced
    // pairwise `mergePairs` landed 2026-09-02 (PB-B-5) â€” the cost
    // profile matches spec Â§Cost accounting > Buffers.
    // read(n) â€” type-guarded per spec Â§Buffers.  Without the guard,
    // `n <= 0` on a non-Int caller-supplied `n` raises MethodNotDefined
    // inside the critical section, orphaning the token.
    method read(@n) {
      match n {
        i /\ Int => {
          for (@meta <- @[*private, *metaP]) {
            match meta {
              "REVOKED" => {
                @[*private, *metaP]!("REVOKED") |
                return!([false, "BUFERR_REVOKED", "buffer is closed"])
              }
              (ell, rho, cap, u, lease, lo, hi) => {
                match lease {
                  "none" => {
                    // r = max(0, min(i, ell - rho))
                    match (i <= 0) {
                      true => {
                        @[*private, *metaP]!(meta) |
                        return!([true, "".hexToBytes()])
                      }
                      false => {
                        match (ell - rho) {
                          unread => {
                            match (unread <= 0) {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, "".hexToBytes()])
                              }
                              false => {
                                new gCh in {
                                  gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                  for (@allBytes <- gCh) {
                                    match (i <= unread) {
                                      true => {
                                        @[*private, *metaP]!(
                                          (ell, rho + i, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + i)])
                                      }
                                      false => {
                                        @[*private, *metaP]!(
                                          (ell, rho + unread, cap, u, lease, lo, hi)) |
                                        return!([true, allBytes.slice(rho, rho + unread)])
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "fill in progress"])
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
      }
    } |

    // toByteArray(@cap) â€” copy of [0, ell), no cursor move.  Refused
    // under held lease.
    //
    // ## Materialization cap (slice 9c-ii)
    //
    // `cap` is the caller's budget for materialized bytes.  Signature
    // added to close spec Â§446's `FSERR_QUOTA_EXCEEDED` gap: pre-slice-
    // 9c-ii `toByteArray()` was unbounded (limited only by Buffer's
    // 1 GiB platform allocation cap), so a caller with no other budget
    // knowledge could be forced into a 1 GiB copy by a bloated buffer.
    //
    // Semantics:
    //   * non-Int cap                  â†’ `[false, "BUFERR_INVALID_ARGUMENT", ...]`
    //   * cap < 0                      â†’ `[false, "BUFERR_INVALID_CAPACITY", ...]`
    //   * ell > cap                    â†’ `[false, "FSERR_QUOTA_EXCEEDED", ...]`
    //   * ell â‰¤ cap on non-lease meta  â†’ `[true, bytes]` (0 â‰¤ i < ell)
    //
    // Cap validation runs BEFORE the meta peek so a malformed cap
    // fails fast without disturbing the buffer state cell.
    //
    // Callers: `File.writeFrom` / `File.writeFromAt` (arity-1 and
    // arity-2 wait:true variants) pass `67108864` (MAX_WRITE_BYTES
    // = 64 MiB), matching the downstream `fs_write` cap so an
    // over-cap buffer fails at materialization rather than syscall
    // dispatch.
    method toByteArray(@cap) {
      match cap {
        c /\ Int => {
          match c < 0 {
            true => return!(
              [false, "BUFERR_INVALID_CAPACITY", "cap must be non-negative"])
            false => {
              for (@meta <- @[*private, *metaP]) {
                match meta {
                  "REVOKED" => {
                    @[*private, *metaP]!("REVOKED") |
                    return!([false, "BUFERR_REVOKED", "buffer is closed"])
                  }
                  (ell, _rho, _cap, _u, lease, lo, hi) => {
                    match lease {
                      "none" => {
                        match ell > c {
                          true => {
                            @[*private, *metaP]!(meta) |
                            return!([false, "FSERR_QUOTA_EXCEEDED",
                              "buffer content size exceeds cap"])
                          }
                          false => {
                            match ell == 0 {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, "".hexToBytes()])
                              }
                              false => {
                                new gCh in {
                                  gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                  for (@allBytes <- gCh) {
                                    @[*private, *metaP]!(meta) |
                                    return!([true, allBytes.slice(0, ell)])
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      _ => {
                        @[*private, *metaP]!(meta) |
                        return!([false, "BUFERR_FILLING", "fill in progress"])
                      }
                    }
                  }
                  _ => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "cap must be an integer"])
      }
    } |

    // slice(offset, n) â€” positional copy of [offset, offset+n); no
    // cursor move.  Refused under lease.  M-13 (2026-09-04) â€”
    // implements the previously-deferred method.
    //
    // Guards (spec Â§Buffer > Reads):
    //   - non-Int offset or n â†’ BUFERR_INVALID_ARGUMENT
    //   - offset < 0 or n < 0 â†’ BUFERR_OUT_OF_RANGE
    //   - offset + n > ell    â†’ BUFERR_OUT_OF_RANGE
    method slice(@offset, @n) {
      match offset {
        o /\ Int => {
          match n {
            i /\ Int => {
              match o < 0 or i < 0 {
                true => return!(
                  [false, "BUFERR_OUT_OF_RANGE", "offset and n must be non-negative"])
                false => {
                  for (@meta <- @[*private, *metaP]) {
                    match meta {
                      "REVOKED" => {
                        @[*private, *metaP]!("REVOKED") |
                        return!([false, "BUFERR_REVOKED", "buffer is closed"])
                      }
                      (ell, rho, cap, u, lease, lo, hi) => {
                        match lease {
                          "none" => {
                            match o + i > ell {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([false, "BUFERR_OUT_OF_RANGE",
                                  "offset + n exceeds buffer length"])
                              }
                              false => {
                                match i == 0 {
                                  true => {
                                    // Empty slice: no gather needed.
                                    @[*private, *metaP]!(meta) |
                                    return!([true, "".hexToBytes()])
                                  }
                                  false => {
                                    new gCh in {
                                      gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                                      for (@allBytes <- gCh) {
                                        @[*private, *metaP]!(meta) |
                                        return!([true, allBytes.slice(o, o + i)])
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => {
                            @[*private, *metaP]!(meta) |
                            return!([false, "BUFERR_FILLING", "fill in progress"])
                          }
                        }
                      }
                      _ => {
                        @[*private, *metaP]!(meta) |
                        return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
                      }
                    }
                  }
                }
              }
            }
            _ => return!([false, "BUFERR_INVALID_ARGUMENT", "n must be an integer"])
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "offset must be an integer"])
      }
    } |

    // validUtf8PrefixLen() â€” largest j â‰¤ â„“ with bytes [0, j) valid
    // UTF-8 (spec Â§Buffer > Reads > validUtf8PrefixLen).  Refused
    // under lease.  M-13 (2026-09-04) â€” implements the previously-
    // deferred method.
    //
    // Uses the native `.validUtf8PrefixLen()` ByteArray method (spec
    // Â§Three stateless native helpers) after materializing the live
    // portion [0, ell).  Total on ByteArray; ill-formed sequences
    // don't error but simply reduce `j`.
    method validUtf8PrefixLen() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, lease, lo, hi) => {
            match lease {
              "none" => {
                match ell == 0 {
                  true => {
                    // Empty buffer: prefix length is 0.
                    @[*private, *metaP]!(meta) |
                    return!([true, 0])
                  }
                  false => {
                    new gCh in {
                      gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                      for (@allBytes <- gCh) {
                        @[*private, *metaP]!(meta) |
                        return!([true, allBytes.slice(0, ell).validUtf8PrefixLen()])
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "fill in progress"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // view() â€” decode [0, ell) as UTF-8; strict.  Refused under
    // lease.  M-13 (2026-09-04) â€” implements the previously-deferred
    // method.
    //
    // Composes `.validUtf8PrefixLen()` with `.decodeUtf8()`: if the
    // valid prefix length equals ell, the whole live region is
    // well-formed and `.decodeUtf8()`'s U+FFFD-substitution is a
    // no-op.  If the prefix is shorter, the region is ill-formed and
    // we return BUFERR_BAD_ENCODING (spec Â§Buffer > Reads > view).
    //
    // A dedicated `decodeUtf8Strict` primitive would collapse the
    // two-scan composition to a single scan; deferred pending a
    // caller with a bottleneck at view().
    method view() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, _rho, _cap, _u, lease, lo, hi) => {
            match lease {
              "none" => {
                match ell == 0 {
                  true => {
                    @[*private, *metaP]!(meta) |
                    return!([true, ""])
                  }
                  false => {
                    new gCh in {
                      gatherChunks!(*private, *chunkP, lo, hi, *gCh) |
                      for (@allBytes <- gCh) {
                        match allBytes.slice(0, ell) {
                          prefix => {
                            match prefix.validUtf8PrefixLen() == ell {
                              true => {
                                @[*private, *metaP]!(meta) |
                                return!([true, prefix.decodeUtf8()])
                              }
                              false => {
                                @[*private, *metaP]!(meta) |
                                return!([false, "BUFERR_BAD_ENCODING",
                                  "buffer contains ill-formed UTF-8"])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "fill in progress"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Fill lease --------------------------------------------------

    method beginFill() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // Mint a fresh unforgeable name.  We return `*fillToken`
                // (the dereferenced name) rather than a bundle+ so that
                // endFill's equality check `lease == presented` sees the
                // same Par shape on both sides.  The name is still
                // unforgeable â€” a caller cannot construct it â€” and can
                // only be used by presenting it back to endFill.
                new fillToken in {
                  @[*private, *metaP]!((ell, rho, cap, u, *fillToken, lo, hi)) |
                  return!([true, *fillToken])
                }
              }
              _ => {
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "lease already held"])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // endFill(presented) â€” release the lease iff `presented` matches
    // the active fillToken.
    //
    // Two-stage check fixes M-1: reject "no lease held" explicitly
    // BEFORE the equality comparison.  Without this, a caller passing
    // presented = "none" against lease "none" would get an
    // indistinguishable "success" reply even though no lease was ever
    // held â€” breaking ownership audits.
    method endFill(@presented) {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (ell, rho, cap, u, lease, lo, hi) => {
            match lease {
              "none" => {
                // No lease held; reject any presented token â€” including
                // presented == "none", which would otherwise falsely
                // report success (M-1 fix).
                @[*private, *metaP]!(meta) |
                return!([false, "BUFERR_FILLING", "no lease held"])
              }
              _ => {
                // Lease is a Name.  `==` between Pars is total (structural
                // equality: identical Names â†’ true, all other pairs â†’
                // false), so it never raises regardless of `presented`'s
                // type.
                match lease == presented {
                  true => {
                    @[*private, *metaP]!((ell, rho, cap, u, "none", lo, hi)) |
                    return!([true])
                  }
                  false => {
                    @[*private, *metaP]!(meta) |
                    return!([false, "BUFERR_FILLING", "lease token mismatch"])
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // -- Lifecycle ---------------------------------------------------

    // clear() â€” reset the buffer for reuse WITHOUT closing it.
    // Advances lo to hi (NEVER REWIND â€” consensus-safety invariant),
    // sets ell = rho = 0, releases any held lease.  Consumes stored
    // chunks so their storage is refunded within the deploy.
    //
    // Deliberately NOT lease-gated: this is the non-destructive
    // recovery path for a lease whose holder died or lost its token
    // (spec Â§Buffers > Fill lease > Abandonment).  Shipping clear() in
    // this phase (rather than deferring) gives the lease a
    // non-destructive escape hatch â€” otherwise the only recovery from
    // a stuck lease is close(), which revokes the buffer entirely.
    method clear() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([false, "BUFERR_REVOKED", "buffer is closed"])
          }
          (_ell, _rho, cap, u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                // NEVER REWIND lo â€” advance to hi.  This invariant is
                // load-bearing for consensus safety (spec Â§Buffers >
                // Implementation notes): a stale chunk-index observation
                // from a prior epoch must never collide with a
                // freshly-written chunk at the same index.
                @[*private, *metaP]!((0, 0, cap, u, "none", hi, hi)) |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "buffer state unrecognized"])
          }
        }
      }
    } |

    // close() â€” replace metadata with "REVOKED" tombstone and drain
    // chunks (refunding storage within the deploy).  Deliberately not
    // lease-gated: it is a recovery path for a stuck lease.  Does not
    // remove the persistent dispatcher â€” the GC FIP reclaims that at
    // deploy end.
    method close() {
      for (@meta <- @[*private, *metaP]) {
        match meta {
          "REVOKED" => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
          (_ell, _rho, _cap, _u, _lease, lo, hi) => {
            new doneCh in {
              drainChunks!(*private, *chunkP, lo, hi, *doneCh) |
              for (_ <- doneCh) {
                @[*private, *metaP]!("REVOKED") |
                return!([true])
              }
            }
          }
          _ => {
            @[*private, *metaP]!("REVOKED") |
            return!([true])
          }
        }
      }
    } |

    // -- Default arm -------------------------------------------------

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Allocator agent â€” the buffer factory.
  // ==================================================================
  //
  // Capacity guards ordered `n <= n_max(unit)` BEFORE `n * 4` (avoid
  // Rholang's checked-Int multiplication overflow â€” spec Â§Formal
  // semantics > Allocation).
  //
  // L (platform capacity limit) = 1 GiB.  A quota-agent hook will
  // override this once Â§FSERR_QUOTA_EXCEEDED lands.
  agent Allocator {
    constructor() { Nil } |

    // alloc(nUnits, unit) â€” type-guarded per spec Â§Buffers.  Without
    // the Int guard, `nUnits <= 0` on a non-Int caller-supplied value
    // would raise MethodNotDefined, aborting the reduction and leaving
    // the caller's `!?` blocked forever (Mi-3 fix).
    method alloc(@nUnits, @unit) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match unit {
                "bytes" => {
                  match i > 1073741824 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i, "bytes")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                "utf8" => {
                  match i > 268435456 {
                    true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                    false => {
                      for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                        return!([true, bufHandle])
                      }
                    }
                  }
                }
                _ => return!([false, "BUFERR_INVALID_UNIT", "unit must be bytes or utf8"])
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    // Parameter name matches spec Â§430 (`nUnits`, not `n`).
    method allocBytes(@nUnits) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match i > 1073741824 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i, "bytes")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    method allocUtf8(@nUnits) {
      match nUnits {
        i /\ Int => {
          match i <= 0 {
            true  => return!([false, "BUFERR_INVALID_CAPACITY", "nUnits must be positive"])
            false => {
              match i > 268435456 {
                true  => return!([false, "BUFERR_INVALID_CAPACITY", "exceeds platform cap"])
                false => {
                  for (@bufHandle <- Buffer!?(i * 4, "utf8")) {
                    return!([true, bufHandle])
                  }
                }
              }
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "nUnits must be an integer"])
      }
    } |

    // allocRows(m, innerN, innerUnit) â€” spec Â§443:
    //   "a buffer of buffers: m inner byte buffers, each allocated
    //    by alloc(innerN, innerUnit)".
    //
    // Type-guards each arg per spec Â§Buffers.  Fails atomically: if
    // any inner buffer allocation would exceed the aggregate platform
    // cap, no inner is allocated.  Failure taxonomy: same as `alloc`
    // (BUFERR_INVALID_ARGUMENT / BUFERR_INVALID_CAPACITY /
    // BUFERR_INVALID_UNIT).
    //
    // The utf8 cap is 256 MB (m * innerN â‰¤ 2^28 units, each unit â‰¤ 4
    // bytes â†’ aggregate â‰¤ 2^30 bytes).  Bytes cap is 1 GB aggregate.
    //
    // ## Known deferral â€” FSERR_QUOTA_EXCEEDED (spec Â§446)
    //
    // Spec Â§446 lists a fourth failure code, `FSERR_QUOTA_EXCEEDED`,
    // returned when a quota agent declines the reservation.  The
    // quota-agent hook is scheduled for a separate quota-infrastructure
    // slice; until then, only the three platform-cap failures above
    // are surfaced.  The M-13-2 atomicity fix in `allocInnersLoop`
    // makes the eventual quota wire-in a one-line change (forward the
    // quota agent's decline reply through the same first-failure
    // path).
    method allocRows(@m, @innerN, @innerUnit) {
      match m {
        mi /\ Int => {
          match innerN {
            ni /\ Int => {
              match mi <= 0 {
                true => return!(
                  [false, "BUFERR_INVALID_CAPACITY", "m must be positive"])
                false => {
                  match ni <= 0 {
                    true => return!(
                      [false, "BUFERR_INVALID_CAPACITY", "innerN must be positive"])
                    false => {
                      match innerUnit {
                        "bytes" => {
                          match mi > 1073741824 / ni {
                            true => return!(
                              [false, "BUFERR_INVALID_CAPACITY",
                               "aggregate m*innerN exceeds platform cap"])
                            false => {
                              new innersRet in {
                                allocInnersLoop!(mi, ni, "bytes", [], *innersRet) |
                                for (@innersReply <- innersRet) {
                                  match innersReply {
                                    [true, inners] => {
                                      for (@rowsHandle <- Rows!?(mi, "bytes", inners)) {
                                        return!([true, rowsHandle])
                                      }
                                    }
                                    _ => return!(innersReply)
                                  }
                                }
                              }
                            }
                          }
                        }
                        "utf8" => {
                          match mi > 268435456 / ni {
                            true => return!(
                              [false, "BUFERR_INVALID_CAPACITY",
                               "aggregate m*innerN exceeds platform cap"])
                            false => {
                              new innersRet in {
                                allocInnersLoop!(mi, ni * 4, "utf8", [], *innersRet) |
                                for (@innersReply <- innersRet) {
                                  match innersReply {
                                    [true, inners] => {
                                      for (@rowsHandle <- Rows!?(mi, "utf8", inners)) {
                                        return!([true, rowsHandle])
                                      }
                                    }
                                    _ => return!(innersReply)
                                  }
                                }
                              }
                            }
                          }
                        }
                        _ => return!(
                          [false, "BUFERR_INVALID_UNIT",
                           "innerUnit must be bytes or utf8"])
                      }
                    }
                  }
                }
              }
            }
            _ => return!(
              [false, "BUFERR_INVALID_ARGUMENT", "innerN must be an integer"])
          }
        }
        _ => return!(
          [false, "BUFERR_INVALID_ARGUMENT", "m must be an integer"])
      }
    } |

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Rows agent â€” the buffer-of-buffers (Â§Fixed-size line reading).
  //
  // A distinct type from Buffer: its "elements" are inner buffer
  // handles, not bytes.  The outer holds `m` inner buffers, all with
  // the same unit.  Callers reach an inner via `getAt(i)` and use it
  // as a normal Buffer (writeBytes, remaining, beginFill, etc.).
  //
  // ## Delivered methods (spec Â§578-583)
  //
  //   capacityRows, innerUnit, getAt, clear, close, default.
  //
  // ## State layout
  //
  //   rowsMetaP  â†’ (m, unit, "live" | "revoked")
  //   innerP[i]  â†’ inner buffer handle for i âˆˆ [0, m).  Parked once
  //                at construction (peek-only from getAt).
  //
  // Every method acquires the metadata token via linear-recv, checks
  // for the revoked tombstone, then does its work.  Methods that
  // touch every inner (clear, close) iterate via a module-level
  // helper contract to keep the metadata critical section bounded.
  // ==================================================================
  agent Rows {
    // Constructor is called by allocRows with an already-allocated
    // list of inner handles.  It parks each inner at its index
    // (via parkInnersLoop) and installs the "live" metadata token.
    constructor(@m, @unit, @inners) {
      @[*private, *rowsMetaP]!((m, unit, "live")) |
      parkInnersLoop!(*private, *innerP, 0, m, inners)
    } |

    method capacityRows() {
      for (@meta <<- @[*private, *rowsMetaP]) {
        match meta {
          (m, _unit, "live") => return!([true, m])
          (_m, _unit, "revoked") => return!(
            [false, "BUFERR_REVOKED", "rows is closed"])
          _ => return!(
            [false, "BUFERR_REVOKED", "rows state unrecognized"])
        }
      }
    } |

    method innerUnit() {
      for (@meta <<- @[*private, *rowsMetaP]) {
        match meta {
          (_m, unit, "live") => return!([true, unit])
          (_m, _unit, "revoked") => return!(
            [false, "BUFERR_REVOKED", "rows is closed"])
          _ => return!(
            [false, "BUFERR_REVOKED", "rows state unrecognized"])
        }
      }
    } |

    // getAt(i) â€” peek the inner handle at index i (no consumption).
    // Type-guarded on i; range-checked before touching innerP.
    method getAt(@i) {
      match i {
        idx /\ Int => {
          for (@meta <<- @[*private, *rowsMetaP]) {
            match meta {
              (m, _unit, "live") => {
                match idx < 0 {
                  true => return!(
                    [false, "BUFERR_OUT_OF_RANGE", "index must be non-negative"])
                  false => {
                    match idx >= m {
                      true => return!(
                        [false, "BUFERR_OUT_OF_RANGE",
                         "index out of range"])
                      false => {
                        for (@inner <<- @[*private, *innerP, idx]) {
                          return!([true, inner])
                        }
                      }
                    }
                  }
                }
              }
              (_m, _unit, "revoked") => return!(
                [false, "BUFERR_REVOKED", "rows is closed"])
              _ => return!(
                [false, "BUFERR_REVOKED", "rows state unrecognized"])
            }
          }
        }
        _ => return!([false, "BUFERR_INVALID_ARGUMENT", "i must be an integer"])
      }
    } |

    // clear() â€” clears every inner buffer.  Fails if outer revoked.
    //
    // Best-effort on individual inners: `clearInnersLoop` consumes
    // each inner's `clear()` reply and continues regardless of
    // success or failure of that individual call.  Rationale: an
    // outer clear() is a bulk recovery operation; failing the whole
    // call because ONE inner was independently closed by another
    // party would leave callers unable to recover.  (m-13-1 docstring
    // fix: earlier text said replies were "propagated"; the code has
    // always been best-effort.)
    method clear() {
      for (@meta <- @[*private, *rowsMetaP]) {
        match meta {
          (m, unit, "live") => {
            new doneCh in {
              clearInnersLoop!(*private, *innerP, 0, m, *doneCh) |
              for (@_ <- doneCh) {
                @[*private, *rowsMetaP]!((m, unit, "live")) |
                return!([true])
              }
            }
          }
          (m, unit, "revoked") => {
            @[*private, *rowsMetaP]!((m, unit, "revoked")) |
            return!([false, "BUFERR_REVOKED", "rows is closed"])
          }
          _ => {
            @[*private, *rowsMetaP]!(meta) |
            return!([false, "BUFERR_REVOKED", "rows state unrecognized"])
          }
        }
      }
    } |

    // close() â€” closes every inner buffer AND marks the outer
    // "revoked".  Idempotent on already-closed outer.
    method close() {
      for (@meta <- @[*private, *rowsMetaP]) {
        match meta {
          (m, unit, "live") => {
            new doneCh in {
              closeInnersLoop!(*private, *innerP, 0, m, *doneCh) |
              for (@_ <- doneCh) {
                @[*private, *rowsMetaP]!((m, unit, "revoked")) |
                return!([true])
              }
            }
          }
          (m, unit, "revoked") => {
            @[*private, *rowsMetaP]!((m, unit, "revoked")) |
            return!([true])
          }
          _ => {
            @[*private, *rowsMetaP]!(meta) |
            return!([true])
          }
        }
      }
    } |

    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "BUFERR_UNSUPPORTED", "unknown method"])
      }
    }
  } |

  // ==================================================================
  // Module-level helper: gather chunks [lo, hi) into a single ByteArray.
  //
  // Takes `privateName` and `chunkPName` as parameters so it can
  // access an instance's chunks (the caller passes `*private, *chunkP`).
  //
  // Cost shape (slice 9c-iii, 2026-09-02): balanced divide-and-
  // conquer pairwise merge â€” Î˜(â„“ log Î½) for Î½ chunks summing to â„“
  // bytes, matching Â§Cost accounting > Buffers.  Recursion splits
  // `[lo, hi)` at the midpoint, dispatches both halves in parallel,
  // and concats the two returned ByteArrays at each internal node.
  // log Î½ levels; each level's concatBytes calls together copy
  // exactly â„“ bytes; total O(â„“ log Î½) copies.  Pre-9c-iii the impl
  // was a right-fold with the same operation count but Î˜(â„“Î½) total
  // copies (each earlier chunk got copied on every subsequent
  // concat).
  //
  // Storage-neutral: reads each chunk with a linear receive and
  // immediately re-parks it, so `hi - lo` chunks remain on the
  // tuplespace after this returns.  Each chunk is touched exactly
  // once regardless of the merge strategy â€” only the Î½=1 base case
  // does a receive, and every chunk is at exactly one such leaf.
  // ==================================================================
  contract gatherChunks(@privateName, @chunkPName, @lo, @hi, ret) = {
    match hi - lo {
      0 => ret!("".hexToBytes())
      _ => {
        match hi - lo == 1 {
          true => {
            // Î½=1 leaf: read chunk `lo`, re-park, reply.
            for (@seg <- @[privateName, chunkPName, lo]) {
              @[privateName, chunkPName, lo]!(seg) |
              ret!(seg)
            }
          }
          false => {
            // Î½>1: split at midpoint, recurse on both halves in
            // parallel, concat results.  Integer division rounds
            // toward zero â€” for hi-lo odd, the left half gets the
            // floor half and the right half gets the ceiling half.
            // Balance is asymptotically fine either way.
            new leftCh, rightCh in {
              gatherChunks!(privateName, chunkPName, lo, (lo + hi) / 2, *leftCh) |
              gatherChunks!(privateName, chunkPName, (lo + hi) / 2, hi, *rightCh) |
              for (@leftBytes <- leftCh; @rightBytes <- rightCh) {
                ret!([leftBytes, rightBytes].concatBytes())
              }
            }
          }
        }
      }
    }
  } |

  // ==================================================================
  // Module-level helper: drain chunks [lo, hi) â€” consume each chunk
  // WITHOUT re-parking, refunding its tuplespace storage.  Used by
  // clear() and close().
  //
  // Awaits each removal before signalling completion (spec Â§Concurrency
  // > Metadata-token mutex: "clear/close must await every chunk removal
  // before re-parking the metadata token, on every exit path" â€”
  // otherwise a concurrent read could observe a half-removed range).
  //
  // Signals completion by sending Nil on `done`.  The caller re-parks
  // the metadata token only after receiving on `done`.
  // ==================================================================
  contract drainChunks(@privateName, @chunkPName, @lo, @hi, done) = {
    match hi - lo {
      0 => done!(Nil)
      _ => {
        // Consume chunk `lo` (no re-park).
        for (@_seg <- @[privateName, chunkPName, lo]) {
          match hi - lo == 1 {
            true  => done!(Nil)
            false => drainChunks!(privateName, chunkPName, lo + 1, hi, *done)
          }
        }
      }
    }
  } |

  // ==================================================================
  // allocInnersLoop â€” recursively allocate `remaining` fresh inner
  // Buffers, each of capacity `capBytes` bytes and unit `unit`, and
  // accumulate them into a List via `acc`.  Returns `[true, inners]`
  // via `ret` on success, or `[false, code, msg]` on the first
  // Buffer-mint failure (spec Â§446: "on any failure it allocates no
  // inner buffers").  The accumulator is discarded on error, so
  // partially-allocated inner Buffers become unreachable and get
  // reclaimed by the deploy-end GC â€” no leak (M-13-2 fix).
  //
  // Note: Buffer's current implementation replies with a bare handle
  // rather than `[true, handle]`.  We shape-match both shapes so the
  // atomicity guarantee holds even if Buffer's reply format later
  // gains an ok-flag (matching Buffer!?'s !? sugar convention).
  //
  // Precondition: `remaining >= 0`, `capBytes > 0`.
  // ==================================================================
  contract allocInnersLoop(@remaining, @capBytes, @unit, @acc, ret) = {
    match remaining <= 0 {
      true  => ret!([true, acc])
      false => {
        // TODO(quota): when the FSERR_QUOTA_EXCEEDED quota-agent hook
        // lands (spec Â§446), invoke it here BEFORE Buffer!? and
        // forward its decline via the [false, _code, _msg] arm below.
        // The M-13-2 atomicity guarantee (discard the accumulator on
        // first failure) already handles the propagation shape.
        for (@bufReply <- Buffer!?(capBytes, unit)) {
          match bufReply {
            [true, bufHandle] => {
              allocInnersLoop!(remaining - 1, capBytes, unit,
                acc ++ [bufHandle], *ret)
            }
            [false, _code, _msg] => {
              // First-failure atomicity: discard the accumulator,
              // forward the error unchanged.  The already-allocated
              // buffers have no other holders and become unreachable.
              ret!(bufReply)
            }
            _ => {
              // Malformed reply â€” treat as a bare handle for
              // backward compat with Buffer's current constructor
              // shape (which returns just the handle).
              allocInnersLoop!(remaining - 1, capBytes, unit,
                acc ++ [bufReply], *ret)
            }
          }
        }
      }
    }
  } |

  // ==================================================================
  // parkInnersLoop â€” park each element of `inners` at
  // @[privateName, innerPName, i] for i in [0, m).  Used ONCE at
  // Rows construction; the parked handles are peeked (via <<-) by
  // getAt, so they stay in the tuplespace for the Rows instance's
  // lifetime.
  //
  // Precondition: inners.length() == m.
  // ==================================================================
  contract parkInnersLoop(@privateName, @innerPName, @i, @m, @inners) = {
    match i >= m {
      true  => Nil
      false => {
        @[privateName, innerPName, i]!(inners.nth(i)) |
        parkInnersLoop!(privateName, innerPName, i + 1, m, inners)
      }
    }
  } |

  // ==================================================================
  // clearInnersLoop â€” invoke `clear()` on each inner buffer parked at
  // @[privateName, innerPName, i] for i in [lo, hi).  Awaits each
  // reply sequentially before signalling `done`.  Ignores individual
  // clear failures; the outer Rows.clear reports [true] as long as
  // the loop completes.
  // ==================================================================
  contract clearInnersLoop(@privateName, @innerPName, @lo, @hi, done) = {
    match lo >= hi {
      true => done!(Nil)
      false => {
        for (@inner <<- @[privateName, innerPName, lo]) {
          for (@_reply <- @inner!?("clear")) {
            clearInnersLoop!(privateName, innerPName, lo + 1, hi, *done)
          }
        }
      }
    }
  } |

  // ==================================================================
  // closeInnersLoop â€” invoke `close()` on each inner buffer parked at
  // @[privateName, innerPName, i] for i in [lo, hi).  Same
  // sequencing discipline as clearInnersLoop.
  // ==================================================================
  contract closeInnersLoop(@privateName, @innerPName, @lo, @hi, done) = {
    match lo >= hi {
      true => done!(Nil)
      false => {
        for (@inner <<- @[privateName, innerPName, lo]) {
          for (@_reply <- @inner!?("close")) {
            closeInnersLoop!(privateName, innerPName, lo + 1, hi, *done)
          }
        }
      }
    }
  }

  |
  

  agent Stdin {
    constructor(@fd) {
      @[*private, *stdinFdP]!(fd) |
      @[*private, *stdinStateP]!("open")
    } |

    // -- chars() ---------------------------------------------------
    //
    // CharStream over stdin bytes decoded as UTF-8.  Same codepoint
    // logic as File.chars: per-byte codepointLen, refill on truncated
    // codepoint at pending's end, EOS on 0-byte fsRead.
    method chars() {
      for (@state <- @[*private, *stdinStateP]) {
        match state {
          "closed" => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdinFdP]) {
              new charProducer, charBuilder, pendingCell in {
                pendingCell!(("".hexToBytes(), 0, false)) |

                contract charProducer(retCh) = {
                  for (@(pending, idx, eofSeen) <- pendingCell) {
                    match idx >= pending.length() {
                      true => {
                        match eofSeen {
                          true => {
                            pendingCell!((pending, idx, true)) |
                            retCh!([false, "EOS", "end of input"])
                          }
                          false => {
                            new readCh in {
                              fsRead!(fd, 4096, *readCh) |
                              for (@reply <- readCh) {
                                match reply {
                                  [true, ba /\ ByteArray] => {
                                    match ba.length() {
                                      0 => {
                                        pendingCell!((pending, idx, true)) |
                                        retCh!([false, "EOS", "end of input"])
                                      }
                                      _ => {
                                        pendingCell!((ba, 0, false)) |
                                        charProducer!(*retCh)
                                      }
                                    }
                                  }
                                  _ => {
                                    pendingCell!((pending, idx, eofSeen)) |
                                    retCh!(reply)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      false => {
                        new lenCh in {
                          codepointLen!(pending.nth(idx), *lenCh) |
                          for (@n <- lenCh) {
                            match n {
                              -1 => {
                                pendingCell!((pending, idx, eofSeen)) |
                                retCh!([false, "FSERR_IO",
                                  "invalid UTF-8 start byte"])
                              }
                              _ => {
                                match idx + n <= pending.length() {
                                  true => {
                                    pendingCell!((pending, idx + n, eofSeen)) |
                                    retCh!([true,
                                      pending.slice(idx, idx + n).decodeUtf8()])
                                  }
                                  false => {
                                    match eofSeen {
                                      true => {
                                        pendingCell!((pending, idx, true)) |
                                        retCh!([false, "FSERR_IO",
                                          "truncated UTF-8 at end of input"])
                                      }
                                      false => {
                                        new readCh in {
                                          fsRead!(fd, 4096, *readCh) |
                                          for (@reply <- readCh) {
                                            match reply {
                                              [true, ba /\ ByteArray] => {
                                                match ba.length() {
                                                  0 => {
                                                    pendingCell!((pending, idx, true)) |
                                                    retCh!([false, "FSERR_IO",
                                                      "truncated UTF-8 at end of input"])
                                                  }
                                                  _ => {
                                                    pendingCell!((
                                                      [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                      0, false)) |
                                                    charProducer!(*retCh)
                                                  }
                                                }
                                              }
                                              _ => {
                                                pendingCell!((pending, idx, eofSeen)) |
                                                retCh!(reply)
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } |

                contract charBuilder(@vals, retCh) = {
                  match vals {
                    v /\ List => concatStringsLoop!(v, "", *retCh)
                    _ => retCh!([false, "FSERR_IO",
                      "chunk builder expected List"])
                  }
                } |

                for (@streamHandle <- Stream!?(*charProducer, *charBuilder)) {
                  @[*private, *stdinStateP]!("open") |
                  return!([true, streamHandle])
                }
              }
            }
          }
          _ => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin state unrecognized"])
          }
        }
      }
    } |

    // -- bytes() ---------------------------------------------------
    //
    // ByteStream: one Int per next(), refilling in 4096-byte chunks.
    // No decoding; just relay bytes.
    method bytes() {
      for (@state <- @[*private, *stdinStateP]) {
        match state {
          "closed" => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdinFdP]) {
              new byteProducer, byteBuilder, pendingCell in {
                pendingCell!(("".hexToBytes(), 0, false)) |

                contract byteProducer(retCh) = {
                  for (@(pending, idx, eofSeen) <- pendingCell) {
                    match idx >= pending.length() {
                      true => {
                        match eofSeen {
                          true => {
                            pendingCell!((pending, idx, true)) |
                            retCh!([false, "EOS", "end of input"])
                          }
                          false => {
                            new readCh in {
                              fsRead!(fd, 4096, *readCh) |
                              for (@reply <- readCh) {
                                match reply {
                                  [true, ba /\ ByteArray] => {
                                    match ba.length() {
                                      0 => {
                                        pendingCell!((pending, idx, true)) |
                                        retCh!([false, "EOS", "end of input"])
                                      }
                                      _ => {
                                        pendingCell!((ba, 0, false)) |
                                        byteProducer!(*retCh)
                                      }
                                    }
                                  }
                                  _ => {
                                    pendingCell!((pending, idx, eofSeen)) |
                                    retCh!(reply)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      false => {
                        pendingCell!((pending, idx + 1, eofSeen)) |
                        retCh!([true, pending.nth(idx)])
                      }
                    }
                  }
                } |

                contract byteBuilder(@vals, retCh) = {
                  match vals {
                    v /\ List => retCh!([true, v])
                    _ => retCh!([false, "FSERR_IO",
                      "chunk builder expected List"])
                  }
                } |

                for (@streamHandle <- Stream!?(*byteProducer, *byteBuilder)) {
                  @[*private, *stdinStateP]!("open") |
                  return!([true, streamHandle])
                }
              }
            }
          }
          _ => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin state unrecognized"])
          }
        }
      }
    } |

    // -- readLine() ------------------------------------------------
    //
    // Single-shot CharStream over the next line.  Yields 1-codepoint
    // Strings until LF; LF is consumed but NOT emitted.  Pre-exhausted
    // stream if stdin is at end of input.  MVP: LF only (spec Â§618
    // full \R deferred, matching File.readLine).
    //
    // ## Error paths (not "pre-exhausted"; spec Â§1084 leaves these
    //    implicit â€” behavior matches File.readLine)
    //
    // - Invalid UTF-8 start byte at the reader's position surfaces
    //   as `[false, "FSERR_IO", "invalid UTF-8 start byte"]`.
    // - Truncated multi-byte codepoint at end of input surfaces as
    //   `[false, "FSERR_IO", "truncated UTF-8 at end of input"]` â€”
    //   the reader has committed to the codepoint's lead byte and
    //   cannot back out.  Callers that need EOS-shaped termination
    //   MUST validate their input is well-formed UTF-8.
    method readLine() {
      for (@state <- @[*private, *stdinStateP]) {
        match state {
          "closed" => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdinFdP]) {
              new lineProducer, lineBuilder, lineCell in {
                // State: (pending, idx, eofSeen, doneAtLF).
                lineCell!(("".hexToBytes(), 0, false, false)) |

                contract lineProducer(retCh) = {
                  for (@(pending, idx, eofSeen, doneAtLF) <- lineCell) {
                    match doneAtLF {
                      true => {
                        lineCell!((pending, idx, eofSeen, true)) |
                        retCh!([false, "EOS", "end of line"])
                      }
                      false => {
                        match idx >= pending.length() {
                          true => {
                            match eofSeen {
                              true => {
                                lineCell!((pending, idx, true, false)) |
                                retCh!([false, "EOS", "end of input"])
                              }
                              false => {
                                new readCh in {
                                  fsRead!(fd, 4096, *readCh) |
                                  for (@reply <- readCh) {
                                    match reply {
                                      [true, ba /\ ByteArray] => {
                                        match ba.length() {
                                          0 => {
                                            lineCell!((pending, idx, true, false)) |
                                            retCh!([false, "EOS", "end of input"])
                                          }
                                          _ => {
                                            lineCell!((ba, 0, false, false)) |
                                            lineProducer!(*retCh)
                                          }
                                        }
                                      }
                                      _ => {
                                        lineCell!((pending, idx, eofSeen, false)) |
                                        retCh!(reply)
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          false => {
                            new byteAt in {
                              byteAt!(pending.nth(idx)) |
                              for (@b <- byteAt) {
                                match b {
                                  10 => {
                                    // LF: consume it, mark done.  No
                                    // seek-back (stdin has no cursor
                                    // to rewind; the pending buffer
                                    // has already been read from fd).
                                    // Bytes past LF sit in pending for
                                    // this readLine's lifetime but are
                                    // orphaned â€” a subsequent readLine
                                    // starts fresh with empty pending
                                    // and re-reads.  This is the
                                    // "stdin readLine is single-shot"
                                    // limitation; multi-line reads
                                    // should use lines() instead.
                                    lineCell!((pending, idx + 1, eofSeen, true)) |
                                    retCh!([false, "EOS", "end of line"])
                                  }
                                  _ => {
                                    new lenCh in {
                                      codepointLen!(b, *lenCh) |
                                      for (@n <- lenCh) {
                                        match n {
                                          -1 => {
                                            lineCell!((pending, idx, eofSeen, false)) |
                                            retCh!([false, "FSERR_IO",
                                              "invalid UTF-8 start byte"])
                                          }
                                          _ => {
                                            match idx + n <= pending.length() {
                                              true => {
                                                lineCell!((pending, idx + n, eofSeen, false)) |
                                                retCh!([true,
                                                  pending.slice(idx, idx + n).decodeUtf8()])
                                              }
                                              false => {
                                                match eofSeen {
                                                  true => {
                                                    lineCell!((pending, idx, true, false)) |
                                                    retCh!([false, "FSERR_IO",
                                                      "truncated UTF-8 at end of input"])
                                                  }
                                                  false => {
                                                    new readCh in {
                                                      fsRead!(fd, 4096, *readCh) |
                                                      for (@reply <- readCh) {
                                                        match reply {
                                                          [true, ba /\ ByteArray] => {
                                                            match ba.length() {
                                                              0 => {
                                                                lineCell!((pending, idx, true, false)) |
                                                                retCh!([false, "FSERR_IO",
                                                                  "truncated UTF-8 at end of input"])
                                                              }
                                                              _ => {
                                                                lineCell!((
                                                                  [pending.slice(idx, pending.length()), ba].concatBytes(),
                                                                  0, false, false)) |
                                                                lineProducer!(*retCh)
                                                              }
                                                            }
                                                          }
                                                          _ => {
                                                            lineCell!((pending, idx, eofSeen, false)) |
                                                            retCh!(reply)
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } |

                contract lineBuilder(@vals, retCh) = {
                  match vals {
                    v /\ List => concatStringsLoop!(v, "", *retCh)
                    _ => retCh!([false, "FSERR_IO",
                      "chunk builder expected List"])
                  }
                } |

                for (@streamHandle <- Stream!?(*lineProducer, *lineBuilder)) {
                  @[*private, *stdinStateP]!("open") |
                  return!([true, streamHandle])
                }
              }
            }
          }
          _ => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin state unrecognized"])
          }
        }
      }
    } |

    // -- lines() ---------------------------------------------------
    //
    // Outer LineStream over stdin.  Same structure as File.lines():
    // shared sourceCell across outer + inner, single-active-inner
    // rule, drained-inners-fail-closed.  chunk() unsupported.
    //
    // Same shallow-close limitations as File.lines (M-11-1, M-11-2):
    // inner.close() and outer.close() are bare Stream.close â€” the
    // source drain happens naturally on outer.next() force-drain,
    // which is the only observation path under compliant usage.
    method lines() {
      for (@state <- @[*private, *stdinStateP]) {
        match state {
          "closed" => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdinFdP]) {
              new sourceCell, activeInnerCell,
                  scanRefill, mintInner, outerProd, outerBuild in {
                sourceCell!(("".hexToBytes(), 0, false)) |
                activeInnerCell!(Nil) |

                contract scanRefill(@pending, @idx, @eofSeen, ret) = {
                  new scanRet in {
                    scanLineForLF!(pending, idx, 0,
                      pending.length() + 1, *scanRet) |
                    for (@scanReply <- scanRet) {
                      match scanReply {
                        [true, "LF_FOUND", lfPos, _] => {
                          ret!((pending, lfPos + 1, eofSeen))
                        }
                        _ => {
                          match eofSeen {
                            true => ret!((pending, pending.length(), true))
                            false => {
                              new readCh in {
                                fsRead!(fd, 4096, *readCh) |
                                for (@rr <- readCh) {
                                  match rr {
                                    [true, ba /\ ByteArray] => {
                                      match ba.length() {
                                        0 => ret!((pending, pending.length(), true))
                                        _ => {
                                          new nextP in {
                                            nextP!(
                                              [pending.slice(idx, pending.length()),
                                               ba].concatBytes()) |
                                            for (@np <- nextP) {
                                              scanRefill!(np, 0, false, *ret)
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => ret!((pending, idx, eofSeen))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } |

                contract mintInner(@pending, @idx, @eofSeen, retCh) = {
                  new innerStatusCh, innerProducer, innerBuilder in {
                    innerStatusCh!("open") |

                    contract innerBuilder(@vals, cbRet) = {
                      match vals {
                        v /\ List => concatStringsLoop!(v, "", *cbRet)
                        _ => cbRet!([false, "FSERR_IO",
                          "chunk builder expected List"])
                      }
                    } |

                    contract innerProducer(ipRet) = {
                      for (@stat <- innerStatusCh) {
                        match stat {
                          "revoked" => {
                            innerStatusCh!("revoked") |
                            ipRet!([false, "FSERR_CLOSED",
                              "inner drained by outer"])
                          }
                          "eos" => {
                            innerStatusCh!("eos") |
                            ipRet!([false, "EOS", "end of line"])
                          }
                          "open" => {
                            for (@(p, i, eof) <- sourceCell) {
                              match i >= p.length() {
                                true => {
                                  match eof {
                                    true => {
                                      sourceCell!((p, i, true)) |
                                      innerStatusCh!("eos") |
                                      ipRet!([false, "EOS", "end of input"])
                                    }
                                    false => {
                                      new readCh in {
                                        fsRead!(fd, 4096, *readCh) |
                                        for (@rr <- readCh) {
                                          match rr {
                                            [true, ba /\ ByteArray] => {
                                              match ba.length() {
                                                0 => {
                                                  sourceCell!((p, i, true)) |
                                                  innerStatusCh!("eos") |
                                                  ipRet!([false, "EOS", "end of input"])
                                                }
                                                _ => {
                                                  sourceCell!((ba, 0, false)) |
                                                  innerStatusCh!("open") |
                                                  innerProducer!(*ipRet)
                                                }
                                              }
                                            }
                                            _ => {
                                              sourceCell!((p, i, eof)) |
                                              innerStatusCh!("open") |
                                              ipRet!(rr)
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                false => {
                                  match p.nth(i) {
                                    10 => {
                                      sourceCell!((p, i + 1, eof)) |
                                      innerStatusCh!("eos") |
                                      ipRet!([false, "EOS", "end of line"])
                                    }
                                    b => {
                                      new lenCh in {
                                        codepointLen!(b, *lenCh) |
                                        for (@n <- lenCh) {
                                          match n {
                                            -1 => {
                                              sourceCell!((p, i, eof)) |
                                              innerStatusCh!("open") |
                                              ipRet!([false, "FSERR_IO",
                                                "invalid UTF-8 start byte"])
                                            }
                                            _ => {
                                              match i + n <= p.length() {
                                                true => {
                                                  sourceCell!((p, i + n, eof)) |
                                                  innerStatusCh!("open") |
                                                  ipRet!([true,
                                                    p.slice(i, i + n).decodeUtf8()])
                                                }
                                                false => {
                                                  match eof {
                                                    true => {
                                                      sourceCell!((p, i, true)) |
                                                      innerStatusCh!("open") |
                                                      ipRet!([false, "FSERR_IO",
                                                        "truncated UTF-8 at end of input"])
                                                    }
                                                    false => {
                                                      new readCh in {
                                                        fsRead!(fd, 4096, *readCh) |
                                                        for (@rr <- readCh) {
                                                          match rr {
                                                            [true, ba /\ ByteArray] => {
                                                              match ba.length() {
                                                                0 => {
                                                                  sourceCell!((p, i, true)) |
                                                                  innerStatusCh!("open") |
                                                                  ipRet!([false, "FSERR_IO",
                                                                    "truncated UTF-8 at end of input"])
                                                                }
                                                                _ => {
                                                                  sourceCell!((
                                                                    [p.slice(i, p.length()),
                                                                     ba].concatBytes(),
                                                                    0, false)) |
                                                                  innerStatusCh!("open") |
                                                                  innerProducer!(*ipRet)
                                                                }
                                                              }
                                                            }
                                                            _ => {
                                                              sourceCell!((p, i, eof)) |
                                                              innerStatusCh!("open") |
                                                              ipRet!(rr)
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => {
                            innerStatusCh!(stat) |
                            ipRet!([false, "FSERR_IO",
                              "inner state unrecognized"])
                          }
                        }
                      }
                    } |

                    for (@innerHandle <-
                      Stream!?(*innerProducer, *innerBuilder)) {
                      activeInnerCell!(*innerStatusCh) |
                      sourceCell!((pending, idx, eofSeen)) |
                      retCh!([true, innerHandle])
                    }
                  }
                } |

                contract outerProd(retCh) = {
                  new needsDrainCh in {
                    for (@innerRef <- activeInnerCell) {
                      match innerRef {
                        Nil => needsDrainCh!(false)
                        _ => {
                          for (@innerStatus <- @innerRef) {
                            match innerStatus {
                              "open" => {
                                @innerRef!("revoked") |
                                needsDrainCh!(true)
                              }
                              _ => {
                                @innerRef!("revoked") |
                                needsDrainCh!(false)
                              }
                            }
                          }
                        }
                      }
                    } |
                    for (@needsDrain <- needsDrainCh) {
                      for (@(pending, idx, eofSeen) <- sourceCell) {
                        new drainedCh in {
                          match needsDrain {
                            true => scanRefill!(pending, idx, eofSeen, *drainedCh)
                            false => drainedCh!((pending, idx, eofSeen))
                          } |
                          for (@(p, i, eof) <- drainedCh) {
                            match i >= p.length() {
                              true => {
                                match eof {
                                  true => {
                                    activeInnerCell!(Nil) |
                                    sourceCell!((p, i, true)) |
                                    retCh!([false, "EOS", "end of input"])
                                  }
                                  false => {
                                    new readCh in {
                                      fsRead!(fd, 4096, *readCh) |
                                      for (@rr <- readCh) {
                                        match rr {
                                          [true, ba /\ ByteArray] => {
                                            match ba.length() {
                                              0 => {
                                                activeInnerCell!(Nil) |
                                                sourceCell!((p, i, true)) |
                                                retCh!([false, "EOS", "end of input"])
                                              }
                                              _ => {
                                                mintInner!(ba, 0, false, *retCh)
                                              }
                                            }
                                          }
                                          _ => {
                                            activeInnerCell!(Nil) |
                                            sourceCell!((p, i, eof)) |
                                            retCh!(rr)
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              false => {
                                mintInner!(p, i, eof, *retCh)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } |

                contract outerBuild(@_vals, cbRet) = {
                  cbRet!([false, "FSERR_UNSUPPORTED",
                    "chunk unsupported on LineStream (single-active-inner rule)"])
                } |

                for (@outerHandle <- Stream!?(*outerProd, *outerBuild)) {
                  @[*private, *stdinStateP]!("open") |
                  return!([true, outerHandle])
                }
              }
            }
          }
          _ => {
            @[*private, *stdinStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdin state unrecognized"])
          }
        }
      }
    } |

    // -- close() ---------------------------------------------------
    //
    // Mark this Stdin cap "closed"; subsequent method calls return
    // FSERR_CLOSED via the state check.  Does NOT call fsClose â€”
    // the powerbox owns the process fd (spec Â§1085).
    method close() {
      for (@_state <- @[*private, *stdinStateP]) {
        @[*private, *stdinStateP]!("closed") |
        return!([true])
      }
    } |

    // -- Default arm ----------------------------------------------
    //
    // Catches seek/tell/size/bytesAt (spec Â§1087 says they return
    // FSERR_UNSUPPORTED) and any other unknown method.
    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED",
          "unknown method or not supported on Stdin"])
      }
    }
  }

  |
  

  agent Stdout {
    constructor(@fd) {
      @[*private, *stdoutFdP]!(fd) |
      @[*private, *stdoutStateP]!("open")
    } |

    // -- writeByteArray(bytes) -------------------------------------
    //
    // Type-guarded on ByteArray shape.  Writes at the fd's current
    // position via fsWrite.  Normalizes fsWrite's `[true, nWritten]`
    // (or any `[true, ...]` shape) reply to bare `[true]` per spec
    // Â§1112.  Forwards `[false, code, msg]` failures unchanged.
    // Wraps any other shape in FSERR_IO.  No mode gate (Stdout is
    // inherently write-only).
    method writeByteArray(@bytes) {
      match bytes {
        b /\ ByteArray => {
          for (@state <- @[*private, *stdoutStateP]) {
            match state {
              "closed" => {
                @[*private, *stdoutStateP]!("closed") |
                return!([false, "FSERR_CLOSED", "stdout is closed"])
              }
              "open" => {
                for (@fd <<- @[*private, *stdoutFdP]) {
                  new writeCh in {
                    fsWrite!(fd, b, *writeCh) |
                    for (@reply <- writeCh) {
                      @[*private, *stdoutStateP]!("open") |
                      // m-15-1 hardening: greedy `[true, ..._]` match
                      // catches both `[true]` and `[true, nWritten]`
                      // shapes; either normalizes to `[true]`.
                      match reply {
                        [true, ..._]       => return!([true])
                        [false, code, msg] => return!([false, code, msg])
                        _ => return!([false, "FSERR_IO",
                          "fsWrite returned malformed reply"])
                      }
                    }
                  }
                }
              }
              _ => {
                @[*private, *stdoutStateP]!("closed") |
                return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
              }
            }
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "bytes must be a ByteArray"])
      }
    } |

    // -- writeString(s) --------------------------------------------
    //
    // Bounded convenience: encode `s` as UTF-8 and delegate.  Type-
    // guarded on String.
    method writeString(@s) {
      match s {
        str /\ String => {
          for (@reply <- @(*this)!?("writeByteArray", str.toUtf8Bytes())) {
            return!(reply)
          }
        }
        _ => return!([false, "FSERR_BAD_ARG", "s must be a String"])
      }
    } |

    // -- writeBytes(byteStream) ------------------------------------
    //
    // Sequential ByteStream consumer.  Drains via the shared
    // writeBytesLoop helper (same one File.writeBytes uses).  The
    // input stream is closed by the loop on success or error.
    method writeBytes(@byteStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeBytesLoop!(byteStream, fd, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  @[*private, *stdoutStateP]!("open") |
                  // writeBytesLoop returns [true] on EOS or
                  // [false, code, msg] with a byte-count prefix on
                  // error.  Both shapes match spec Â§1108 directly.
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeChars(charStream) ------------------------------------
    //
    // Sequential CharStream consumer.  UTF-8-encodes each char via
    // toUtf8Bytes() as it drains; delegates to writeCharsLoop.
    method writeChars(@charStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  @[*private, *stdoutStateP]!("open") |
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeLine(charStream) -------------------------------------
    //
    // Drains charStream via writeCharsLoop, then appends LF (0x0A)
    // via fsWrite.  Line separator is always \n (spec Â§959).
    //
    // If the char-drain phase errors, forward that error unchanged
    // (do NOT append LF â€” partial line, no terminator).  If the
    // LF write fails after a successful drain, forward the LF error.
    method writeLine(@charStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new loopRet in {
                writeCharsLoop!(charStream, fd, 0, *loopRet) |
                for (@charsReply <- loopRet) {
                  match charsReply {
                    [true] => {
                      new lfCh in {
                        fsWrite!(fd, "0a".hexToBytes(), *lfCh) |
                        for (@lfReply <- lfCh) {
                          match lfReply {
                            [true, _] => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([true])
                            }
                            [false, code, msg] => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([false, code, msg])
                            }
                            _ => {
                              @[*private, *stdoutStateP]!("open") |
                              return!([false, "FSERR_IO",
                                "fsWrite for LF terminator returned malformed reply"])
                            }
                          }
                        }
                      }
                    }
                    _ => {
                      @[*private, *stdoutStateP]!("open") |
                      return!(charsReply)
                    }
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- writeLines(lineStream) ------------------------------------
    //
    // Drains an outer LineStream, calling writeLine per inner.
    // Releases stdoutStateP BEFORE the loop: writeLinesLoop calls
    // back into `*this!?("writeLine", inner)`, which acquires
    // stdoutStateP per iteration.  Holding it across the loop
    // would deadlock â€” same pattern as File.writeLines.
    method writeLines(@lineStream) {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@_fd <<- @[*private, *stdoutFdP]) {
              @[*private, *stdoutStateP]!("open") |
              new loopRet in {
                writeLinesLoop!(*this, lineStream, 0, *loopRet) |
                for (@finalReply <- loopRet) {
                  return!(finalReply)
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- flush() ---------------------------------------------------
    //
    // Forces durable write on the fd (spec Â§1113).  On stdio, this
    // flushes to the terminal / pipe buffer.
    //
    // M-15-1 hardening: shape-validate fsFlush's reply.  Every other
    // Stdout method that dispatches to a native primitive wraps
    // unexpected shapes in FSERR_IO; flush should too, so a future
    // primitive change can't propagate malformed replies to callers.
    method flush() {
      for (@state <- @[*private, *stdoutStateP]) {
        match state {
          "closed" => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout is closed"])
          }
          "open" => {
            for (@fd <<- @[*private, *stdoutFdP]) {
              new flushCh in {
                fsFlush!(fd, *flushCh) |
                for (@reply <- flushCh) {
                  @[*private, *stdoutStateP]!("open") |
                  match reply {
                    [true]             => return!([true])
                    [false, code, msg] => return!([false, code, msg])
                    _ => return!([false, "FSERR_IO",
                      "fsFlush returned malformed reply"])
                  }
                }
              }
            }
          }
          _ => {
            @[*private, *stdoutStateP]!("closed") |
            return!([false, "FSERR_CLOSED", "stdout state unrecognized"])
          }
        }
      }
    } |

    // -- close() ---------------------------------------------------
    //
    // Mark this Stdout cap "closed"; subsequent method calls return
    // FSERR_CLOSED via the state check.  Does NOT call fsClose â€”
    // the powerbox owns the process fd (spec Â§1114, same rule as
    // Stdin.close).  Active streams held via bundle+ are NOT force-
    // closed here â€” same shallow-close limitation as File.close
    // (M-11-2 deferral).
    method close() {
      for (@_state <- @[*private, *stdoutStateP]) {
        @[*private, *stdoutStateP]!("closed") |
        return!([true])
      }
    } |

    // -- Default arm -----------------------------------------------
    //
    // Catches read-side methods (chars, bytes, lines, readLine â€”
    // spec Â§1116) and any other unknown method with FSERR_UNSUPPORTED.
    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED",
          "unknown method or not supported on Stdout"])
      }
    }
  }

  |
  

  // Composition-time init (RH-A5-11 note): this send lands
  // synchronously with the rest of the outer `new` body during
  // genesis composition â€” no deploy can reach `Fs.revoke()` /
  // any method before genesis commits, and all peek-reads
  // (`<<-`) block naturally until the value is present.  There
  // is no cross-deploy window during which `fsRevokedP` could
  // observe as empty.
  @[*fsRevokedP]!(false) |

  agent Fs {
    // -- constructor(stdinFd, stdoutFd, stderrFd, bMap) -----------
    //
    // Powerbox provides the three stdio fds and the static bundle at
    // mint time.  Fds are stashed unchanged; each stdio method mints
    // a fresh Stdin / Stdout on demand (spec Â§1085 / Â§1114 require
    // fresh-cap-after-close).
    constructor(@stdinFd, @stdoutFd, @stderrFd, @bMap) {
      @[*private, *fsBundleP]!(bMap) |
      @[*private, *fsStdinFdP]!(stdinFd) |
      @[*private, *fsStdoutFdP]!(stdoutFd) |
      @[*private, *fsStderrFdP]!(stderrFd)
    } |

    // -- stdin() / stdout() / stderr() ----------------------------
    //
    // Fresh-mint per call.  Two calls on the same Fs return DISTINCT
    // caps; closing one does not affect any subsequent call.  Fd
    // cell is read non-linearly so unbounded parallel calls are safe.
    //
    // ## Consensus discipline â€” stdio is INTRINSICALLY ORACULAR
    //
    // The Stdin / Stdout constructors take a fd only, no `cmode`
    // argument (see Stdin.rho / Stdout.rho docstrings for full
    // rationale).  Consensus-mode deploys are structurally still
    // able to call `Fs.stdin()` / `Fs.stdout()` / `Fs.stderr()` â€”
    // there is no runtime gate here â€” but any bytes read from
    // stdin or side-effects observed via stdout MUST NOT flow into
    // consensus-observable tuplespace state.  A deploy that routes
    // stdin bytes into consensus state will diverge across nodes
    // and fail consensus with a state-root mismatch.  This is a
    // deploy-author invariant, consistent with the treatment of
    // oracular file reads.
    method stdin() {
      for (@revoked <<- @[*fsRevokedP]) {
        match revoked {
          true  => return!([false, "FSERR_REVOKED", "Fs has been revoked"])
          false => {
            for (@fd <<- @[*private, *fsStdinFdP]) {
              for (@cap <- Stdin!?(fd)) {
                return!([true, cap])
              }
            }
          }
        }
      }
    } |

    method stdout() {
      for (@revoked <<- @[*fsRevokedP]) {
        match revoked {
          true  => return!([false, "FSERR_REVOKED", "Fs has been revoked"])
          false => {
            for (@fd <<- @[*private, *fsStdoutFdP]) {
              for (@cap <- Stdout!?(fd)) {
                return!([true, cap])
              }
            }
          }
        }
      }
    } |

    method stderr() {
      for (@revoked <<- @[*fsRevokedP]) {
        match revoked {
          true  => return!([false, "FSERR_REVOKED", "Fs has been revoked"])
          false => {
            for (@fd <<- @[*private, *fsStderrFdP]) {
              for (@cap <- Stdout!?(fd)) {
                return!([true, cap])
              }
            }
          }
        }
      }
    } |

    // -- openFile(name, options) -----------------------------------
    //
    // Slice 27: fresh-mint per call â€” every invocation invokes
    // `openFileImpl` directly (no cache lookup).  Two calls with the
    // same `(name, options)` yield DISTINCT File agents with
    // independent cursors; closing one has no effect on the other.
    method openFile(@name, @options) {
      // Revoke gate â€” see module-level docstring.  Non-linear read
      // so unbounded parallel calls are safe; module-cell has one
      // Bool value written at composition-time and only advanced
      // to `true` by revoke().
      for (@revoked <<- @[*fsRevokedP]) {
        match revoked {
          true  => return!([false, "FSERR_REVOKED", "Fs has been revoked"])
          false => {
      match name {
        n /\ String => {
          new modeCh in {
            // M-22 (2026-09-04, RH-A5-3): type-guard `mode` at
            // extraction (`{"mode": v /\ String ..._}`) so a non-
            // String value under the `mode` key doesn't collapse
            // through the outer `Nil` sentinel and produce the
            // misleading "options must be a Map" error.  Distinct
            // arms below produce distinct sentinels.
            match options {
              {} => modeCh!("r")
              {"mode": v /\ String ..._} => modeCh!(v)
              {"mode": _ ..._} => modeCh!(
                (false, "FSERR_BAD_ARG", "mode must be a String"))
              {_ : _ ..._} => modeCh!("r")
              _ => modeCh!(Nil)
            } |
            for (@requestedMode <- modeCh) {
              match requestedMode {
                Nil => return!(
                  [false, "FSERR_BAD_ARG", "options must be a Map"])
                (false, code, msg) => return!([false, code, msg])
                m /\ String => {
                  for (@bMap <<- @[*private, *fsBundleP]) {
                    match bMap.contains(n) {
                      false => return!(
                        [false, "FSERR_UNSUPPORTED",
                         "logical name not in static bundle"])
                      true => {
                        match bMap.get(n) {
                          (canonRoot, rel, provisioned, "file", cmode) => {
                            match m {
                              "r" => openFileImpl!(
                                canonRoot, "", rel, "r", cmode, *File, *return)
                              // Spec Â§File modes enumerates exactly
                              // 8 forms (r/w/a/r+/w+/wx/w+x/a+).
                              "w" \/ "w+" \/ "wx" \/ "w+x" \/ "a" \/ "a+" \/ "r+" => {
                                // Write-capable cap check.  Only "r"
                                // provisioned rejects; every other
                                // file mode (r+, w, w+, a, a+, wx,
                                // w+x) grants write.
                                match provisioned {
                                  "r" => return!(
                                    [false, "FSERR_UNSUPPORTED",
                                     "requested mode exceeds provisioned attenuation"])
                                  _ => openFileImpl!(
                                    canonRoot, "", rel, m, cmode, *File, *return)
                                }
                              }
                              _ => return!(
                                [false, "FSERR_BAD_ARG", "unknown file mode"])
                            }
                          }
                          (_, _, _, "dir", _) => return!(
                            [false, "FSERR_BAD_ARG",
                             "logical name is a directory; use openDir"])
                          _ => return!(
                            [false, "FSERR_UNSUPPORTED",
                             "logical name malformed"])
                        }
                      }
                    }
                  }
                }
                _ => return!(
                  [false, "FSERR_BAD_ARG", "mode must be a String"])
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "name must be a String"])
      }
          }
        }
      }
    } |

    // -- openDir(name, options) ------------------------------------
    //
    // Slice 27: fresh-mint per call â€” same rationale as openFile.
    method openDir(@name, @options) {
      // Revoke gate â€” see module-level docstring.
      for (@revoked <<- @[*fsRevokedP]) {
        match revoked {
          true  => return!([false, "FSERR_REVOKED", "Fs has been revoked"])
          false => {
      match name {
        n /\ String => {
          new modeCh in {
            // M-10 A5-RH-A5-1 (2026-09-04): reject `path: true`
            // explicitly.  Full mkdir-p implementation deferred to
            // a follow-up.  Same guard lives at Dir.rho::openDir
            // for the nested path.
            // M-22 (2026-09-04, RH-A5-3): see Fs.openFile above for
            // the type-guard rationale.
            match options {
              {"path": true ..._} => return!(
                [false, "FSERR_UNSUPPORTED", "path=true not yet implemented"])
              {} => modeCh!("r")
              {"mode": v /\ String ..._} => modeCh!(v)
              {"mode": _ ..._} => modeCh!(
                (false, "FSERR_BAD_ARG", "mode must be a String"))
              {_ : _ ..._} => modeCh!("r")
              _ => modeCh!(Nil)
            } |
            for (@requestedMode <- modeCh) {
              match requestedMode {
                Nil => return!(
                  [false, "FSERR_BAD_ARG", "options must be a Map"])
                (false, code, msg) => return!([false, code, msg])
                m /\ String => {
                  for (@bMap <<- @[*private, *fsBundleP]) {
                    match bMap.contains(n) {
                      false => return!(
                        [false, "FSERR_UNSUPPORTED",
                         "logical name not in static bundle"])
                      true => {
                        match bMap.get(n) {
                          (canonRoot, rel, provisioned, "dir", cmode) => {
                            match m {
                              "r" => openDirImpl!(
                                canonRoot, "", rel, "r", cmode, *File, *return)
                              "r+" => {
                                match provisioned {
                                  "r+" => openDirImpl!(
                                    canonRoot, "", rel, m, cmode, *File, *return)
                                  _ => return!(
                                    [false, "FSERR_UNSUPPORTED",
                                     "requested mode exceeds provisioned attenuation"])
                                }
                              }
                              _ => return!(
                                [false, "FSERR_BAD_ARG",
                                 "dir mode must be \"r\" or \"r+\""])
                            }
                          }
                          (_, _, _, "file", _) => return!(
                            [false, "FSERR_BAD_ARG",
                             "logical name is a file; use openFile"])
                          _ => return!(
                            [false, "FSERR_UNSUPPORTED",
                             "logical name malformed"])
                        }
                      }
                    }
                  }
                }
                _ => return!(
                  [false, "FSERR_BAD_ARG", "mode must be a String"])
              }
            }
          }
        }
        _ => return!(
          [false, "FSERR_BAD_ARG", "name must be a String"])
      }
          }
        }
      }
    } |

    // -- revoke() -------------------------------------------------
    //
    // Ambient-authority off switch.  Flips the module-level
    // `fsRevokedP` cell to `true` atomically via linear consume +
    // rewrite in the same reduction step.  Idempotent: a second
    // revoke() call also returns [true] (the linear receive
    // consumes whatever value is in the cell, and the rewrite
    // always sets `true`).
    //
    // Post-revoke, every openFile/openDir/stdin/stdout/stderr call
    // on any Fs instance (including instances minted AFTER revoke)
    // returns [false, "FSERR_REVOKED", ...].  Previously-minted
    // File/Dir caps are unaffected.  See spec Â§Revocation.
    //
    // Any Fs cap holder can call revoke().  The ocap design
    // assumes the powerbox is the intended caller during the
    // genesis handoff window.
    method revoke() {
      for (@_current <- @[*fsRevokedP]) {
        @[*fsRevokedP]!(true) |
        return!([true])
      }
    } |

    // -- Default arm ----------------------------------------------
    default(...@args) {
      match args {
        [*ret, ..._] => ret!([false, "FSERR_UNSUPPORTED",
          "unknown method or not implemented in this slice"])
      }
    }
  }

  |
  // CRIT-2 fix (2026-08-06): snapshot-cadence commitment.  Binds
  // cadence to a fresh unforgeable name and immediately consumes
  // it (peek + drop) so the term serializes deterministically as
  // a function of cadence but leaves no user-reachable state.  The
  // sole purpose is byte-diff detection at
  // `BlockApproverProtocol::validate_candidate` â€” a leader with
  // cadence=100 and a validator with cadence=50 now produce
  // different fs_generator deploy terms, so validation fails loudly
  // instead of silently proceeding with divergent snapshot behavior.
  new snapshotCadenceCommitmentP in {
    snapshotCadenceCommitmentP!(Nil) |
    for (_ <- snapshotCadenceCommitmentP) { Nil }
  } |
  // Slice 25: mint one shared Fs instance (stdio fds 0/1/2, static
  // bundle populated from operator config+CLI merge) and publish
  // it at the registry URI derived from FS_GENERATOR_PK.  Per-
  // principal delegation via powerbox is a candidate follow-up
  // (see fs_genesis.rs docstring MVP simplifications Â§1);
  // shards may keep the shared-Fs shape indefinitely.
  for (@fs <- Fs!?(0, 1, 2, {})) {
    rs!(
      "042eb8e6d34c86e2e1fab28bc3eb084a2179ee755df8ce4cb1971f90b63de20ca7ece78513d3a219cb89265559c42ea66b93ce4dd2f6fb6d3881dbb86026829cc3".hexToBytes(),
      (9223372036854775807, fs),
      "30450221009282e2b346a1777a761957f187b44ab52705e8352701f01bd718f6137093b3630220453f1035f155b11d255515eea787dbd26e65eafc1d70dce66dd61324231b22d3".hexToBytes(),
      *uriOut
    ) |
    // PB-B-3: also publish under the Versioned Registry so the
    // spec-canonical `rho:serve:1.0.0:<pk_hex>:fs:1.*` lookup shape
    // resolves.  Runs in parallel with the insertSigned call above;
    // both target the same `fs` Par, so leader/follower state is
    // deterministic regardless of which insert commits first.
    // Drain insertVerRet so the deploy's tuplespace effects fully
    // commit (the mutator's produce is what actually stores the
    // entry; the reply on insertVerRet is `true` on success).
    // Store the fs cap under the versioned-registry map.  Callers
    // resolve via `rho:serve:1.0.0:<pk_hex>:fs:1.0.0`.  The
    // `for(@_ <- insertVerRet)` await sequences the mutator's
    // commit to complete BEFORE the deploy exits â€” a dropped
    // await lets fs_generator terminate while the store update
    // is still in-flight, so subsequent deploys see a partially-
    // committed store and lookupVersion returns Nil.  E2E
    // resolution pinned by
    // `fs_cap_is_resolvable_via_versioned_registry_uri` in
    // `casper/tests/genesis/contracts/fileio_fs_spec.rs`.
    v1Api!("insertVersion", "serve", "fs", "1.0.0", fs, *insertVerRet) |
    for (@_ <- insertVerRet) { Nil }
  } |
  // PB-B-5 (2026-09-02): mint one shared Allocator instance and
  // publish it at `rho:serve:1.0.0:<FS_GENERATOR_PUB_KEY_HEX>:buffer:1.0.0`
  // so user deploys can obtain Buffer / Rows caps.  Same delegation
  // shape as the fs cap above (single shared instance per node via
  // insertVersion under the serve namespace).  Per-principal
  // delegation is a candidate powerbox slice (would mirror PB-B-3 â†’
  // PB-B-5 authenticated-caller discipline) but is not scheduled â€”
  // post-PB-M-1 narrowing left shard-specific delegation shapes as
  // optional add-ons rather than core FIP substrate.
  //
  // No `insertSigned` counterpart â€” legacy `rho:id:<hash>` publication
  // was a compatibility affordance for the Fs cap; Allocator ships
  // fresh so callers use the serve-URN form exclusively.
  //
  // Runs in parallel with the Fs mint/publish block above; both
  // Allocator!?() and Fs!?(...) are independent no-arg / arg-list
  // constructors on module-scope agents already lexically in the
  // outer `new` binding, so no ordering constraint between them.
  for (@alloc <- Allocator!?()) {
    v1Api!("insertVersion", "serve", "buffer", "1.0.0", alloc, *allocInsertVerRet) |
    for (@_ <- allocInsertVerRet) { Nil }
  }
}
