Aş.±àçF+d`‰áçg'ø²Óˆê¤´z}gÂM<M¬-‹Üà´˜yÛ¯ÃsÍ—@©ÑJ	.÷c9 z‚r/*
 The table below describes the required computations and their dependencies

 No. | Dependency | Computation method | Result
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 1.  |            | given              | sk = 2a2eaa76d6fea9f502629e32b0f8eea19b9de8e2188ec0d589fcafa98fb1f031
 2.  |            | given              | timestamp = 1571408470880
 3.  |            | lastNonce          | nonce = 9223372036854775807
 4.  | 1,         | secp256k1          | pk = 04fe2eb1e0e7462b1a8f64600389e1e76727f8b2d38804eaa4b48f7a7d6715130fc24d3c4dac2d8bdc19e0b49879dbaf07c30773cd9740a9d14a092ef76339207a
 5.  | 2, 4, 3,   | registry           | value = (1571408470880, 04fe2eb1e0e7462b1a8f64600389e1e76727f8b2d38804eaa4b48f7a7d6715130fc24d3c4dac2d8bdc19e0b49879dbaf07c30773cd9740a9d14a092ef76339207a, 9223372036854775807)
 6.  | 5,         | protobuf           | toSign = 2a65aa01620a092a0710c08df3f3bb5b0a462a44ca014104fe2eb1e0e7462b1a8f64600389e1e76727f8b2d38804eaa4b48f7a7d6715130fc24d3c4dac2d8bdc19e0b49879dbaf07c30773cd9740a9d14a092ef76339207a0a0d2a0b10feffffffffffffffff01
 7.  | 6, 1,      | secp256k1          | sig = 304402201d9ecd4984f6fd7618dfe1dfa6753c662b2765f6e0b8819e63f37c65ba4c9175022067305a89ef93fd1726ecf31929d3306cdf29a7f8efa849fe6a336b499c67739c
 8.  | 4,         | registry           | uri = rho:id:b9s6j3xeobgset4ndn64hje64grfcj7a43eekb3fh43yso5ujiecfn
 ----+------------+--------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------
 */

new MultiSigSystemVault,
    rs(`rho:registry:insertSigned:secp256k1`), uriOut,
    rl(`rho:registry:lookup`),
    _fromPublicKey,
    _multiSigSystemVault,
    SystemVaultCh,
    AuthKeyCh,
    ListOpsCh
in {
  rl!(`rho:lang:listOps`, *ListOpsCh) |
  rl!(`rho:system:authKey`, *AuthKeyCh) |
  rl!(`rho:vault:system`, *SystemVaultCh) |
  for(@(_, ListOps) <- ListOpsCh &
      @(_, AuthKey) <- AuthKeyCh &
      @(_, SystemVault) <- SystemVaultCh) {

    contract MultiSigSystemVault(@"makeSealerUnsealer", ret) = {
      new mapStore, sealer, unsealer in {
        mapStore!({}) |
        contract sealer(@value, retS) = {
          for (@map <- mapStore) {
            new box in {
              mapStore!(map.set(*box, value)) |
              retS!(*box)
            }
          }
        } |
        contract unsealer(@box, retU) = {
          for (@map <<- mapStore) {
            if (map.contains(box)) {
              retU!((true, map.get(box)))
            } else {
              retU!((false, "Invalid box"))
            }
          }
        } |
        ret!((*sealer, *unsealer))
      }
    } |

    contract MultiSigSystemVault(@"deployerAuthKey", deployerId, ret) = {
      new DeployerIdOps(`rho:system:deployerId:ops`),
          vaultAddrCh,
          deployerPubKeyBytesCh in {
        DeployerIdOps!("pubKeyBytes", *deployerId, *deployerPubKeyBytesCh) |
        for (@deployerPubKeyBytes <- deployerPubKeyBytesCh) {
          _fromPublicKey!(deployerPubKeyBytes, *ret)
        }
      }
    } |

    contract _fromPublicKey(@publicKey, ret) = {
      new VaultAddress(`rho:vault:address`), vaultAddrCh in {
        VaultAddress!("fromPublicKey", publicKey, *vaultAddrCh)|
        for (@vaultAddress <- vaultAddrCh) {
          @AuthKey!("make", (*_multiSigSystemVault, vaultAddress), *ret)
        }
      }
    } |

    // MultiSig
    // Returns (false, errorMsg) or (true, (multiSigVault, vaultAddress, systemVault))
    contract MultiSigSystemVault(@"create", @publicKeys, @unsealers, @quorumSize, ret) = {
      if (quorumSize > publicKeys.length() + unsealers.length() or
          quorumSize <= 0) {
        ret!((false, "invalid quorum size"))
      } else {
        new unf, authKeyCh, authPubKeysCh, VaultAddress(`rho:vault:address`), vaultAddrCh in {
          VaultAddress!("fromUnforgeable", *unf, *vaultAddrCh) |
          @SystemVault!("unforgeableAuthKey", *unf, *authKeyCh) |
          @ListOps!("map", publicKeys, *_fromPublicKey, *authPubKeysCh) |
          for (@systemVaultAuthKey <- authKeyCh & @authPubKeys <- authPubKeysCh & @vaultAddr <- vaultAddrCh) {
            new multiSig, nonceStore, nonceMapStore, systemVaultCh, verify in {
              @SystemVault!("findOrCreate", vaultAddr, *systemVaultCh) |
              for (@maybeSystemVault <- systemVaultCh) {
                match maybeSystemVault {
                  (false, _) => { ret!(maybeSystemVault) }
                  (true, systemVault) => {
                    ret!((true, (bundle+{*multiSig}, vaultAddr, systemVault))) |
                    // Nonce starts at zero
                    @(*multiSig, *nonceStore)!(0) |

                    // Map from (vaultAddress, nonce) to
                    //   (true, confirmationSet)
                    //   (false, "transaction complete")
                    @(*multiSig, *nonceMapStore)!({}) |

                    contract multiSig(@"balance", ret) = {
                      @systemVault!("balance", *ret)
                    } |

                    contract verify(@auth, idxAuthPubKeysCh, unsealedCh) = {
                      new unsealerTest in {
                        // Check whether auth is in the list of authPubKeys
                        @ListOps!("indexOf", authPubKeys, auth, *idxAuthPubKeysCh) |
                        // Check whether auth is a sealed tuple
                        @ListOps!("partialFold", unsealers, (-1, Nil), *unsealerTest, *unsealedCh) |
                        contract unsealerTest(head, @(prevPos, _), result) = {
                          new retH in {
                            head!(auth, *retH) |
                            for (@(success, value) <- retH) {
                              result!(success, (prevPos + 1, value))
                            }
                          }
                        }
                      }
                    } |

                    // Creates transfer and "signs" with first account.
                    // auth is either a deployerAuthKey or
                    //                a sealed (*multiSig, targetVaultAddress, amount, *ret) tuple
                    // returns (true, (true, nonce)) when more sigs required
                    //         (true, (false, "done")) when only one sig required
                    //         (false, errorMsg) on failure
                    contract multiSig(@"transfer", @targetVaultAddress, @amount, @auth, ret) = {
                      new idxAuthPubKeysCh, unsealedCh in {
                        verify!(auth, *idxAuthPubKeysCh, *unsealedCh) |
                        for (@idxAuthPubKeys <- idxAuthPubKeysCh & @unsealed, @info <- unsealedCh) {
                          if (idxAuthPubKeys >= 0 or (unsealed and info.nth(1) == (bundle+{*multiSig}, targetVaultAddress, amount, *ret))) {
                            for (@nonce <- @(*multiSig, *nonceStore) & @nonceMap <- @(*multiSig, *nonceMapStore)) {
                              @(*multiSig, *nonceStore)!(nonce + 1) |
                              if (quorumSize == 1) {
                                @(*multiSig, *nonceMapStore)!(nonceMap.set(nonce, Nil)) |
                                new successCh in {
                                  @systemVault!("transfer", targetVaultAddress, amount, systemVaultAuthKey, *successCh) |
                                  for (@(success, msg) <- successCh) {
                                    if (success) {
                                      ret!((true, (false, "done")))
                                    } else {
                                      ret!((false, msg))
                                    }
                                  }
                                }
                              } else {
                                if (unsealed) {
                                  // If a contract is confirming, record which unsealer was used
                                  @(*multiSig, *nonceMapStore)!(
                                    nonceMap.set(nonce, (targetVaultAddress, amount, Set(unsealers.nth(info.nth(0)))))
                                  )
                                } else {
                                  // If a human is confirming, record which deployerAuthKey was used
                                  @(*multiSig, *nonceMapStore)!(
                                    nonceMap.set(nonce, (targetVaultAddress, amount, Set(auth)))
                                  )
                                } |
                                ret!((true, (true, nonce)))
                              }
                            }
                          } else {
                            ret!((false, "invalid auth"))
                          }
                        }
                      }
                    } |

                    // Confirms transfer transaction.
                    // auth is either a deployerAuthKey or
                    //                a sealed (*multiSig, targetVaultAddress, amount, nonce, *ret) tuple
                    // returns (true, (true, nonce)) when more sigs required
                    //         (true, (false, "done")) when all required sigs have been provided
                    //         (false, errorMsg) on failure
                    contract multiSig(@"confirm", @targetVaultAddress, @amount, @auth, @nonce, ret) = {
                      new idxAuthPubKeysCh, unsealedCh in {
                        verify!(auth, *idxAuthPubKeysCh, *unsealedCh) |
                        for (@idxAuthPubKeys <- idxAuthPubKeysCh & @unsealed, @info <- unsealedCh) {
                          if (idxAuthPubKeys >= 0 or (unsealed and info.nth(1) == (bundle+{*multiSig}, targetVaultAddress, amount, nonce, *ret))) {
                            for (@nonceMap <- @(*multiSig, *nonceMapStore)) {
                              match nonceMap.get(nonce) {
                                Nil => {
                                  @(*multiSig, *nonceMapStore)!(nonceMap) |
                                  ret!((false, "inactive transaction nonce"))
                                }
                                (nonceTargetVaultAddress, nonceAmount, nonceConfirmers) => {
                                  if (targetVaultAddress != nonceTargetVaultAddress or
                                      amount != nonceAmount) {
                                    @(*multiSig, *nonceMapStore)!(nonceMap) |
                                    ret!((false, "given data does not match stored data"))
                                  } else {
                                    if (((not unsealed) and nonceConfirmers.contains(auth)) or
                                        (unsealed and nonceConfirmers.contains(unsealers.nth(info.nth(0))))) {
                                      @(*multiSig, *nonceMapStore)!(nonceMap) |
                                      ret!((false, "already confirmed"))
                                    } else {
                                      // If this is the last confirmation
                                      if (nonceConfirmers.size() == quorumSize - 1) {
                                        // All done with this nonce
                                        @(*multiSig, *nonceMapStore)!(nonceMap.set(nonce, Nil)) |
                                        new successCh in {
                                          @systemVault!("transfer", targetVaultAddress, amount, systemVaultAuthKey, *successCh) |
                                          for (@(success, msg) <- successCh) {
                                            if (success) {
                                              ret!((true, (false, "done")))
                                            } else {
                                              ret!((false, msg))
                                            }
                                          }
                                        }
                                      } else {
                                        if (unsealed) {
                                          // If a contract is confirming, record which unsealer was used
                                          @(*multiSig, *nonceMapStore)!(
                                            nonceMap.set(nonce,
                                              (targetVaultAddress, amount, nonceConfirmers.add(unsealers.nth(info.thn(0))))
                                            )
                                          )
                                        } else {
                                          // If a human is confirming, record which deployerAuthKey was used
                                          @(*multiSig, *nonceMapStore)!(
                                            nonceMap.set(nonce,
                                              (targetVaultAddress, amount, nonceConfirmers.add(auth))
                                            )
                                          )
                                        } |
                                        ret!((true, (true, nonce)))
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  @(*multiSig, *nonceMapStore)!(nonceMap) |
                                  ret!((false, "INTERNAL ERROR: bad data stored in nonceMap"))
                                }
                              }
                            }
                          } else {
                            ret!((false, "invalid auth"))
                          }
                        }
                      }
                    } // contract multiSig(@"confirm", ...
                  } // (true, systemVault) =>
                } // match
              }// for (@maybeSystemVault, ...
            } // new
          } // for
        } // new
      } // quorum size
    } |
    rs!(
      "04fe2eb1e0e7462b1a8f64600389e1e76727f8b2d38804eaa4b48f7a7d6715130fc24d3c4dac2d8bdc19e0b49879dbaf07c30773cd9740a9d14a092ef76339207a".hexToBytes(),
      (9223372036854775807, bundle+{*MultiSigSystemVault}),
      "304402201d9ecd4984f6fd7618dfe1dfa6753c662b2765f6e0b8819e63f37c65ba4c9175022067305a89ef93fd1726ecf31929d3306cdf29a7f8efa849fe6a336b499c67739c".hexToBytes(),
      *uriOut
    )
  }
}
