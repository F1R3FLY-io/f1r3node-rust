  SystemVault, rs(`rho:registry:insertSigned:secp256k1`), uriOut,
  RevWallet(`rho:rev:wallet`)
in {
  contract SystemVault(@"find", @owner, ret) = {
    RevWallet!("find", owner, *ret)
  } |
  contract SystemVault(@"balance", @owner, ret) = {
    RevWallet!("balance", owner, *ret)
  } |
  contract SystemVault(@"transfer", @to, @amount, deployerId, ret) = {
    RevWallet!("transfer", (*deployerId, to, amount), *ret)
  } |
  rs!(
