#!/usr/bin/env bash
#
# commit-msg hook - Reject unratified commit identities and session trailers
#
# The commit author and every Co-authored-by trailer must be ratified: an
# email that already authored a commit in this history (CLAUDE.md "Commit
# Messages"). CI applies the same check to pull requests.
#

set -euo pipefail

checker="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.github/scripts/check-commit-trailers.sh"
[ -x "$checker" ] || checker="$(git rev-parse --show-toplevel)/.github/scripts/check-commit-trailers.sh"
exec "$checker" message "$1"
