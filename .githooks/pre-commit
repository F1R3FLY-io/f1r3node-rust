#!/usr/bin/env bash
#
# pre-commit hook - Run formatting and lint checks before committing
#
# Runs cargo fmt (check mode) and cargo clippy to catch style and lint
# issues before they enter the repository.
#
# To bypass (use sparingly): git commit --no-verify
#
# Environment variables:
#   SKIP_FMT=1      - Skip cargo fmt check
#   SKIP_CLIPPY=1   - Skip cargo clippy
#   SKIP_DENY=1     - Skip cargo deny check
#   SKIP_POLICY=1   - Skip the source-policy gate (no RAII in lazily-initialised statics)
#   VERBOSE=1       - Show full command output
#
# CI environment detection:
#   Automatically skips in CI environments.
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"

SKIP_FMT="${SKIP_FMT:-0}"
SKIP_CLIPPY="${SKIP_CLIPPY:-0}"
SKIP_DENY="${SKIP_DENY:-0}"
SKIP_POLICY="${SKIP_POLICY:-0}"
VERBOSE="${VERBOSE:-0}"

# Skip in CI
if [ -n "${CI:-}" ] || [ -n "${GITLAB_CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
    echo "Skipping pre-commit hooks in CI environment"
    exit 0
fi

cd "$REPO_ROOT"

FAILED=0

echo ""
echo -e "${CYAN}Running pre-commit checks...${NC}"
echo "================================"

# --- cargo fmt ---
#
# ⚠ The check goes through scripts/check-fmt.sh, and its EXIT CODE is read
# three ways, because a formatter has three outcomes and not two:
#
#   0 CLEAN | 1 DIFFS | 2 TOOL ERROR (rustfmt did not answer the question)
#
# Treating every non-zero as "unformatted" told the author to run
# `cargo fmt --all` for a crash that command cannot fix, and — worse in the
# other direction — the common shorthand
#
#     rustfmt --check <file> | grep -c '^Diff in'
#
# reads a crash as ZERO DIFFS, i.e. as CLEAN: rustfmt exits 101 with no stdout
# when handed a file outside the config root while rustfmt.toml carries an
# `ignore` list, which ours does and must. See scripts/check-fmt.sh, whose
# --self-test constructs all three states and proves the check separates them.
if [[ "$SKIP_FMT" == "1" ]]; then
    echo -e "  ${CYAN}[fmt]${NC}    ${YELLOW}SKIP${NC} (SKIP_FMT=1)"
else
    fmt_out=$(mktemp)
    # ⚠ `|| fmt_status=$?` and not a bare call: this script runs under
    # `set -e`, where a non-zero exit outside a condition would abort the hook
    # before it could tell 1 from 2 — and an aborted hook reports nothing at
    # all, which is the failure mode this whole change is about.
    fmt_status=0
    "$REPO_ROOT/scripts/check-fmt.sh" > "$fmt_out" 2>&1 || fmt_status=$?
    case "$fmt_status" in
        0)
            echo -e "  ${CYAN}[fmt]${NC}    ${GREEN}PASS${NC}"
            ;;
        1)
            echo -e "  ${CYAN}[fmt]${NC}    ${RED}FAIL${NC} (unformatted files)"
            FAILED=1
            if [[ "$VERBOSE" == "1" ]]; then
                cat "$fmt_out"
            else
                echo ""
                echo -e "  ${YELLOW}Unformatted files detected. Run:${NC}"
                echo "    cargo fmt --all"
                echo ""
            fi
            ;;
        *)
            # ⚠ NOT a formatting verdict. The tool failed, so this commit is
            # blocked with the output shown in full whatever VERBOSE says —
            # a silent "run cargo fmt" here would be advice for the wrong
            # problem, and treating it as a pass would be worse.
            echo -e "  ${CYAN}[fmt]${NC}    ${RED}TOOL ERROR${NC} (exit $fmt_status; formatting is UNKNOWN)"
            FAILED=1
            echo ""
            cat "$fmt_out"
            echo ""
            ;;
    esac
    rm -f "$fmt_out"
fi

# --- cargo clippy ---
if [[ "$SKIP_CLIPPY" == "1" ]]; then
    echo -e "  ${CYAN}[clippy]${NC} ${YELLOW}SKIP${NC} (SKIP_CLIPPY=1)"
else
    clippy_out=$(mktemp)
    if cargo clippy --workspace -- -D warnings > "$clippy_out" 2>&1; then
        echo -e "  ${CYAN}[clippy]${NC} ${GREEN}PASS${NC}"
    else
        echo -e "  ${CYAN}[clippy]${NC} ${RED}FAIL${NC}"
        FAILED=1
        if [[ "$VERBOSE" == "1" ]]; then
            cat "$clippy_out"
        else
            # Show just the error lines
            grep -E "^error" "$clippy_out" | head -20
            echo ""
            echo -e "  ${YELLOW}Run for details:${NC} cargo clippy --workspace --all-targets"
            echo ""
        fi
    fi
    rm -f "$clippy_out"
fi

# --- cargo deny ---
if [[ "$SKIP_DENY" == "1" ]]; then
    echo -e "  ${CYAN}[deny]${NC}   ${YELLOW}SKIP${NC} (SKIP_DENY=1)"
elif ! command -v cargo-deny >/dev/null 2>&1; then
    echo -e "  ${CYAN}[deny]${NC}   ${YELLOW}SKIP${NC} (cargo-deny not installed; \`cargo install cargo-deny\`)"
else
    deny_out=$(mktemp)
    if cargo deny check > "$deny_out" 2>&1; then
        echo -e "  ${CYAN}[deny]${NC}   ${GREEN}PASS${NC}"
    else
        echo -e "  ${CYAN}[deny]${NC}   ${RED}FAIL${NC}"
        FAILED=1
        if [[ "$VERBOSE" == "1" ]]; then
            cat "$deny_out"
        else
            grep -E "^error" "$deny_out" | head -20
            echo ""
            echo -e "  ${YELLOW}Run for details:${NC} cargo deny check"
            echo ""
        fi
    fi
    rm -f "$deny_out"
fi

# --- source policy: no RAII type inside a lazily-initialised static ---
#
# Rust runs no destructors for statics, so a `TempDir` (or any other Drop-contract type)
# behind lazy_static!/Lazy/LazyLock/OnceLock/OnceCell never cleans up. No clippy lint covers
# that placement, so the policy lives in shared/tests/no_raii_in_statics.rs. It reads only
# source files, so it is fast and needs no build of the rest of the workspace.
if [[ "$SKIP_POLICY" == "1" ]]; then
    echo -e "  ${CYAN}[policy]${NC} ${YELLOW}SKIP${NC} (SKIP_POLICY=1)"
else
    policy_out=$(mktemp)
    if cargo test -p shared --test no_raii_in_statics > "$policy_out" 2>&1; then
        echo -e "  ${CYAN}[policy]${NC} ${GREEN}PASS${NC}"
    else
        echo -e "  ${CYAN}[policy]${NC} ${RED}FAIL${NC}"
        FAILED=1
        if [[ "$VERBOSE" == "1" ]]; then
            cat "$policy_out"
        else
            sed -n '/RAII types found\|ALLOWLIST entries\|The walk is broken\|region finder is broken/,+12p' \
                "$policy_out" | head -30
            echo ""
            echo -e "  ${YELLOW}Run for details:${NC} cargo test -p shared --test no_raii_in_statics"
            echo ""
        fi
    fi
    rm -f "$policy_out"
fi

# Summary
echo "================================"
if [[ $FAILED -eq 0 ]]; then
    echo -e "${GREEN}All pre-commit checks passed!${NC}"
    exit 0
else
    echo -e "${RED}Pre-commit checks failed! Commit aborted.${NC}"
    echo ""
    echo "Fix the issues and try again, or bypass with: git commit --no-verify"
    echo ""
    echo "Options:"
    echo "  SKIP_FMT=1 git commit       - Skip formatting check"
    echo "  SKIP_CLIPPY=1 git commit    - Skip clippy lint check"
    echo "  SKIP_DENY=1 git commit      - Skip cargo deny check"
    echo "  SKIP_POLICY=1 git commit    - Skip the RAII-in-statics source policy"
    echo "  VERBOSE=1 git commit        - Show full output"
    exit 1
fi
