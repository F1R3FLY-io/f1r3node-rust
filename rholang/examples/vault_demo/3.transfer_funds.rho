new
  w(`rho:rev:wallet`), deployerId(`rho:system:deployerId`), resultCh,
  stdout(`rho:io:stdout`)
in {

  stdout!(("3.transfer_funds.rho")) |

  match ("%TO", 100) {
    (to, amount) => {

      stdout!(("Beginning transfer of ", amount, "to", to)) |

      w!("transfer", (*deployerId, to, amount), *resultCh) |
      for (@result <- resultCh) {

        stdout!(("Finished transfer of ", amount, "to", to, "result was:", result))
      }
    }
  }

}
