new
  w(`rho:rev:wallet`), balanceCh,
  stdout(`rho:io:stdout`)
in {

  stdout!(("2.check_balance.rho")) |

  match "%VAULT_ADDR" {
    vaultAddress => {

      stdout!(("Reading the wallet at VaultAddress", vaultAddress)) |

      w!("balance", vaultAddress, *balanceCh) |
      for (@result <- balanceCh) {

        stdout!(("Balance result is", result))
      }
    }
  }

}
