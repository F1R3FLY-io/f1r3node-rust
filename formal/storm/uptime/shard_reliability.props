"month_down_hours": R{"down_hours"}=? [ C<=HORIZON_HOURS ];
"month_survival": P=? [ !"service_down" U>HORIZON_HOURS true ];
"month_quorum_loss": P=? [ F<=HORIZON_HOURS "quorum_lost" ];
"month_common_failure": P=? [ F<=HORIZON_HOURS "common_failure" ];
"month_storage_unavailable": P=? [ F<=HORIZON_HOURS "storage_unavailable" ];
"month_queue_cap": P=? [ F<=HORIZON_HOURS "queue_cap_exhausted" ];
"month_lag_slo": P=? [ F<=HORIZON_HOURS "lag_slo_exceeded" ];
"month_memory_cap": P=? [ F<=HORIZON_HOURS "memory_cap_exhausted" ];
"month_resource_exhaustion": P=? [ F<=HORIZON_HOURS "resource_exhausted" ];
"first_loss_quorum": P=? [ "service_up" U<=HORIZON_HOURS "quorum_lost" ];
"first_loss_common": P=? [ "service_up" U<=HORIZON_HOURS "common_failure" ];
"first_loss_storage": P=? [ "service_up" U<=HORIZON_HOURS "storage_unavailable" ];
"first_loss_queue": P=? [ "service_up" U<=HORIZON_HOURS "queue_cap_exhausted" ];
"first_loss_lag": P=? [ "service_up" U<=HORIZON_HOURS "lag_slo_exceeded" ];
"first_loss_memory": P=? [ "service_up" U<=HORIZON_HOURS "memory_cap_exhausted" ];
"month_queue_bucket_hours": R{"queue_bucket_hours"}=? [ C<=HORIZON_HOURS ];
"month_memory_bucket_hours": R{"memory_bucket_hours"}=? [ C<=HORIZON_HOURS ];
"steady_state_down": S=? [ "service_down" ];
"mean_time_to_service_loss": R{"up_hours"}=? [ F "service_down" ];
"eventual_recovery": P=? [ F "service_up" ];
"expected_recovery_hours": R{"down_hours"}=? [ F "service_up" ];
